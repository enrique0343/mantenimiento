---
// Fase 59 · Esqueleto que deja BASE para que la ficha y la hoja de vida (WP-C) lo
// coloquen desde ya. Lo reemplaza WP-D, su dueño, manteniendo estas props y el id
// del contenedor (#licencias). Mientras tanto no muestra nada.
// Licencias y permisos del equipo.
interface Props {
  activoId: number;
  /** "ficha" (con botones y formulario) u "hoja" (hoja de vida impresa, sin scripts). */
  variante?: "ficha" | "hoja";
  /** Título de la sección en la hoja de vida, por ejemplo «6. Expediente técnico». */
  titulo?: string;
}
const { activoId: _activoId, variante: _variante = "ficha", titulo: _titulo } = Astro.props;
