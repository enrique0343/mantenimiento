---
// Asignar la ubicación de equipos pendientes (sin ubicación): sede → ubicación con
// su ruta. Un botón [data-asignar-ubicacion] con data-activos="1,2" asigna esos
// equipos; sin data-activos, los marcados (.sel-pendiente:checked). Lo usan el
// tablero biomédico y la ficha del equipo; solo se pinta para admin y jefe.
// POST /api/activos/asignar-ubicacion: todo o nada, con su registro por equipo.
import type { ArbolUbicaciones } from "@/lib/tablero-bio";

interface Props { arbol: ArbolUbicaciones }
const { arbol } = Astro.props;
---
<dialog id="ubicDialog" class="w-full max-w-lg rounded-sm p-0 backdrop:bg-slate-900/60" aria-labelledby="ubicTitulo">
  <div class="border-b border-slate-200 px-5 py-4">
    <h2 id="ubicTitulo" class="font-semibold">Asignar ubicación</h2>
    <p id="ubicQue" class="text-sm text-slate-600"></p>
  </div>
  <div class="space-y-3 px-5 py-4 text-sm">
    {arbol.ubicaciones.length === 0 ? (
      <p class="text-slate-600">No hay ubicaciones activas. Créalas primero en Administración, Sedes y ubicaciones.</p>
    ) : (
      <>
        <div>
          <label class="label" for="ubicSede">Sede</label>
          <select id="ubicSede" class="input">
            <option value="">Elige la sede</option>
            {arbol.sedes.map((s) => <option value={s.id}>{s.nombre}</option>)}
          </select>
        </div>
        <div>
          <label class="label" for="ubicLugar">Ubicación</label>
          <select id="ubicLugar" class="input" disabled>
            <option value="">Primero elige la sede</option>
            {arbol.ubicaciones.map((u) => <option value={u.id} data-sede={u.sedeId}>{u.ruta}</option>)}
          </select>
        </div>
      </>
    )}
    <p class="text-xs text-slate-500">Queda en el historial de cada equipo con tu nombre, la hora y la ubicación de antes y la nueva.</p>
    <p id="ubicErr" class="hidden text-red-700" role="alert"></p>
  </div>
  <div class="flex justify-end gap-2 border-t border-slate-200 px-5 py-3">
    <button type="button" class="btn-secondary btn-sm" id="ubicCancelar">Cancelar</button>
    <button type="button" class="btn-primary btn-sm" id="ubicConfirmar" disabled={arbol.ubicaciones.length === 0}>Asignar ubicación</button>
  </div>
</dialog>

<script>
  const dialog = document.getElementById("ubicDialog") as HTMLDialogElement | null;
  if (dialog) {
    const sede = document.getElementById("ubicSede") as HTMLSelectElement | null;
    const lugar = document.getElementById("ubicLugar") as HTMLSelectElement | null;
    const err = document.getElementById("ubicErr")!;
    const que = document.getElementById("ubicQue")!;
    const confirmar = document.getElementById("ubicConfirmar") as HTMLButtonElement;
    // Todas las ubicaciones; al elegir la sede quedan solo las suyas (iOS no oculta <option hidden>).
    const todas = lugar ? Array.from(lugar.querySelectorAll<HTMLOptionElement>("option[data-sede]")).map((o) => o.cloneNode(true) as HTMLOptionElement) : [];
    const pintar = () => {
      if (!lugar || !sede) return;
      const primera = document.createElement("option");
      primera.value = "";
      primera.textContent = sede.value ? "Elige la ubicación" : "Primero elige la sede";
      lugar.replaceChildren(primera, ...todas.filter((o) => o.dataset.sede === sede.value).map((o) => o.cloneNode(true) as HTMLOptionElement));
      lugar.disabled = !sede.value;
    };
    sede?.addEventListener("change", pintar);
    pintar();
    let ids: number[] = [];
    const mostrarError = (m: string) => { err.textContent = m; err.classList.toggle("hidden", !m); };
    document.querySelectorAll<HTMLButtonElement>("[data-asignar-ubicacion]").forEach((b) => b.addEventListener("click", () => {
      ids = b.dataset.activos
        ? b.dataset.activos.split(",").map(Number).filter((n) => n > 0)
        : Array.from(document.querySelectorAll<HTMLInputElement>(".sel-pendiente:checked")).map((c) => Number(c.dataset.activo));
      ids = [...new Set(ids)];
      if (!ids.length) { window.showToast?.("Marca al menos un equipo.", "warning"); return; }
      que.textContent = b.dataset.titulo ?? (ids.length === 1 ? "1 equipo pendiente de ubicación." : `${ids.length} equipos pendientes de ubicación.`);
      mostrarError("");
      confirmar.disabled = !lugar;
      dialog.showModal();
    }));
    document.getElementById("ubicCancelar")!.addEventListener("click", () => dialog.close());
    confirmar.addEventListener("click", async () => {
      if (!lugar?.value) { mostrarError(sede?.value ? "Elige la ubicación." : "Elige la sede y la ubicación."); return; }
      confirmar.disabled = true;
      try {
        const r = await fetch("/api/activos/asignar-ubicacion", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ activoIds: ids, ubicacionId: Number(lugar.value) }) });
        const j: any = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(typeof j?.error === "string" ? j.error : "No se pudo guardar. Revisa la conexión e inténtalo de nuevo.");
        window.showToast?.(j.n === 1 ? "Ubicación asignada." : `Ubicación asignada a ${j.n} equipos.`, "success");
        dialog.close();
        setTimeout(() => location.reload(), 600);
      } catch (e) {
        mostrarError((e as Error).message);
        confirmar.disabled = false;
      }
    });
  }
</script>
