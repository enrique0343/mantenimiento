---
// Encabezado de documento controlado · Sistema Visual Avante v2.0, A4.
import { fmtFechaSoloCompacta } from "@/lib/datetime";
interface Props {
  titulo: string;
  subtitulo?: string | null;
  codigo?: string | null;
  etiquetaCodigo?: string;
  version?: string | number | null;
  fecha?: string | null;
  soloImpresion?: boolean;
}
const { titulo, subtitulo, codigo, etiquetaCodigo = "Código", version, fecha, soloImpresion = false } = Astro.props;
const hoy = new Date(Date.now() - 6 * 3_600_000).toISOString().slice(0, 10);
const enSV = (f: string) => (/^\d{4}-\d{2}-\d{2}$/.test(f) ? f : new Date(Date.parse(f) - 6 * 3_600_000).toISOString().slice(0, 10));
const fechaTxt = fmtFechaSoloCompacta(fecha ? enSV(fecha) : hoy);
---
<header class:list={["doc-cab", { "solo-impresion": soloImpresion }]}>
  <img class="doc-logo" src="/brand/avante-logo.png" alt="Avante Complejo Hospitalario" />
  <div class="doc-cab-centro">
    <div class="doc-cab-titulo">{titulo}</div>
    {subtitulo && <div class="doc-cab-sub">{subtitulo}</div>}
  </div>
  <dl class="doc-cab-meta">
    {codigo && <><dt>{etiquetaCodigo}</dt><dd>{codigo}</dd></>}
    {version != null && <><dt>Versión</dt><dd>{version}</dd></>}
    <dt>Fecha</dt><dd>{fechaTxt}</dd>
  </dl>
</header>
