---
import { encodeInlineScriptVars } from "@/lib/inline-script-vars";
import "@/styles/globals.css";
import AppIcon from "@/components/AppIcon.astro";
import { AREA_KEYS, AREAS, parseArea, areaHref } from "@/lib/areas";

interface Props {
  title?: string;
  hideNav?: boolean;
}
const { title = "Mantenimiento", hideNav = false } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;

const isAdmin = user?.rol === "admin";
const isAdminOrJefe = user?.rol === "admin" || user?.rol === "jefe";
const isOperativo = isAdminOrJefe || user?.rol === "tecnico";
const esTecnico = user?.rol === "tecnico";
const area = Astro.locals.area ?? parseArea(Astro.url.searchParams.get("area")) ?? parseArea(Astro.params.area);
const info = area ? AREAS[area] : null;
const operationalTabs = area ? [
  {href: `/areas/${area}`, label: "Resumen", show: true},
  {href: areaHref("/tickets", area), label: "Solicitudes", show: true},
  {href: areaHref("/ordenes", area), label: "Órdenes", show: !["motorista","proveedor"].includes(user?.rol ?? "")},
  {href: areaHref("/activos", area), label: info!.inventoryLabel, show: user?.rol !== "motorista"},
  {href: areaHref("/catalogo-aires", "aires"), label: "Catálogo de aires", show: area === "aires" && user?.rol !== "motorista"},
  {href: areaHref("/conjuntos", area), label: "Conjuntos", show: isOperativo || user?.rol === "visualizador"},
  {href: areaHref("/planes", area), label: "Planes", show: isOperativo || user?.rol === "visualizador"},
].filter(x=>x.show) : [];
const ROL_LABEL: Record<string, string> = {
  admin:        "Admin",
  jefe:         "Jefe",
  tecnico:      "Técnico",
  proveedor:    "Proveedor",
  solicitante:  "Solicitante",
  visualizador: "Visualizador",
  motorista:    "Motorista",
};

const isActive = (href: string) =>
  path === href.split("?")[0] || (href.split("?")[0] !== "/" && path.startsWith(href.split("?")[0] + "/"));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#1E2142" />
    <link rel="icon" href="/icons/favicon-64.png" sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/figtree-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree-600.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      body { margin: 0; }
      .sidebar { width: 220px; min-width: 220px; }
      @media (max-width: 768px) {
        .sidebar { display: none; }
        .sidebar.open { display: flex; position: fixed; inset: 0; z-index: 50; }
        .main-content { margin-left: 0 !important; }
      }
    </style>
  </head>
  <body class="min-h-screen">
    {!hideNav && user ? (
      <div class="flex min-h-screen">
        <!-- Sidebar -->
        <aside class="sidebar flex flex-col text-white" id="sidebar">
          <div class="marca-app">
            <a href="/" class="marca-logo" aria-label="Inicio"><img src="/brand/avante-logo-reverso.png" alt="Avante Complejo Hospitalario" /></a>
          </div>
          <span class="marca-sub">Mantenimiento</span>

          <nav class="app-nav" aria-label="Navegación principal">
            {esTecnico ? (
              <>
                <a href="/campo" class="app-nav-link"><AppIcon name="home" /><span>Hoy</span></a>
                <a href="/campo#buscar" class="app-nav-link"><AppIcon name="search" /><span>Buscar equipo</span></a>
                <a href="/campo#reportar" class="app-nav-link"><AppIcon name="alert" /><span>Reportar falla</span></a>
                <a href="/campo#ayuda" class="app-nav-link"><AppIcon name="help" /><span>Ayuda</span></a>
              </>
            ) : <>
            <a href="/" class:list={["app-nav-link", {active:path === "/"}]} aria-current={path === "/" ? "page" : undefined}><AppIcon name="home" /><span>Panorama general</span></a>
            <div class="app-nav-label">Áreas de mantenimiento</div>
            {AREA_KEYS.map(key => <a href={`/areas/${key}`} class:list={["app-nav-link", {active:area === key}]} aria-current={area === key ? "page" : undefined}><AppIcon name={AREAS[key].icon}/><span>{AREAS[key].label}</span></a>)}
            <div class="app-nav-label">Gestión compartida</div>
            {isAdminOrJefe && <a href="/preventivos" class:list={["app-nav-link", {active:isActive("/preventivos")}]} aria-current={isActive("/preventivos") ? "page" : undefined}><AppIcon name="calendar"/><span>Tablero de preventivos</span></a>}
            {(isOperativo || user.rol === "visualizador") && <a href="/ronda" class:list={["app-nav-link", {active:isActive("/ronda")}]} aria-current={isActive("/ronda") ? "page" : undefined}><AppIcon name="clipboard"/><span>Ronda de turno</span></a>}
            {isOperativo && <a href="/aop" class:list={["app-nav-link", {active:isActive("/aop")}]} aria-current={isActive("/aop") ? "page" : undefined}><AppIcon name="clock"/><span>Desviaciones (AOP)</span></a>}
            {isOperativo && <a href="/eop" class:list={["app-nav-link", {active:isActive("/eop")}]} aria-current={isActive("/eop") ? "page" : undefined}><AppIcon name="alert"/><span>Emergencias (EOP)</span></a>}
            <a href="/recursos" class:list={["app-nav-link", {active:path === "/recursos"}]}><AppIcon name="box"/><span>Recursos</span></a>
            {isAdminOrJefe && <a href="/indicadores" class:list={["app-nav-link", {active:path === "/indicadores"}]}><AppIcon name="report"/><span>Indicadores y reportes</span></a>}
            {isAdminOrJefe && <a href="/administracion" class:list={["app-nav-link", {active:path === "/administracion"}]}><AppIcon name="settings"/><span>Administración</span></a>}
            {user.rol !== "motorista" && <a href="/mi-panel" class="app-nav-link"><AppIcon name="equipment"/><span>Mi trabajo</span></a>}
            {isAdminOrJefe && <a href="/campo" class="app-nav-link"><AppIcon name="clipboard"/><span>Modo técnico</span></a>}
            <a href="/manual" class="app-nav-link"><AppIcon name="book"/><span>Ayuda</span></a>
            </>}
          </nav>

          <div class="sidebar-usuario">
            <a href="/perfil"><strong class="truncate">{user.nombre}</strong><span>{ROL_LABEL[user.rol] ?? user.rol}</span></a>
            <button id="logoutBtn" class="sidebar-salir">Cerrar sesión</button>
          </div>
        </aside>

        <!-- Contenido principal -->
        <div class="flex-1 flex flex-col min-w-0">
          <header class="app-topbar flex items-center justify-between gap-3 px-4 py-2.5">
            <button id="menuToggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar" class="topbar-ic md:hidden">☰</button>
            <button id="searchOpen" class="topbar-busca">
              <AppIcon name="search" size={18} />
              <span class="truncate">Buscar OT, equipo, ticket…</span>
              <span class="ml-auto hidden sm:inline text-[11px]">⌘K</span>
            </button>
            <div class="flex items-center gap-1">
              <button id="bellBtn" class="topbar-ic" title="Notificaciones" aria-label="Notificaciones">
                <AppIcon name="bell" size={20} />
                <span id="bellBadge" class="punto-aviso hidden"></span>
              </button>
            </div>
          </header>

          <!-- Panel de notificaciones -->
          <div id="bellPanel" class="hidden fixed top-14 right-4 z-50 w-80 max-h-[70vh] overflow-y-auto bg-white border border-slate-300">
            <div class="flex items-center justify-between border-b border-slate-100 px-4 py-2">
              <span class="font-semibold text-sm">Notificaciones</span>
              <button id="bellMarkAll" class="text-xs text-brand-600 hover:underline">Marcar todas</button>
            </div>
            <div id="bellList" class="divide-y divide-slate-100 text-sm">
              <div class="p-4 text-center text-slate-400">Cargando…</div>
            </div>
          </div>

          <main class="app-content flex-1 p-4 sm:p-6">
            {info && !esTecnico && <div class="area-context"><div class="area-context-heading"><span class="area-symbol"><AppIcon name={info.icon} size={23}/></span><div><span class="area-eyebrow">Área de mantenimiento</span><strong>{info.label}</strong></div></div><nav class="area-tabs" aria-label={`Secciones de ${info.label}`}>{operationalTabs.map(tab=><a href={tab.href} class:list={[{active:isActive(tab.href)}]} aria-current={isActive(tab.href)?"page":undefined}>{tab.label}</a>)}</nav></div>}
            <slot />
          </main>
        </div>
      </div>

      <!-- Modal búsqueda global -->
      <div id="searchModal" class="fixed inset-0 z-[100] hidden p-4 sm:p-12" style="background:rgba(30,33,66,.6)">
        <div class="mx-auto max-w-2xl bg-white overflow-hidden">
          <div class="border-b border-slate-200 px-4">
            <input id="searchInput" type="text" placeholder="Buscar OT, equipo, ticket, item, requisición…" class="w-full border-0 bg-transparent py-3 text-base outline-none focus:ring-0" />
          </div>
          <div id="searchResults" class="max-h-[60vh] overflow-y-auto p-2 text-sm">
            <p class="p-4 text-center text-slate-400">Escribe al menos 2 caracteres para buscar.</p>
          </div>
          <div class="border-t border-slate-200 px-4 py-2 text-[10px] text-slate-400 flex justify-between">
            <span>↑↓ navegar · Enter abrir · ESC cerrar</span>
            <button id="searchClose" class="hover:text-slate-700">Cerrar</button>
          </div>
        </div>
      </div>
    ) : (
      <main class="mx-auto max-w-7xl px-4 py-6">
        <slot />
      </main>
    )}

    <!-- Global confirm dialog -->
    <div id="confirmModal" class="fixed inset-0 z-[150] hidden items-center justify-center p-4" style="background:rgba(30,33,66,.6)">
      <div class="w-full max-w-sm overflow-hidden bg-white" style="border-top:3px solid var(--azul)">
        <div class="px-5 pt-5 pb-2">
          <h3 id="confirmTitle" class="text-base font-semibold"></h3>
          <p id="confirmMsg" class="mt-1 text-sm text-slate-600 leading-relaxed"></p>
        </div>
        <div class="flex items-center justify-end gap-2 px-5 py-4">
          <button id="confirmCancel" class="btn btn-secondary btn-sm">Cancelar</button>
          <button id="confirmOk" class="btn btn-danger btn-sm">Confirmar</button>
        </div>
      </div>
    </div>

    <!-- Toast container -->
    <!-- Motivo obligatorio (fecha, frecuencia, desactivar o eliminar un preventivo) -->
    <div id="motivoModal" class="fixed inset-0 z-[150] hidden items-center justify-center p-4" style="background:rgba(30,33,66,.6)" role="dialog" aria-modal="true" aria-labelledby="motivoTitle">
      <div class="w-full max-w-md overflow-hidden bg-white" style="border-top:3px solid var(--azul)">
        <div class="px-5 pt-5 pb-2">
          <h3 id="motivoTitle" class="text-base font-semibold"></h3>
          <p id="motivoMsg" class="mt-1 text-sm text-slate-600 leading-relaxed"></p>
          <label for="motivoInput" class="label mt-3">Motivo *</label>
          <textarea id="motivoInput" class="input" rows="3" maxlength="1000" placeholder="Por qué se hace este cambio"></textarea>
          <p class="mt-1 text-xs text-slate-500">Queda en el historial con tu nombre, la hora, el antes y el después.</p>
          <p id="motivoErr" class="mt-1 hidden text-sm text-red-600" role="alert"></p>
        </div>
        <div class="flex items-center justify-end gap-2 px-5 py-4">
          <button id="motivoCancel" type="button" class="btn btn-secondary btn-sm">Cancelar</button>
          <button id="motivoOk" type="button" class="btn btn-primary btn-sm">Guardar con motivo</button>
        </div>
      </div>
    </div>

    <div id="toastContainer" class="fixed bottom-5 right-5 left-5 sm:left-auto z-[200] flex flex-col gap-2 pointer-events-none sm:max-w-xs" aria-live="polite"></div>


    {area && <script is:inline define:vars={{ __encodedScriptVars: encodeInlineScriptVars({currentArea:area}) }}>
      const { currentArea } = JSON.parse(decodeURIComponent(__encodedScriptVars));
      (() => {
        const paths = ["/activos", "/conjuntos", "/tickets", "/ordenes", "/planes", "/actividades", "/cronograma", "/planificador", "/gantt", "/plan-mantenimiento"];
        document.querySelectorAll("a[href]").forEach(link => {
          const url = new URL(link.href, location.origin);
          if (url.origin === location.origin && !url.searchParams.has("area") && paths.some(p=>url.pathname === p || url.pathname.startsWith(p+"/"))) {
            url.searchParams.set("area", currentArea);
            link.href = url.pathname + url.search + url.hash;
          }
        });
      })();
    </script>}

    <script is:inline>
      // ─── Toast system ─────────────────────────────────────────────────────────
      window.showToast = (function () {
        function esc(s) {
          return String(s || "").replace(/[&<>"']/g, function (c) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
          });
        }
        return function (msg, type, duration) {
          var container = document.getElementById("toastContainer");
          if (!container) return;
          type = type || "success";
          var clases = { success: "ok", error: "mal", warning: "ojo", info: "" };
          var t = document.createElement("div");
          t.style.cssText = "opacity:0;transform:translateY(10px);transition:opacity .25s,transform .25s";
          t.className = "aviso-toast " + (clases[type] || "");
          t.innerHTML = "<span>" + esc(msg) + "</span>";
          container.appendChild(t);
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              t.style.opacity = "1";
              t.style.transform = "translateY(0)";
            });
          });
          setTimeout(function () {
            t.style.opacity = "0";
            t.style.transform = "translateY(10px)";
            setTimeout(function () { t.remove(); }, 280);
          }, duration || 4000);
        };
      })();

      // ─── Confirm dialog ───────────────────────────────────────────────────────
      (function () {
        var modal = document.getElementById("confirmModal");
        var titleEl = document.getElementById("confirmTitle");
        var msgEl = document.getElementById("confirmMsg");
        var okBtn = document.getElementById("confirmOk");
        var cancelBtn = document.getElementById("confirmCancel");
        if (!modal) return;
        var _resolve = null;

        function closeModal(val) {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
          if (_resolve) { _resolve(val); _resolve = null; }
        }

        window.confirmAction = function (title, msg, opts) {
          opts = opts || {};
          return new Promise(function (resolve) {
            _resolve = resolve;
            titleEl.textContent = title || "¿Confirmar acción?";
            msgEl.textContent = msg || "";
            var danger = opts.danger !== false;
            okBtn.textContent = opts.confirmLabel || (danger ? "Confirmar" : "Aceptar");
            okBtn.className = "btn btn-sm " + (danger ? "btn-danger" : "btn-primary");
            modal.classList.remove("hidden");
            modal.classList.add("flex");
          });
        };

        okBtn && okBtn.addEventListener("click", function () { closeModal(true); });
        cancelBtn && cancelBtn.addEventListener("click", function () { closeModal(false); });
        modal && modal.addEventListener("click", function (e) { if (e.target === modal) closeModal(false); });
      })();

      // ─── Motivo obligatorio ───────────────────────────────────────────────────
      // pedirMotivo(título, mensaje) → el motivo escrito (mínimo 10 caracteres) o null si se cancela.
      (function () {
        var modal = document.getElementById("motivoModal");
        var input = document.getElementById("motivoInput");
        var err = document.getElementById("motivoErr");
        if (!modal || !input || !err) return;
        var _resolve = null;
        var minimo = 10;
        function cerrar(val) {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
          if (_resolve) { _resolve(val); _resolve = null; }
        }
        window.pedirMotivo = function (titulo, mensaje, opts) {
          opts = opts || {};
          minimo = opts.minimo || 10;
          if (_resolve) { _resolve(null); _resolve = null; }
          return new Promise(function (resolve) {
            _resolve = resolve;
            document.getElementById("motivoTitle").textContent = titulo || "Motivo del cambio";
            document.getElementById("motivoMsg").textContent = mensaje || "";
            input.value = "";
            err.classList.add("hidden");
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            input.focus();
          });
        };
        document.getElementById("motivoOk").addEventListener("click", function () {
          var texto = input.value.trim();
          if (texto.length < minimo) {
            err.textContent = "Escribe al menos " + minimo + " caracteres.";
            err.classList.remove("hidden");
            input.focus();
            return;
          }
          cerrar(texto);
        });
        document.getElementById("motivoCancel").addEventListener("click", function () { cerrar(null); });
        modal.addEventListener("click", function (e) { if (e.target === modal) cerrar(null); });
        modal.addEventListener("keydown", function (e) { if (e.key === "Escape") cerrar(null); });
      })();

      document.getElementById("logoutBtn")?.addEventListener("click", async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        location.href = "/login";
      });
      // ─── Búsqueda global (Cmd+K / Ctrl+K) ─────────────────────────────────
      (function () {
        var modal = document.getElementById("searchModal");
        var input = document.getElementById("searchInput");
        var results = document.getElementById("searchResults");
        var openBtn = document.getElementById("searchOpen");
        var closeBtn = document.getElementById("searchClose");
        if (!modal || !input || !results) return;

        function openModal() {
          modal.classList.remove("hidden");
          setTimeout(function () { input.focus(); }, 50);
        }
        function closeModal() {
          modal.classList.add("hidden");
          input.value = "";
          results.innerHTML = '<p class="p-4 text-center text-slate-400">Escribe al menos 2 caracteres para buscar.</p>';
        }
        openBtn && openBtn.addEventListener("click", openModal);
        closeBtn && closeBtn.addEventListener("click", closeModal);
        modal.addEventListener("click", function (e) { if (e.target === modal) closeModal(); });

        document.addEventListener("keydown", function (e) {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
            e.preventDefault();
            modal.classList.contains("hidden") ? openModal() : closeModal();
          }
          if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
        });

        var t;
        input.addEventListener("input", function () {
          clearTimeout(t);
          var q = input.value.trim();
          if (q.length < 2) {
            results.innerHTML = '<p class="p-4 text-center text-slate-400">Escribe al menos 2 caracteres.</p>';
            return;
          }
          t = setTimeout(function () { buscar(q); }, 200);
        });

        function buscar(q) {
          results.innerHTML = '<p class="p-4 text-center text-slate-400">Buscando…</p>';
          fetch("/api/search?q=" + encodeURIComponent(q) + (searchArea ? "&area=" + encodeURIComponent(searchArea) : ""))
            .then(function (r) { return r.json(); })
            .then(function (j) { renderResultados(j.resultados); })
            .catch(function () { results.innerHTML = '<p class="p-4 text-center text-red-500">Error al buscar</p>'; });
        }

        function renderResultados(R) {
          var groups = [
            { key: "ordenes",       label: "Órdenes", link: function (r) { return "/ordenes/" + r.id; },        title: function (r) { return esc(r.codigo || ("OT #" + r.id)) + " · " + esc(r.titulo); },        meta: function (r) { return r.tipo + " · " + r.estado; } },
            { key: "equipos",       label: "Equipos",  link: function (r) { return "/activos/" + r.id; },        title: function (r) { return esc(r.codigo) + " · " + esc(r.nombre); },     meta: function (r) { return r.tipo + " · " + r.estado; } },
            { key: "tickets",       label: "Tickets", link: function (r) { return "/tickets/" + r.id; },        title: function (r) { return "#" + r.id + " · " + esc(r.asunto); },        meta: function (r) { return r.estado; } },
            { key: "items",         label: "Inventario", link: function (r) { return "/inventario/" + r.id; },     title: function (r) { return esc(r.codigo) + " · " + esc(r.nombre); },     meta: function (r) { return r.unidad; } },
            { key: "comentarios",   label: "Comentarios", link: function (r) { return "/ordenes/" + r.ordenId; },   title: function (r) { return esc(r.ordenCodigo || ("OT #" + r.ordenId)) + " · " + esc(r.ordenTitulo); }, meta: function (r) { return new Date(r.createdAt).toLocaleString("es", { timeZone: "America/El_Salvador" }); } },
            { key: "requisiciones", label: "Requisiciones", link: function (r) { return "/requisiciones/" + r.id; }, title: function (r) { return esc(r.numero); },                            meta: function (r) { return r.estado; } },
          ];
          var html = "";
          var totalRes = 0;
          groups.forEach(function (g) {
            var arr = R[g.key] || [];
            if (arr.length === 0) return;
            totalRes += arr.length;
            html += '<div class="mb-2"><div class="etq px-3 py-1">' + g.label + '</div>';
            arr.forEach(function (r) {
              var snippet = r.snippet
                ? '<div class="text-xs text-slate-600 mt-0.5">' + r.snippet + '</div>'
                : '';
              html += '<a href="' + g.link(r) + '" class="block rounded px-3 py-2 hover:bg-slate-100"><div class="font-medium text-sm text-slate-800">' + g.title(r) + '</div>' + snippet + '<div class="text-[10px] text-slate-500 mt-0.5">' + g.meta(r) + '</div></a>';
            });
            html += '</div>';
          });
          if (totalRes === 0) {
            results.innerHTML = '<p class="p-4 text-center text-slate-400">Sin resultados.</p>';
          } else {
            results.innerHTML = html;
          }
        }
        function esc(s) {
          return String(s || "").replace(/[&<>"']/g, function (c) {
            return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c];
          });
        }
      })();

      // ─── Campana de notificaciones in-app ─────────────────────────────────
      (function () {
        var btn = document.getElementById("bellBtn");
        var panel = document.getElementById("bellPanel");
        var badge = document.getElementById("bellBadge");
        var list = document.getElementById("bellList");
        var markAll = document.getElementById("bellMarkAll");
        if (!btn || !panel || !badge || !list) return;

        function fmtRel(iso) {
          var d = new Date(iso);
          var diff = (Date.now() - d.getTime()) / 1000;
          if (diff < 60) return "ahora";
          if (diff < 3600) return Math.floor(diff / 60) + " min";
          if (diff < 86400) return Math.floor(diff / 3600) + " h";
          if (diff < 604800) return Math.floor(diff / 86400) + " d";
          return d.toLocaleDateString("es", { timeZone: "America/El_Salvador" });
        }

        function render(notifs) {
          if (!notifs || notifs.length === 0) {
            list.innerHTML = '<div class="p-6 text-center text-slate-400">Sin notificaciones</div>';
            return;
          }
          list.innerHTML = notifs.map(function (n) {
            var bg = n.leida ? "" : "bg-slate-50";
            var dot = n.leida ? "" : '<span class="inline-block h-2 w-2 rounded-full bg-blue-500 mr-1"></span>';
            var content =
              '<div class="flex items-start gap-2">' +
                dot +
                '<div class="flex-1 min-w-0">' +
                  '<div class="font-medium text-slate-800 truncate">' + escapeHtml(n.titulo) + '</div>' +
                  (n.mensaje ? '<div class="text-xs text-slate-600 mt-0.5">' + escapeHtml(n.mensaje) + '</div>' : '') +
                  '<div class="text-[10px] text-slate-400 mt-1">' + fmtRel(n.createdAt) + '</div>' +
                '</div>' +
              '</div>';
            if (n.link) {
              return '<a href="' + n.link + '" class="block px-3 py-2 hover:bg-slate-50 ' + bg + '" data-nid="' + n.id + '">' + content + '</a>';
            }
            return '<div class="block px-3 py-2 ' + bg + '" data-nid="' + n.id + '">' + content + '</div>';
          }).join("");

          list.querySelectorAll("[data-nid]").forEach(function (el) {
            el.addEventListener("click", function () {
              var id = el.getAttribute("data-nid");
              fetch("/api/notificaciones", {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ id: Number(id) }),
              }).catch(function () {});
            });
          });
        }

        function escapeHtml(s) {
          return String(s || "").replace(/[&<>"']/g, function (c) {
            return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c];
          });
        }

        function refresh() {
          fetch("/api/notificaciones")
            .then(function (r) { return r.json(); })
            .then(function (j) {
              var n = Number(j.noLeidas || 0);
              if (n > 0) {
                badge.textContent = n > 99 ? "99+" : String(n);
                badge.classList.remove("hidden");
              } else {
                badge.classList.add("hidden");
              }
              render(j.notificaciones || []);
            }).catch(function () {});
        }

        btn.addEventListener("click", function (e) {
          e.stopPropagation();
          panel.classList.toggle("hidden");
          if (!panel.classList.contains("hidden")) refresh();
        });

        document.addEventListener("click", function (e) {
          if (!panel.classList.contains("hidden") && !panel.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
            panel.classList.add("hidden");
          }
        });

        markAll && markAll.addEventListener("click", function () {
          fetch("/api/notificaciones", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ action: "marcar_todas_leidas" }),
          }).then(refresh).catch(function () {});
        });

        // Refrescar al cargar y cada 60 segundos
        refresh();
        setInterval(refresh, 60000);
      })();

      // Toggle sidebar en móvil + cerrar al hacer tap afuera o al navegar
      var toggle = document.getElementById("menuToggle");
      var sidebar = document.getElementById("sidebar");
      if (toggle && sidebar) {
        toggle.addEventListener("click", function (e) {
          e.stopPropagation();
          sidebar.classList.toggle("open");
          toggle.setAttribute("aria-expanded", String(sidebar.classList.contains("open")));
        });
        // Tap fuera cierra
        document.addEventListener("click", function (e) {
          if (sidebar.classList.contains("open") && !sidebar.contains(e.target) && e.target !== toggle) {
            sidebar.classList.remove("open"); toggle.setAttribute("aria-expanded", "false");
          }
        });
        // Tap en cualquier link del sidebar lo cierra
        sidebar.querySelectorAll("a").forEach(function (a) {
          a.addEventListener("click", function () { sidebar.classList.remove("open"); toggle.setAttribute("aria-expanded", "false"); });
        });
      }
    </script>
  </body>
</html>
