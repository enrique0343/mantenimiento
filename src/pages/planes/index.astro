---
import Layout from "@/layouts/Layout.astro";
import { getDb } from "@/lib/db";
import { planesMantenimiento, activos, usuarios, ubicaciones, sucursales, contratosMantenimiento, proveedores } from "@/lib/schema";
import { eq, desc, inArray } from "drizzle-orm";
import { parseArea, areaHref, activoAreaCondition } from "@/lib/areas";
import { FRECUENCIAS_RUTINA_EQUIPO, etiquetaFrecuencia, fechaCorta } from "@/lib/biomedico";
export const prerender = false;

const user = Astro.locals.user!;
if (user.rol !== "admin" && user.rol !== "jefe") return Astro.redirect(areaHref("/cronograma", Astro.url.searchParams.get("area")));

const db = getDb(Astro);
const url = new URL(Astro.request.url);
const area = parseArea(url.searchParams.get("area"));
const fSucursal = url.searchParams.get("sucursal");
const fFrecuencia = url.searchParams.get("frecuencia");
const fEstado = url.searchParams.get("estado") ?? "activos";

const rows = await db
  // D1 corta el resultado a 100 columnas: del equipo y del técnico, solo lo que se muestra.
  .select({
    p: planesMantenimiento,
    a: { id: activos.id, codigo: activos.codigo, nombre: activos.nombre, rubro: activos.rubro, estado: activos.estado },
    u: { id: usuarios.id, nombre: usuarios.nombre },
    ub: { id: ubicaciones.id, nombre: ubicaciones.nombre },
    s: { id: sucursales.id, nombre: sucursales.nombre },
  })
  .from(planesMantenimiento)
  .leftJoin(activos, eq(activos.id, planesMantenimiento.activoId))
  .leftJoin(usuarios, eq(usuarios.id, planesMantenimiento.asignadoA))
  .leftJoin(ubicaciones, eq(ubicaciones.id, activos.ubicacionId))
  .leftJoin(sucursales, eq(sucursales.id, ubicaciones.sucursalId))
  .where(area ? activoAreaCondition(area) : undefined)
  .orderBy(desc(planesMantenimiento.id));

const filtered = rows.filter((r) =>
  (!fSucursal || r.s?.id === Number(fSucursal)) &&
  (!fFrecuencia || r.p.frecuencia === fFrecuencia) &&
  (fEstado === "todos" || (fEstado === "activos" ? r.p.activo : !r.p.activo))
);

const sucursalesList = await db
  .select({ id: sucursales.id, nombre: sucursales.nombre })
  .from(sucursales)
  .where(eq(sucursales.activa, true))
  .orderBy(sucursales.nombre);

// Contratos vigentes/por vencer para vincular planes contratados
const contratosList = await db
  .select({ id: contratosMantenimiento.id, codigo: contratosMantenimiento.codigo, nombre: contratosMantenimiento.nombre })
  .from(contratosMantenimiento)
  .where(inArray(contratosMantenimiento.estado, ["vigente", "por_vencer"]))
  .orderBy(contratosMantenimiento.codigo);

// Proveedor del servicio externo (plan anual): los activos, más el ya elegido aunque se haya desactivado.
const proveedoresList = await db
  .select({ id: proveedores.id, nombre: proveedores.nombre, activo: proveedores.activo })
  .from(proveedores)
  .orderBy(proveedores.nombre);
const proveedoresActivos = proveedoresList.filter((p) => p.activo);
const proveedorPorId = new Map(proveedoresList.map((p) => [p.id, p]));

// Fecha sin hora: fechaCorta no la pasa por new Date (que mostraba el día anterior).
const fmt = (s: string) => fechaCorta(s);
---

<Layout title="Planes de mantenimiento">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div>
      <h1 class="text-2xl font-bold">Planes de mantenimiento preventivo</h1>
      <p class="text-sm text-slate-500">{rows.length} en total · mostrando {filtered.length}</p>
    </div>
    <div class="flex gap-2">
      <a href={areaHref("/planificador", area)} class="btn-secondary">Planificador mensual</a>
      <a href={areaHref("/cronograma", area)} class="btn-secondary">Cronograma</a>
    </div>
  </div>

  <!-- Filtros -->
  <form class="card mt-3 flex flex-wrap items-end gap-3 p-3" method="get">
    {area && <input type="hidden" name="area" value={area} />}
    <div>
      <label class="label text-xs">Sucursal</label>
      <select name="sucursal" class="input text-sm">
        <option value="">Todas</option>
        {sucursalesList.map((s) => <option value={s.id} selected={String(s.id) === fSucursal}>{s.nombre}</option>)}
      </select>
    </div>
    <div>
      <label class="label text-xs">Frecuencia</label>
      <select name="frecuencia" class="input text-sm">
        <option value="">Todas</option>
        {FRECUENCIAS_RUTINA_EQUIPO.map((k) => <option value={k} selected={k === fFrecuencia}>{etiquetaFrecuencia(k)}</option>)}
      </select>
    </div>
    <div>
      <label class="label text-xs">Estado</label>
      <select name="estado" class="input text-sm">
        <option value="activos" selected={fEstado === "activos"}>Activos</option>
        <option value="inactivos" selected={fEstado === "inactivos"}>Inactivos</option>
        <option value="todos" selected={fEstado === "todos"}>Todos</option>
      </select>
    </div>
    <button class="btn-primary text-sm">Filtrar</button>
    {(fSucursal || fFrecuencia || fEstado !== "activos") && <a href={areaHref("/planes", area)} class="btn-secondary text-sm">Limpiar</a>}
  </form>

  <!-- Barra de acciones bulk (aparece cuando hay seleccionados) -->
  <div id="bulkBar" class="hidden mt-3 flex items-center justify-between gap-3 rounded-lg border border-brand-200 bg-brand-50 p-3 text-sm">
    <span class="text-brand-800"><span id="bulkCount">0</span> seleccionados</span>
    <div class="flex gap-2">
      <button id="bulkActivar" class="btn-secondary text-sm">✓ Activar</button>
      <button id="bulkDesactivar" class="btn-secondary text-sm">Desactivar</button>
      <button id="bulkEliminar" class="btn-secondary text-sm text-red-600 hover:bg-red-50">Eliminar</button>
    </div>
  </div>

  <div class="card mt-4 overflow-hidden">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase text-slate-500">
        <tr>
          <th class="px-3 py-2 w-8"><input type="checkbox" id="selAll" /></th>
          <th class="px-3 py-2">Plan</th>
          <th class="px-3 py-2">Equipo</th>
          <th class="px-3 py-2">Sucursal</th>
          <th class="px-3 py-2">Frecuencia</th>
          <th class="px-3 py-2">Próxima fecha</th>
          <th class="px-3 py-2">Asignado</th>
          <th class="px-3 py-2">Modalidad</th>
          <th class="px-3 py-2">Contrato</th>
          <th class="px-3 py-2">Proveedor</th>
          <th class="px-3 py-2">Estado</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {filtered.length === 0 && <tr><td colspan="11" class="px-4 py-6 text-center text-slate-400">Sin planes con esos filtros.</td></tr>}
        {filtered.map((r) => (
          <tr class:list={["hover:bg-slate-50", !r.p.activo && "opacity-60"]}>
            <td class="px-3 py-2"><input type="checkbox" class="row-chk" data-id={r.p.id} /></td>
            <td class="px-3 py-2">
              <div class="font-medium">{r.p.titulo}</div>
              {r.p.descripcion && <div class="text-xs text-slate-500 truncate max-w-md">{r.p.descripcion}</div>}
            </td>
            <td class="px-3 py-2 text-xs">
              {r.a ? <a href={areaHref(`/activos/${r.a.id}`, area ?? r.a.rubro)} class="text-brand-700 hover:underline">{r.a.codigo} · {r.a.nombre}</a> : "—"}
              {r.a?.estado === "baja" && <span class="ml-1 badge bg-slate-200 text-slate-600">Equipo de baja</span>}
            </td>
            <td class="px-3 py-2 text-xs text-slate-600">{r.s?.nombre ?? "—"}</td>
            <td class="px-3 py-2 text-xs">{etiquetaFrecuencia(r.p.frecuencia)}</td>
            <td class="px-3 py-2 text-xs">{fmt(r.p.proximaFecha)}</td>
            <td class="px-3 py-2 text-xs text-slate-600">{r.u?.nombre ?? <span class="text-slate-400">Sin asignar</span>}</td>
            <td class="px-3 py-2">
              <select class="modalidad-sel rounded border border-slate-200 bg-white px-1.5 py-1 text-xs text-slate-700 hover:border-slate-300" data-id={r.p.id}>
                <option value="interno" selected={r.p.modalidad === "interno"}>Propio</option>
                <option value="contratado" selected={r.p.modalidad === "contratado"}>Externo</option>
                <option value="mixto" selected={r.p.modalidad === "mixto"}>Mixto</option>
              </select>
            </td>
            <td class="px-3 py-2">
              <select class="contrato-sel rounded border border-slate-200 bg-white px-1.5 py-1 text-xs text-slate-700 hover:border-slate-300 max-w-[140px]" data-id={r.p.id}>
                <option value="">—</option>
                {contratosList.map((c) => (
                  <option value={c.id} selected={r.p.contratoId === c.id}>{c.codigo}</option>
                ))}
              </select>
            </td>
            <td class="px-3 py-2">
              <select class="proveedor-sel rounded border border-slate-200 bg-white px-1.5 py-1 text-xs text-slate-700 hover:border-slate-300 max-w-[160px]" data-id={r.p.id} title="Proveedor del servicio externo">
                <option value="">—</option>
                {proveedoresActivos.map((p) => (
                  <option value={p.id} selected={r.p.proveedorId === p.id}>{p.nombre}</option>
                ))}
                {r.p.proveedorId && !proveedorPorId.get(r.p.proveedorId)?.activo && (
                  <option value={r.p.proveedorId} selected disabled>{proveedorPorId.get(r.p.proveedorId)?.nombre ?? "Proveedor"} (inactivo)</option>
                )}
              </select>
            </td>
            <td class="px-3 py-2">
              {r.p.activo
                ? <span class="badge bg-emerald-100 text-emerald-700">activo</span>
                : <span class="badge bg-slate-200 text-slate-600">inactivo</span>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <script>
    import { areaHref, parseArea } from "@/lib/areas";
    const area = parseArea(new URLSearchParams(location.search).get("area"));
    const selAll = document.getElementById("selAll") as HTMLInputElement;
    const checks = () => Array.from(document.querySelectorAll<HTMLInputElement>(".row-chk"));
    const bulkBar = document.getElementById("bulkBar")!;
    const bulkCount = document.getElementById("bulkCount")!;

    function refresh() {
      const sel = checks().filter((c) => c.checked);
      bulkCount.textContent = String(sel.length);
      bulkBar.classList.toggle("hidden", sel.length === 0);
      // Estado del checkbox "todos"
      if (selAll) {
        const total = checks().length;
        selAll.checked = sel.length > 0 && sel.length === total;
        selAll.indeterminate = sel.length > 0 && sel.length < total;
      }
    }

    selAll?.addEventListener("change", () => {
      checks().forEach((c) => (c.checked = selAll.checked));
      refresh();
    });
    checks().forEach((c) => c.addEventListener("change", refresh));

    async function bulkAction(accion: "eliminar" | "desactivar" | "activar") {
      const ids = checks().filter((c) => c.checked).map((c) => Number(c.dataset.id));
      if (ids.length === 0) return;

      const verbo = accion === "eliminar" ? "ELIMINAR" : accion === "desactivar" ? "desactivar" : "activar";
      const msg = accion === "eliminar"
        ? `¿${verbo} permanentemente ${ids.length} plan(es)? Esto NO se puede deshacer.`
        : `¿${verbo} ${ids.length} plan(es)?`;
      if (!confirm(msg)) return;

      const r = await fetch(areaHref("/api/planes/bulk", area), {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ accion, ids }),
      });
      if (r.ok) location.reload();
      else {
        // Por ejemplo: rutinas de equipos dados de baja en la selección (409).
        const j = await r.json().catch(() => null) as { error?: unknown } | null;
        alert(typeof j?.error === "string" ? j.error : "No se pudo completar la acción.");
      }
    }

    document.getElementById("bulkEliminar")?.addEventListener("click", () => bulkAction("eliminar"));
    document.getElementById("bulkDesactivar")?.addEventListener("click", () => bulkAction("desactivar"));
    document.getElementById("bulkActivar")?.addEventListener("click", () => bulkAction("activar"));

    // ── Modalidad / contrato inline ──
    async function patchPlan(sel: HTMLSelectElement, body: Record<string, unknown>, prev: string) {
      sel.disabled = true;
      const r = await fetch(areaHref(`/api/planes/${sel.dataset.id}`, area), {
        method: "PATCH",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      sel.disabled = false;
      if (r.ok) {
        sel.classList.add("ring-2", "ring-emerald-300");
        setTimeout(() => sel.classList.remove("ring-2", "ring-emerald-300"), 900);
        return true;
      }
      sel.value = prev;
      const j = await r.json().catch(() => null) as { error?: unknown } | null;
      window.showToast?.(typeof j?.error === "string" ? j.error : "No se pudo guardar", "error");
      return false;
    }
    document.querySelectorAll<HTMLSelectElement>(".modalidad-sel").forEach((sel) => {
      let prev = sel.value;
      sel.addEventListener("change", async () => {
        await patchPlan(sel, { modalidad: sel.value }, prev);
        prev = sel.value;
      });
    });
    document.querySelectorAll<HTMLSelectElement>(".contrato-sel").forEach((sel) => {
      let prev = sel.value;
      sel.addEventListener("change", async () => {
        await patchPlan(sel, { contratoId: sel.value ? Number(sel.value) : null }, prev);
        prev = sel.value;
      });
    });
    // Proveedor del servicio externo: el plan anual lo imprime en «Modalidad y proveedor».
    document.querySelectorAll<HTMLSelectElement>(".proveedor-sel").forEach((sel) => {
      let prev = sel.value;
      sel.addEventListener("change", async () => {
        await patchPlan(sel, { proveedorId: sel.value ? Number(sel.value) : null }, prev);
        prev = sel.value;
      });
    });
  </script>
</Layout>
