---
// Revisión semanal: lo que pide el SOP-MG-01 a la jefatura. Días por turnos, por sede.
import { encodeInlineScriptVars } from "@/lib/inline-script-vars";
import Layout from "@/layouts/Layout.astro";
import { getDb } from "@/lib/db";
import { and, eq } from "drizzle-orm";
import { ESTADO_RONDA, puedeConfigurarRondas, puedeVerRondas, resumenSemana } from "@/lib/ronda-turno";
import { ahoraSV, lunesDe, sumarDias } from "@/lib/turnos";
import { rondaRevisiones, sucursales } from "@/lib/schema";
import { fmtFechaSoloCompacta } from "@/lib/datetime";
export const prerender = false;

const user = Astro.locals.user!;
if (!puedeVerRondas(user.rol)) return Astro.redirect(user.rol === "tecnico" ? "/campo" : "/");
const db = getDb(Astro);
const url = new URL(Astro.request.url);
const hoy = ahoraSV().fecha;
const pedida = url.searchParams.get("semana");
const lunes = lunesDe(pedida && /^\d{4}-\d{2}-\d{2}$/.test(pedida) ? pedida : sumarDias(hoy, -7));
const sedes = await db.select({ id: sucursales.id, nombre: sucursales.nombre }).from(sucursales).where(eq(sucursales.activa, true));
const filas = [];
for (const s of sedes) {
  const r = await resumenSemana(db, s.id, lunes);
  const [firma] = await db.select().from(rondaRevisiones).where(and(eq(rondaRevisiones.sucursalId, s.id), eq(rondaRevisiones.semana, lunes))).limit(1);
  filas.push({ sede: s, r, firma: firma ?? null });
}
const puedeFirmar = puedeConfigurarRondas(user.rol);
const dias = Array.from({ length: 7 }, (_, i) => sumarDias(lunes, i));
const LEYENDA = ["completa", "con_novedad", "en_curso", "incompleta", "no_se_hizo", "no_aplica"] as const;
---
<Layout title="Revisión de la semana">
  <a href="/ronda" class="text-xs text-slate-400 hover:text-brand-600">← Ronda de turno</a>
  <div class="mt-1 flex flex-wrap items-end justify-between gap-3">
    <h1 class="text-2xl font-bold text-slate-900">Revisión de la semana del {fmtFechaSoloCompacta(lunes)}</h1>
    <div class="flex gap-2">
      <a class="btn-secondary btn-sm" href={`/ronda/semana?semana=${sumarDias(lunes, -7)}`}>← Anterior</a>
      <a class="btn-secondary btn-sm" href={`/ronda/semana?semana=${sumarDias(lunes, 7)}`}>Siguiente →</a>
    </div>
  </div>
  <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-slate-500">
    {LEYENDA.map((e) => <li class="flex items-center gap-1.5"><span class={`inline-block h-2.5 w-2.5 rounded-full ${ESTADO_RONDA[e].punto}`}></span>{ESTADO_RONDA[e].label}</li>)}
  </ul>
  {filas.map(({ sede, r, firma }) => (
    <section class="card mt-4 overflow-x-auto p-4">
      <h2 class="font-semibold text-slate-800">{sede.nombre}</h2>
      <p class="mt-1 text-xs text-slate-500">{(firma ?? r).esperadas} esperadas · {(firma ?? r).completas} completas · {(firma ?? r).conNovedad} con novedades · {(firma ?? r).incompletas} incompletas · {(firma ?? r).noHechas} no se hicieron{firma ? " · cifras de cuando se firmó" : ""}</p>
      {!r.haceRonda && <p class="mt-1 text-xs text-slate-500">Hoy esta sede no hace ronda. Cada turno se revisa con lo que regía cuando empezó.</p>}
      <table class="mt-2 text-[11px]">
        <thead><tr><th></th>{dias.map((d) => <th class="px-1 font-normal text-slate-400">{d.slice(8)}</th>)}</tr></thead>
        <tbody>
          {r.turnos.map((t) => (
            <tr>
              <td class="pr-2 text-slate-500">{t}</td>
              {dias.map((d) => {
                const c = r.celdas.find((x) => x.fecha === d && x.turno === t);
                const est = c ? ESTADO_RONDA[c.estado] : null;
                return <td class="px-1 py-0.5 text-center">{c?.ejecucionId
                  ? <a href={`/ronda/${c.ejecucionId}`} title={est?.label}><span class={`inline-block h-3 w-3 rounded-full ${est?.punto}`}></span></a>
                  : <span title={est?.label} class={`inline-block h-3 w-3 rounded-full ${est?.punto}`}></span>}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
      {firma
        ? <p class="mt-2 text-xs text-emerald-700">Revisada por {firma.revisadaNombre} el {fmtFechaSoloCompacta(ahoraSV(new Date(firma.revisadaEn)).fecha)}. {firma.observaciones}</p>
        : r.terminada && r.esperadas === 0
        ? <p class="mt-2 text-xs text-slate-500">Esa semana no se exigían rondas en esta sede: no hay nada que firmar.</p>
        : puedeFirmar && r.terminada && (
          <div class="mt-3 flex flex-wrap items-end gap-2">
            <textarea class="input min-w-[16rem] flex-1" rows="2" data-obs={sede.id} placeholder={r.excepciones ? "Hubo excepciones: qué revisaste y qué se hizo (obligatorio)" : "Observaciones (opcional)"}></textarea>
            <button class="btn-primary btn-sm" data-firmar={sede.id}>Firmar la revisión</button>
          </div>
        )}
    </section>
  ))}
</Layout>
<script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({ lunes }) }}>
  const { lunes } = JSON.parse(decodeURIComponent(__encodedScriptVars));
  document.querySelectorAll("[data-firmar]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const sucursalId = Number(btn.getAttribute("data-firmar"));
      const observaciones = document.querySelector('[data-obs="' + sucursalId + '"]')?.value?.trim() || null;
      btn.setAttribute("disabled", "true");
      try {
        const r = await fetch("/api/ronda-turno/revision", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ sucursalId, semana: lunes, observaciones }) });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(typeof d.error === "string" ? d.error : "No se pudo firmar");
        location.reload();
      } catch (e) {
        window.showToast?.(e instanceof Error ? e.message : "Error al firmar", "error");
        btn.removeAttribute("disabled");
      }
    });
  });
</script>
