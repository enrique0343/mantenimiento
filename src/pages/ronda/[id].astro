---
// La orden de ronda: lo que decía el recorrido ese turno, lo que se leyó, con hora
// real, quién y cómo llegó. Solo lectura: la ronda se hace en Modo técnico.
import Layout from "@/layouts/Layout.astro";
import { getDb } from "@/lib/db";
import { asc, eq, inArray } from "drizzle-orm";
import { paradasDeEjecucion, puedeVerRondas, rangoNormal, etiquetaTurno } from "@/lib/ronda-turno";
import { SISTEMA_LABEL, type Sistema } from "@/lib/resolver";
import { aopEventos, ordenes, procedimientos, rondaEjecuciones, rondaLecturas, rondaMarcas, sucursales, usuarios } from "@/lib/schema";
import { fmtFechaSoloCompacta, fmtHora } from "@/lib/datetime";
import { etiquetaOT } from "@/lib/orden-codigo";
export const prerender = false;

const user = Astro.locals.user!;
if (!puedeVerRondas(user.rol)) return Astro.redirect(user.rol === "tecnico" ? "/campo" : "/");
const id = Number(Astro.params.id);
if (!Number.isFinite(id)) return Astro.redirect("/ronda");

const db = getDb(Astro);
const [fila] = await db
  .select({ e: rondaEjecuciones, sede: sucursales.nombre, inicio: usuarios.nombre })
  .from(rondaEjecuciones)
  .leftJoin(sucursales, eq(sucursales.id, rondaEjecuciones.sucursalId))
  .leftJoin(usuarios, eq(usuarios.id, rondaEjecuciones.iniciadaPor))
  .where(eq(rondaEjecuciones.id, id))
  .limit(1);
if (!fila) return Astro.redirect("/ronda");
const ejec = fila.e;
const cerrada = ejec.estado === "completada";
const puntos = await paradasDeEjecucion(db, ejec);
const filasLecturas = await db
  .select({ l: rondaLecturas, codigoOrden: ordenes.codigo })
  .from(rondaLecturas)
  .leftJoin(ordenes, eq(ordenes.id, rondaLecturas.ordenId))
  .where(eq(rondaLecturas.ejecucionId, id));
const lecturas = filasLecturas.map((f) => ({ ...f.l, codigoOrden: f.codigoOrden }));
const porPunto = new Map(lecturas.map((l) => [l.puntoId, l]));
const marcas = await db
  .select({ m: rondaMarcas, quien: usuarios.nombre })
  .from(rondaMarcas)
  .leftJoin(usuarios, eq(usuarios.id, rondaMarcas.usuarioId))
  .where(eq(rondaMarcas.ejecucionId, id))
  .orderBy(asc(rondaMarcas.id));
const idsEventos = [...new Set(marcas.map((x) => x.m.aopEventoId).filter((x): x is number => x != null))];
const eventos = idsEventos.length
  ? await db.select({ id: aopEventos.id, estado: aopEventos.estado, codigo: procedimientos.codigoCorto }).from(aopEventos).leftJoin(procedimientos, eq(procedimientos.id, aopEventos.procedimientoId)).where(inArray(aopEventos.id, idsEventos))
  : [];
const mapaEventos = new Map(eventos.map((e) => [e.id, e]));
const anotados = lecturas.length;
const fuera = lecturas.filter((l) => l.resultado === "fuera").length;
const sinVerificar = lecturas.filter((l) => l.resultado === "no_verificado").length;
// Una parada con lectura está en rango o fuera; una de verificación, conforme o no.
const textoResultado = (resultado: string, numerica: boolean) =>
  resultado === "no_verificado" ? "No verificado" : resultado === "ok" ? (numerica ? "En rango" : "Conforme") : (numerica ? "Fuera de rango" : "No conforme");
const COLOR = { ok: "bg-emerald-100 text-emerald-700", fuera: "bg-orange-100 text-orange-700", no_verificado: "bg-slate-100 text-slate-600" } as const;
---
<Layout title={`Ronda ${ejec.turno} · ${fila.sede ?? ""}`}>
  <a href="/ronda" class="text-xs text-slate-400 hover:text-brand-600">← Ronda de turno</a>
  <div class="mt-1 flex flex-wrap items-center gap-2">
    <h1 class="text-2xl font-bold text-slate-900">{fila.sede ?? "Sede"}</h1>
    <span class={`badge ${cerrada ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700"}`}>{cerrada ? "Firmada" : "Sin cerrar"}</span>
  </div>
  <p class="mt-1 text-sm text-slate-500">
    {fmtFechaSoloCompacta(ejec.fecha)} · {etiquetaTurno(ejec.turno)}{fila.inicio ? ` · inició ${fila.inicio}` : ""}{ejec.iniciadaEn ? ` a las ${fmtHora(ejec.iniciadaEn)}` : ""}{cerrada && ejec.minutosRonda != null ? ` · ${ejec.minutosRonda} min` : ""}
  </p>
  <div class="card mt-4 p-4 text-sm">
    <p class="text-slate-600"><b>{anotados}</b> de {puntos.length} paradas anotadas · <b>{fuera}</b> fuera de rango · <b>{sinVerificar}</b> sin verificar</p>
    {cerrada && <p class="mt-2"><b>Firma:</b> {ejec.firmaNombre} · {ejec.completadaEn ? fmtHora(ejec.completadaEn) : ""}{ejec.recibidaEn && ejec.completadaEn && Date.parse(ejec.recibidaEn) - Date.parse(ejec.completadaEn) > 120000 ? ` · capturada sin señal, llegó a las ${fmtHora(ejec.recibidaEn)}` : ""}</p>}
    {ejec.notas && <p class="mt-2 rounded-lg bg-slate-50 px-3 py-2 text-xs text-slate-600"><b>Entrega de turno:</b> {ejec.notas}</p>}
  </div>
  <div class="mt-4 space-y-2">
    {puntos.map((p) => {
      const l = porPunto.get(p.id);
      const historia = marcas.filter((x) => x.m.puntoId === p.id);
      return (
        <article class="card p-4">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <div class="text-[11px] text-slate-400">{p.lineaSop ? `Línea ${p.lineaSop} del SOP · ` : ""}{SISTEMA_LABEL[p.sistema as Sistema] ?? p.sistema}{p.critico ? " · crítica" : ""}</div>
              <h3 class="font-semibold text-slate-800">{p.etiqueta}</h3>
              <p class="mt-0.5 text-xs text-slate-500">Normal: {rangoNormal(p)}{p.fuente ? ` · ${p.fuente}` : ""}</p>
            </div>
            <div class="shrink-0 text-right">
              {l ? <span class={`badge ${COLOR[l.resultado as keyof typeof COLOR]}`}>{textoResultado(l.resultado, !!p.requiereValor)}</span> : <span class="badge bg-red-100 text-red-700">Sin anotar</span>}
              {l?.valor != null && <div class="mt-1 text-sm font-semibold text-slate-700">{l.valor}{p.unidad ? ` ${p.unidad}` : ""}</div>}
            </div>
          </div>
          {l?.nota && <p class="mt-2 rounded-lg bg-slate-50 px-3 py-2 text-xs text-slate-600">{l.nota}</p>}
          {l?.ordenId && <a class="mt-1 inline-block text-xs font-semibold text-brand-700 underline" href={`/ordenes/${l.ordenId}`}>{etiquetaOT({ id: l.ordenId, codigo: l.codigoOrden })}</a>}
          {historia.length > 0 && (
            <ul class="mt-2 space-y-0.5 text-[11px] text-slate-500">
              {historia.map(({ m, quien }) => (
                <li>
                  {fmtHora(m.ocurridoEn)} · {quien ?? "—"} · {textoResultado(m.resultado, !!p.requiereValor)}{m.valor != null ? ` ${m.valor}` : ""}
                  {m.sinSenal ? ` · capturada sin señal, llegó a las ${fmtHora(m.recibidoEn)}` : ""}{m.ajustado ? " · hora ajustada por el servidor" : ""}
                  {cerrada && ejec.recibidaEn && m.recibidoEn > ejec.recibidaEn ? " · llegó después de la firma" : ""}
                  {m.aopEventoId && <a class="ml-1 font-semibold text-orange-700 underline" href={`/aop/${m.aopEventoId}`}>{mapaEventos.get(m.aopEventoId)?.codigo ?? "AOP"}</a>}
                </li>
              ))}
            </ul>
          )}
        </article>
      );
    })}
  </div>
</Layout>
