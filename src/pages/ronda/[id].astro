---
// Ejecutar la ronda del turno · LA PANTALLA DEL TÉCNICO
//
// Una parada por tarjeta, con el valor normal al lado del campo donde se
// teclea la lectura. El técnico no decide si está fuera de rango: anota el
// número y el sistema lo compara contra el SCP. Si se sale, aparece ahí mismo
// el AOP que rige el punto, el reloj que empezó a correr y las tres primeras
// acciones. Nadie tiene que ir a buscar un documento.
import Layout from "@/layouts/Layout.astro";
import { getDb } from "@/lib/db";
import { and, asc, eq, inArray } from "drizzle-orm";
import {
  puedeEjecutarRonda,
  puedeVerRondas,
  puntosDeRonda,
  rangoNormal,
  etiquetaTurno,
  type RondaLectura,
} from "@/lib/ronda-turno";
import { cronometro, fmtCuentaRegresiva, RELOJ } from "@/lib/aop";
import { SISTEMA_LABEL, type Sistema } from "@/lib/resolver";
import { sistemaInfo } from "@/lib/procedimientos";
import {
  aopAcciones,
  aopEventos,
  procedimientos,
  rondaEjecuciones,
  rondaLecturas,
  rondas,
  sucursales,
  usuarios,
} from "@/lib/schema";
import { fmtFechaSoloCompacta, fmtHora } from "@/lib/datetime";
export const prerender = false;

const user = Astro.locals.user!;
if (!puedeVerRondas(user.rol)) return Astro.redirect("/");
const puedeAnotar = puedeEjecutarRonda(user.rol);

const id = Number(Astro.params.id);
if (!Number.isFinite(id)) return Astro.redirect("/ronda");

const db = getDb(Astro);
const [fila] = await db
  .select({ e: rondaEjecuciones, r: rondas, sede: sucursales.nombre, inicio: usuarios.nombre })
  .from(rondaEjecuciones)
  .leftJoin(rondas, eq(rondas.id, rondaEjecuciones.rondaId))
  .leftJoin(sucursales, eq(sucursales.id, rondaEjecuciones.sucursalId))
  .leftJoin(usuarios, eq(usuarios.id, rondaEjecuciones.iniciadaPor))
  .where(eq(rondaEjecuciones.id, id))
  .limit(1);
if (!fila) return Astro.redirect("/ronda");

const ejec = fila.e;
const cerrada = ejec.estado === "completada";
const puntos = await puntosDeRonda(db, ejec.rondaId);

// Lecturas ya anotadas, por punto
const lecturas: RondaLectura[] = await db.select().from(rondaLecturas).where(eq(rondaLecturas.ejecucionId, id));
const porPunto = new Map<number, RondaLectura>(lecturas.map((l) => [l.puntoId, l]));

// El AOP de cada punto, con sus tres primeras acciones
const idsAop = [...new Set(puntos.map((p) => p.aopProcedimientoId).filter((x): x is number => x != null))];
const aops = idsAop.length
  ? await db
      .select({ id: procedimientos.id, codigo: procedimientos.codigoCorto, titulo: procedimientos.titulo, estado: procedimientos.estado })
      .from(procedimientos)
      .where(inArray(procedimientos.id, idsAop))
  : [];
const mapaAop = new Map(aops.map((a) => [a.id, a]));
const accionesFilas = idsAop.length
  ? await db
      .select({ pid: aopAcciones.procedimientoId, orden: aopAcciones.orden, accion: aopAcciones.accion })
      .from(aopAcciones)
      .where(inArray(aopAcciones.procedimientoId, idsAop))
      .orderBy(asc(aopAcciones.procedimientoId), asc(aopAcciones.orden))
  : [];
const accionesPorAop = new Map<number, string[]>();
for (const a of accionesFilas) {
  const l = accionesPorAop.get(a.pid) ?? [];
  if (l.length < 3) l.push(a.accion);
  accionesPorAop.set(a.pid, l);
}

// Los episodios que abrió esta ronda, con su reloj
const idsEventos = lecturas.map((l) => l.aopEventoId).filter((x): x is number => x != null);
const eventos = idsEventos.length
  ? await db.select().from(aopEventos).where(inArray(aopEventos.id, idsEventos))
  : [];
const mapaEventos = new Map(eventos.map((e) => [e.id, e]));

// ── Agrupado por familia, en el orden del recorrido ─────────────────────────
const familias: Array<{ sistema: string; puntos: typeof puntos }> = [];
for (const p of puntos) {
  const ultima = familias[familias.length - 1];
  if (ultima && ultima.sistema === p.sistema) ultima.puntos.push(p);
  else familias.push({ sistema: p.sistema, puntos: [p] });
}

const anotados = lecturas.length;
const total = puntos.length;
const pct = total ? Math.round((anotados / total) * 100) : 0;
const fuera = lecturas.filter((l) => l.resultado === "fuera").length;
const criticosPendientes = puntos.filter((p) => p.critico && !porPunto.has(p.id)).length;
---

<Layout title={`Ronda ${ejec.turno} · ${fila.sede ?? ""}`}>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <a href="/ronda" class="text-xs text-slate-400 hover:text-brand-600">← Ronda de turno</a>
      <div class="mt-1 flex items-center gap-2">
        <h1 class="text-2xl font-bold text-slate-900">{fila.sede ?? "Sede"}</h1>
        <span class={`badge ${cerrada ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700"}`}>
          {cerrada ? "Ronda cerrada" : "Ronda en curso"}
        </span>
      </div>
      <p class="mt-1 text-sm text-slate-500">
        {fmtFechaSoloCompacta(ejec.fecha)} · {etiquetaTurno(ejec.turno)}
        {fila.inicio ? ` · inició ${fila.inicio}` : ""}
        {cerrada && ejec.minutosRonda != null ? ` · ${ejec.minutosRonda} min` : ""}
      </p>
    </div>
    <div class="text-right">
      <div class="text-3xl font-bold text-slate-900" id="contador">{anotados}<span class="text-lg font-normal text-slate-400">/{total}</span></div>
      <div class="text-[11px] text-slate-400">paradas anotadas</div>
    </div>
  </div>

  {/* ── Barra de avance ── */}
  <div class="card mt-4 p-4">
    <div class="h-2 overflow-hidden rounded-full bg-slate-100">
      <div id="barra" class={`h-full rounded-full ${fuera > 0 ? "bg-orange-400" : "bg-emerald-500"}`} style={`width:${pct}%`}></div>
    </div>
    <div class="mt-2 flex flex-wrap items-center justify-between gap-2 text-xs">
      <span class="text-slate-500">
        <span id="n-ok" class="font-semibold text-emerald-600">{lecturas.filter((l) => l.resultado === "ok").length}</span> en rango ·
        <span id="n-fuera" class="font-semibold text-orange-600">{fuera}</span> fuera de rango ·
        <span id="n-pend" class="font-semibold text-slate-600">{total - anotados}</span> sin anotar
      </span>
      {!cerrada && puedeAnotar && (
        <button class="btn-primary btn-sm" id="btn-cerrar">Cerrar la ronda</button>
      )}
    </div>
    {!cerrada && criticosPendientes > 0 && (
      <p class="mt-2 text-[11px] text-slate-400">
        Quedan {criticosPendientes} punto(s) crítico(s) sin anotar. Si no se pueden verificar, márcalos como «No pude verificar» con la razón.
      </p>
    )}
    {cerrada && ejec.notas && (
      <p class="mt-2 rounded-lg bg-slate-50 px-3 py-2 text-xs text-slate-600"><span class="font-semibold">Notas del turno:</span> {ejec.notas}</p>
    )}
  </div>

  {/* ── Las paradas ── */}
  {familias.map((g) => {
    const info = sistemaInfo(g.sistema);
    return (
      <section class="mt-5">
        <div class="mb-2 flex items-center gap-2">
          <span class="text-lg">{info.icono}</span>
          <h2 class="font-semibold text-slate-800">{SISTEMA_LABEL[g.sistema as Sistema] ?? g.sistema}</h2>
          <span class="badge bg-slate-100 text-slate-500">{g.puntos.length}</span>
        </div>
        <div class="space-y-3">
          {g.puntos.map((p) => {
            const l = porPunto.get(p.id);
            const aop = p.aopProcedimientoId ? mapaAop.get(p.aopProcedimientoId) : null;
            const ev = l?.aopEventoId ? mapaEventos.get(l.aopEventoId) : null;
            const cron = ev ? cronometro(ev) : null;
            const borde =
              l?.resultado === "fuera" ? "border-l-orange-500"
              : l?.resultado === "ok" ? "border-l-emerald-500"
              : l?.resultado === "no_verificado" ? "border-l-slate-400"
              : p.critico ? "border-l-slate-200" : "border-l-slate-100";
            return (
              <article class={`card border-l-4 p-4 ${borde}`} data-punto={p.id}>
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                      <span class="font-mono text-[10px] text-slate-400">{p.orden}</span>
                      <h3 class="font-semibold text-slate-800">{p.etiqueta}</h3>
                      {p.critico && <span class="badge bg-red-50 text-red-600">Crítico</span>}
                    </div>
                    {p.instruccion && <p class="mt-1 text-sm leading-snug text-slate-600">{p.instruccion}</p>}
                    <div class="mt-2 flex flex-wrap items-center gap-2 text-[11px]">
                      <span class="rounded-md bg-sky-50 px-2 py-1 font-medium text-sky-700">Normal: {rangoNormal(p)}</span>
                      {p.fuente && <span class="text-slate-400">{p.fuente}</span>}
                      {aop && (
                        <a href={`/procedimientos/${aop.id}`} class="text-slate-400 hover:text-brand-600">
                          Si se sale: <span class="font-mono">{aop.codigo}</span>
                        </a>
                      )}
                    </div>
                  </div>

                  {/* Estado actual de la parada */}
                  <div class="shrink-0 text-right" data-estado={p.id}>
                    {l ? (
                      <>
                        <span class={`badge ${
                          l.resultado === "ok" ? "bg-emerald-100 text-emerald-700"
                          : l.resultado === "fuera" ? "bg-orange-100 text-orange-700"
                          : "bg-slate-100 text-slate-600"
                        }`}>
                          {l.resultado === "ok" ? "En rango" : l.resultado === "fuera" ? "Fuera de rango" : "No verificado"}
                        </span>
                        {l.valor != null && (
                          <div class="mt-1 text-sm font-semibold text-slate-700">{l.valor}{p.unidad ? ` ${p.unidad}` : ""}</div>
                        )}
                        <div class="text-[10px] text-slate-400">{fmtHora(l.registradoEn)}</div>
                      </>
                    ) : (
                      <span class="badge bg-slate-100 text-slate-400">Sin anotar</span>
                    )}
                  </div>
                </div>

                {/* Qué hacer: aparece solo cuando se salió de rango */}
                <div data-aviso={p.id} class={l?.resultado === "fuera" && aop ? "" : "hidden"}>
                  {l?.resultado === "fuera" && aop && (
                    <div class={`mt-3 rounded-xl border-l-4 bg-orange-50 p-3 ${cron ? RELOJ[cron.reloj].borde : "border-orange-400"}`}>
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="text-sm font-bold text-orange-900">
                          Se rige por <span class="font-mono">{aop.codigo}</span> · {aop.titulo}
                        </div>
                        {cron && <span class={`badge ${RELOJ[cron.reloj].badge}`}>{RELOJ[cron.reloj].label}</span>}
                      </div>
                      {cron && (
                        <div class="mt-1 text-xs font-medium text-orange-800">
                          Actuar: {fmtCuentaRegresiva(cron.minutosParaActuar)} · Escalar: {fmtCuentaRegresiva(cron.minutosParaEscalar)}
                        </div>
                      )}
                      <ol class="mt-2 space-y-1 text-xs text-orange-900">
                        {(accionesPorAop.get(aop.id) ?? []).map((a, i) => (
                          <li class="flex gap-2">
                            <span class="font-bold">{i + 1}.</span>
                            <span class="leading-snug">{a}</span>
                          </li>
                        ))}
                      </ol>
                      {ev && (
                        <a href={`/aop/${ev.id}`} class="mt-2 inline-block text-xs font-semibold text-orange-800 hover:underline">
                          Abrir la desviación y registrar lo que hice →
                        </a>
                      )}
                    </div>
                  )}
                </div>

                {l?.nota && (
                  <p class="mt-2 rounded-lg bg-slate-50 px-3 py-2 text-xs text-slate-600"><span class="font-semibold">Nota:</span> {l.nota}</p>
                )}

                {/* Anotar */}
                {!cerrada && puedeAnotar && (
                  <div class="mt-3 flex flex-wrap items-end gap-2 border-t border-slate-100 pt-3">
                    {p.requiereValor ? (
                      <>
                        <div>
                          <label class="label" for={`v-${p.id}`}>Lectura{p.unidad ? ` (${p.unidad})` : ""}</label>
                          <input class="input w-32" type="number" step="any" id={`v-${p.id}`} value={l?.valor ?? ""} placeholder="—" />
                        </div>
                        <button class="btn-primary btn-sm" data-anotar={p.id} data-resultado="ok">Anotar lectura</button>
                      </>
                    ) : (
                      <>
                        <button class="btn-primary btn-sm" data-anotar={p.id} data-resultado="ok">Conforme</button>
                        <button class="btn-secondary btn-sm !border-orange-300 !text-orange-700" data-anotar={p.id} data-resultado="fuera">No conforme</button>
                      </>
                    )}
                    <button class="btn-secondary btn-sm" data-anotar={p.id} data-resultado="no_verificado">No pude verificar</button>
                    <input class="input flex-1 min-w-[12rem]" type="text" id={`n-${p.id}`} value={l?.nota ?? ""} placeholder="Nota (obligatoria si no se pudo verificar)" />
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </section>
    );
  })}

  {puntos.length === 0 && (
    <div class="card mt-5 p-8 text-center">
      <p class="text-sm text-slate-500">Esta ronda no tiene paradas configuradas.</p>
    </div>
  )}

  {/* ── Modal de cierre ── */}
  <div id="modal-cerrar" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/40 p-4">
    <div class="card w-full max-w-lg p-5">
      <h2 class="text-lg font-bold text-slate-900">Cerrar la ronda del turno</h2>
      <p class="mt-1 text-sm text-slate-500">
        Queda registrada con la hora, quién la hizo y cuánto duró. Las desviaciones abiertas siguen con su reloj corriendo.
      </p>
      <div id="cerrar-faltantes" class="mt-3 hidden rounded-lg bg-red-50 p-3 text-xs text-red-700"></div>
      <div class="mt-3">
        <label class="label" for="cerrar-notas">Notas del turno (opcional)</label>
        <textarea class="input" id="cerrar-notas" rows="3" placeholder="Lo que el turno siguiente tiene que saber."></textarea>
      </div>
      <div class="mt-4 flex justify-end gap-2">
        <button class="btn-secondary btn-sm" id="cerrar-cancelar">Cancelar</button>
        <button class="btn-primary btn-sm" id="cerrar-confirmar">Cerrar la ronda</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  const ejecId = Number(location.pathname.split("/").pop());

  function pintarAvance(av) {
    if (!av) return;
    const anotados = av.total - av.pendientes;
    const el = document.getElementById("contador");
    if (el) el.innerHTML = anotados + '<span class="text-lg font-normal text-slate-400">/' + av.total + "</span>";
    const barra = document.getElementById("barra");
    if (barra) {
      barra.style.width = (av.total ? Math.round((anotados / av.total) * 100) : 0) + "%";
      barra.className = "h-full rounded-full " + (av.fuera > 0 ? "bg-orange-400" : "bg-emerald-500");
    }
    const sOk = document.getElementById("n-ok");
    const sFuera = document.getElementById("n-fuera");
    const sPend = document.getElementById("n-pend");
    if (sOk) sOk.textContent = String(av.ok);
    if (sFuera) sFuera.textContent = String(av.fuera);
    if (sPend) sPend.textContent = String(av.pendientes);
  }

  const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

  function pintarPunto(puntoId, data, unidad) {
    // Estado
    const cajaEstado = document.querySelector('[data-estado="' + puntoId + '"]');
    if (cajaEstado) {
      const etiqueta = data.resultado === "ok" ? "En rango" : data.resultado === "fuera" ? "Fuera de rango" : "No verificado";
      const color =
        data.resultado === "ok" ? "bg-emerald-100 text-emerald-700"
        : data.resultado === "fuera" ? "bg-orange-100 text-orange-700"
        : "bg-slate-100 text-slate-600";
      const valorInput = document.getElementById("v-" + puntoId);
      const valor = valorInput && valorInput.value !== "" ? valorInput.value + (unidad ? " " + unidad : "") : "";
      cajaEstado.innerHTML =
        '<span class="badge ' + color + '">' + etiqueta + "</span>" +
        (valor ? '<div class="mt-1 text-sm font-semibold text-slate-700">' + esc(valor) + "</div>" : "") +
        '<div class="text-[10px] text-slate-400">ahora</div>';
    }
    // Borde de la tarjeta
    const art = document.querySelector('[data-punto="' + puntoId + '"]');
    if (art) {
      art.className = art.className.replace(/border-l-(?!4\b)[a-z0-9-]+/g, "").trim() + " " +
        (data.resultado === "fuera" ? "border-l-orange-500" : data.resultado === "ok" ? "border-l-emerald-500" : "border-l-slate-400");
    }
    // Qué hacer
    const aviso = document.querySelector('[data-aviso="' + puntoId + '"]');
    if (!aviso) return;
    if (data.resultado === "fuera" && data.aop) {
      const pasos = (data.aop.acciones || [])
        .map((a, i) => '<li class="flex gap-2"><span class="font-bold">' + (i + 1) + '.</span><span class="leading-snug">' + esc(a.accion) + "</span></li>")
        .join("");
      const reloj = data.aop.reloj || {};
      aviso.innerHTML =
        '<div class="mt-3 rounded-xl border-l-4 border-orange-400 bg-orange-50 p-3">' +
          '<div class="text-sm font-bold text-orange-900">Se rige por <span class="font-mono">' + esc(data.aop.codigo) + "</span> · " + esc(data.aop.titulo) + "</div>" +
          (reloj.actuar || reloj.escalar
            ? '<div class="mt-1 text-xs font-medium text-orange-800">Actuar: ' + esc(reloj.actuar || "sin plazo") + " · Escalar: " + esc(reloj.escalar || "sin plazo") + "</div>"
            : "") +
          '<ol class="mt-2 space-y-1 text-xs text-orange-900">' + pasos + "</ol>" +
          (data.eventoId
            ? '<a href="/aop/' + data.eventoId + '" class="mt-2 inline-block text-xs font-semibold text-orange-800 hover:underline">Abrir la desviación y registrar lo que hice →</a>'
            : "") +
        "</div>";
      aviso.classList.remove("hidden");
    } else {
      aviso.innerHTML = "";
      aviso.classList.add("hidden");
    }
  }

  document.querySelectorAll("[data-anotar]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const puntoId = Number(btn.getAttribute("data-anotar"));
      const resultado = btn.getAttribute("data-resultado");
      const valorInput = document.getElementById("v-" + puntoId);
      const notaInput = document.getElementById("n-" + puntoId);
      const nota = notaInput ? notaInput.value.trim() : "";

      if (valorInput && resultado === "ok" && valorInput.value.trim() === "") {
        window.showToast?.("Teclea la lectura antes de anotar", "error");
        valorInput.focus();
        return;
      }
      if (resultado === "no_verificado" && !nota) {
        window.showToast?.("Escribe por qué no se pudo verificar", "error");
        notaInput?.focus();
        return;
      }

      const original = btn.textContent;
      btn.setAttribute("disabled", "true");
      btn.textContent = "…";
      try {
        const r = await fetch("/api/ronda-turno/" + ejecId + "/lectura", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            puntoId,
            resultado,
            valor: valorInput && valorInput.value.trim() !== "" ? Number(valorInput.value) : null,
            nota: nota || null,
          }),
        });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(typeof d.error === "string" ? d.error : "No se pudo anotar el punto");
        const unidad = valorInput ? (valorInput.previousElementSibling?.textContent?.match(/\(([^)]+)\)/)?.[1] ?? "") : "";
        pintarPunto(puntoId, d, unidad);
        pintarAvance(d.avance);
        window.showToast?.(d.mensaje, d.fuera ? "error" : "success");
      } catch (e) {
        window.showToast?.(e instanceof Error ? e.message : "Error al anotar", "error");
      } finally {
        btn.removeAttribute("disabled");
        btn.textContent = original;
      }
    });
  });

  // ── Cierre de la ronda ──
  const modal = document.getElementById("modal-cerrar");
  const abrirModal = () => { modal?.classList.remove("hidden"); modal?.classList.add("flex"); };
  const cerrarModal = () => { modal?.classList.add("hidden"); modal?.classList.remove("flex"); };
  document.getElementById("btn-cerrar")?.addEventListener("click", abrirModal);
  document.getElementById("cerrar-cancelar")?.addEventListener("click", cerrarModal);
  modal?.addEventListener("click", (e) => { if (e.target === modal) cerrarModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") cerrarModal(); });

  document.getElementById("cerrar-confirmar")?.addEventListener("click", async (ev) => {
    const btn = ev.currentTarget;
    const caja = document.getElementById("cerrar-faltantes");
    btn.setAttribute("disabled", "true");
    btn.textContent = "Cerrando…";
    try {
      const notas = document.getElementById("cerrar-notas")?.value?.trim() || null;
      const r = await fetch("/api/ronda-turno/" + ejecId + "/cerrar", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ notas }),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) {
        if (caja) {
          caja.innerHTML =
            "<div class='font-semibold'>" + esc(d.error || "No se pudo cerrar") + "</div>" +
            ((d.faltantes || []).length
              ? "<ul class='mt-1 list-disc pl-4'>" + d.faltantes.map((f) => "<li>" + esc(f) + "</li>").join("") + "</ul>"
              : "");
          caja.classList.remove("hidden");
        }
        throw new Error(d.error || "No se pudo cerrar la ronda");
      }
      window.showToast?.("Ronda cerrada", "success");
      location.reload();
    } catch (e) {
      window.showToast?.(e instanceof Error ? e.message : "Error al cerrar", "error");
    } finally {
      btn.removeAttribute("disabled");
      btn.textContent = "Cerrar la ronda";
    }
  });
</script>
