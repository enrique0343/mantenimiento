---
// Fase 59 · Catálogo de centros de costo (Administración). Admin y jefe.
import Layout from "@/layouts/Layout.astro";
import { getDb } from "@/lib/db";
import { centrosCosto, sucursales } from "@/lib/schema";
import { asc, eq, sql } from "drizzle-orm";
import { puedeGestionarBio } from "@/lib/biomedico";
export const prerender = false;

const user = Astro.locals.user!;
if (!puedeGestionarBio(user.rol)) return Astro.redirect("/");

const db = getDb(Astro);
const centros = await db
  .select({
    id: centrosCosto.id, codigo: centrosCosto.codigo, nombre: centrosCosto.nombre, sucursalId: centrosCosto.sucursalId,
    activo: centrosCosto.activo, sede: sucursales.nombre,
    equipos: sql<number>`(SELECT count(*) FROM activos a WHERE a.centro_costo_id = ${centrosCosto.id})`,
  })
  .from(centrosCosto)
  .leftJoin(sucursales, eq(sucursales.id, centrosCosto.sucursalId))
  .orderBy(asc(centrosCosto.codigo));
const sedes = await db.select({ id: sucursales.id, nombre: sucursales.nombre }).from(sucursales).orderBy(asc(sucursales.nombre));
const activos = centros.filter((c) => c.activo).length;
---

<Layout title="Centros de costo">
  <a href="/administracion" class="text-sm text-slate-500 hover:underline">← Administración</a>
  <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">Centros de costo</h1>
      <p class="text-sm text-slate-500">{activos} {activos === 1 ? "activo" : "activos"} · el centro de costo se asigna a cada equipo del inventario.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <button id="listaBtn" type="button" class="btn-secondary">Pegar lista</button>
      <button id="newBtn" type="button" class="btn-primary">+ Nuevo centro</button>
    </div>
  </div>

  <div id="form" class="card mt-4 hidden p-5">
    <h2 class="mb-3 font-semibold" id="formTitle">Nuevo centro de costo</h2>
    <input type="hidden" id="f_id" value="" />
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div><label class="label" for="f_codigo">Código *</label><input class="input" id="f_codigo" maxlength="20" autocapitalize="characters" placeholder="Ej: CC-01" /></div>
      <div class="sm:col-span-2"><label class="label" for="f_nombre">Nombre *</label><input class="input" id="f_nombre" maxlength="120" autocapitalize="characters" placeholder="Ej: UCI ADULTOS" /></div>
      <div>
        <label class="label" for="f_sede">Sede</label>
        <select class="input" id="f_sede">
          <option value="">Todas las sedes</option>
          {sedes.map((s) => <option value={s.id}>{s.nombre}</option>)}
        </select>
      </div>
      <label id="f_activoBox" class="hidden items-center gap-2 pt-6 text-sm text-slate-700">
        <input type="checkbox" id="f_activo" class="h-4 w-4" /> Activo
      </label>
    </div>
    <p class="mt-2 text-xs text-slate-500">Con sede, solo se asigna a equipos de esa sede. Sin sede, sirve para cualquiera.</p>
    <p id="formErr" class="mt-2 hidden text-sm text-red-600" role="alert"></p>
    <div class="mt-3 flex gap-2">
      <button id="saveBtn" type="button" class="btn-primary">Guardar</button>
      <button id="cancelBtn" type="button" class="btn-secondary">Cancelar</button>
    </div>
  </div>

  <div id="lista" class="card mt-4 hidden p-5">
    <h2 class="font-semibold">Pegar lista</h2>
    <p class="mt-1 text-xs text-slate-500">Una línea por centro: CÓDIGO, NOMBRE y, si aplica, SEDE. Puedes copiar las columnas desde Excel.</p>
    <textarea id="l_texto" class="input mt-2 font-mono text-xs" rows="8" placeholder={"CC-01\tUCI ADULTOS\tSede Central\nCC-02\tEMERGENCIA"}></textarea>
    <p id="listaMsg" class="mt-2 hidden text-sm" role="status"></p>
    <ul id="listaRes" class="mt-2 space-y-0.5 text-xs"></ul>
    <div class="mt-3 flex gap-2">
      <button id="listaGuardar" type="button" class="btn-primary">Agregar centros</button>
      <button id="listaCerrar" type="button" class="btn-secondary">Cerrar</button>
    </div>
  </div>

  <div class="card mt-4 overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase text-slate-500">
        <tr>
          <th class="px-4 py-2">Código</th>
          <th class="px-4 py-2">Nombre</th>
          <th class="px-4 py-2">Sede</th>
          <th class="px-4 py-2">Equipos</th>
          <th class="px-4 py-2">Estado</th>
          <th class="px-4 py-2">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {centros.length === 0 && (
          <tr><td colspan="6" class="px-4 py-6 text-center text-slate-400">Todavía no hay centros de costo. Agrégalos uno por uno o pega la lista.</td></tr>
        )}
        {centros.map((c) => (
          <tr class:list={[!c.activo && "opacity-60"]}>
            <td class="px-4 py-2 font-mono text-xs font-semibold">{c.codigo}</td>
            <td class="px-4 py-2">{c.nombre}</td>
            <td class="px-4 py-2 text-slate-600">{c.sede ?? "Todas las sedes"}</td>
            <td class="px-4 py-2"><a href={`/activos?centro=${c.id}&estado=todos`} class="text-brand-700 hover:underline">{Number(c.equipos)}</a></td>
            <td class="px-4 py-2">
              <span class:list={["badge", c.activo ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-500"]}>{c.activo ? "Activo" : "Desactivado"}</span>
            </td>
            <td class="px-4 py-2 text-xs">
              <div class="flex flex-wrap gap-3">
                <button type="button" class="edit-btn text-brand-700 hover:underline" data-id={c.id} data-codigo={c.codigo} data-nombre={c.nombre} data-sede={c.sucursalId ?? ""} data-activo={c.activo ? "1" : ""}>Editar</button>
                <button type="button" class="toggle-btn text-slate-600 hover:underline" data-id={c.id} data-activo={c.activo ? "1" : ""}>{c.activo ? "Desactivar" : "Activar"}</button>
                {Number(c.equipos) === 0 && <button type="button" class="del-btn text-red-600 hover:underline" data-id={c.id} data-codigo={c.codigo}>Eliminar</button>}
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Layout>

<script>
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $("form");
  const lista = $("lista");
  const formErr = $("formErr");
  const textoError = async (r: Response, porDefecto: string) => {
    const j = await r.json().catch(() => ({}));
    return typeof j.error === "string" ? j.error : porDefecto;
  };

  function abrirForm(datos: { id?: string; codigo?: string; nombre?: string; sede?: string; activo?: boolean }) {
    $<HTMLInputElement>("f_id").value = datos.id ?? "";
    $<HTMLInputElement>("f_codigo").value = datos.codigo ?? "";
    $<HTMLInputElement>("f_nombre").value = datos.nombre ?? "";
    $<HTMLSelectElement>("f_sede").value = datos.sede ?? "";
    $<HTMLInputElement>("f_activo").checked = datos.activo ?? true;
    $("f_activoBox").classList.toggle("hidden", !datos.id);
    $("f_activoBox").classList.toggle("flex", !!datos.id);
    $("formTitle").textContent = datos.id ? "Editar centro de costo" : "Nuevo centro de costo";
    formErr.classList.add("hidden");
    lista.classList.add("hidden");
    form.classList.remove("hidden");
    form.scrollIntoView({ behavior: "smooth" });
    $<HTMLInputElement>("f_codigo").focus();
  }

  $("newBtn").addEventListener("click", () => abrirForm({}));
  $("cancelBtn").addEventListener("click", () => form.classList.add("hidden"));
  document.querySelectorAll<HTMLButtonElement>(".edit-btn").forEach((b) => b.addEventListener("click", () => abrirForm({
    id: b.dataset.id, codigo: b.dataset.codigo, nombre: b.dataset.nombre, sede: b.dataset.sede, activo: b.dataset.activo === "1",
  })));

  $("saveBtn").addEventListener("click", async () => {
    formErr.classList.add("hidden");
    const id = $<HTMLInputElement>("f_id").value;
    const sede = $<HTMLSelectElement>("f_sede").value;
    const payload: Record<string, unknown> = {
      codigo: $<HTMLInputElement>("f_codigo").value,
      nombre: $<HTMLInputElement>("f_nombre").value,
      sucursalId: sede ? Number(sede) : null,
    };
    if (id) payload.activo = $<HTMLInputElement>("f_activo").checked;
    const r = await fetch(id ? `/api/centros-costo/${id}` : "/api/centros-costo", {
      method: id ? "PATCH" : "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(payload),
    });
    if (!r.ok) {
      formErr.textContent = await textoError(r, "No se pudo guardar el centro.");
      formErr.classList.remove("hidden");
      return;
    }
    location.reload();
  });

  document.querySelectorAll<HTMLButtonElement>(".toggle-btn").forEach((b) => b.addEventListener("click", async () => {
    b.disabled = true;
    const r = await fetch(`/api/centros-costo/${b.dataset.id}`, {
      method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ activo: b.dataset.activo !== "1" }),
    });
    if (r.ok) { location.reload(); return; }
    b.disabled = false;
    alert(await textoError(r, "No se pudo cambiar el estado del centro."));
  }));

  document.querySelectorAll<HTMLButtonElement>(".del-btn").forEach((b) => b.addEventListener("click", async () => {
    if (!confirm(`¿Eliminar el centro ${b.dataset.codigo}? Solo se elimina un centro sin equipos.`)) return;
    b.disabled = true;
    const r = await fetch(`/api/centros-costo/${b.dataset.id}`, { method: "DELETE" });
    if (r.ok) { location.reload(); return; }
    b.disabled = false;
    alert(await textoError(r, "No se pudo eliminar el centro."));
  }));

  // ── Pegar lista ──
  const listaMsg = $("listaMsg");
  const listaRes = $("listaRes");
  $("listaBtn").addEventListener("click", () => {
    form.classList.add("hidden");
    lista.classList.remove("hidden");
    lista.scrollIntoView({ behavior: "smooth" });
    $<HTMLTextAreaElement>("l_texto").focus();
  });
  $("listaCerrar").addEventListener("click", () => {
    lista.classList.add("hidden");
    if (listaRes.childElementCount) location.reload();
  });
  $("listaGuardar").addEventListener("click", async () => {
    const texto = $<HTMLTextAreaElement>("l_texto").value;
    listaRes.replaceChildren();
    if (!texto.trim()) {
      listaMsg.textContent = "Pega al menos una línea.";
      listaMsg.className = "mt-2 text-sm text-red-600";
      return;
    }
    const boton = $<HTMLButtonElement>("listaGuardar");
    boton.disabled = true;
    const r = await fetch("/api/centros-costo", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ lista: texto }) });
    boton.disabled = false;
    if (!r.ok) {
      listaMsg.textContent = await textoError(r, "No se pudo leer la lista.");
      listaMsg.className = "mt-2 text-sm text-red-600";
      return;
    }
    const j = (await r.json()) as { creados: number; resultados: { linea: number; codigo: string; error?: string }[] };
    const conError = j.resultados.filter((x) => x.error).length;
    listaMsg.textContent = `${j.creados} ${j.creados === 1 ? "centro agregado" : "centros agregados"}${conError ? `; ${conError} ${conError === 1 ? "línea con error" : "líneas con error"}` : ""}.`;
    listaMsg.className = `mt-2 text-sm ${conError ? "text-amber-700" : "text-emerald-700"}`;
    listaRes.replaceChildren(...j.resultados.map((x) => {
      const li = document.createElement("li");
      li.className = x.error ? "text-red-700" : "text-emerald-700";
      li.textContent = `Línea ${x.linea} · ${x.codigo || "—"}: ${x.error ?? "agregado"}`;
      return li;
    }));
  });
</script>
