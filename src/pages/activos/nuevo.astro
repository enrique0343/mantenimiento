---
import { encodeInlineScriptVars } from "@/lib/inline-script-vars";
import Layout from "@/layouts/Layout.astro";
import { getDb } from "@/lib/db";
import { centrosCosto, sucursales, ubicaciones, proveedores, usuarios } from "@/lib/schema";
import { eq, and, inArray, asc } from "drizzle-orm";
import { CATEGORIAS_POR_AREA } from "@/lib/categorias-equipos";
import { CRITICIDAD_LABEL, CRITICIDAD_DESC } from "@/lib/inventario-jci";
import ActivoAreaFields from "@/components/ActivoAreaFields.astro";
import UppercaseFields from "@/components/UppercaseFields.astro";
import ModeloAireSelector from "@/components/ModeloAireSelector.astro";
import { AREAS, areaHref, parseArea } from "@/lib/areas";
import { SUBCAT_KEYS, SUBCATS_BIOMEDICO } from "@/lib/rubros";
import { CLASES_RIESGO, ENTIDADES_REGISTRO } from "@/lib/biomedico";
import { CODIGO_MAX } from "@/lib/registro-activos";
import { AYUDA_EMPRESA, ETIQUETA_EMPRESA, PERSONAL_PROPIO } from "@/lib/tablero-bio";
export const prerender = false;
const area = parseArea(Astro.url.searchParams.get("area")) ?? "equipo_general";
const titulo = AREAS[area].createLabel;
const registrado = Astro.url.searchParams.get("registrado");
const registroAnterior = registrado && /^[^\u0000-\u001f\u007f]{1,60}$/.test(registrado) ? registrado : null;

const user = Astro.locals.user!;
// Fase 59: el jefe también registra equipos (D2).
if (!["admin", "jefe", "tecnico"].includes(user.rol)) {
  return Astro.redirect(areaHref("/activos", area));
}

const db = getDb(Astro);
// La empresa que da mantenimiento la pone o la cambia la jefatura (la API lo exige).
const puedeEmpresa = user.rol === "admin" || user.rol === "jefe";
const sucRows = await db.select({ id: sucursales.id, nombre: sucursales.nombre }).from(sucursales).orderBy(sucursales.nombre);
const ubRows = await db.select().from(ubicaciones).orderBy(ubicaciones.nombre);
const provRows = await db.select({ id: proveedores.id, nombre: proveedores.nombre }).from(proveedores).where(eq(proveedores.activo, true)).orderBy(proveedores.nombre);
const userRows = await db
  .select({ id: usuarios.id, nombre: usuarios.nombre, rol: usuarios.rol })
  .from(usuarios)
  .where(and(eq(usuarios.activo, true), inArray(usuarios.rol, ["tecnico", "jefe", "admin"])))
  .orderBy(asc(usuarios.nombre));
const centros = await db
  .select({ id: centrosCosto.id, codigo: centrosCosto.codigo, nombre: centrosCosto.nombre, sucursalId: centrosCosto.sucursalId, sede: sucursales.nombre })
  .from(centrosCosto)
  .leftJoin(sucursales, eq(sucursales.id, centrosCosto.sucursalId))
  .where(eq(centrosCosto.activo, true))
  .orderBy(asc(centrosCosto.codigo));

const ubJson = JSON.stringify(ubRows);
const PREFIJO: Record<string, string> = { biomedico: "BIO", equipo_general: "EQ", aires: "AC", infraestructura: "INF" };
---

<Layout title={titulo}>
  <a href={areaHref("/activos", area)} class="text-sm text-slate-500 hover:underline">&larr; Volver</a>
  <h1 class="mt-2 text-2xl font-bold" id="formTitle">{titulo}</h1>
  <p class="mt-2 text-sm text-slate-500">Puedes guardar ahora y completar después. Si dejas el código vacío, el sistema asigna uno.</p>
  {registroAnterior && <p class="mt-3 rounded-lg bg-emerald-50 p-3 text-sm text-emerald-800" role="status">Unidad {registroAnterior} registrada. Ya puedes ingresar la siguiente unidad.</p>}

  <form id="form" class="card mt-4 space-y-5 p-5">
    <ModeloAireSelector area={area} />
    <ActivoAreaFields area={area} />
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <input type="hidden" id="tipo" value={area === "biomedico" ? "biomedico" : "general"} />
      <div>
        <label class="label">Categoría</label>
        <input class="input" id="categoria" data-uppercase autocapitalize="characters" list="categoriasList" placeholder="Selecciona o escribe..." />
        <datalist id="categoriasList"></datalist>
        <p class="mt-1 text-xs text-slate-500">Las sugerencias corresponden al área seleccionada.</p>
      </div>
      <div>
        <label class="label" for="codigo">Código institucional</label>
        <input class="input" id="codigo" data-uppercase autocapitalize="characters" maxlength={CODIGO_MAX} autocomplete="off" aria-describedby="codigoHelp" />
        <p class="mt-1 text-xs text-slate-500" id="codigoHelp">Usa el código de Ingeniería Biomédica si ya tiene uno. Vacío = automático (<span id="codigoPrefijo">{PREFIJO[area]}</span>-…). No se puede repetir.</p>
      </div>
      <div>
        <label class="label">Número de activo</label>
        <input class="input" id="numeroActivo" data-uppercase autocapitalize="characters" placeholder="Ej: AC-2024-001" />
      </div>
      <div class="sm:col-span-2">
        <label class="label" for="nombre">Nombre</label>
        <input class="input" id="nombre" data-uppercase autocapitalize="characters" aria-describedby="nombreHelp" />
        <p class="mt-1 text-xs text-slate-500" id="nombreHelp">Si lo dejas vacío, se registrará como pendiente de identificar.</p>
      </div>
      <div class="sm:col-span-2">
        <label class="label">Descripción</label>
        <textarea class="input" id="descripcion" data-uppercase autocapitalize="characters" placeholder="Describe el equipo o instalación y su función" rows="2"></textarea>
      </div>
      <div>
        <label class="label">Marca</label>
        <input class="input" id="marca" data-uppercase autocapitalize="characters" />
      </div>
      <div>
        <label class="label">Modelo</label>
        <input class="input" id="modelo" data-uppercase autocapitalize="characters" />
      </div>
      <div>
        <label class="label" for="serial">Número de serie</label>
        <input class="input" id="serial" data-uppercase autocapitalize="characters" aria-describedby="serieAviso" />
        <p id="serieAviso" class="mt-1 hidden rounded bg-amber-50 p-2 text-xs text-amber-800" role="status"></p>
      </div>
      <div>
        <label class="label">Año</label>
        <input class="input" id="anio" type="number" min="1900" max="2100" />
      </div>

      <!-- Ubicacion estructurada (si hay sucursales) -->
      {sucRows.length > 0 && (
        <>
          <div>
            <label class="label">Sucursal</label>
            <select class="input" id="sucursalSel">
              <option value="">— Seleccionar —</option>
              {sucRows.map((s) => <option value={s.id}>{s.nombre}</option>)}
            </select>
          </div>
          <div>
            <label class="label">Ubicación</label>
            <select class="input" id="ubicacionSel">
              <option value="">— Seleccionar —</option>
            </select>
          </div>
        </>
      )}

      <div>
        <label class="label" for="centroCostoSel">Centro de costo</label>
        <select class="input" id="centroCostoSel">
          <option value="">— Sin centro de costo —</option>
          {centros.map((c) => <option value={c.id} data-sucursal={c.sucursalId ?? ""}>{c.codigo} · {c.nombre}{c.sede ? ` (${c.sede})` : ""}</option>)}
        </select>
        <p class="mt-1 text-xs text-slate-500">{centros.length ? "Opcional. Aparecen los centros sin sede o de la sede elegida." : "Todavía no hay centros de costo: se agregan en Administración → Centros de costo."}</p>
      </div>

      <div class="sm:col-span-2">
        <label class="label">{sucRows.length > 0 ? "Ubicación adicional / Detalle" : "Ubicación"}</label>
        <input class="input" id="ubicacion" data-uppercase autocapitalize="characters" placeholder="Ej: Sala 3 - Quirófano A" />
      </div>

      <div>
        <label class="label">Estado</label>
        <select class="input" id="estado">
          <option value="operativo">Operativo</option>
          <option value="averiado">Averiado</option>
          <option value="mantenimiento">En mantenimiento</option>
        </select>
      </div>

      {provRows.length > 0 && (
        <div>
          <label class="label" for="proveedorSel">{ETIQUETA_EMPRESA}</label>
          <select class="input" id="proveedorSel" disabled={!puedeEmpresa}>
            <option value="">{PERSONAL_PROPIO} (sin empresa)</option>
            {provRows.map((p) => <option value={p.id}>{p.nombre}</option>)}
          </select>
          <p class="mt-1 text-xs text-slate-500">{AYUDA_EMPRESA}{!puedeEmpresa && " La define la jefatura."}</p>
        </div>
      )}
    </div>

    <div id="bioFields" class="hidden border-t border-slate-200 pt-5">
      <h2 class="mb-3 font-semibold text-purple-700">Datos biomédicos</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="label" for="claseRiesgo">Clase de riesgo *</label>
          <select class="input" id="claseRiesgo">
            <option value="" disabled selected>— Elegir —</option>
            {CLASES_RIESGO.map((c) => <option value={c.valor}>{c.etiqueta} ({c.descripcion})</option>)}
          </select>
          <p class="mt-1 text-xs text-slate-500">Obligatoria en equipos biomédicos.</p>
        </div>
        <div>
          <label class="label" for="subcategoria">Subcategoría clínica</label>
          <select class="input" id="subcategoria">
            <option value="">— Sin segmentar —</option>
            {SUBCAT_KEYS.map((k) => <option value={k}>{SUBCATS_BIOMEDICO[k].label}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <h3 class="text-sm font-semibold text-slate-700">Registro sanitario</h3>
          <label class="mt-2 flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" id="registroNoRequiere" class="h-4 w-4" />
            No requiere registro sanitario
          </label>
        </div>
        <div class="registro-campo">
          <label class="label" for="registroEntidad">Entidad</label>
          <select class="input" id="registroEntidad">
            <option value="">— Elegir —</option>
            {ENTIDADES_REGISTRO.map((e) => <option value={e}>{e}</option>)}
            <option value="__otra__">Otra</option>
          </select>
        </div>
        <div class="registro-campo hidden" id="registroEntidadOtraBox">
          <label class="label" for="registroEntidadOtra">¿Cuál?</label>
          <input class="input" id="registroEntidadOtra" data-uppercase autocapitalize="characters" maxlength="60" />
        </div>
        <div class="registro-campo">
          <label class="label" for="registroSanitario">Número de registro</label>
          <input class="input" id="registroSanitario" data-uppercase autocapitalize="characters" />
        </div>
        <div class="registro-campo">
          <label class="label" for="registroEmision">Fecha de emisión</label>
          <input class="input" id="registroEmision" type="date" />
        </div>
        <div class="registro-campo">
          <label class="label" for="registroVencimiento">Fecha de vencimiento</label>
          <input class="input" id="registroVencimiento" type="date" />
        </div>
        <p class="text-xs text-slate-500 sm:col-span-2">Las calibraciones se registran después, en la ficha del equipo.</p>
      </div>
    </div>

    <div class="border-t border-slate-200 pt-5">
      <h2 class="mb-3 font-semibold text-brand-700">Datos patrimoniales y criticidad</h2>
      <p class="text-xs text-slate-500 mb-3">La criticidad evalúa el impacto de una falla del equipo o instalación. Es independiente de la urgencia de una solicitud.</p>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="label">Fecha de adquisición</label>
          <input class="input" id="fechaAdquisicion" type="date" />
        </div>
        <div>
          <label class="label">Vida útil estimada (años)</label>
          <input class="input" id="vidaUtilAnios" type="number" min="0" max="100" placeholder="Ej: 10" />
        </div>
        <div>
          <label class="label">Valor de adquisición (USD)</label>
          <input class="input" id="valorAdquisicion" type="number" min="0" step="0.01" />
        </div>
        <div>
          <label class="label">Responsable del equipo</label>
          <select class="input" id="responsableSel">
            <option value="">— Sin asignar —</option>
            {userRows.map((u) => <option value={u.id}>{u.nombre}</option>)}
          </select>
        </div>
        <div>
          <label class="label">Criticidad operacional</label>
          <select class="input" id="criticidadOperacional">
            {(["alta", "media", "baja"] as const).map((c) => (
              <option value={c} selected={c === "media"}>{CRITICIDAD_LABEL[c]}</option>
            ))}
          </select>
          <p class="mt-1 text-xs text-slate-500" id="critDesc">{CRITICIDAD_DESC.media}</p>
        </div>
        <div class="flex items-center gap-2 pt-6">
          <input type="checkbox" id="requiereCalibracion" class="h-4 w-4" />
          <label for="requiereCalibracion" class="text-sm text-slate-700">Requiere calibración (aunque no sea biomédico)</label>
        </div>
      </div>
    </div>

    <div class="border-t border-slate-200 pt-5">
      <h2 class="mb-3 font-semibold text-emerald-700">Mantenimiento preventivo automático</h2>
      <p class="text-xs text-slate-500 mb-3">Si configuras la frecuencia, el sistema generará automáticamente las órdenes preventivas en cada ciclo. Si después se hace un correctivo, el contador se reinicia automáticamente.</p>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="label">Frecuencia de mantenimiento</label>
          <select class="input" id="mantenimientoFrecuencia">
            <option value="">— Sin programación automática —</option>
            <option value="diaria">Diaria</option>
            <option value="semanal">Semanal</option>
            <option value="quincenal">Quincenal</option>
            <option value="mensual">Mensual</option>
            <option value="bimestral">Bimestral (2 meses)</option>
            <option value="trimestral">Trimestral (3 meses)</option>
            <option value="cuatrimestral">Cuatrimestral (4 meses)</option>
            <option value="semestral">Semestral (6 meses)</option>
            <option value="anual">Anual</option>
          </select>
        </div>
        <div>
          <label class="label">Primera ejecución (próxima fecha)</label>
          <input class="input" id="mantenimientoProximaFecha" type="date" />
          <p class="text-xs text-slate-400 mt-1">Si lo dejas vacío, se calcula automáticamente desde hoy.</p>
        </div>
        <div>
          <label class="label">Prioridad de la OT</label>
          <select class="input" id="mantenimientoPrioridad">
            <option value="baja">Baja</option>
            <option value="media" selected>Media</option>
            <option value="alta">Alta</option>
            <option value="urgente">Urgente</option>
          </select>
        </div>
        <div>
          <label class="label">Título del plan (opcional)</label>
          <input class="input" id="mantenimientoTitulo" data-uppercase autocapitalize="characters" placeholder="Ej: Limpieza filtros y revisión general" />
        </div>
      </div>
    </div>

    <div class="border-t border-slate-200 pt-5">
      <h2 class="mb-3 font-semibold text-amber-700">SLA del equipo (horas para completar OT)</h2>
      <p class="text-xs text-slate-500 mb-3">Define el tiempo máximo según la prioridad. La fecha de vencimiento de las nuevas OT se calculará automáticamente.</p>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div>
          <label class="label">Urgente</label>
          <input class="input" id="slaUrgenteHoras" type="number" min="0" value="4" />
          <p class="mt-1 text-xs text-slate-400">horas</p>
        </div>
        <div>
          <label class="label">Alta</label>
          <input class="input" id="slaAltaHoras" type="number" min="0" value="24" />
          <p class="mt-1 text-xs text-slate-400">horas</p>
        </div>
        <div>
          <label class="label">Media</label>
          <input class="input" id="slaMediaHoras" type="number" min="0" value="72" />
          <p class="mt-1 text-xs text-slate-400">horas</p>
        </div>
        <div>
          <label class="label">Baja</label>
          <input class="input" id="slaBajaHoras" type="number" min="0" value="168" />
          <p class="mt-1 text-xs text-slate-400">horas</p>
        </div>
      </div>
    </div>

    <p id="err" class="hidden text-sm text-red-600" role="alert" tabindex="-1"></p>
    <div class="flex flex-wrap gap-2">
      <button class="btn-primary" type="submit" id="saveBtn">{titulo}</button>
      <button class:list={["btn-secondary", area !== "aires" && "hidden"]} type="submit" id="saveAnotherBtn">Guardar y registrar otra unidad</button>
      <a class="btn-secondary" href={areaHref("/activos", area)}>Cancelar</a>
    </div>
  </form>
  <UppercaseFields />

  <script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({ ubJson, categoriasPorArea: CATEGORIAS_POR_AREA, areas: AREAS, critDescJson: CRITICIDAD_DESC, prefijos: PREFIJO, entidades: ENTIDADES_REGISTRO }) }}>
    const { ubJson, categoriasPorArea, areas, critDescJson, prefijos, entidades } = JSON.parse(decodeURIComponent(__encodedScriptVars));
    const allUbs = JSON.parse(ubJson);

    // Descripción de criticidad operacional
    const critSel = document.getElementById("criticidadOperacional");
    const critDescEl = document.getElementById("critDesc");
    critSel?.addEventListener("change", () => {
      if (critDescEl) critDescEl.textContent = critDescJson[critSel.value] ?? "";
    });

    const areaSel = document.getElementById("rubro");
    const tipoSel = document.getElementById("tipo");
    function actualizarArea() {
      const key = areaSel.value;
      tipoSel.value = key === "biomedico" ? "biomedico" : "general";
      document.getElementById("bioFields").classList.toggle("hidden", key !== "biomedico");
      document.getElementById("aireFields").classList.toggle("hidden", key !== "aires");
      document.getElementById("infraFields").classList.toggle("hidden", key !== "infraestructura");
      document.getElementById("servicioFields").classList.toggle("hidden", !["equipo_general", "biomedico"].includes(key));
      for (const el of document.querySelectorAll("#aireFields input, #infraFields input, #servicioFields input")) el.disabled = el.closest(".hidden") !== null;
      const list = document.getElementById("categoriasList");
      list.replaceChildren(...(categoriasPorArea[key] ?? []).map((c) => { const option = document.createElement("option"); option.value = c; return option; }));
      document.getElementById("formTitle").textContent = areas[key]?.createLabel ?? "Registrar activo";
      document.getElementById("saveBtn").textContent = areas[key]?.createLabel ?? "Registrar activo";
      document.getElementById("saveAnotherBtn").classList.toggle("hidden", key !== "aires");
      const prefijo = document.getElementById("codigoPrefijo");
      if (prefijo) prefijo.textContent = prefijos[key] ?? "EQ";
    }
    areaSel.addEventListener("change", actualizarArea);
    actualizarArea();

    // Sucursal → ubicación y centros de costo de esa sede (o sin sede)
    const sucursalSel = document.getElementById("sucursalSel");
    const ubicacionSel = document.getElementById("ubicacionSel");
    const centroSel = document.getElementById("centroCostoSel");
    function filtrarCentros() {
      const sid = sucursalSel?.value ?? "";
      for (const o of centroSel.options) {
        if (!o.value) continue;
        const visible = !sid || !o.dataset.sucursal || o.dataset.sucursal === sid;
        o.hidden = !visible;
        o.disabled = !visible;
        if (!visible && o.selected) centroSel.value = "";
      }
    }
    if (sucursalSel && ubicacionSel) {
      sucursalSel.addEventListener("change", () => {
        const sid = Number(sucursalSel.value);
        const filtered = sid ? allUbs.filter((u) => u.sucursalId === sid) : [];
        ubicacionSel.innerHTML = '<option value="">— Seleccionar —</option>';
        filtered.forEach((u) => {
          const opt = document.createElement("option");
          opt.value = u.id;
          opt.textContent = `${u.nombre} (${u.tipo})`;
          ubicacionSel.appendChild(opt);
        });
        filtrarCentros();
      });
    }

    // Registro sanitario: «no requiere» oculta los demás campos; «Otra» pide cuál.
    const noRequiere = document.getElementById("registroNoRequiere");
    const entidadSel = document.getElementById("registroEntidad");
    const otraBox = document.getElementById("registroEntidadOtraBox");
    function pintarRegistro() {
      for (const el of document.querySelectorAll(".registro-campo")) el.classList.toggle("hidden", noRequiere.checked);
      otraBox.classList.toggle("hidden", noRequiere.checked || entidadSel.value !== "__otra__");
    }
    noRequiere.addEventListener("change", pintarRegistro);
    entidadSel.addEventListener("change", pintarRegistro);
    pintarRegistro();

    // Serie repetida: solo avisa, no impide guardar.
    const serialEl = document.getElementById("serial");
    const serieAviso = document.getElementById("serieAviso");
    const ESTADO = { operativo: "Operativo", averiado: "Averiado", mantenimiento: "En mantenimiento", baja: "Dado de baja" };
    serialEl.addEventListener("blur", async () => {
      serieAviso.classList.add("hidden");
      const valor = serialEl.value.trim();
      if (!valor) return;
      try {
        const r = await fetch(`/api/activos/serie?valor=${encodeURIComponent(valor)}`);
        if (!r.ok) return;
        const { coincidencias } = await r.json();
        if (!coincidencias?.length) return;
        const lista = coincidencias.map((c) => `${c.codigo} · ${c.nombre} (${ESTADO[c.estado] ?? c.estado})`).join("; ");
        serieAviso.textContent = `Esta serie ya está registrada en ${lista}. Revisa que no sea el mismo equipo.`;
        serieAviso.classList.remove("hidden");
      } catch { /* sin conexión: no se avisa */ }
    });

    // Form submit
    const form = document.getElementById("form");
    const err = document.getElementById("err");
    const saveBtn = document.getElementById("saveBtn");
    const saveAnotherBtn = document.getElementById("saveAnotherBtn");
    const mostrarError = (texto) => { if (err) { err.textContent = texto; err.classList.remove("hidden"); err.focus(); } };
    let saving = false;
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (saving) return;
      err?.classList.add("hidden");
      const v = (id) => document.getElementById(id)?.value?.trim() ?? "";
      const sv = (id) => document.getElementById(id)?.value ?? "";
      const isBio = sv("tipo") === "biomedico";
      const registrarOtra = e.submitter?.id === "saveAnotherBtn" && sv("rubro") === "aires";
      const payload = {
        codigo: v("codigo") || null,
        nombre: v("nombre"),
        descripcion: v("descripcion") || null,
        ubicacion: v("ubicacion") || null,
        estado: sv("estado"),
        tipo: sv("tipo"),
        rubro: sv("rubro"),
        datosTecnicos: sv("rubro") === "aires" ? { tipoUnidad: v("tipoUnidad") || null, capacidadBtuH: v("capacidadBtuH") ? Number(v("capacidadBtuH")) : null, refrigerante: v("refrigerante") || null }
          : sv("rubro") === "infraestructura" ? { tipoInstalacion: v("tipoInstalacion") || null, sector: v("sector") || null }
          : { servicio: v("servicio") || null },
        categoria: v("categoria") || null,
        numeroActivo: v("numeroActivo") || null,
        marca: v("marca") || null,
        modelo: v("modelo") || null,
        serial: v("serial") || null,
        anio: v("anio") ? Number(v("anio")) : null,
        ubicacionId: sv("ubicacionSel") ? Number(sv("ubicacionSel")) : null,
        centroCostoId: sv("centroCostoSel") ? Number(sv("centroCostoSel")) : null,
        proveedorId: sv("proveedorSel") ? Number(sv("proveedorSel")) : null,
        slaUrgenteHoras: Number(sv("slaUrgenteHoras") || 4),
        slaAltaHoras: Number(sv("slaAltaHoras") || 24),
        slaMediaHoras: Number(sv("slaMediaHoras") || 72),
        slaBajaHoras: Number(sv("slaBajaHoras") || 168),
        fechaAdquisicion: v("fechaAdquisicion") || null,
        vidaUtilAnios: v("vidaUtilAnios") ? Number(v("vidaUtilAnios")) : null,
        valorAdquisicion: v("valorAdquisicion") ? Number(v("valorAdquisicion")) : null,
        responsableId: sv("responsableSel") ? Number(sv("responsableSel")) : null,
        criticidadOperacional: sv("criticidadOperacional") || "media",
        requiereCalibracion: document.getElementById("requiereCalibracion")?.checked ?? false,
      };
      if (sv("rubro") === "aires" && sv("modeloAireId")) {
        payload.modeloAireId = Number(sv("modeloAireId"));
        payload.modeloAireVersion = Number(sv("modeloAireVersion"));
      }
      if (isBio) {
        if (!sv("claseRiesgo")) { mostrarError("Elige la clase de riesgo."); document.getElementById("claseRiesgo")?.focus(); return; }
        payload.claseRiesgo = sv("claseRiesgo");
        payload.subcategoria = sv("subcategoria") || null;
        if (noRequiere.checked) {
          payload.registroSanitarioNoRequiere = true;
        } else {
          const emision = v("registroEmision"), vence = v("registroVencimiento");
          if (emision && vence && vence < emision) { mostrarError("El vencimiento no puede ser anterior a la emisión."); return; }
          const entidad = sv("registroEntidad") === "__otra__" ? v("registroEntidadOtra") : sv("registroEntidad");
          payload.registroSanitarioNoRequiere = false;
          payload.registroSanitario = v("registroSanitario") || null;
          payload.registroSanitarioEntidad = entidad || null;
          payload.registroSanitarioEmision = emision || null;
          payload.registroSanitarioVencimiento = vence || null;
        }
      }

      // Mantenimiento preventivo auto
      const frec = sv("mantenimientoFrecuencia");
      if (frec) {
        payload.mantenimientoFrecuencia = frec;
        payload.mantenimientoProximaFecha = v("mantenimientoProximaFecha") || null;
        payload.mantenimientoTitulo = v("mantenimientoTitulo") || null;
        payload.mantenimientoPrioridad = sv("mantenimientoPrioridad") || "media";
      }
      saving = true;
      saveBtn.disabled = true;
      saveAnotherBtn.disabled = true;
      saveBtn.textContent = "Guardando…";
      try {
        const res = await fetch("/api/activos", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) {
          mostrarError(typeof j.error === "string" ? j.error : "No se pudo registrar el equipo.");
          return;
        }
        if (!Number.isSafeInteger(j.activo?.id)) throw new Error("No se recibió la ficha creada");
        if (registrarOtra) {
          const next = new URL("/activos/nuevo", location.origin);
          next.searchParams.set("area", "aires");
          next.searchParams.set("registrado", j.activo.codigo);
          if (payload.modeloAireId) next.searchParams.set("modeloAireId", String(payload.modeloAireId));
          location.href = next.pathname + next.search;
          return;
        }
        location.href = `/activos/${j.activo.id}?area=${encodeURIComponent(j.activo.rubro)}`;
      } catch {
        mostrarError("No se pudo confirmar el registro. Revisa el inventario antes de volver a guardarlo.");
      } finally {
        saving = false;
        saveBtn.disabled = false;
        saveAnotherBtn.disabled = false;
        saveBtn.textContent = areas[sv("rubro")]?.createLabel ?? "Registrar activo";
      }
    });
  </script>
</Layout>
