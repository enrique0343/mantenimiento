---
import { encodeInlineScriptVars } from "@/lib/inline-script-vars";
import Layout from "@/layouts/Layout.astro";
import { ESCANEO_ACTIVOS_HABILITADO } from "@/lib/campo-config";
import ActivoConjuntos from "@/components/ActivoConjuntos.astro";
import CatalogoAireOrigen from "@/components/CatalogoAireOrigen.astro";
import { getConjuntosDelActivo } from "@/lib/conjuntos";
import { getDb } from "@/lib/db";
import { etiquetaOT } from "@/lib/orden-codigo";
import { activos, planesMantenimiento, ordenes, usuarios, sucursales, ubicaciones, proveedores, auditLog, contratosMantenimiento, contratoEquipos, calibraciones, activoDocumentos, activoRespaldos, procedimientos, activoUbicacionesServidas, variablesPredictivas, centrosCosto, activoBajas, activoExpedienteNa, alertasEquipo, alertasEquipoActivos, pruebasSeguridadElectrica } from "@/lib/schema";
import { eq, asc, desc, and, inArray, ne, sql } from "drizzle-orm";
import { alias } from "drizzle-orm/sqlite-core";
import { FRECUENCIAS } from "@/lib/frecuencias";
import { labelCampo } from "@/lib/audit";
import { ESTADO_CONTRATO_LABEL, ESTADO_CONTRATO_COLOR, diasParaVencer } from "@/lib/contratos";
import { CRITICIDAD_LABEL, CRITICIDAD_COLOR, RESULTADO_CALIB_LABEL, RESULTADO_CALIB_COLOR } from "@/lib/inventario-jci";
import DocumentosEquipo from "@/components/bio/DocumentosEquipo.astro";
import LicenciasEquipo from "@/components/bio/LicenciasEquipo.astro";
import CapacitacionesEquipo from "@/components/bio/CapacitacionesEquipo.astro";
import {
  ALERTA_BADGE, APLICABILIDAD_LABEL, ARCHIVO_ACCEPT, ARCHIVO_MAX_BYTES, DESTINOS_BAJA, ESTADO_ACTIVO_COLOR, ESTADO_ACTIVO_LABEL,
  ESTADO_ALERTA_LABEL, ESTADO_CALIBRACION_COLOR, ESTADO_CALIBRACION_LABEL, ESTADO_REGISTRO_COLOR, ESTADO_REGISTRO_LABEL,
  ESTADO_SEG_ELEC_COLOR, ESTADO_SEG_ELEC_LABEL, FRECUENCIAS_RUTINA_EQUIPO, HISTORIAL_ACTIVO, MOTIVOS_BAJA, RESULTADO_SE_COLOR,
  RESULTADO_SE_LABEL, TIPO_ALERTA_LABEL, completitudExpediente, diasEntre, esFechaISO, estadoRegistroSanitario,
  estadoSeguridadElectrica, etiquetaCentroCosto, etiquetaClaseRiesgo, etiquetaFrecuencia, fechaCorta, folioActaBaja,
  hoySV, infoCalibracion, opcionesLaboratorio, patronVigenteEn, puedeGestionarBio, puedeRegistrarBio, puedeVerBio, sumarMeses,
  textoAcreditacion, textoVence, type CalMin,
} from "@/lib/biomedico";
import { lineasExpediente, puedeImprimirVineta, tarjetaHistorialCambios, textoLabAcreditado } from "@/lib/historial-equipo";
import {
  NIVELES_JERARQUIA, NIVEL_LABEL, NIVEL_COLOR, PROFUNDIDAD_MAXIMA,
  ROLES_UBICACION_SERVIDA, ROL_SERVIDA_LABEL, ROL_SERVIDA_COLOR, ROL_SERVIDA_AYUDA,
  TIPO_ATRIBUTO_LABEL, TIPO_ATRIBUTO_COLOR, ESTADO_PROCEDIMIENTO_LABEL, ESTADO_PROCEDIMIENTO_COLOR,
  valorNominalTexto, rutaAscendente, hijosConOrdenesAbiertas, descendientesDe,
  type NivelJerarquia, type RolUbicacionServida, type TipoAtributo,
} from "@/lib/jerarquia";
import {
  queRigeEsteActivo, queSigue, juegoDeFamilia, equiposPorFamilia,
  SISTEMA_LABEL, type Sistema,
} from "@/lib/resolver";
import { TIPO_PROC, SISTEMAS, estadoInfo } from "@/lib/procedimientos";
import { AREAS, areaHref, parseArea, activoAreaCondition } from "@/lib/areas";
import { rubroDeActivo } from "@/lib/rubros";
import { leerDatosTecnicos } from "@/lib/activo-area";
export const prerender = false;

const id = Number(Astro.params.id);
if (!Number.isFinite(id)) return Astro.redirect(areaHref("/activos", parseArea(Astro.url.searchParams.get("area"))));

const db = getDb(Astro);
const [a] = await db.select().from(activos).where(eq(activos.id, id)).limit(1);
if (!a) return Astro.redirect(areaHref("/activos", parseArea(Astro.url.searchParams.get("area"))));
const area = rubroDeActivo(a.rubro, a.tipo);
if (parseArea(Astro.url.searchParams.get("area")) !== area) return Astro.redirect(areaHref(Astro.url.pathname + Astro.url.search, area));
const datosTecnicos = leerDatosTecnicos(a.datosTecnicos);

// Sucursal + ubicación + proveedor (vía FKs)
let sucursalInfo: { id: number; nombre: string } | null = null;
let ubicacionInfo: { id: number; nombre: string; tipo: string } | null = null;
let proveedorInfo: { id: number; nombre: string } | null = null;
if (a.ubicacionId) {
  const [u] = await db
    .select({ id: ubicaciones.id, nombre: ubicaciones.nombre, tipo: ubicaciones.tipo, sucursalId: ubicaciones.sucursalId })
    .from(ubicaciones).where(eq(ubicaciones.id, a.ubicacionId)).limit(1);
  if (u) {
    ubicacionInfo = { id: u.id, nombre: u.nombre, tipo: u.tipo };
    const [s] = await db.select({ id: sucursales.id, nombre: sucursales.nombre })
      .from(sucursales).where(eq(sucursales.id, u.sucursalId)).limit(1);
    if (s) sucursalInfo = s;
  }
}
if (a.proveedorId) {
  const [p] = await db.select({ id: proveedores.id, nombre: proveedores.nombre })
    .from(proveedores).where(eq(proveedores.id, a.proveedorId)).limit(1);
  if (p) proveedorInfo = p;
}

// Quién registró la inspección de aceptación (FMS.07)
let aceptadoPorNombre: string | null = null;
if (a.aceptacionPor) {
  const [ap] = await db.select({ nombre: usuarios.nombre }).from(usuarios).where(eq(usuarios.id, a.aceptacionPor)).limit(1);
  aceptadoPorNombre = ap?.nombre ?? null;
}

const planes = await db
  .select({ p: planesMantenimiento, u: usuarios })
  .from(planesMantenimiento)
  .leftJoin(usuarios, eq(usuarios.id, planesMantenimiento.asignadoA))
  .where(eq(planesMantenimiento.activoId, id))
  .orderBy(asc(planesMantenimiento.proximaFecha));

const ordsRel = await db
  .select()
  .from(ordenes)
  .where(eq(ordenes.activoId, id))
  .orderBy(desc(ordenes.id))
  .limit(10);

const tecnicos = await db
  .select({ id: usuarios.id, nombre: usuarios.nombre, rol: usuarios.rol })
  .from(usuarios)
  .where(and(eq(usuarios.activo, true), inArray(usuarios.rol, ["tecnico", "jefe", "proveedor"])))
  .orderBy(asc(usuarios.nombre));

const user = Astro.locals.user!;
const canEdit = user.rol === "admin" || user.rol === "jefe" || user.rol === "tecnico";
const conjuntosHistorial = ["admin", "jefe", "tecnico", "visualizador"].includes(user.rol)
  ? await getConjuntosDelActivo(Astro, id) : [];
const canJefe = user.rol === "admin" || user.rol === "jefe";
// Fase 59: lo biomédico de la ficha (resumen JCI, baja, calibraciones, documentos) solo
// para quien ve biomédico; registrar para admin, jefe y técnico; corregir y dar de baja,
// admin y jefe. El resto de la ficha sigue abierta como antes.
const verBio = puedeVerBio(user.rol);
const registraBio = puedeRegistrarBio(user.rol);
const gestionaBio = puedeGestionarBio(user.rol);

// Historial de cambios (bitácora del equipo): ahí quedan calibraciones, documentos, bajas y pruebas
// eléctricas, así que es de quien ve lo biomédico, igual que el historial completo (K-C1). Para los
// demás roles ni se consulta y tarjetaHistorialCambios devuelve null (la tarjeta no se pinta).
const LIMITE_BITACORA_FICHA = 50;
const auditRows = verBio
  ? await db
      .select({
        accion: auditLog.accion, resumen: auditLog.resumen, cambios: auditLog.cambios, createdAt: auditLog.createdAt,
        usuario: usuarios.nombre,
      })
      .from(auditLog)
      .leftJoin(usuarios, eq(usuarios.id, auditLog.usuarioId))
      .where(and(eq(auditLog.entidad, "activo"), eq(auditLog.entidadId, id)))
      .orderBy(desc(auditLog.id))
      .limit(LIMITE_BITACORA_FICHA)
  : [];
// Valores a la vista: fechas DD/MM/AAAA y marcas en hora de El Salvador (el CSV del historial las deja en AAAA-MM-DD).
const historialCambios = tarjetaHistorialCambios(user.rol, auditRows, labelCampo);

// Fechas en El Salvador: una fecha sola se parte como texto (sin el día de menos);
// una marca de tiempo se pasa a la hora de El Salvador.
const fmt = (s: string | null | undefined) => fechaCorta(s);
const hoy = hoySV();
const isBio = area === "biomedico";

// Contratos vigentes/por vencer que cubren este equipo
const contratosActivoRaw = await db
  .select({ c: contratosMantenimiento, prov: proveedores })
  .from(contratoEquipos)
  .innerJoin(contratosMantenimiento, eq(contratosMantenimiento.id, contratoEquipos.contratoId))
  .leftJoin(proveedores, eq(proveedores.id, contratosMantenimiento.proveedorId))
  .where(and(
    eq(contratoEquipos.activoId, a.id),
    inArray(contratosMantenimiento.estado, ["vigente", "por_vencer"]),
  ))
  .orderBy(asc(contratosMantenimiento.fechaFin));

const contratosActivo = contratosActivoRaw.map(({ c, prov }) => {
  const d = diasParaVencer(c.fechaFin);
  let colorBadge = "bg-emerald-100 text-emerald-700";
  if (c.estado === "por_vencer") {
    colorBadge = d > 60 ? "bg-amber-100 text-amber-700"
      : d > 30 ? "bg-orange-100 text-orange-700"
      : "bg-red-100 text-red-700";
  }
  const labelBadge = c.estado === "por_vencer"
    ? (d > 0 ? `Vence en ${d}d` : "Vencido")
    : ESTADO_CONTRATO_LABEL[c.estado as keyof typeof ESTADO_CONTRATO_LABEL];
  return { c, prov, colorBadge, labelBadge };
});

// ─── Fase 34: datos patrimoniales, calibraciones y documentos ────────────────
let responsableInfo: { id: number; nombre: string } | null = null;
if (a.responsableId) {
  const [u] = await db.select({ id: usuarios.id, nombre: usuarios.nombre }).from(usuarios).where(eq(usuarios.id, a.responsableId)).limit(1);
  if (u) responsableInfo = u;
}

const criticidad = (a.criticidadOperacional ?? "media") as "alta" | "media" | "baja";
// Vida útil con aritmética de fechas en texto (sin new Date('AAAA-MM-DD')).
const finVida = a.vidaUtilAnios && esFechaISO(a.fechaAdquisicion) ? sumarMeses(a.fechaAdquisicion, 12 * a.vidaUtilAnios) : null;
const diasVida = finVida ? diasEntre(hoy, finVida) : null;
const vidaRem = diasVida != null ? diasVida / 365.25 : null;
const vidaVencida = diasVida != null && diasVida < 0;

// ─── Fase 59 · centro de costo, registro sanitario, calibración, JCI y baja ──
const centroCosto = a.centroCostoId
  ? (await db.select({ codigo: centrosCosto.codigo, nombre: centrosCosto.nombre }).from(centrosCosto).where(eq(centrosCosto.id, a.centroCostoId)).limit(1))[0] ?? null
  : null;
const registroEstado = estadoRegistroSanitario(a, hoy);
const estadoActivoLabel = (ESTADO_ACTIVO_LABEL as Record<string, string>)[a.estado] ?? a.estado;
const estadoActivoColor = (ESTADO_ACTIVO_COLOR as Record<string, string>)[a.estado] ?? "bg-slate-100 text-slate-600";

// Calibración: el universo es biomédico, patrón o «Requiere calibración». La baja y
// «No requiere» se muestran con su texto. El estado sale de biomedico.ts (regla de WP-B).
const llevaCal = isBio || a.requiereCalibracion || a.esPatron;
const equipoCal = { tipo: a.tipo, rubro: a.rubro, estado: a.estado, requiereCalibracion: a.requiereCalibracion, esPatron: a.esPatron, calibracionNoAplica: a.calibracionNoAplica };
const patronCal = alias(activos, "patron_cal");
const registroCal = alias(usuarios, "registro_cal");
const correctorCal = alias(usuarios, "corrector_cal");
const equipoCalibrado = alias(activos, "equipo_calibrado");
// Todas las consultas por activo_id (JOIN o subconsulta), con columnas elegidas (límites de D1).
const [
  calibracionesRows, calsPatronesUsados, usadoComoPatron, usadoComoPatronConteo,
  docsExpediente, naExpediente, pruebasValidas, alertasRows, bajaVigenteRows, vinculosHistorial,
] = await Promise.all([
  verBio
    ? db.select({
        c: {
          id: calibraciones.id, fechaCalibracion: calibraciones.fechaCalibracion, proximaCalibracion: calibraciones.proximaCalibracion,
          laboratorioId: calibraciones.laboratorioId, laboratorioExterno: calibraciones.laboratorioExterno,
          numeroCertificado: calibraciones.numeroCertificado, patronActivoId: calibraciones.patronActivoId,
          patronReferencia: calibraciones.patronReferencia, resultado: calibraciones.resultado, incertidumbre: calibraciones.incertidumbre,
          certificadoR2Key: calibraciones.certificadoR2Key, realizadoPor: calibraciones.realizadoPor, notas: calibraciones.notas,
          labAcreditado: calibraciones.labAcreditado, labAcreditacionRef: calibraciones.labAcreditacionRef,
          corregidaEn: calibraciones.corregidaEn,
        },
        labNombre: proveedores.nombre,
        patron: { id: patronCal.id, codigo: patronCal.codigo, nombre: patronCal.nombre, rubro: patronCal.rubro, tipo: patronCal.tipo },
        registro: registroCal.nombre,
        corrector: correctorCal.nombre,
      })
        .from(calibraciones)
        .leftJoin(proveedores, eq(proveedores.id, calibraciones.laboratorioId))
        .leftJoin(patronCal, eq(patronCal.id, calibraciones.patronActivoId))
        .leftJoin(registroCal, eq(registroCal.id, calibraciones.usuarioId))
        .leftJoin(correctorCal, eq(correctorCal.id, calibraciones.corregidaPor))
        .where(eq(calibraciones.activoId, id))
        .orderBy(desc(calibraciones.fechaCalibracion), desc(calibraciones.id))
    : [],
  // Calibraciones de los patrones usados con este equipo: su vigencia en cada fecha.
  verBio
    ? db.select({
        id: calibraciones.id, activoId: calibraciones.activoId, fechaCalibracion: calibraciones.fechaCalibracion,
        proximaCalibracion: calibraciones.proximaCalibracion, resultado: calibraciones.resultado, certificadoR2Key: calibraciones.certificadoR2Key,
      })
        .from(calibraciones)
        .where(sql`${calibraciones.activoId} in (select patron_activo_id from calibraciones where activo_id = ${id} and patron_activo_id is not null)`)
    : [],
  verBio && a.esPatron
    ? db.select({
        id: calibraciones.id, fechaCalibracion: calibraciones.fechaCalibracion,
        equipo: { id: equipoCalibrado.id, codigo: equipoCalibrado.codigo, nombre: equipoCalibrado.nombre, rubro: equipoCalibrado.rubro, tipo: equipoCalibrado.tipo },
      })
        .from(calibraciones)
        .innerJoin(equipoCalibrado, eq(equipoCalibrado.id, calibraciones.activoId))
        .where(eq(calibraciones.patronActivoId, id))
        .orderBy(desc(calibraciones.fechaCalibracion), desc(calibraciones.id))
        .limit(10)
    : [],
  verBio && a.esPatron
    ? db.select({ n: sql<number>`count(*)` }).from(calibraciones).where(eq(calibraciones.patronActivoId, id))
    : [],
  verBio && isBio
    ? db.select({ categoria: activoDocumentos.categoria, fechaVencimiento: activoDocumentos.fechaVencimiento }).from(activoDocumentos).where(eq(activoDocumentos.activoId, id))
    : [],
  verBio && isBio
    ? db.select({ requisito: activoExpedienteNa.requisito, motivo: activoExpedienteNa.motivo }).from(activoExpedienteNa).where(eq(activoExpedienteNa.activoId, id))
    : [],
  // K-F2: última prueba válida = estado 'valida', la de fecha mayor (empate: id mayor).
  verBio
    ? db.select({
        id: pruebasSeguridadElectrica.id, fecha: pruebasSeguridadElectrica.fecha, tipo: pruebasSeguridadElectrica.tipo,
        resultado: pruebasSeguridadElectrica.resultado, proximaFecha: pruebasSeguridadElectrica.proximaFecha,
      })
        .from(pruebasSeguridadElectrica)
        .where(and(eq(pruebasSeguridadElectrica.activoId, id), eq(pruebasSeguridadElectrica.estado, "valida")))
        .orderBy(desc(pruebasSeguridadElectrica.fecha), desc(pruebasSeguridadElectrica.id))
    : [],
  verBio
    ? db.select({
        id: alertasEquipo.id, tipo: alertasEquipo.tipo, titulo: alertasEquipo.titulo, fechaAlerta: alertasEquipo.fechaAlerta,
        estado: alertasEquipo.estado, aplicabilidad: alertasEquipo.aplicabilidad, fechaCierre: alertasEquipo.fechaCierre,
      })
        .from(alertasEquipoActivos)
        .innerJoin(alertasEquipo, eq(alertasEquipo.id, alertasEquipoActivos.alertaId))
        .where(eq(alertasEquipoActivos.activoId, id))
        .orderBy(desc(alertasEquipo.fechaAlerta), desc(alertasEquipo.id))
    : [],
  verBio && a.estado === "baja"
    ? db.select({
        id: activoBajas.id, fechaBaja: activoBajas.fechaBaja, motivo: activoBajas.motivo, motivoDetalle: activoBajas.motivoDetalle,
        evaluacionTecnica: activoBajas.evaluacionTecnica, evaluadoPor: activoBajas.evaluadoPor, autorizaNombre: activoBajas.autorizaNombre,
        autorizaCargo: activoBajas.autorizaCargo, destinoFinal: activoBajas.destinoFinal, destinoDetalle: activoBajas.destinoDetalle,
        registradoPorNombre: activoBajas.registradoPorNombre, createdAt: activoBajas.createdAt,
      })
        .from(activoBajas)
        .where(and(eq(activoBajas.activoId, id), eq(activoBajas.estado, "vigente")))
        .limit(1)
    : [],
  // Solo el administrador elimina: ¿tiene algo de HISTORIAL_ACTIVO? Una sola consulta.
  user.rol === "admin"
    ? db.get<Record<string, number>>(sql`SELECT ${sql.join(
        HISTORIAL_ACTIVO.map((v, i) => sql`EXISTS(SELECT 1 FROM ${sql.raw(v.tabla)} WHERE ${sql.raw(v.columna)} = ${id}) AS ${sql.raw(`h${i}`)}`),
        sql`, `,
      )}`)
    : null,
]);

const calMin: CalMin[] = calibracionesRows.map((r) => ({
  id: r.c.id, fechaCalibracion: r.c.fechaCalibracion, proximaCalibracion: r.c.proximaCalibracion, resultado: r.c.resultado, certificadoR2Key: r.c.certificadoR2Key,
}));
const infoCal = infoCalibracion(equipoCal, calMin, hoy);
const ultimaCalRow = calibracionesRows.find((r) => r.c.id === infoCal.calibracionId) ?? null;
// Días para la próxima: no se cuentan en un equipo de baja.
const diasCal = a.estado === "baja" ? null : infoCal.dias;
const mostrarCal = verBio && (llevaCal || calibracionesRows.length > 0);
// «Imprimir viñeta» (pedido de WP-B): solo si al equipo le aplica la calibración y ya tiene alguna;
// un equipo de baja o con «No requiere calibración» no tiene viñeta en /calibraciones/vinetas.
const vinetaVisible = puedeImprimirVineta(user.rol, equipoCal, calibracionesRows.length);
const puedeRegistrarCal = mostrarCal && registraBio && a.estado !== "baja" && !a.calibracionNoAplica;
const puedeCorregirCal = mostrarCal && gestionaBio;
const necesitaFormularioCal = puedeRegistrarCal || (puedeCorregirCal && calibracionesRows.length > 0);
const calsPorPatronUsado = new Map<number, CalMin[]>();
for (const c of calsPatronesUsados) {
  const lista = calsPorPatronUsado.get(c.activoId) ?? [];
  lista.push({ id: c.id, fechaCalibracion: c.fechaCalibracion, proximaCalibracion: c.proximaCalibracion, resultado: c.resultado, certificadoR2Key: c.certificadoR2Key });
  calsPorPatronUsado.set(c.activoId, lista);
}
const vigenciaPatron = (patronActivoId: number | null, fecha: string) =>
  patronActivoId == null ? null : patronVigenteEn(calsPorPatronUsado.get(patronActivoId) ?? [], fecha);
const usadoComoPatronTotal = Number(usadoComoPatronConteo[0]?.n ?? 0);

// Listas del formulario de calibración: laboratorios por acreditación y equipos patrón
// con su vigencia hoy (el servidor revisa la vigencia en la fecha de la calibración).
const [provsLab, patronesLista, calsDePatrones] = necesitaFormularioCal
  ? await Promise.all([
      db.select({
        id: proveedores.id, nombre: proveedores.nombre, esLaboratorioAcreditado: proveedores.esLaboratorioAcreditado,
        acreditacionVigencia: proveedores.acreditacionVigencia, acreditacionOrgano: proveedores.acreditacionOrgano,
        acreditacionNumero: proveedores.acreditacionNumero,
      }).from(proveedores).where(eq(proveedores.activo, true)).orderBy(asc(proveedores.nombre)),
      db.select({ id: activos.id, codigo: activos.codigo, nombre: activos.nombre, marca: activos.marca, modelo: activos.modelo, serial: activos.serial })
        .from(activos)
        .where(and(eq(activos.esPatron, true), ne(activos.estado, "baja"), ne(activos.id, id)))
        .orderBy(asc(activos.codigo)),
      db.select({
        id: calibraciones.id, activoId: calibraciones.activoId, fechaCalibracion: calibraciones.fechaCalibracion,
        proximaCalibracion: calibraciones.proximaCalibracion, resultado: calibraciones.resultado, certificadoR2Key: calibraciones.certificadoR2Key,
      }).from(calibraciones).where(sql`${calibraciones.activoId} in (select id from activos where es_patron = 1)`),
    ])
  : [[], [], []];
const gruposLab = opcionesLaboratorio(provsLab, hoy);
const provPorId = new Map(provsLab.map((p) => [p.id, p]));
const avisoNoAcreditado = "Este laboratorio no tiene acreditación vigente. Puedes guardar, pero la calibración quedará como «laboratorio no acreditado».";
const avisoLab = (labId: number, acreditado: boolean) => {
  const p = provPorId.get(labId);
  return acreditado && p ? `Acreditado: ${textoAcreditacion(p)}.` : avisoNoAcreditado;
};
const calsPorPatron = new Map<number, CalMin[]>();
for (const c of calsDePatrones) {
  const lista = calsPorPatron.get(c.activoId) ?? [];
  lista.push({ id: c.id, fechaCalibracion: c.fechaCalibracion, proximaCalibracion: c.proximaCalibracion, resultado: c.resultado, certificadoR2Key: c.certificadoR2Key });
  calsPorPatron.set(c.activoId, lista);
}
const patronesOpciones = patronesLista.map((p) => {
  const calibs = calsPorPatron.get(p.id) ?? [];
  const v = patronVigenteEn(calibs, hoy);
  const nombre = [p.codigo, p.nombre, [p.marca, p.modelo].filter(Boolean).join(" "), p.serial ? `S/N ${p.serial}` : ""].filter(Boolean).join(" · ");
  const estado = v.vigente ? `vigente hasta ${fechaCorta(v.hasta)}` : calibs.length ? "sin calibración vigente" : "sin calibración registrada";
  return { id: p.id, etiqueta: `${nombre} — ${estado}` };
});
// Datos de cada calibración para «Corregir» (solo admin y jefe).
const calibracionesJs = puedeCorregirCal
  ? calibracionesRows.map((r) => ({
      id: r.c.id, fechaCalibracion: r.c.fechaCalibracion, fechaTexto: fechaCorta(r.c.fechaCalibracion),
      proximaCalibracion: r.c.proximaCalibracion, laboratorioId: r.c.laboratorioId, labNombre: r.labNombre,
      laboratorioExterno: r.c.laboratorioExterno, numeroCertificado: r.c.numeroCertificado, patronActivoId: r.c.patronActivoId,
      patronEtiqueta: r.patron ? `${r.patron.codigo} · ${r.patron.nombre}` : null, patronReferencia: r.c.patronReferencia,
      resultado: r.c.resultado, incertidumbre: r.c.incertidumbre, realizadoPor: r.c.realizadoPor, notas: r.c.notas,
      tieneCertificado: !!r.c.certificadoR2Key,
    }))
  : [];

// Expediente (WP-D: 5 requisitos con «No aplica»), seguridad eléctrica (K-F2) y alertas. Si el
// inventario marca «No requiere registro sanitario», ese requisito no aplica (MOTIVO_SIN_REGISTRO).
const expediente = verBio && isBio
  ? completitudExpediente({
      documentos: docsExpediente, aceptacionFecha: a.aceptacionFecha, noAplica: naExpediente,
      registroSanitarioNoRequiere: a.registroSanitarioNoRequiere, hoy,
    })
  : null;
// Por requisito: un documento vencido que ya se renovó no se cuenta como vencido.
const lineasExp = expediente ? lineasExpediente(expediente) : null;
const ultimaSE = pruebasValidas[0] ?? null;
const estadoSE = estadoSeguridadElectrica(ultimaSE ? { resultado: ultimaSE.resultado, proximaFecha: ultimaSE.proximaFecha } : null, hoy);
const aceptacionSE = pruebasValidas.find((p) => p.tipo === "aceptacion") ?? null;
const mostrarSE = verBio && (isBio || pruebasValidas.length > 0);
const alertasOrdenadas = [...alertasRows].sort((x, y) => Number(x.estado === "cerrada") - Number(y.estado === "cerrada"));
const alertasAbiertas = alertasRows.filter((x) => x.estado !== "cerrada").length;
const retiroAbierto = alertasRows.some((x) => x.tipo === "retiro" && x.estado !== "cerrada");
const mostrarAlertas = verBio && (isBio || alertasRows.length > 0);
const hayResumenJci = mostrarCal || !!expediente || mostrarSE || mostrarAlertas;
const bajaVigente = bajaVigenteRows[0] ?? null;
const etqMotivoBaja = (m: string) => (MOTIVOS_BAJA as Record<string, string>)[m] ?? m;
const etqDestinoBaja = (d: string) => (DESTINOS_BAJA as Record<string, string>)[d] ?? d;

// Eliminar: solo un equipo registrado por error y sin historial (el servidor lo vuelve a revisar, K-A3).
const etiquetasHistorial = vinculosHistorial ? HISTORIAL_ACTIVO.filter((_, i) => Number(vinculosHistorial[`h${i}`]) === 1).map((v) => v.etiqueta) : [];
const canDelete = user.rol === "admin" && conjuntosHistorial.length === 0 && !!vinculosHistorial && etiquetasHistorial.length === 0;

// Rutinas: las frecuencias que acepta la API de rutinas (sin «Por turno»).
const etiquetaFrecuenciaForm = (v: string) => FRECUENCIAS.find((f) => f.value === v)?.label ?? etiquetaFrecuencia(v);
const OPCIONES_FRECUENCIA = FRECUENCIAS_RUTINA_EQUIPO.map((v) => ({ value: v, label: etiquetaFrecuenciaForm(v) }));
const frecuenciaOfrecida = (f: string) => (FRECUENCIAS_RUTINA_EQUIPO as readonly string[]).includes(f);

// ─── Fase 37: contingencia (equipos de respaldo) ─────────────────────────────
const respaldoAlias = alias(activos, "respaldo_alias");
const respaldosRows = await db
  .select({ rel: activoRespaldos, eq_: respaldoAlias })
  .from(activoRespaldos)
  .innerJoin(respaldoAlias, eq(respaldoAlias.id, activoRespaldos.respaldoId))
  .where(eq(activoRespaldos.activoId, id));

const principalAlias = alias(activos, "principal_alias");
const respaldaARows = await db
  .select({ rel: activoRespaldos, eq_: principalAlias })
  .from(activoRespaldos)
  .innerJoin(principalAlias, eq(principalAlias.id, activoRespaldos.activoId))
  .where(eq(activoRespaldos.respaldoId, id));

// Candidatos para vincular como respaldo (solo admin/jefe gestiona)
const candidatosRespaldo = canJefe
  ? await db.select({ id: activos.id, codigo: activos.codigo, nombre: activos.nombre })
      .from(activos).where(and(ne(activos.id, id), ne(activos.estado, "baja"), activoAreaCondition(area))).orderBy(asc(activos.codigo))
  : [];
const fueraDeServicio = a.estado === "averiado" || a.estado === "mantenimiento";
const respaldosOperativos = respaldosRows.filter((r) => r.eq_.estado === "operativo");

// ─── Fase 47 · SCP: jerarquía, puntos de ajuste y mapa de distribución ──────
// GO-GUI-011-2026 cap. 02-03: «Cada sistema crítico se registra como activo
// padre con sus componentes como hijos»; el SCP es la ficha del sistema y su
// versión vive como atributo del activo.
const nivel = (a.nivelJerarquia ?? "componente") as NivelJerarquia;
const estadoColorActivo: Record<string, string> = {
  operativo: "bg-emerald-100 text-emerald-700",
  averiado: "bg-red-100 text-red-700",
  mantenimiento: "bg-amber-100 text-amber-700",
  baja: "bg-slate-200 text-slate-600",
};

const ancestros = await rutaAscendente(db, id);
const componentes = await hijosConOrdenesAbiertas(db, id);

// SCP vinculado (activos.scpProcedimientoId → procedimientos)
let scpInfo: { id: number; codigoCorto: string; titulo: string; version: string; estado: string; sistema: string; proximaRevision: string | null } | null = null;
if (a.scpProcedimientoId) {
  const [p] = await db
    .select({
      id: procedimientos.id, codigoCorto: procedimientos.codigoCorto, titulo: procedimientos.titulo,
      version: procedimientos.version, estado: procedimientos.estado, sistema: procedimientos.sistema,
      proximaRevision: procedimientos.proximaRevision,
    })
    .from(procedimientos).where(eq(procedimientos.id, a.scpProcedimientoId)).limit(1);
  if (p) scpInfo = p;
}
// Un activo de nivel «sistema» sin SCP es un sistema crítico sin ficha.
const faltaScp = nivel === "sistema" && !a.scpProcedimientoId;

// Puntos de ajuste: atributos del activo con valor normal, mínimo y máximo.
const atributosScp = await db
  .select().from(variablesPredictivas)
  .where(and(
    eq(variablesPredictivas.activoId, id),
    inArray(variablesPredictivas.tipoAtributo, ["punto_ajuste", "posicion_normal"]),
  ))
  .orderBy(asc(variablesPredictivas.nombre));

// Mapa de distribución: «una manejadora sirve varias salas».
const servidasRows = await db
  .select({ rel: activoUbicacionesServidas, u: ubicaciones, s: sucursales })
  .from(activoUbicacionesServidas)
  .innerJoin(ubicaciones, eq(ubicaciones.id, activoUbicacionesServidas.ubicacionId))
  .leftJoin(sucursales, eq(sucursales.id, ubicaciones.sucursalId))
  .where(eq(activoUbicacionesServidas.activoId, id))
  .orderBy(asc(ubicaciones.nombre));

// Opciones de los formularios (solo si el usuario puede editar).
const descendientesIds = canEdit ? await descendientesDe(db, id) : new Set<number>();
const candidatosPadre = canEdit
  ? (await db.select({ id: activos.id, codigo: activos.codigo, nombre: activos.nombre, nivelJerarquia: activos.nivelJerarquia })
      .from(activos).where(and(ne(activos.id, id), ne(activos.estado, "baja"))).orderBy(asc(activos.codigo)))
      .filter((c) => !descendientesIds.has(c.id))
  : [];
const procedimientosScp = canEdit
  ? await db.select({ id: procedimientos.id, codigoCorto: procedimientos.codigoCorto, titulo: procedimientos.titulo, version: procedimientos.version })
      .from(procedimientos).where(and(eq(procedimientos.tipo, "scp"), eq(procedimientos.activo, true)))
      .orderBy(asc(procedimientos.codigoCorto))
  : [];
const idsYaServidos = new Set(servidasRows.map((r) => r.u.id));
const ubicacionesOpciones = canEdit
  ? await db.select({ id: ubicaciones.id, nombre: ubicaciones.nombre, tipo: ubicaciones.tipo, sucursal: sucursales.nombre })
      .from(ubicaciones).leftJoin(sucursales, eq(sucursales.id, ubicaciones.sucursalId))
      .where(eq(ubicaciones.activa, true)).orderBy(asc(ubicaciones.nombre))
  : [];

// ─── Fase 48 · Qué rige este equipo (resolver) ───────────────────────────────
// GO-GUI-011-2026: nadie debería buscar un documento. El resolver contesta aquí
// y ahora qué sistema gobierna este equipo, con qué procedimientos, y —si el
// equipo está fuera de servicio— qué EOP manda y cuáles son sus tres primeras
// acciones. «Si un equipo falla, el sistema sabe que sigue bajo tal documento».
const rige = await queRigeEsteActivo(db, id, sucursalInfo?.id ?? null);
// Ya falló: la respuesta no se busca, se muestra.
const sigueFalla = fueraDeServicio ? await queSigue(db, id, "falla", sucursalInfo?.id ?? null) : null;

const ORIGEN_SISTEMA: Record<"declarado" | "heredado" | "inferido", { label: string; detalle: string; color: string }> = {
  declarado: {
    label: "Declarado por el equipo",
    detalle: "Alguien lo fijó en la ficha: es un dato, no una deducción.",
    color: "bg-emerald-100 text-emerald-700",
  },
  heredado: {
    label: "Heredado del sistema padre",
    detalle: "El componente toma el sistema del activo padre que lo contiene (cap. 02-03).",
    color: "bg-sky-100 text-sky-700",
  },
  inferido: {
    label: "Inferido por el nombre",
    detalle:
      "Nadie lo declaró: se deduce del nombre y la categoría. Una suposición no debería decidir qué " +
      "procedimiento aplica cuando este equipo falle.",
    color: "bg-amber-100 text-amber-700",
  },
};

const sistemaResuelto: Sistema | null = rige?.sistema ?? null;

// ─── El juego de los cinco es de la FAMILIA, no de este equipo ───────────────
// «Todos los aires acondicionados deben aplicarse los mismos 5 documentos.»
// El juego no se arma equipo por equipo: se define una vez por sistema crítico
// y todos sus equipos lo heredan. Por eso la cadena se lee de juegoDeFamilia
// —que incluye los documentos que cubren varias familias a la vez, como la
// ronda por turno— y no de una lista suelta de este equipo.
const juego = sistemaResuelto ? await juegoDeFamilia(db, sistemaResuelto, sucursalInfo?.id ?? null) : null;
// Cuántos equipos comparten el juego: la brecha de 40 aires sin EOP no pesa
// igual que la de uno.
const familiaConteo = sistemaResuelto
  ? (await equiposPorFamilia(db))[sistemaResuelto] ?? { total: 0, criticos: 0 }
  : null;

// Red de seguridad: si un documento existe para el sistema pero le falta su
// fila en procedimiento_sistemas, igual debe verse. Nunca decir «falta» de algo
// que ya está escrito.
const docsDeRige: Record<string, any[]> = rige
  ? { scp: rige.scp ? [rige.scp] : [], sop: rige.sop, aop: rige.aop, eop: rige.eop, mop: rige.mop }
  : {};

// La cadena del cap. 01 en orden: SCP cómo está configurado → SOP cómo se opera
// → AOP se desvió → EOP ya falló → MOP se interviene. Un eslabón por tipo, con
// el documento con el que de verdad se opera: el vigente manda sobre el
// borrador. Única excepción: el SCP que declara el propio equipo manda sobre el
// de la familia, porque la configuración sí es de cada máquina.
const cadena = (juego?.slots ?? []).map((s) => {
  const docs = s.documentos.length > 0 ? s.documentos : (docsDeRige[s.tipo] ?? []);
  const pref =
    docs.find((d: any) => d.estado === "vigente") ??
    docs.find((d: any) => d.estado === "en_validacion") ??
    docs[0] ??
    null;
  const propio = s.tipo === "scp" && !!a.scpProcedimientoId && !!rige?.scp;
  const doc = propio ? rige!.scp! : pref;
  return {
    tipo: s.tipo,
    label: s.label,
    pregunta: s.pregunta,
    doc,
    propio,
    cubierto: !!doc,
    vigente: doc?.estado === "vigente",
    otros: docs.filter((d: any) => d.id !== doc?.id).length,
  };
});
const nCubiertos = cadena.filter((s) => s.cubierto).length;
const nVigentes = cadena.filter((s) => s.vigente).length;
// Lo que le falta a la familia se dice en la ficha del equipo: el hueco no es
// de este equipo, es de todos los que comparten el juego.
const faltanEnFamilia = cadena.filter((s) => !s.cubierto);
const textoFaltantes = faltanEnFamilia
  .map((s) => `el ${TIPO_PROC[s.tipo].label}`)
  .reduce((acc, t, i, arr) => (i === 0 ? t : i === arr.length - 1 ? `${acc} y ${t}` : `${acc}, ${t}`), "");
const sinNingunDocumento = cadena.length > 0 && nCubiertos === 0;
// El EOP con el que se abrirá la respuesta si este equipo falla.
const eopDeLaFamilia = cadena.find((s) => s.tipo === "eop")?.doc ?? null;
