  {canEdit && (
    <script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({ activoId: a.id }) }}>
      const { activoId } = JSON.parse(decodeURIComponent(__encodedScriptVars));
      (function () {
        const modal = document.getElementById("acepModal");
        if (!modal) return;
        const show = () => { modal.classList.remove("hidden"); modal.classList.add("flex"); };
        const hide = () => { modal.classList.add("hidden"); modal.classList.remove("flex"); };
        document.getElementById("acepBtn")?.addEventListener("click", show);
        document.getElementById("acep_cancel")?.addEventListener("click", hide);
        modal.addEventListener("click", (e) => { if (e.target === modal) hide(); });

        document.getElementById("acep_save")?.addEventListener("click", async () => {
          const err = document.getElementById("acep_err");
          err.classList.add("hidden");
          const fecha = document.getElementById("acep_fecha").value;
          if (!fecha) { err.textContent = "La fecha es obligatoria."; err.classList.remove("hidden"); return; }
          const boton = document.getElementById("acep_save");
          boton.disabled = true;
          try {
            const res = await fetch(`/api/activos/${activoId}`, {
              method: "PATCH",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({
                aceptacionFecha: fecha,
                aceptacionResultado: document.getElementById("acep_resultado").value,
                aceptacionNotas: document.getElementById("acep_notas").value.trim() || null,
              }),
            });
            if (res.ok) { window.showToast?.("Inspección de aceptación registrada", "success"); location.reload(); return; }
            const j = await res.json().catch(() => ({}));
            err.textContent = typeof j.error === "string" ? j.error : "No se pudo guardar la inspección.";
          } catch {
            err.textContent = "No hay conexión. Intenta de nuevo.";
          }
          err.classList.remove("hidden");
          boton.disabled = false;
        });
      })();
    </script>
  )}

  <!-- Documentos y expediente, licencias y capacitaciones: los pinta WP-D (K-BASE-2).
       Cada componente revisa el rol y consulta la base; anclas #documentos, #licencias y #capacitaciones. -->
  <DocumentosEquipo activoId={a.id} />
  <LicenciasEquipo activoId={a.id} />
  <CapacitacionesEquipo activoId={a.id} />

  <!-- Contingencia / equipos de respaldo -->
  <div class="card mt-6 p-5" id="contingencia">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="font-semibold text-slate-900">Continuidad — equipos de respaldo</h2>
        <p class="text-xs text-slate-500">Plan de contingencia (JCI FMS.9): a qué equipo recurrir si este sale de servicio.</p>
      </div>
      {canJefe && <button id="respaldoBtn" class="btn-primary text-sm">+ Vincular respaldo</button>}
    </div>

    {fueraDeServicio && respaldosRows.length > 0 && (
      <div class="mt-3 rounded-md border border-amber-300 bg-amber-50 p-3 text-sm text-amber-800">
        Este equipo está <strong>{a.estado}</strong>.
        {respaldosOperativos.length > 0
          ? <span> Respaldo operativo disponible: <strong>{respaldosOperativos.map((r) => r.eq_.codigo).join(", ")}</strong>.</span>
