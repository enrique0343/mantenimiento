          <div>
            <label class="label">Notas</label>
            <input id="respaldoNotas" class="input" placeholder="Opcional" />
          </div>
        </div>
        <div class="mt-2 flex gap-2">
          <button id="respaldoSave" class="btn-primary text-sm">Vincular</button>
          <button id="respaldoCancel" class="btn-secondary text-sm">Cancelar</button>
        </div>
      </div>
    )}

    <div class="mt-3">
      <div class="text-xs uppercase text-slate-500">Respaldos de este equipo</div>
      {respaldosRows.length === 0 ? (
        <p class="mt-1 text-sm text-slate-500">Sin equipos de respaldo configurados.</p>
      ) : (
        <ul class="mt-2 divide-y divide-slate-100 text-sm">
          {respaldosRows.map((r) => (
            <li class="flex items-center justify-between gap-3 py-2">
              <div class="min-w-0 flex-1">
                <a href={areaHref(`/activos/${r.eq_.id}`, rubroDeActivo(r.eq_.rubro, r.eq_.tipo))} class="font-medium text-brand-700 hover:underline">{r.eq_.codigo} · {r.eq_.nombre}</a>
                <span class:list={["ml-2 badge text-[10px]", r.eq_.estado === "operativo" ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700"]}>{r.eq_.estado}</span>
                {r.rel.notas && <div class="text-xs text-slate-500">{r.rel.notas}</div>}
              </div>
              {canJefe && <button class="respaldo-del text-xs text-red-600 hover:underline" data-id={r.eq_.id}>Quitar</button>}
            </li>
          ))}
        </ul>
      )}
      {respaldaARows.length > 0 && (
        <p class="mt-3 text-xs text-slate-500">Este equipo es respaldo de: {respaldaARows.map((r) => r.eq_.codigo).join(", ")}</p>
      )}
    </div>
  </div>

  {mostrarCal && (
    <div class="card mt-6 p-5" id="calibraciones">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="font-semibold text-purple-700">Calibraciones</h2>
            {a.estado === "baja"
              ? <span class={`badge text-[10px] ${ESTADO_ACTIVO_COLOR.baja}`}>Dado de baja</span>
              : <span class={`badge text-[10px] ${ESTADO_CALIBRACION_COLOR[infoCal.estado]}`}>{ESTADO_CALIBRACION_LABEL[infoCal.estado]}</span>}
            {a.esPatron && <a href="/calibraciones/patrones" class="badge bg-indigo-100 text-[10px] text-indigo-700 hover:underline">Equipo patrón</a>}
          </div>
          <p class="text-xs text-slate-500">Trazabilidad metrológica (JCI FMS.8 / MINSAL): certificado, laboratorio acreditado, patrón y resultado.</p>
          {infoCal.ultima && (
            <p class="mt-1 text-xs text-slate-600">
              Última {fmt(infoCal.ultima)}{infoCal.proxima ? ` · Próxima ${fmt(infoCal.proxima)}` : ""}{diasCal != null ? ` · ${textoVence(diasCal)}` : ""}
            </p>
          )}
          {a.calibracionNoAplica && (
            <p class="mt-1 text-xs text-slate-600">No requiere calibración{a.calibracionNoAplicaMotivo ? `: ${a.calibracionNoAplicaMotivo}` : "."}</p>
          )}
        </div>
        <div class="flex flex-wrap gap-2">
          {vinetaVisible && <a href={`/calibraciones/vinetas?activos=${a.id}`} class="btn-secondary text-sm">Imprimir viñeta</a>}
          {puedeRegistrarCal && <button id="calNewBtn" type="button" class="btn-primary text-sm">+ Registrar calibración</button>}
        </div>
      </div>

      {a.esPatron && (
        <div class="mt-3 rounded-md border border-indigo-200 bg-indigo-50 p-3 text-sm text-indigo-900">
          {usadoComoPatronTotal === 0
            ? "Este equipo es un patrón. Todavía no se usó en ninguna calibración."
            : `Este equipo es un patrón. Se usó en ${usadoComoPatronTotal} ${usadoComoPatronTotal === 1 ? "calibración" : "calibraciones"}:`}
          {usadoComoPatron.length > 0 && (
            <ul class="mt-1 space-y-0.5 text-xs">
              {usadoComoPatron.map((u) => (
                <li>
                  <a href={areaHref(`/activos/${u.equipo.id}`, rubroDeActivo(u.equipo.rubro, u.equipo.tipo))} class="hover:underline">
                    {fmt(u.fechaCalibracion)} · {u.equipo.codigo} · {u.equipo.nombre}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {usadoComoPatronTotal > usadoComoPatron.length && <p class="mt-1 text-xs">Se muestran las {usadoComoPatron.length} más recientes.</p>}
          <a href="/calibraciones/patrones" class="mt-1 inline-block text-xs font-medium underline">Ver lista de patrones</a>
        </div>
      )}

      {necesitaFormularioCal && (
        <div id="calForm" class="mt-4 hidden rounded-md border border-purple-200 bg-purple-50/40 p-4">
          <h3 id="calTitulo" class="font-semibold text-slate-900">Registrar calibración</h3>
          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <label class="label" for="c_fecha">Fecha de calibración *</label>
              <input id="c_fecha" type="date" class="input" max={hoy} />
            </div>
            <div>
              <label class="label" for="c_proxima">Próxima calibración <span class="font-normal text-slate-400">(obligatoria salvo «No conforme»)</span></label>
              <input id="c_proxima" type="date" class="input" />
            </div>
            <div>
              <label class="label" for="c_lab">Laboratorio</label>
              <select id="c_lab" class="input">
                <option value="" data-aviso="">— Externo / no listado —</option>
                {gruposLab.acreditados.length > 0 && (
                  <optgroup label="Laboratorios con acreditación vigente">
                    {gruposLab.acreditados.map((l) => <option value={l.id} data-aviso={avisoLab(l.id, true)} data-ok="1">{l.etiqueta}</option>)}
                  </optgroup>
                )}
                {gruposLab.vencidos.length > 0 && (
                  <optgroup label="Acreditación vencida o sin vigencia">
                    {gruposLab.vencidos.map((l) => <option value={l.id} data-aviso={avisoLab(l.id, false)}>{l.etiqueta}</option>)}
                  </optgroup>
                )}
                {gruposLab.otros.length > 0 && (
                  <optgroup label="Otros proveedores (sin acreditación)">
                    {gruposLab.otros.map((l) => <option value={l.id} data-aviso={avisoLab(l.id, false)}>{l.etiqueta}</option>)}
                  </optgroup>
                )}
              </select>
              <p id="c_lab_aviso" class="mt-1 hidden text-xs"></p>
            </div>
            <div>
              <label class="label" for="c_labext">Laboratorio externo (si no está en la lista)</label>
              <input id="c_labext" class="input" placeholder="Nombre del laboratorio" maxlength="200" />
            </div>
            <div>
              <label class="label" for="c_cert">N.º de certificado</label>
              <input id="c_cert" class="input" maxlength="100" />
            </div>
            <div>
              <label class="label" for="c_resultado">Resultado *</label>
              <select id="c_resultado" class="input">
                <option value="conforme">Conforme</option>
                <option value="conforme_con_ajuste">Conforme con ajuste</option>
                <option value="no_conforme">No conforme</option>
              </select>
            </div>
            <div>
              <label class="label" for="c_patron_id">Equipo patrón usado (de la lista)</label>
              <select id="c_patron_id" class="input">
                <option value="">— Ninguno de la lista —</option>
                {patronesOpciones.map((p) => <option value={p.id}>{p.etiqueta}</option>)}
              </select>
            </div>
            <div>
              <label class="label" for="c_patron">Patrón o trazabilidad del certificado</label>
              <input id="c_patron" class="input" placeholder="Ej.: trazable a CENAM / NIST" maxlength="300" />
            </div>
            <div>
              <label class="label" for="c_incert">Incertidumbre</label>
              <input id="c_incert" class="input" placeholder="Ej.: ±0.5 °C (k=2)" maxlength="100" />
            </div>
            <div>
              <label class="label" for="c_realizado">Realizado por</label>
              <input id="c_realizado" class="input" placeholder="Técnico o empresa" maxlength="200" />
            </div>
            <div class="sm:col-span-2">
              <label class="label" for="c_file" id="c_file_label">Certificado (PDF o imagen JPG, PNG o WEBP; máx. 15 MB)</label>
              <input id="c_file" type="file" accept={ARCHIVO_ACCEPT} class="input" />
            </div>
            <div class="sm:col-span-2">
              <label class="label" for="c_notas">Notas <span class="font-normal text-slate-400">(obligatorias si el resultado es No conforme o Conforme con ajuste)</span></label>
              <textarea id="c_notas" class="input" rows="2"></textarea>
            </div>
            <div id="c_motivo_wrap" class="hidden sm:col-span-2">
              <label class="label" for="c_motivo">Motivo de la corrección *</label>
              <textarea id="c_motivo" class="input" rows="2" maxlength="500" placeholder="Ej.: el número de certificado estaba mal escrito"></textarea>
            </div>
          </div>
          <p id="c_msg" class="mt-2 hidden text-sm"></p>
          <div id="c_avisos" class="mt-2 hidden rounded-md border border-amber-300 bg-amber-50 p-3 text-sm text-amber-800">
            <p class="font-semibold">Se guardó la calibración, con estos avisos:</p>
            <ul id="c_avisos_lista" class="mt-1 list-disc pl-5"></ul>
            <button id="c_avisos_ok" type="button" class="btn-secondary btn-sm mt-2">Entendido</button>
          </div>
          <div class="mt-3 flex gap-2">
            <button id="c_save" type="button" class="btn-primary text-sm">Guardar calibración</button>
            <button id="c_cancel" type="button" class="btn-secondary text-sm">Cancelar</button>
          </div>
        </div>
      )}

      {puedeCorregirCal && calibracionesRows.length > 0 && (
        <div id="calDelModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50 p-4">
          <div class="card w-full max-w-md p-5">
            <h3 class="text-lg font-semibold text-slate-900">Eliminar calibración</h3>
            <p id="calDelTexto" class="mt-1 text-sm text-slate-600"></p>
            <label class="label mt-3" for="calDelMotivo">Motivo *</label>
            <textarea id="calDelMotivo" class="input" rows="3" maxlength="500" placeholder="Ej.: se registró en el equipo equivocado"></textarea>
            <p class="mt-1 text-xs text-slate-500">El certificado no se borra: la copia queda en la bitácora del equipo.</p>
            <p id="calDelErr" class="mt-2 hidden text-sm text-red-600"></p>
            <div class="mt-4 flex justify-end gap-2">
              <button id="calDelCancel" type="button" class="btn-secondary">Cancelar</button>
              <button id="calDelOk" type="button" class="btn-primary">Eliminar</button>
            </div>
          </div>
        </div>
      )}
      {registraBio && calibracionesRows.some((r) => !r.c.certificadoR2Key) && (
        <input id="c_adj_file" type="file" accept={ARCHIVO_ACCEPT} class="hidden" aria-label="Certificado de calibración" />
      )}

      {calibracionesRows.length === 0 ? (
        <p class="mt-3 text-sm text-slate-500">Sin calibraciones registradas.</p>
      ) : (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase text-slate-500">
              <tr>
                <th class="px-3 py-2">Fecha</th>
                <th class="px-3 py-2">Próxima</th>
                <th class="px-3 py-2">Laboratorio</th>
                <th class="px-3 py-2">Certificado</th>
                <th class="px-3 py-2">Patrón</th>
                <th class="px-3 py-2">Incertidumbre</th>
                <th class="px-3 py-2">Resultado</th>
                <th class="px-3 py-2 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {calibracionesRows.map((r) => {
                const c = r.c;
                const vig = vigenciaPatron(c.patronActivoId, c.fechaCalibracion);
                const segunda = [
                  c.realizadoPor && `Realizado por: ${c.realizadoPor}`,
                  c.notas && `Notas: ${c.notas}`,
                  r.registro && `Registró ${r.registro}`,
                  c.corregidaEn && `Corregida el ${fmt(c.corregidaEn)}${r.corrector ? ` por ${r.corrector}` : ""}`,
                ].filter(Boolean).join(" · ");
                return (
                  <>
                    <tr class="border-t border-slate-100 align-top hover:bg-slate-50">
                      <td class="px-3 py-2 font-mono text-xs">{fmt(c.fechaCalibracion)}</td>
                      <td class="px-3 py-2 font-mono text-xs">{fmt(c.proximaCalibracion)}</td>
                      <td class="px-3 py-2 text-xs">
                        {r.labNombre ?? c.laboratorioExterno ?? "—"}
                        {(r.labNombre || c.laboratorioExterno) && (
                          <span
                            class:list={["badge ml-1 text-[10px]", c.labAcreditado ? "bg-emerald-100 text-emerald-700" : c.labAcreditado === false ? "bg-amber-100 text-amber-700" : "bg-slate-100 text-slate-600"]}
                            title={c.labAcreditacionRef ?? undefined}
                          >{textoLabAcreditado(c.labAcreditado)}</span>
                        )}
                      </td>
                      <td class="px-3 py-2 text-xs">
                        {c.certificadoR2Key ? (
                          <a href={`/api/calibraciones/certificado/${c.id}`} target="_blank" class="text-brand-600 hover:underline">{c.numeroCertificado ?? "Ver certificado"}</a>
                        ) : (
                          <>
                            <span>{c.numeroCertificado ?? "—"}</span>
                            <span class="ml-1 text-amber-700">sin archivo</span>
                            {registraBio && <button type="button" class="cal-adj ml-1 text-brand-600 hover:underline" data-id={c.id}>Adjuntar</button>}
                          </>
                        )}
                      </td>
                      <td class="px-3 py-2 text-xs">
                        {r.patron && (
                          <a href={areaHref(`/activos/${r.patron.id}`, rubroDeActivo(r.patron.rubro, r.patron.tipo))} class="text-brand-600 hover:underline">{r.patron.codigo} · {r.patron.nombre}</a>
                        )}
                        {r.patron && vig && !vig.vigente && <span class="block font-semibold text-red-600">sin calibración vigente en esa fecha</span>}
                        {c.patronReferencia && <span class="block text-slate-500">{c.patronReferencia}</span>}
                        {!r.patron && !c.patronReferencia && "—"}
                      </td>
                      <td class="px-3 py-2 text-xs">{c.incertidumbre ?? "—"}</td>
                      <td class="px-3 py-2"><span class={`badge text-[10px] ${RESULTADO_CALIB_COLOR[c.resultado]}`}>{RESULTADO_CALIB_LABEL[c.resultado]}</span></td>
                      <td class="whitespace-nowrap px-3 py-2 text-right text-xs">
                        {puedeCorregirCal && <button type="button" class="cal-fix text-brand-600 hover:underline" data-id={c.id}>Corregir</button>}
                        {puedeCorregirCal && <button type="button" class="cal-del ml-2 text-red-600 hover:underline" data-id={c.id} data-fecha={fmt(c.fechaCalibracion)}>Eliminar</button>}
                      </td>
                    </tr>
                    {segunda && (
                      <tr class="text-xs text-slate-500">
                        <td colspan="8" class="whitespace-pre-wrap px-3 pb-2">{segunda}</td>
                      </tr>
                    )}
                  </>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  )}

  <!-- Cronograma de mantenimiento -->
  <div class="card mt-6 p-5">
    <div class="flex items-center justify-between">
      <h2 id="planes" class="font-semibold scroll-mt-24">Cronograma de mantenimiento preventivo</h2>
      {canEdit && a.estado !== "baja" && <button id="newPlanBtn" class="btn-primary">+ Agregar al cronograma</button>}
    </div>

    <div id="newPlanForm" class="mt-4 hidden rounded-md border border-slate-200 bg-slate-50 p-4">
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="sm:col-span-2"><label class="label">Título *</label><input class="input" id="p_titulo" placeholder="Ej.: limpieza general, calibración semestral…" /></div>
        <div class="sm:col-span-2"><label class="label">Descripción o instrucciones</label><textarea class="input" id="p_descripcion" rows="2"></textarea></div>
        <div>
          <label class="label">Frecuencia *</label>
          <select class="input" id="p_frecuencia">
            {OPCIONES_FRECUENCIA.map((f) => <option value={f.value} selected={f.value === "mensual"}>{f.label}</option>)}
          </select>
        </div>
        <div><label class="label">Próxima ejecución *</label><input class="input" id="p_proxima" type="date" required /></div>
        <div><label class="label">Alerta (días antes)</label><input class="input" id="p_alerta" type="number" min="0" max="90" value="7" /></div>
        <div>
          <label class="label">Prioridad</label>
          <select class="input" id="p_prioridad">
            <option value="baja">Baja</option>
            <option value="media" selected>Media</option>
            <option value="alta">Alta</option>
            <option value="urgente">Urgente</option>
          </select>
        </div>
        <div><label class="label">Horas estimadas</label><input class="input" id="p_horas" type="number" step="0.5" min="0" /></div>
        <div>
          <label class="label">Asignar a (opcional)</label>
          <select class="input" id="p_asignado">
            <option value="">- Sin asignar -</option>
            {tecnicos.map((t) => <option value={t.id}>{t.nombre}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2 border-t border-slate-200 pt-3 mt-1">
          <label class="label">Plantilla de checklist <span class="text-slate-400 font-normal">(opcional pero recomendada)</span></label>
          <select class="input" id="p_plantilla">
            <option value="">— Sin plantilla (checklist vacío) —</option>
          </select>
          <p class="mt-1 text-xs text-slate-500">Al seleccionar una plantilla, los puntos críticos se cargan abajo y podrás ajustarlos para este equipo específico.</p>
          <p id="p_plantillaHint" class="mt-1 text-xs text-brand-600"></p>
        </div>
        <div class="sm:col-span-2">
          <label class="label">Puntos críticos del checklist</label>
          <textarea id="p_checklist" class="input font-mono text-xs" rows="6" placeholder="Selecciona una plantilla arriba o escribe los puntos uno por línea&#10;Ej:&#10;Limpieza de filtros&#10;Verificación de gas refrigerante"></textarea>
          <p class="mt-1 text-xs text-slate-500">Cada línea es un punto. El técnico debe marcar cada uno como OK, N/A o Desviación antes de cerrar la OT.</p>
        </div>
      </div>
      <p id="p_err" class="mt-2 hidden text-sm text-red-600"></p>
      <div class="mt-3 flex gap-2">
        <button id="p_save" class="btn-primary">Guardar plan</button>
        <button id="p_cancel" class="btn-secondary">Cancelar</button>
      </div>
    </div>

    <div class="mt-4">
      {planes.length === 0 ? (
        <p class="text-sm text-slate-500">Aún no hay planes de mantenimiento para este equipo. {canEdit && a.estado !== "baja" && "Agrega uno para que el sistema genere órdenes automáticamente."}</p>
      ) : (
        <ul class="divide-y divide-slate-100">
          {planes.map((r) => (
            <li class="py-3" id={`plan-${r.p.id}`}>
              <div class="flex items-start justify-between gap-2">
                <div class="flex-1">
                  <div class="font-medium">{r.p.titulo}</div>
                  <div class="mt-1 flex flex-wrap items-center gap-2 text-xs">
                    <span class="rounded bg-slate-100 px-2 py-0.5">{etiquetaFrecuencia(r.p.frecuencia)}</span>
                    <span class="rounded bg-blue-100 px-2 py-0.5 text-blue-700">Próxima: <strong>{fmt(r.p.proximaFecha)}</strong></span>
                    {r.u
                      ? <span class="rounded bg-emerald-100 px-2 py-0.5 text-emerald-700">{r.u.nombre}</span>
                      : <span class="rounded bg-amber-100 px-2 py-0.5 text-amber-700">Sin asignar</span>
                    }
                    {r.p.prioridad && <span class="rounded bg-slate-100 px-2 py-0.5 capitalize text-slate-600">{r.p.prioridad}</span>}
                  </div>
                  {r.p.ultimaGeneracion && <div class="mt-1 text-xs text-slate-400">Última OT generada: {fmt(r.p.ultimaGeneracion)}</div>}
                  {r.p.descripcion && <div class="mt-1 text-sm text-slate-600">{r.p.descripcion}</div>}
                </div>
                <div class="flex items-center gap-2">
                  <span class={`badge ${r.p.activo ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-500"}`}>
                    {r.p.activo ? "activo" : "pausado"}
                  </span>
                  {canEdit && (
                    <>
                      {/* De baja, la API de rutinas (WP-E) solo deja pausar o eliminar: editar y activar responden 409. */}
                      {a.estado !== "baja" && <button data-id={r.p.id} data-edit class="btn-secondary text-xs">Editar</button>}
                      {(a.estado !== "baja" || r.p.activo) && <button data-id={r.p.id} data-pause class="btn-secondary text-xs">{r.p.activo ? "Pausar" : "Activar"}</button>}
                      {canJefe && <button data-id={r.p.id} data-del class="btn-secondary text-xs text-red-600">Eliminar</button>}
                    </>
                  )}
                </div>
              </div>

              {canEdit && (
                <div id={`edit-${r.p.id}`} class="mt-3 hidden rounded border border-brand-200 bg-brand-50/40 p-3">
                  <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                    <div class="sm:col-span-2">
                      <label class="label">Título</label>
                      <input class="input edit-titulo" data-id={r.p.id} value={r.p.titulo} />
                    </div>
                    <div class="sm:col-span-2">
                      <label class="label">Descripción</label>
                      <textarea class="input edit-descripcion" data-id={r.p.id} rows="2">{r.p.descripcion ?? ""}</textarea>
                    </div>
                    <div>
                      <label class="label">Frecuencia</label>
                      <select class="input edit-frecuencia" data-id={r.p.id}>
                        {!frecuenciaOfrecida(r.p.frecuencia) && <option value={r.p.frecuencia} selected>{etiquetaFrecuencia(r.p.frecuencia)} (no disponible)</option>}
                        {OPCIONES_FRECUENCIA.map((f) => <option value={f.value} selected={f.value === r.p.frecuencia}>{f.label}</option>)}
                      </select>
                    </div>
                    <div>
                      <label class="label">Próxima ejecución</label>
                      <input class="input edit-proxima" data-id={r.p.id} type="date" value={r.p.proximaFecha} />
                    </div>
                    <div>
                      <label class="label">Alerta días antes</label>
                      <input class="input edit-alerta" data-id={r.p.id} type="number" min="0" max="90" value={r.p.alertaDiasAntes} />
                    </div>
                    <div>
                      <label class="label">Prioridad</label>
                      <select class="input edit-prioridad" data-id={r.p.id}>
                        <option value="baja" selected={r.p.prioridad === "baja"}>Baja</option>
                        <option value="media" selected={r.p.prioridad === "media"}>Media</option>
                        <option value="alta" selected={r.p.prioridad === "alta"}>Alta</option>
                        <option value="urgente" selected={r.p.prioridad === "urgente"}>Urgente</option>
                      </select>
                    </div>
                    <div>
                      <label class="label">Horas estimadas</label>
                      <input class="input edit-horas" data-id={r.p.id} type="number" step="0.5" min="0" value={r.p.horasEstimadas ?? ""} />
                    </div>
                    <div>
                      <label class="label">Asignar a</label>
                      <select class="input edit-asignado" data-id={r.p.id}>
                        <option value="">- Sin asignar -</option>
                        {tecnicos.map((t) => <option value={t.id} selected={t.id === r.p.asignadoA}>{t.nombre}</option>)}
                      </select>
                    </div>
                  </div>
                  <p class="mt-2 text-xs text-slate-500">Si cambias la frecuencia o la próxima fecha, los próximos ciclos se calcularán a partir de aquí.</p>
                  <p class="edit-msg mt-2 hidden text-xs" data-id={r.p.id}></p>
                  <div class="mt-2 flex gap-2">
                    <button data-id={r.p.id} data-save class="btn-primary text-sm">Guardar</button>
                    <button data-id={r.p.id} data-cancel class="btn-secondary text-sm">Cancelar</button>
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <!-- Historial de OT -->
  <div class="card mt-6 p-5">
    <h2 class="font-semibold">Últimas órdenes de trabajo</h2>
    {ordsRel.length === 0 ? (
      <p class="mt-2 text-sm text-slate-500">Sin órdenes registradas para este equipo.</p>
    ) : (
      <ul class="mt-3 divide-y divide-slate-100 text-sm">
        {ordsRel.map((o) => (
          <li class="flex items-center justify-between py-2">
            <a href={areaHref(`/ordenes/${o.id}`, area)} class="text-brand-700 hover:underline">{etiquetaOT(o)} - {o.titulo}</a>
            <span class="text-xs text-slate-500 capitalize">{o.tipo} · {o.estado.replace("_"," ")}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- Historial de cambios (bitácora): solo quien ve lo biomédico (lleva calibraciones, documentos y bajas);
       para proveedor, solicitante y motorista historialCambios es null. Valores a la vista (DD/MM/AAAA). -->
  {historialCambios && (
  <div class="card mt-6 p-5">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="font-semibold">Historial de cambios</h2>
      <div class="flex items-center gap-3">
        <span class="text-xs text-slate-500">{historialCambios.length === LIMITE_BITACORA_FICHA ? `Los ${LIMITE_BITACORA_FICHA} más recientes` : `${historialCambios.length} ${historialCambios.length === 1 ? "evento" : "eventos"}`}</span>
        <a href={areaHref(`/activos/${a.id}/historial`, area)} class="text-xs font-medium text-brand-600 hover:underline">Ver historial completo</a>
      </div>
    </div>
    {historialCambios.length === 0 ? (
      <p class="mt-2 text-sm text-slate-500">Sin cambios registrados todavía.</p>
    ) : (
      <ul class="mt-3 divide-y divide-slate-100 text-sm">
        {historialCambios.map((r) => (
          <li class="py-3">
            <div class="flex items-start justify-between gap-2">
              <div>
                <span class={`badge ${r.accionColor}`}>{r.accionLabel}</span>
                <span class="ml-2 text-sm font-medium">{r.usuario}</span>
                {r.resumen && <span class="ml-2 text-sm text-slate-600">— {r.resumen}</span>}
              </div>
              <span class="whitespace-nowrap text-xs text-slate-400">{r.cuando}</span>
            </div>
            {r.cambios.length > 0 && (
              <table class="mt-2 ml-2 text-xs text-slate-600">
                <tbody>
                  {r.cambios.map((c) => (
                    <tr>
                      <td class="pr-3 font-medium text-slate-500">{c.etiqueta}:</td>
                      <td class="pr-2 text-red-600 line-through">{c.antes}</td>
                      <td class="pr-2">→</td>
                      <td class="text-emerald-700">{c.despues}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
  )}

  <script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({ activoId: id, activoCodigo: a.codigo, activoNombre: a.nombre, ubicacionNombre: ubicacionInfo?.nombre ?? null, hoy }) }}>
    const { activoId, activoCodigo, activoNombre, ubicacionNombre, hoy } = JSON.parse(decodeURIComponent(__encodedScriptVars));
    const $ = (id) => document.getElementById(id);
    // Cache de plantillas para repoblar el textarea de checklist
    let plantillasCache = [];
    // Metadata del procedimiento por texto de paso (criterio, bloqueante, etc.),
    // poblada al elegir una plantilla, para no perderla al guardar el plan.
    let plantillaMetaByTexto = {};

    async function cargarPlantillas() {
      try {
        const res = await fetch("/api/checklist-plantillas?activas=1");
        if (!res.ok) return;
        const j = await res.json();
        plantillasCache = j.plantillas ?? [];
        const sel = $("p_plantilla");
        if (!sel) return;
        sel.innerHTML = '<option value="">— Sin plantilla (checklist vacío) —</option>';
        for (const p of plantillasCache) {
          const opt = document.createElement("option");
          opt.value = String(p.id);
          opt.textContent = `${p.nombre} (${p.items.length} puntos)`;
          sel.appendChild(opt);
        }
      } catch {}
    }

    $("p_plantilla")?.addEventListener("change", () => {
      const id = Number($("p_plantilla").value);
      if (!id) return;
      const p = plantillasCache.find((x) => x.id === id);
      if (!p) return;
      const textareaEl = $("p_checklist");
      if (!textareaEl) return;
      // Si hay contenido previo, confirmar antes de sobrescribir
      if (textareaEl.value.trim() && !confirm("¿Reemplazar los puntos actuales con los de esta plantilla?")) return;
      textareaEl.value = p.items.map((it) => it.texto).join("\n");
      // Guardar la metadata del procedimiento por texto de paso
      plantillaMetaByTexto = {};
      for (const it of p.items) {
        plantillaMetaByTexto[it.texto.trim()] = {
          criterio: it.criterioAceptacion ?? null,
          bloqueante: !!it.bloqueante,
          minutos: it.minutosEstimados ?? null,
          materiales: it.materiales ?? null,
          requiereValor: !!it.requiereValor,
          unidad: it.unidad ?? null,
          esperadoMin: it.valorEsperadoMin ?? null,
          esperadoMax: it.valorEsperadoMax ?? null,
        };
      }
      const crit = p.items.filter((it) => it.criterioAceptacion).length;
      const blo = p.items.filter((it) => it.bloqueante).length;
      const hint = $("p_plantillaHint");
      if (hint) hint.textContent = `Procedimiento cargado: ${p.items.length} pasos · ${crit} con criterio · ${blo} crítico(s). Cada paso conserva su criterio y tiempo al generar la OT.`;
    });

    $("newPlanBtn")?.addEventListener("click", () => {
      $("newPlanForm").classList.remove("hidden");
      // Pre-llenar título: "Mantenimiento preventivo {nombre equipo} {ubicación}"
      const tituloEl = $("p_titulo");
      if (tituloEl && !tituloEl.value) {
        const partes = ["Mantenimiento preventivo", activoNombre];
        if (ubicacionNombre) partes.push(ubicacionNombre);
        tituloEl.value = partes.filter(Boolean).join(" ");
      }
      // Pre-llenar próxima fecha con hoy en El Salvador (lo calcula el servidor)
      const fechaEl = $("p_proxima");
      if (fechaEl && !fechaEl.value) fechaEl.value = hoy;
      // Cargar plantillas si aún no se cargaron
      if (plantillasCache.length === 0) cargarPlantillas();
    });
    $("p_cancel")?.addEventListener("click", () => $("newPlanForm").classList.add("hidden"));

    $("p_save")?.addEventListener("click", async () => {
      const err = $("p_err");
      const boton = $("p_save");
      if (boton.disabled) return;
      err.classList.add("hidden");
      // Construir checklist desde el textarea (formato esperado por la API: [{texto}])
      const checklistRaw = $("p_checklist")?.value?.trim() || "";
      let checklist = null;
      if (checklistRaw) {
        const items = checklistRaw.split("\n").map((l) => l.trim()).filter(Boolean)
          .map((texto) => {
            const meta = plantillaMetaByTexto[texto];
            return meta ? { texto, ...meta } : { texto };
          });
        if (items.length > 0) checklist = items;
      }
      const payload = {
        titulo: $("p_titulo").value.trim(),
        descripcion: $("p_descripcion").value.trim() || null,
        frecuencia: $("p_frecuencia").value,
        proximaFecha: $("p_proxima").value,
        alertaDiasAntes: Number($("p_alerta").value || 7),
        prioridad: $("p_prioridad").value,
        horasEstimadas: $("p_horas").value ? Number($("p_horas").value) : null,
        asignadoA: $("p_asignado").value ? Number($("p_asignado").value) : null,
        checklist,
      };
      if (!payload.titulo || !payload.proximaFecha) {
        err.textContent = "El título y la próxima fecha son obligatorios.";
        err.classList.remove("hidden");
        return;
      }
      // Un solo envío: dos clics seguidos creaban dos rutinas iguales (y el doble de órdenes).
      boton.disabled = true;
      const fallo = (t) => { err.textContent = t; err.classList.remove("hidden"); boton.disabled = false; };
      try {
        const res = await fetch(`/api/activos/${activoId}/planes`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          const j = await res.json().catch(() => ({}));
          return fallo(typeof j.error === "string" ? j.error : "No se pudo guardar la rutina.");
        }
        location.reload();
      } catch {
        fallo("No hay conexión. Intenta de nuevo.");
      }
    });

    // Si la API responde con error, se dice; antes se recargaba como si nada.
    const avisoRutina = async (res, texto) => {
      const j = await res.json().catch(() => ({}));
      const msg = typeof j.error === "string" ? j.error : texto;
      if (window.showToast) window.showToast(msg, "error"); else alert(msg);
    };
    document.querySelectorAll("[data-pause]").forEach((b) => {
      b.addEventListener("click", async (e) => {
        const id = e.currentTarget.dataset.id;
        const isActive = e.currentTarget.textContent.trim() === "Pausar";
        try {
          const res = await fetch(`/api/planes/${id}`, {
            method: "PATCH",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ activo: !isActive }),
          });
          if (!res.ok) return avisoRutina(res, isActive ? "No se pudo pausar la rutina." : "No se pudo activar la rutina.");
          location.reload();
        } catch {
          alert(isActive ? "No se pudo pausar la rutina." : "No se pudo activar la rutina.");
        }
      });
    });

    document.querySelectorAll("[data-del]").forEach((b) => {
      b.addEventListener("click", async (e) => {
        if (!confirm("¿Eliminar esta rutina de mantenimiento?")) return;
        const id = e.currentTarget.dataset.id;
        try {
          const res = await fetch(`/api/planes/${id}`, { method: "DELETE" });
          if (!res.ok) return avisoRutina(res, "No se pudo eliminar la rutina.");
          location.reload();
        } catch {
          alert("No se pudo eliminar la rutina.");
        }
      });
    });

    // Editar plan inline
    document.querySelectorAll("[data-edit]").forEach((b) => {
      b.addEventListener("click", (e) => {
        const id = e.currentTarget.dataset.id;
        document.getElementById(`edit-${id}`)?.classList.remove("hidden");
      });
    });
    document.querySelectorAll("[data-cancel]").forEach((b) => {
      b.addEventListener("click", (e) => {
        const id = e.currentTarget.dataset.id;
        document.getElementById(`edit-${id}`)?.classList.add("hidden");
      });
    });
    document.querySelectorAll("[data-save]").forEach((b) => {
      b.addEventListener("click", async (e) => {
        const boton = e.currentTarget;
        const id = boton.dataset.id;
        const get = (cls) => document.querySelector(`.${cls}[data-id="${id}"]`);
        const v = (cls) => get(cls)?.value?.trim() ?? "";
        const num = (cls) => { const x = get(cls)?.value; return x === "" || x == null ? null : Number(x); };
        const asign = get("edit-asignado")?.value;
        const payload = {
          titulo: v("edit-titulo"),
          descripcion: v("edit-descripcion") || null,
          frecuencia: get("edit-frecuencia").value,
          proximaFecha: v("edit-proxima"),
          alertaDiasAntes: num("edit-alerta") ?? 7,
          prioridad: get("edit-prioridad").value,
          horasEstimadas: num("edit-horas"),
          asignadoA: asign ? Number(asign) : null,
        };
        const msg = document.querySelector(`.edit-msg[data-id="${id}"]`);
        msg?.classList.add("hidden");
        const fallo = (t) => {
          if (msg) {
            msg.textContent = t;
            msg.className = "edit-msg mt-2 text-xs text-red-600";
            msg.classList.remove("hidden");
          }
          boton.disabled = false;
        };
        boton.disabled = true;
        try {
          const res = await fetch(`/api/planes/${id}`, {
            method: "PATCH",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(payload),
          });
          if (!res.ok) {
            const j = await res.json().catch(() => ({}));
            return fallo(typeof j.error === "string" ? j.error : "No se pudo guardar la rutina.");
          }
          location.reload();
        } catch {
          fallo("No hay conexión. Intenta de nuevo.");
        }
      });
    });

    // Documentos (WP-D) y calibraciones tienen sus propios scripts: un error ahí no
    // detiene los demás formularios de la ficha.

    // ─── Equipos de respaldo (contingencia) ─────────────────────────────────
    $("respaldoBtn")?.addEventListener("click", () => $("respaldoForm")?.classList.toggle("hidden"));
    $("respaldoCancel")?.addEventListener("click", () => $("respaldoForm")?.classList.add("hidden"));
    $("respaldoSave")?.addEventListener("click", async () => {
      const sel = $("respaldoSel");
      if (!sel?.value) { alert("Selecciona un equipo de respaldo."); return; }
      const res = await fetch(`/api/activos/${activoId}/respaldos`, {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ respaldoId: Number(sel.value), notas: $("respaldoNotas")?.value || null }),
      });
      if (res.ok) location.reload(); else { const j = await res.json().catch(() => ({})); alert("Error: " + (typeof j.error === "string" ? j.error : "no se pudo vincular")); }
    });
    document.querySelectorAll(".respaldo-del").forEach((b) => {
      b.addEventListener("click", async (e) => {
        if (!confirm("¿Quitar este equipo de respaldo?")) return;
        const rid = e.currentTarget.dataset.id;
        const res = await fetch(`/api/activos/${activoId}/respaldos?respaldoId=${rid}`, { method: "DELETE" });
        if (res.ok) location.reload(); else alert("Error al quitar");
      });
    });

    // ─── Fase 47 · Jerarquía del SCP (padre + nivel + SCP vinculado) ───────
    const jerModal = $("jerModal");
    const abrirJer = () => { jerModal?.classList.remove("hidden"); jerModal?.classList.add("flex"); };
    const cerrarJer = () => { jerModal?.classList.add("hidden"); jerModal?.classList.remove("flex"); };
    $("jerModalBtn")?.addEventListener("click", abrirJer);
    $("jer_cancel")?.addEventListener("click", cerrarJer);
    jerModal?.addEventListener("click", (e) => { if (e.target === jerModal) cerrarJer(); });

    // Al elegir un SCP se propone su versión vigente como referencia del activo.
    $("jer_scp")?.addEventListener("change", () => {
      const sel = $("jer_scp");
      const opt = sel.options[sel.selectedIndex];
      const ver = opt?.dataset?.version;
      if (!sel.value) { $("jer_version").value = ""; return; }
      if (ver) $("jer_version").value = ver;
    });

    $("jer_save")?.addEventListener("click", async () => {
      const err = $("jer_err");
      err.classList.add("hidden");
      const padreVal = $("jer_padre").value;
      const scpVal = $("jer_scp").value;
      const payload = {
        padreId: padreVal ? Number(padreVal) : null,
        nivelJerarquia: $("jer_nivel").value,
        scpProcedimientoId: scpVal ? Number(scpVal) : null,
        scpVersionRef: scpVal ? ($("jer_version").value.trim() || null) : null,
      };
      const res = await fetch(`/api/activos/${activoId}`, {
        method: "PATCH",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      const j = await res.json().catch(() => ({}));
      if (!res.ok) {
        err.textContent = typeof j.error === "string" ? j.error : "No se pudo guardar la jerarquía.";
        err.classList.remove("hidden");
        window.showToast?.(typeof j.error === "string" ? j.error : "No se pudo guardar", "error");
        return;
      }
      window.showToast?.("Jerarquía y SCP actualizados", "success");
      location.reload();
    });

    // ─── Fase 47 · Mapa de distribución (ubicaciones servidas) ─────────────
    $("servBtn")?.addEventListener("click", () => $("servForm")?.classList.toggle("hidden"));
    $("serv_cancel")?.addEventListener("click", () => $("servForm")?.classList.add("hidden"));
    $("serv_save")?.addEventListener("click", async () => {
      const err = $("serv_err");
      err.classList.add("hidden");
      if (!$("serv_ubic").value) {
        err.textContent = "Selecciona una ubicación.";
        err.classList.remove("hidden");
        return;
      }
      const res = await fetch(`/api/activos/${activoId}/ubicaciones-servidas`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          ubicacionId: Number($("serv_ubic").value),
          rol: $("serv_rol").value,
          notas: $("serv_notas").value.trim() || null,
        }),
      });
      const j = await res.json().catch(() => ({}));
      if (!res.ok) {
        err.textContent = typeof j.error === "string" ? j.error : "No se pudo agregar al mapa.";
        err.classList.remove("hidden");
        return;
      }
      window.showToast?.("Ubicación agregada al mapa", "success");
      location.reload();
    });
    document.querySelectorAll(".serv-del").forEach((b) => {
      b.addEventListener("click", async (e) => {
        const relId = e.currentTarget.dataset.rel;
        const ok = await (window.confirmAction
          ? window.confirmAction("Quitar del mapa", "¿Quitar esta ubicación del mapa de distribución del activo?")
          : confirm("¿Quitar esta ubicación del mapa de distribución?"));
        if (!ok) return;
        const res = await fetch(`/api/activos/${activoId}/ubicaciones-servidas?relId=${relId}`, { method: "DELETE" });
        if (res.ok) { window.showToast?.("Ubicación quitada", "success"); location.reload(); }
        else window.showToast?.("Error al quitar", "error");
      });
    });


    // ─── Fase 48 · Declarar en firme el sistema crítico del equipo ──────────
    // El resolver sabe inferir el sistema por el nombre, pero una inferencia no
    // debería decidir qué EOP aplica en una emergencia. Esto la vuelve un dato.
    const btnSisSave = $("sisSave");
    if (btnSisSave) {
