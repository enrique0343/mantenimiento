        function abrirNuevo() {
          limpiar();
          modo = { tipo: "nuevo", id: null, original: null };
          $("calTitulo").textContent = "Registrar calibración";
          $("c_motivo_wrap").classList.add("hidden");
          $("c_file_label").textContent = "Certificado (PDF o imagen JPG, PNG o WEBP; máx. 15 MB)";
          $("c_save").textContent = "Guardar calibración";
          $("c_fecha").value = hoy;
          $("c_proxima").value = masAnios(hoy, 1);
          abrir();
        }
        function abrirCorregir(id) {
          const c = calibraciones.find((x) => x.id === id);
          if (!c) return;
          limpiar();
          modo = { tipo: "corregir", id, original: c };
          $("calTitulo").textContent = `Corregir calibración del ${c.fechaTexto}`;
          $("c_motivo_wrap").classList.remove("hidden");
          $("c_file_label").textContent = c.tieneCertificado
            ? "Reemplazar el certificado (opcional; el anterior queda guardado)"
            : "Adjuntar el certificado (opcional; PDF, JPG, PNG o WEBP; máx. 15 MB)";
          $("c_save").textContent = "Guardar corrección";
          $("c_fecha").value = c.fechaCalibracion || "";
          $("c_proxima").value = c.proximaCalibracion || "";
          asegurarOpcion($("c_lab"), c.laboratorioId, `${c.labNombre || "Laboratorio"} (ya no está activo)`);
          $("c_lab").value = c.laboratorioId != null ? String(c.laboratorioId) : "";
          $("c_labext").value = c.laboratorioExterno || "";
          $("c_cert").value = c.numeroCertificado || "";
          asegurarOpcion($("c_patron_id"), c.patronActivoId, `${c.patronEtiqueta || "Equipo patrón"} (ya no está en la lista)`);
          $("c_patron_id").value = c.patronActivoId != null ? String(c.patronActivoId) : "";
          $("c_patron").value = c.patronReferencia || "";
          $("c_resultado").value = c.resultado || "conforme";
          $("c_incert").value = c.incertidumbre || "";
          $("c_realizado").value = c.realizadoPor || "";
          $("c_notas").value = c.notas || "";
          abrir();
        }
        // Ya se guardó (y se están leyendo los avisos): la tabla no muestra lo nuevo hasta recargar.
        // Cerrar el formulario sin recargar hacía creer que no se guardó y se registraba dos veces.
        $("calNewBtn")?.addEventListener("click", () => {
          if (guardado) { location.reload(); return; }
          if (!form.classList.contains("hidden") && modo.tipo === "nuevo") { form.classList.add("hidden"); return; }
          abrirNuevo();
        });
        document.querySelectorAll(".cal-fix").forEach((b) => {
          b.addEventListener("click", (e) => {
            if (guardado) { location.reload(); return; }
            abrirCorregir(Number(e.currentTarget.dataset.id));
