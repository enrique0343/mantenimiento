    // Eliminar equipo (solo admin y solo sin historial; el servidor lo vuelve a revisar)
    document.getElementById("deleteBtn")?.addEventListener("click", async () => {
      if (!confirm("¿Eliminar este equipo? Solo se elimina un equipo registrado por error y sin historial. Para retirarlo del servicio usa «Dar de baja».")) return;
      try {
        const res = await fetch(`/api/activos/${activoId}`, { method: "DELETE" });
        if (res.ok) {
          location.href = `/activos?area=${encodeURIComponent(new URL(location.href).searchParams.get("area") || "")}`;
          return;
        }
        const j = await res.json().catch(() => ({}));
        alert(typeof j.error === "string" ? j.error : "No se pudo eliminar el equipo.");
      } catch {
        alert("No hay conexión. Intenta de nuevo.");
      }
    });
  </script>

  {mostrarCal && registraBio && (
    <script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({ activoId: a.id, hoy, maxBytes: ARCHIVO_MAX_BYTES, calibraciones: calibracionesJs }) }}>
      // Calibraciones (WP-B: K-B1 registrar, K-B2 corregir y eliminar, K-B3 adjuntar el certificado).
      // Script aparte: si algo falla aquí, los demás formularios de la ficha siguen funcionando.
      const { activoId, hoy, maxBytes, calibraciones } = JSON.parse(decodeURIComponent(__encodedScriptVars));
      (function () {
        const $ = (id) => document.getElementById(id);
        const avisar = (msg) => { if (window.showToast) window.showToast(msg, "error"); else alert(msg); };
        const TIPOS = ["application/pdf", "image/jpeg", "image/png", "image/webp"];
        const EXTENSIONES = ["pdf", "jpg", "jpeg", "png", "webp"];
        // Mismo criterio que el servidor (que además revisa los primeros bytes).
        function revisarArchivo(f) {
          if (!f) return null;
          const ext = String(f.name || "").split(".").pop().toLowerCase();
          const tipoOk = TIPOS.includes(f.type) || ((!f.type || f.type === "application/octet-stream") && EXTENSIONES.includes(ext));
          if (!tipoOk) return "El archivo debe ser PDF, JPG, PNG o WEBP.";
          if (f.size === 0) return "El archivo está vacío.";
          if (f.size > maxBytes) return "El archivo pesa más de 15 MB. Comprímelo o divídelo en partes.";
          return null;
        }
        // Fechas como texto 'AAAA-MM-DD' (sin new Date): el 29/02 pasa al 28/02 si el año no es bisiesto.
        const RE_FECHA = /^(\d{4})-(\d{2})-(\d{2})$/;
        function masAnios(f, n) {
          const m = RE_FECHA.exec(f || "");
          if (!m) return "";
          const anio = Number(m[1]) + n;
          const bisiesto = (anio % 4 === 0 && anio % 100 !== 0) || anio % 400 === 0;
          return `${anio}-${m[2]}-${m[2] === "02" && m[3] === "29" && !bisiesto ? "28" : m[3]}`;
        }

        // ── Adjuntar el certificado que falta (admin, jefe y técnico) ──
        const inputAdj = $("c_adj_file");
        let adjuntarId = null;
        document.querySelectorAll(".cal-adj").forEach((b) => {
          b.addEventListener("click", (e) => {
            adjuntarId = Number(e.currentTarget.dataset.id);
            if (inputAdj) { inputAdj.value = ""; inputAdj.click(); }
          });
        });
        inputAdj?.addEventListener("change", async () => {
          const f = inputAdj.files && inputAdj.files[0];
          if (!f || !adjuntarId) return;
          const error = revisarArchivo(f);
          if (error) { avisar(error); return; }
          const fd = new FormData();
          fd.append("file", f);
          try {
            const res = await fetch(`/api/calibraciones/certificado/${adjuntarId}`, { method: "POST", body: fd });
            const j = await res.json().catch(() => ({}));
            if (!res.ok) { avisar(typeof j.error === "string" ? j.error : "No se pudo adjuntar el certificado."); return; }
            location.reload();
          } catch {
            avisar("No hay conexión. Intenta de nuevo.");
          }
        });

        // ── Eliminar con motivo (admin y jefe) ──
        const modalDel = $("calDelModal");
        let borrarId = null;
        const cerrarDel = () => { modalDel?.classList.add("hidden"); modalDel?.classList.remove("flex"); };
        document.querySelectorAll(".cal-del").forEach((b) => {
          b.addEventListener("click", (e) => {
            if (!modalDel) return;
            borrarId = Number(e.currentTarget.dataset.id);
            $("calDelTexto").textContent = `Calibración del ${e.currentTarget.dataset.fecha || ""}. Escribe por qué se elimina: el motivo y una copia de los datos quedan en la bitácora del equipo.`;
            $("calDelMotivo").value = "";
