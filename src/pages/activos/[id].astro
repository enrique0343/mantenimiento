            const ul = $("c_avisos_lista");
            ul.textContent = "";
            for (const t of avisos) {
              const li = document.createElement("li");
              li.textContent = t;
              ul.appendChild(li);
            }
            $("c_avisos").classList.remove("hidden");
          } catch {
            boton.disabled = false;
            mostrarMsg("No hay conexión. Intenta de nuevo.");
          }
        });
      })();
    </script>
  )}
