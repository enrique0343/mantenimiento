          realizadoPor: $("c_realizado").value.trim(),
          notas: $("c_notas").value.trim(),
        });
        function validar(v) {
          if (!v.fechaCalibracion) return "Escribe la fecha de calibración.";
          if (v.fechaCalibracion > hoy) return "La fecha de calibración no puede ser posterior a hoy.";
          if (v.resultado !== "no_conforme" && !v.proximaCalibracion) return "Escribe la fecha de la próxima calibración.";
          if (v.proximaCalibracion && v.proximaCalibracion <= v.fechaCalibracion) return "La próxima calibración debe ser posterior a la fecha de calibración.";
          if (v.proximaCalibracion && v.proximaCalibracion > masAnios(v.fechaCalibracion, 5)) return "La próxima calibración no puede pasar de 5 años después de la calibración.";
          if (!v.laboratorioId && !v.laboratorioExterno) return "Elige el laboratorio de la lista o escribe su nombre.";
          if ((v.resultado === "no_conforme" || v.resultado === "conforme_con_ajuste") && !v.notas) return "Describe en las notas el ajuste o la falla.";
          const errArchivo = revisarArchivo($("c_file") && $("c_file").files ? $("c_file").files[0] : null);
          if (errArchivo) return errArchivo;
          if (modo.tipo === "corregir" && $("c_motivo").value.trim().length < 10) return "Escribe el motivo de la corrección (al menos 10 letras).";
          return null;
