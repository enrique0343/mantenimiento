        $("c_cancel")?.addEventListener("click", () => {
          if (guardado) { location.reload(); return; }
          form.classList.add("hidden");
        });
        $("c_avisos_ok")?.addEventListener("click", () => location.reload());
        // Solo al registrar: la próxima pasa al mismo día del año siguiente.
        $("c_fecha")?.addEventListener("change", () => {
          if (modo.tipo !== "nuevo") return;
          const p = masAnios($("c_fecha").value, 1);
          if (p) $("c_proxima").value = p;
        });

        const valores = () => ({
          fechaCalibracion: $("c_fecha").value,
          proximaCalibracion: $("c_proxima").value,
          laboratorioId: $("c_lab").value,
          laboratorioExterno: $("c_labext").value.trim(),
          numeroCertificado: $("c_cert").value.trim(),
          patronActivoId: $("c_patron_id").value,
          patronReferencia: $("c_patron").value.trim(),
          resultado: $("c_resultado").value,
