<Layout title={a.nombre}>
  <nav class="flex flex-wrap items-center gap-1 text-sm text-slate-500" aria-label="Jerarquía del activo">
    <a href={areaHref("/activos", area)} class="hover:underline">&larr; {AREAS[area].inventoryLabel} · {AREAS[area].label}</a>
    {ancestros.map((an) => (
      <Fragment>
        <span class="text-slate-300">/</span>
        <a href={`/activos/${an.id}`} class="hover:underline" title={an.nombre}>
          <span class="font-mono text-xs">{an.codigo}</span>
          <span class="ml-1">{an.nombre}</span>
        </a>
      </Fragment>
    ))}
    {ancestros.length > 0 && <span class="text-slate-300">/</span>}
    {ancestros.length > 0 && <span class="font-medium text-slate-700">{a.nombre}</span>}
  </nav>

  <div class="mt-2 flex flex-wrap items-start justify-between gap-4">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-2xl font-bold">{a.nombre}</h1>
        <span class="badge bg-brand-50 text-brand-700">{AREAS[area].label}</span>
        <span class={`badge ${CRITICIDAD_COLOR[criticidad]}`} title="Criticidad operacional">{CRITICIDAD_LABEL[criticidad]}</span>
        {a.estado === "baja" && <span class="badge bg-slate-200 text-slate-600">Dado de baja</span>}
        {a.esPatron && <span class="badge bg-indigo-100 text-indigo-700" title="Instrumento patrón: se usa para calibrar otros equipos">Equipo patrón</span>}
      </div>
      <p class="text-sm text-slate-500 font-mono">{a.codigo} {a.numeroActivo && `· ${a.numeroActivo}`}</p>
    </div>
    <div class="flex flex-wrap gap-2">
      {verBio && <a href={areaHref(`/activos/${a.id}/hoja-vida`, area)} class="btn-secondary">Hoja de vida</a>}
      {verBio && <a href={areaHref(`/activos/${a.id}/historial`, area)} class="btn-secondary">Historial</a>}
      {canEdit && <a href={areaHref(`/activos/${a.id}/editar`, area)} class="btn-primary">Editar</a>}
      {vinetaVisible && <a href={`/calibraciones/vinetas?activos=${a.id}`} class="btn-secondary">Imprimir viñeta</a>}
      {gestionaBio && a.estado !== "baja" && <a href={areaHref(`/activos/${a.id}/baja`, area)} class="btn-secondary">Dar de baja</a>}
      {verBio && a.estado === "baja" && bajaVigente && (
        <a href={areaHref(`/activos/${a.id}/acta-baja?baja=${bajaVigente.id}`, area)} class="btn-secondary">Acta de baja</a>
      )}
      {gestionaBio && a.estado === "baja" && <a href={areaHref(`/activos/${a.id}/baja`, area)} class="btn-secondary">Revertir baja</a>}
      {canDelete && <button id="deleteBtn" type="button" class="btn-secondary text-red-600 hover:bg-red-50">Eliminar</button>}
    </div>
  </div>

  <!-- ══ Fase 48 · Qué sigue AHORA: el equipo ya está fuera de servicio ══════ -->
  {sigueFalla && (
    <div class="mt-4 rounded-lg border-2 border-red-400 bg-red-50 p-5" id="que-sigue">
      <div class="text-[11px] font-bold uppercase tracking-wide text-red-700">
        Este equipo está {a.estado} · qué sigue ahora
      </div>
      <h2 class="mt-0.5 text-xl font-bold text-red-800">{sigueFalla.encabezado}</h2>

      {sigueFalla.documento ? (
        <Fragment>
          <div class="mt-1 flex flex-wrap items-center gap-2">
            <a href={`/procedimientos/${sigueFalla.documento.id}`} class="font-mono text-sm font-bold text-red-700 underline">
              {sigueFalla.documento.codigoCorto}
            </a>
            <span class="badge bg-white text-slate-600">v{sigueFalla.documento.version}</span>
            <span class={`badge ${estadoInfo(sigueFalla.documento.estado).color}`}>
              {estadoInfo(sigueFalla.documento.estado).icono} {estadoInfo(sigueFalla.documento.estado).label}
            </span>
          </div>

          {sigueFalla.aviso && (
            <p class="mt-2 rounded border border-amber-300 bg-amber-50 p-2 text-sm font-medium text-amber-800">
              {sigueFalla.aviso}
            </p>
          )}

          {sigueFalla.primerasAcciones.length > 0 ? (
            <Fragment>
              <h3 class="mt-4 text-sm font-semibold text-red-800">Las tres primeras acciones · se saben de memoria</h3>
              <ol class="mt-2 space-y-2">
                {sigueFalla.primerasAcciones.map((acc, i) => (
                  <li class="flex gap-3 rounded-lg border-2 border-red-300 bg-white p-3">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-red-600 border border-red-600 text-lg font-bold ">
                      {i + 1}
                    </span>
                    <span class="self-center text-base font-semibold leading-snug text-slate-900">{acc}</span>
                  </li>
                ))}
              </ol>
            </Fragment>
          ) : (
            <p class="mt-3 rounded-md border border-amber-300 bg-amber-50 p-3 text-sm text-amber-800">
              El {sigueFalla.documento.codigoCorto} no tiene redactadas sus primeras acciones. Un EOP sin
              primeras acciones no se puede ejecutar de memoria: complétalo en la ficha del documento.
            </p>
          )}

          <div class="mt-4 flex flex-wrap gap-2">
            <a href={`/ordenes/nueva?activo=${a.id}&tipo=emergencia&procedimiento=${sigueFalla.documento.id}`} class="btn-primary">
              Abrir orden de emergencia
            </a>
            <a href={`/procedimientos/${sigueFalla.documento.id}`} class="btn-secondary">
              Ver el {sigueFalla.documento.codigoCorto} completo
            </a>
            <a href="/eop" class="btn-secondary">Hoja imprimible</a>
          </div>
        </Fragment>
      ) : (
        <Fragment>
          <p class="mt-2 text-sm font-medium text-red-800">{sigueFalla.aviso}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <a href={`/ordenes/nueva?activo=${a.id}&tipo=emergencia`} class="btn-primary">Abrir orden de emergencia</a>
            {canJefe && sistemaResuelto && (
              <a href={`/procedimientos?nuevo=1&sistema=${sistemaResuelto}&tipo=eop`} class="btn-secondary">
                Registrar el EOP que falta
              </a>
            )}
          </div>
        </Fragment>
      )}
    </div>
  )}

  <!-- ══ Qué rige este equipo · el resolver del volumen GO-GUI-011-2026 ══════ -->
  {rige && (
    <div class="card mt-4 border-slate-300 p-5" id="rige">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="font-semibold text-slate-900">Qué rige este equipo</h2>
          <p class="text-xs text-slate-500">
            Nadie tiene que buscar el documento: el sistema resuelve el juego de cinco que gobierna a toda la
            familia de este equipo y en qué estado está cada eslabón.
          </p>
        </div>
        <a href={`/cobertura?sistema=${rige.sistema}`} class="btn-secondary btn-sm">Cobertura del sistema</a>
      </div>

      <!-- El sistema resuelto y de dónde salió -->
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="badge bg-slate-100 text-slate-700">
          Sistema: <strong class="ml-1">{SISTEMA_LABEL[rige.sistema]}</strong>
        </span>
        <span class={`badge ${ORIGEN_SISTEMA[rige.origenSistema].color}`}>
          {ORIGEN_SISTEMA[rige.origenSistema].label}
        </span>
      </div>
      <p class="mt-1 text-xs text-slate-500">{ORIGEN_SISTEMA[rige.origenSistema].detalle}</p>

      {rige.origenSistema === "inferido" && (
        <div class="mt-3 rounded-md border border-amber-300 bg-amber-50 p-3">
          <div class="text-sm font-semibold text-amber-800">Una inferencia no es una declaración</div>
          <p class="mt-0.5 text-xs text-amber-700">
            Mientras nadie lo declare, los documentos de abajo son una deducción del nombre del equipo.
            Déjalo en firme para que la respuesta a una falla no dependa de una suposición.
          </p>
          {canEdit ? (
            <Fragment>
              <div class="mt-2 flex flex-wrap items-end gap-2">
                <div class="min-w-[13rem]">
                  <label class="label text-xs" for="sisSel">Sistema crítico</label>
                  <select id="sisSel" class="input">
                    {SISTEMAS.map((s) => (
                      <option value={s.value} selected={s.value === rige.sistema}>{s.icono} {s.label}</option>
                    ))}
                  </select>
                </div>
                <button id="sisSave" class="btn-primary btn-sm">Declarar en firme</button>
              </div>
              <p id="sisErr" class="mt-2 hidden text-xs font-medium text-red-600"></p>
            </Fragment>
          ) : (
            <p class="mt-1 text-xs text-amber-700">Pídele a Mantenimiento o Jefatura que lo declare.</p>
          )}
        </div>
      )}

      <!-- ══ El juego es de la familia, no de este equipo ════════════════════ -->
      {juego && (
        <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-3">
          <p class="text-sm text-slate-700">
            Este equipo pertenece a la familia <strong>{juego.label}</strong>.
            {familiaConteo && familiaConteo.total > 1 ? (
              <Fragment>
                {" "}Los 5 documentos de la familia aplican a sus <strong>{familiaConteo.total} equipos</strong>
                {familiaConteo.criticos > 0 && (
                  <Fragment> ({familiaConteo.criticos} de criticidad alta)</Fragment>
                )}.
              </Fragment>
            ) : (
              <Fragment> Los 5 documentos se definen para toda la familia, no para este equipo.</Fragment>
            )}
            <span class="text-slate-500">
              {" "}El juego no se arma equipo por equipo: se define una vez por familia y todos lo heredan.
            </span>
          </p>
          <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs">
            <span class:list={[
              "badge",
              nCubiertos === 5 ? "bg-emerald-100 text-emerald-700" : "bg-red-100 text-red-700",
            ]}>
              Juego {nCubiertos} de 5
            </span>
            <span class:list={[
              "badge",
              nVigentes === 5 ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700",
            ]}>
              {nVigentes} vigente{nVigentes === 1 ? "" : "s"}
            </span>
            <a href={`/procedimientos?nuevo=1&sistema=${juego.sistema}`} class="font-medium text-brand-600 hover:underline">
              Ver la biblioteca de la familia &rarr;
            </a>
          </div>
        </div>
      )}

      <!-- La cadena del cap. 01: SCP → SOP → AOP → EOP → MOP ─────────────── -->
      {sinNingunDocumento ? (
        <div class="mt-3 rounded-md border-2 border-red-300 bg-red-50 p-4">
          <div class="text-sm font-bold text-red-800">
            La familia {SISTEMA_LABEL[rige.sistema]} no tiene ningún documento del juego.
          </div>
          <p class="mt-1 text-xs text-red-700">
            No hay SCP, SOP, AOP, EOP ni MOP para {SISTEMA_LABEL[rige.sistema]}
            {familiaConteo && familiaConteo.total > 1 && (
              <Fragment>, y son {familiaConteo.total} equipos los que quedan sin gobierno</Fragment>
            )}. Si este equipo falla, nadie sabrá qué sigue más que de memoria.
          </p>
          {canJefe && (
            <a href={`/procedimientos?nuevo=1&sistema=${rige.sistema}`} class="btn-secondary btn-sm mt-2 inline-block">
              Registrarlo en la biblioteca
            </a>
          )}
        </div>
      ) : (
        <Fragment>
          <div class="mt-3 -mx-1 overflow-x-auto pb-1">
            <ol class="flex min-w-max items-stretch px-1" aria-label="Juego de documentos de la familia">
              {cadena.map((s, i) => (
                <Fragment>
                  {i > 0 && (
                    <li class="flex select-none items-center px-1 text-lg text-slate-300" aria-hidden="true">&rarr;</li>
                  )}
                  <li class:list={[
                    "flex w-[9.5rem] shrink-0 flex-col rounded-md border-2 p-2",
                    !s.cubierto
                      ? "border-dashed border-red-300 bg-red-50"
                      : s.vigente
                        ? "border-emerald-300 bg-white"
                        : "border-amber-300 bg-white",
                  ]}>
                    <span class={`badge w-fit px-1.5 text-[10px] ${TIPO_PROC[s.tipo].color}`}>
                      {TIPO_PROC[s.tipo].icono} {TIPO_PROC[s.tipo].label}
                    </span>

                    {s.doc ? (
                      <Fragment>
                        <a
                          href={`/procedimientos/${s.doc.id}`}
                          class="mt-1 block font-mono text-sm font-bold text-brand-600 hover:underline"
                          title={s.doc.titulo}
                        >
                          {s.doc.codigoCorto}
                        </a>
                        <span class:list={[
                          "badge mt-1 w-fit text-[10px]",
                          s.vigente ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700",
                        ]}>
                          {estadoInfo(s.doc.estado).icono} {estadoInfo(s.doc.estado).label}
                        </span>
                        {s.propio && (
                          <span class="mt-1 text-[10px] font-medium text-sky-700">Propio de este equipo</span>
                        )}
                        {s.otros > 0 && (
                          <span class="mt-1 text-[10px] text-slate-400">+{s.otros} más en la familia</span>
                        )}
                      </Fragment>
                    ) : (
                      <Fragment>
                        <span class="mt-1 block text-sm font-bold text-red-700">Falta</span>
                        {canJefe ? (
                          <a
                            href={`/procedimientos?nuevo=1&sistema=${rige.sistema}&tipo=${s.tipo}`}
                            class="mt-1 text-[10px] font-medium text-red-700 underline"
                          >
                            Crear el {TIPO_PROC[s.tipo].label}
                          </a>
                        ) : (
                          <span class="mt-1 text-[10px] text-red-600">Nadie lo ha redactado</span>
                        )}
                      </Fragment>
                    )}

                    <p class="mt-auto pt-2 text-[10px] leading-tight text-slate-500">{s.pregunta}</p>
                  </li>
                </Fragment>
              ))}
            </ol>
          </div>

          {faltanEnFamilia.length > 0 && (
            <div class="mt-3 rounded-md border border-red-300 bg-red-50 p-3">
              <div class="text-sm font-semibold text-red-800">
                A esta familia le falta {textoFaltantes}.
              </div>
              <p class="mt-0.5 text-xs text-red-700">
                El hueco no es de este equipo: es de
                {familiaConteo && familiaConteo.total > 1
                  ? ` los ${familiaConteo.total} equipos de ${juego?.label ?? ""} que comparten el juego`
                  : " toda la familia"}.
                Redactarlo una vez lo cierra para todos.
              </p>
              {canJefe && (
                <div class="mt-2 flex flex-wrap gap-2">
                  {faltanEnFamilia.map((s) => (
                    <a
                      href={`/procedimientos?nuevo=1&sistema=${rige.sistema}&tipo=${s.tipo}`}
                      class="btn-secondary btn-sm"
                    >
                      {TIPO_PROC[s.tipo].icono} Crear el {TIPO_PROC[s.tipo].label} de la familia
                    </a>
                  ))}
                </div>
              )}
            </div>
          )}
        </Fragment>
      )}

      {!fueraDeServicio && eopDeLaFamilia && (
        <p class="mt-3 text-xs text-slate-500">
          Si este equipo falla, el sistema abrirá la respuesta con
          <strong class="mx-1">{eopDeLaFamilia.codigoCorto}</strong>
          sin que nadie tenga que buscarlo.
        </p>
      )}
    </div>
  )}
  <ActivoConjuntos relaciones={conjuntosHistorial} />
  <CatalogoAireOrigen modeloAireId={a.modeloAireId} snapshot={a.modeloAireSnapshot} />

  <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
    <div class="card lg:col-span-2 p-5">
      <h2 class="font-semibold">Datos de {area === "infraestructura" ? "la instalación" : area === "aires" ? "la unidad" : "equipo"}</h2>
      <div class="mt-3 grid grid-cols-2 gap-3 text-sm">
        {area === "aires" && <>
          <div><div class="text-xs uppercase text-slate-500">Tipo de unidad</div><div>{datosTecnicos.tipoUnidad || "—"}</div></div>
          <div><div class="text-xs uppercase text-slate-500">Capacidad (BTU/h)</div><div>{datosTecnicos.capacidadBtuH?.toLocaleString("es-SV") || "—"}</div></div>
          <div><div class="text-xs uppercase text-slate-500">Refrigerante</div><div>{datosTecnicos.refrigerante || "—"}</div></div>
        </>}
        {area === "infraestructura" && <>
          <div><div class="text-xs uppercase text-slate-500">Tipo de instalación</div><div>{datosTecnicos.tipoInstalacion || "—"}</div></div>
          <div><div class="text-xs uppercase text-slate-500">Sector</div><div>{datosTecnicos.sector || "—"}</div></div>
        </>}
        {(area === "equipo_general" || area === "biomedico") && <div><div class="text-xs uppercase text-slate-500">Servicio / función</div><div>{datosTecnicos.servicio || "—"}</div></div>}

        <div><div class="text-xs uppercase text-slate-500">Marca / Modelo</div><div>{[a.marca, a.modelo].filter(Boolean).join(" / ") || "-"}</div></div>
        <div><div class="text-xs uppercase text-slate-500">Serie</div><div class="font-mono text-xs">{a.serial ?? "-"}</div></div>
        <div><div class="text-xs uppercase text-slate-500">Año</div><div>{a.anio ?? "-"}</div></div>
        <div><div class="text-xs uppercase text-slate-500">Categoría</div><div>{a.categoria ?? "-"}</div></div>
        <div><div class="text-xs uppercase text-slate-500">Centro de costo</div><div>{centroCosto ? etiquetaCentroCosto(centroCosto) : "—"}</div></div>
        <div>
          <div class="text-xs uppercase text-slate-500">Sucursal</div>
          <div>{sucursalInfo ? <span class="font-medium">{sucursalInfo.nombre}</span> : "-"}</div>
        </div>
        <div>
          <div class="text-xs uppercase text-slate-500">Ubicación</div>
          <div>
            {ubicacionInfo ? <span><span class="font-medium">{ubicacionInfo.nombre}</span> <span class="text-xs text-slate-400 capitalize">({ubicacionInfo.tipo})</span></span> : "-"}
            {a.ubicacion && <div class="text-xs text-slate-500">{a.ubicacion}</div>}
          </div>
        </div>
        {proveedorInfo && (
          <div class="col-span-2"><div class="text-xs uppercase text-slate-500">Proveedor</div><div>{proveedorInfo.nombre}</div></div>
        )}
        <div><div class="text-xs uppercase text-slate-500">Fecha de adquisición</div><div>{fmt(a.fechaAdquisicion)}</div></div>
        <div>
          <div class="text-xs uppercase text-slate-500">Vida útil</div>
          <div>
            {a.vidaUtilAnios ? <span>{a.vidaUtilAnios} años{finVida && <span class="text-xs text-slate-500"> · fin {fmt(finVida)}</span>}</span> : "-"}
          </div>
          {vidaRem != null && !vidaVencida && vidaRem < 2 && (
            <div class="mt-0.5 text-xs text-amber-600">Quedan ~{vidaRem.toFixed(1)} años de vida útil</div>
          )}
        </div>
        <div><div class="text-xs uppercase text-slate-500">Valor de adquisición</div><div>{a.valorAdquisicion != null ? `$${a.valorAdquisicion.toFixed(2)}` : "-"}</div></div>
        <div><div class="text-xs uppercase text-slate-500">Responsable</div><div>{responsableInfo ? `${responsableInfo.nombre}` : "-"}</div></div>
        <div class="col-span-2"><div class="text-xs uppercase text-slate-500">Descripción</div><div class="whitespace-pre-wrap">{a.descripcion ?? "-"}</div></div>
      </div>

      {vidaVencida && (
        <div class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          Este equipo superó su vida útil estimada ({a.vidaUtilAnios} años desde {fmt(a.fechaAdquisicion)}). Evalúa su reemplazo.
        </div>
      )}

      <div class="mt-5 border-t border-slate-200 pt-4">
        <h3 class="font-semibold text-amber-700">SLA del equipo</h3>
        <div class="mt-2 grid grid-cols-4 gap-3 text-sm">
          <div><div class="text-xs uppercase text-slate-500">Urgente</div><div class="font-mono">{a.slaUrgenteHoras} h</div></div>
          <div><div class="text-xs uppercase text-slate-500">Alta</div><div class="font-mono">{a.slaAltaHoras} h</div></div>
          <div><div class="text-xs uppercase text-slate-500">Media</div><div class="font-mono">{a.slaMediaHoras} h</div></div>
          <div><div class="text-xs uppercase text-slate-500">Baja</div><div class="font-mono">{a.slaBajaHoras} h</div></div>
        </div>
      </div>

      {isBio && (
        <div class="mt-5 border-t border-slate-200 pt-4">
          <h3 class="font-semibold text-purple-700">Datos biomédicos</h3>
          <div class="mt-2 grid grid-cols-2 gap-3 text-sm">
            <div class="col-span-2">
              <div class="text-xs uppercase text-slate-500">Registro sanitario</div>
              {a.registroSanitarioNoRequiere ? (
                <div>No requiere registro sanitario</div>
              ) : (
                <div>
                  <span class="font-medium">{a.registroSanitario?.trim() || "Sin número"}</span>
                  <span class={`badge ml-2 text-[10px] ${ESTADO_REGISTRO_COLOR[registroEstado]}`}>{ESTADO_REGISTRO_LABEL[registroEstado]}</span>
                  {(a.registroSanitarioEntidad || a.registroSanitarioEmision || a.registroSanitarioVencimiento) && (
                    <div class="text-xs text-slate-500">
                      {[
                        a.registroSanitarioEntidad,
                        a.registroSanitarioEmision && `emitido ${fmt(a.registroSanitarioEmision)}`,
                        a.registroSanitarioVencimiento && `vence ${fmt(a.registroSanitarioVencimiento)}`,
                      ].filter(Boolean).join(" · ")}
                    </div>
                  )}
                </div>
              )}
            </div>
            <div><div class="text-xs uppercase text-slate-500">Clase de riesgo</div><div>{etiquetaClaseRiesgo(a.claseRiesgo)}</div></div>
            {verBio && (
              <div>
                <div class="text-xs uppercase text-slate-500">Calibración</div>
                <div>
                  {a.estado === "baja"
                    ? <span class={`badge text-[10px] ${ESTADO_ACTIVO_COLOR.baja}`}>Equipo dado de baja</span>
                    : <span class={`badge text-[10px] ${ESTADO_CALIBRACION_COLOR[infoCal.estado]}`}>{ESTADO_CALIBRACION_LABEL[infoCal.estado]}</span>}
                </div>
              </div>
            )}
            {verBio && calMin.length > 0 && <>
              <div><div class="text-xs uppercase text-slate-500">Última calibración</div><div>{fmt(infoCal.ultima)}</div></div>
              <div><div class="text-xs uppercase text-slate-500">Próxima calibración</div><div>{fmt(infoCal.proxima)}{diasCal != null && <span class="text-xs text-slate-500"> · {textoVence(diasCal)}</span>}</div></div>
            </>}
            {verBio && calMin.length === 0 && (a.ultimaCalibracion || a.proximaCalibracion) && <>
              <div><div class="text-xs uppercase text-slate-500">Última calibración</div><div>{fmt(a.ultimaCalibracion)}</div></div>
              <div><div class="text-xs uppercase text-slate-500">Próxima calibración</div><div>{fmt(a.proximaCalibracion)}</div></div>
              <p class="col-span-2 text-xs text-amber-700">Fechas escritas a mano, sin calibración registrada.</p>
            </>}
          </div>
        </div>
      )}
    </div>

    <div class="card p-5">
      <h2 class="font-semibold">Identificación</h2>
      <div class="mt-3">
        <div class="text-xs uppercase text-slate-500">Código interno</div>
        <div class="font-mono text-xs">{a.codigo}</div>
      </div>
      {ESCANEO_ACTIVOS_HABILITADO
        ? <div class="mt-3"><div class="text-xs uppercase text-slate-500">Código de etiqueta</div><div class="font-mono text-xs">{a.qrCode ?? "-"}</div></div>
        : <p class="mt-3 text-xs text-slate-500">Etiqueta GS1 Data Matrix: pendiente. Por ahora el equipo se encuentra por sede y ubicación.</p>}
      <div class="mt-3">
        <div class="text-xs uppercase text-slate-500">Estado</div>
        <div><span class={`badge ${estadoActivoColor}`}>{estadoActivoLabel}</span></div>
      </div>
    </div>

    {contratosActivo.length > 0 && (
      <div class="card p-5">
        <h2 class="font-semibold">Contratos de mantenimiento</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {contratosActivo.map(({ c, prov, colorBadge, labelBadge }) => (
            <li class="border-l-2 border-slate-200 pl-3">
              <a href={`/contratos/${c.id}`} class="text-brand-600 hover:underline font-medium">{c.codigo}</a>
              <div class="text-xs text-slate-600">{c.nombre}</div>
              <div class="text-xs text-slate-500">{prov?.nombre ?? "—"}</div>
              <div class="mt-1">
                <span class={`badge text-[10px] ${colorBadge}`}>{labelBadge}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- ══ Fase 59 · Equipo dado de baja (datos del acta, WP-A) ══════════════════ -->
  {verBio && a.estado === "baja" && (
    <div class="card mt-4 border-l-4 border-slate-500 p-5" id="baja">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <h2 class="font-semibold text-slate-900">Equipo dado de baja</h2>
        <div class="flex flex-wrap gap-2">
          {bajaVigente && (
            <a href={areaHref(`/activos/${a.id}/acta-baja?baja=${bajaVigente.id}`, area)} class="btn-secondary btn-sm">Imprimir acta de baja</a>
          )}
          {gestionaBio && bajaVigente && <a href={areaHref(`/activos/${a.id}/baja`, area)} class="btn-secondary btn-sm">Revertir baja</a>}
        </div>
      </div>
      {bajaVigente ? (
        <div class="mt-3 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
          <div><div class="text-xs uppercase text-slate-500">Fecha de baja</div><div>{fmt(bajaVigente.fechaBaja)} · acta {folioActaBaja(bajaVigente.id)}</div></div>
          <div><div class="text-xs uppercase text-slate-500">Autorizó</div><div>{[bajaVigente.autorizaNombre, bajaVigente.autorizaCargo].filter(Boolean).join(", ")}</div></div>
          <div><div class="text-xs uppercase text-slate-500">Motivo</div><div>{etqMotivoBaja(bajaVigente.motivo)}</div></div>
          <div><div class="text-xs uppercase text-slate-500">Detalle del motivo</div><div class="whitespace-pre-wrap">{bajaVigente.motivoDetalle}</div></div>
          <div class="sm:col-span-2"><div class="text-xs uppercase text-slate-500">Evaluación técnica</div><div class="whitespace-pre-wrap">{bajaVigente.evaluacionTecnica}{bajaVigente.evaluadoPor && <span class="text-xs text-slate-500"> · evaluó {bajaVigente.evaluadoPor}</span>}</div></div>
          <div><div class="text-xs uppercase text-slate-500">Destino final</div><div>{etqDestinoBaja(bajaVigente.destinoFinal)}</div></div>
          <div><div class="text-xs uppercase text-slate-500">Detalle del destino</div><div>{bajaVigente.destinoDetalle || "—"}</div></div>
          <div class="sm:col-span-2 text-xs text-slate-500">Registró {bajaVigente.registradoPorNombre} el {fmt(bajaVigente.createdAt)}.</div>
        </div>
      ) : (
        <p class="mt-2 text-sm text-slate-600">
          Figura como dado de baja, sin acta registrada.
          {gestionaBio && (
            <>
              Para registrar el acta, revierte la baja y vuelve a darlo de baja con sus datos.
              <a href={areaHref(`/activos/${a.id}/baja`, area)} class="ml-1 font-medium text-brand-600 hover:underline">Ir a la baja</a>
            </>
          )}
        </p>
      )}
    </div>
  )}

  <!-- ══ Fase 59 · Resumen de cumplimiento (requisito 9 y JCI FMS.07/08) ═══════ -->
  {verBio && hayResumenJci && (
    <div id="resumen-jci" class="mt-4">
      <h2 class="font-semibold text-slate-900">Resumen de cumplimiento</h2>
      <div class="mt-2 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
        {mostrarCal && (
          <div class="card p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-semibold text-slate-900">Calibración</h3>
              {a.estado === "baja"
                ? <span class={`badge text-[10px] ${ESTADO_ACTIVO_COLOR.baja}`}>Dado de baja</span>
                : <span class={`badge text-[10px] ${ESTADO_CALIBRACION_COLOR[infoCal.estado]}`}>{ESTADO_CALIBRACION_LABEL[infoCal.estado]}</span>}
            </div>
            <div class="mt-2 space-y-1 text-sm text-slate-700">
              {a.calibracionNoAplica && <p>No requiere calibración{a.calibracionNoAplicaMotivo ? `: ${a.calibracionNoAplicaMotivo}` : "."}</p>}
              {!a.calibracionNoAplica && infoCal.proxima && <p>Próxima: {fmt(infoCal.proxima)}{diasCal != null && <span class="text-xs text-slate-500"> · {textoVence(diasCal)}</span>}</p>}
              {ultimaCalRow && <p class="text-xs text-slate-500">Última: {fmt(ultimaCalRow.c.fechaCalibracion)}{(ultimaCalRow.labNombre || ultimaCalRow.c.laboratorioExterno) ? ` · ${ultimaCalRow.labNombre ?? ultimaCalRow.c.laboratorioExterno}` : ""}</p>}
              {!ultimaCalRow && !a.calibracionNoAplica && <p class="text-xs text-slate-500">Sin calibraciones registradas.</p>}
              {infoCal.estado === "no_conforme" && <p class="text-xs font-semibold text-red-700">La última calibración salió no conforme. Revisa el equipo antes de usarlo.</p>}
              {infoCal.estado === "sin_certificado" && <p class="text-xs font-medium text-amber-700">Falta adjuntar el certificado de la última calibración.</p>}
            </div>
            <a href="#calibraciones" class="mt-2 inline-block text-xs font-medium text-brand-600 hover:underline">Ver calibraciones</a>
          </div>
        )}
        {expediente && (
          <div class="card p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-semibold text-slate-900">Expediente técnico</h3>
              <span class:list={["badge text-[10px]", expediente.completo ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700"]}>
                {expediente.completo ? "Completo" : "Incompleto"}
              </span>
            </div>
            <div class="mt-2 space-y-1 text-sm text-slate-700">
              <p>{expediente.cumplidos} de {expediente.total} requisitos</p>
              {lineasExp && lineasExp.faltan.length > 0 && <p class="text-xs text-amber-700">Falta: {lineasExp.faltan.join(", ")}.</p>}
              {lineasExp && lineasExp.vencidos.length > 0 && <p class="text-xs text-red-700">Vencido: {lineasExp.vencidos.join(", ")}.</p>}
              {lineasExp && lineasExp.noAplica.length > 0 && <p class="text-xs text-slate-500">No aplica: {lineasExp.noAplica.join(", ")}.</p>}
            </div>
            <a href="#documentos" class="mt-2 inline-block text-xs font-medium text-brand-600 hover:underline">Ver documentos</a>
          </div>
        )}
        {mostrarSE && (
          <div class="card p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-semibold text-slate-900">Seguridad eléctrica</h3>
              <span class={`badge text-[10px] ${ESTADO_SEG_ELEC_COLOR[estadoSE]}`}>{ESTADO_SEG_ELEC_LABEL[estadoSE]}</span>
            </div>
            <div class="mt-2 space-y-1 text-sm text-slate-700">
              {ultimaSE ? (
                <>
                  <p>
                    {fmt(ultimaSE.fecha)}
