        $("calDelCancel")?.addEventListener("click", cerrarDel);
        modalDel?.addEventListener("click", (e) => { if (e.target === modalDel) cerrarDel(); });
        $("calDelOk")?.addEventListener("click", async () => {
          const err = $("calDelErr");
          const motivo = $("calDelMotivo").value.trim();
          const fallo = (t) => { err.textContent = t; err.classList.remove("hidden"); $("calDelOk").disabled = false; };
          if (motivo.length < 10) return fallo("Escribe el motivo para eliminar la calibración (al menos 10 letras).");
          $("calDelOk").disabled = true;
          try {
            const res = await fetch(`/api/calibraciones/${borrarId}`, {
              method: "DELETE",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ motivo }),
            });
            const j = await res.json().catch(() => ({}));
            if (!res.ok) return fallo(typeof j.error === "string" ? j.error : "No se pudo eliminar la calibración.");
            location.reload();
          } catch {
            fallo("No hay conexión. Intenta de nuevo.");
          }
        });

        // ── Registrar o corregir ──
        const form = $("calForm");
        if (!form) return;
        let modo = { tipo: "nuevo", id: null, original: null };
        let guardado = false;
        const msg = $("c_msg");
        const mostrarMsg = (t) => { msg.textContent = t; msg.className = "mt-2 text-sm text-red-600"; };
        const ocultarMsg = () => { msg.textContent = ""; msg.className = "mt-2 hidden text-sm"; };
        const TEXTOS = ["c_fecha", "c_proxima", "c_labext", "c_cert", "c_patron", "c_incert", "c_realizado", "c_notas", "c_motivo"];

        function avisoLab() {
          const sel = $("c_lab");
          const p = $("c_lab_aviso");
          if (!sel || !p) return;
          const opt = sel.options[sel.selectedIndex];
          let texto = "";
          let ok = false;
          if (sel.value) { texto = (opt && opt.dataset.aviso) || ""; ok = !!opt && opt.dataset.ok === "1"; }
          else if ($("c_labext").value.trim()) texto = "Laboratorio escrito a mano: no se puede comprobar su acreditación.";
          p.textContent = texto;
          p.className = `mt-1 text-xs ${ok ? "text-emerald-700" : "text-amber-700"}${texto ? "" : " hidden"}`;
        }
        $("c_lab")?.addEventListener("change", avisoLab);
        $("c_labext")?.addEventListener("input", avisoLab);

        // Una corrección puede traer un laboratorio inactivo o un patrón que ya no está en la lista.
        function asegurarOpcion(sel, valor, texto) {
          if (!sel || valor === null || valor === undefined || valor === "") return;
          const v = String(valor);
          if (Array.from(sel.options).some((o) => o.value === v)) return;
          const o = document.createElement("option");
          o.value = v;
          o.textContent = texto;
          o.dataset.temporal = "1";
          sel.appendChild(o);
        }
        function limpiar() {
          TEXTOS.forEach((id) => { const el = $(id); if (el) el.value = ""; });
          form.querySelectorAll("option[data-temporal]").forEach((o) => o.remove());
          $("c_lab").value = "";
          $("c_patron_id").value = "";
          $("c_resultado").value = "conforme";
          if ($("c_file")) $("c_file").value = "";
          $("c_avisos").classList.add("hidden");
