---
import { encodeInlineScriptVars } from "@/lib/inline-script-vars";
import Layout from "@/layouts/Layout.astro";
import { ESCANEO_ACTIVOS_HABILITADO } from "@/lib/campo-config";
import { getDb } from "@/lib/db";
import { activos, centrosCosto, planesMantenimiento, sucursales, ubicaciones } from "@/lib/schema";
import { asc, desc, sql, eq } from "drizzle-orm";
import { normalizarCategoria } from "@/lib/categorias-equipos";
import { AREAS, AREA_KEYS, areaHref, parseArea, activoAreaCondition } from "@/lib/areas";
import { rubroDeActivo } from "@/lib/rubros";
import { CRITICIDAD_LABEL, CRITICIDAD_COLOR } from "@/lib/inventario-jci";
import {
  CLASES_RIESGO, ESTADO_ACTIVO_COLOR, ESTADO_ACTIVO_LABEL, ESTADO_REGISTRO_LABEL, hoySV, puedeVerBio,
  type EstadoActivo,
} from "@/lib/biomedico";
import {
  ESTADOS_REGISTRO, FILTRO_ESTADO_LABEL, aFilaInventario, estadoRegistroDeFila, filtrosAQuery, leerFiltrosInventario,
  pasaFiltros, textoBusqueda, type FiltroEstado, type FiltrosInventario,
} from "@/lib/inventario-filtros";
export const prerender = false;

const db = getDb(Astro);
const url = new URL(Astro.request.url);
const area = parseArea(url.searchParams.get("area"));
const filtros = leerFiltrosInventario(url.searchParams, { estadoPorDefecto: "vigentes" });
const vistaParam = url.searchParams.get("vista") === "grupos" ? "grupos" : "tabla";
const hoy = hoySV();

const rows = await db
  .select({ a: activos, ub: ubicaciones, suc: sucursales, cc: { id: centrosCosto.id, codigo: centrosCosto.codigo, nombre: centrosCosto.nombre } })
  .from(activos)
  .leftJoin(ubicaciones, eq(ubicaciones.id, activos.ubicacionId))
  .leftJoin(sucursales, eq(sucursales.id, ubicaciones.sucursalId))
  .leftJoin(centrosCosto, eq(centrosCosto.id, activos.centroCostoId))
  .where(area ? activoAreaCondition(area) : undefined)
  .orderBy(desc(activos.id));

// La búsqueda escrita se aplica en el navegador (en vivo); los demás filtros, aquí.
const todas = rows.map((r) => ({ ...r, fila: aFilaInventario(r) }));
const filtered = todas.filter((r) => pasaFiltros(r.fila, { ...filtros, q: null }, hoy));

const user = Astro.locals.user!;
// Fase 59: el jefe también registra equipos y hace cargas masivas.
const canCreate = user.rol === "admin" || user.rol === "jefe" || user.rol === "tecnico";
const canEdit = user.rol === "admin" || user.rol === "jefe" || user.rol === "tecnico";
const gestiona = user.rol === "admin" || user.rol === "jefe";
const puedeDescargar = puedeVerBio(user.rol);

const planesCount = await db
  .select({ activoId: planesMantenimiento.activoId, n: sql<number>`count(*)` })
  .from(planesMantenimiento)
  .where(sql`${planesMantenimiento.activo} = 1`)
  .groupBy(planesMantenimiento.activoId);
const planesByActivo = new Map(planesCount.map((r) => [r.activoId, Number(r.n)]));

const sucursalesList = await db
  .select({ id: sucursales.id, nombre: sucursales.nombre })
  .from(sucursales)
  .where(eq(sucursales.activa, true))
  .orderBy(sucursales.nombre);

const ubicacionesList = await db
  .select({ id: ubicaciones.id, nombre: ubicaciones.nombre, tipo: ubicaciones.tipo, sucursalId: ubicaciones.sucursalId })
  .from(ubicaciones)
  .where(eq(ubicaciones.activa, true))
  .orderBy(ubicaciones.nombre);
const ubicacionesJson = JSON.stringify(ubicacionesList);

// Centros del filtro: los activos y los que tienen equipos en esta lista.
const centrosConEquipos = new Set(todas.map((r) => r.fila.centroCostoId).filter((id): id is number => id != null));
const centrosList = (await db
  .select({ id: centrosCosto.id, codigo: centrosCosto.codigo, nombre: centrosCosto.nombre, activo: centrosCosto.activo })
  .from(centrosCosto)
  .orderBy(asc(centrosCosto.codigo)))
  .filter((c) => c.activo || centrosConEquipos.has(c.id) || c.id === filtros.centro);

// Conteo por categoría normalizada
const conteoPorCategoria = new Map<string, { tipo: string; n: number }>();
for (const r of rows) {
  const cat = normalizarCategoria(r.a.categoria, r.a.tipo);
  const cur = conteoPorCategoria.get(cat) ?? { tipo: r.a.tipo, n: 0 };
  cur.n++;
  conteoPorCategoria.set(cat, cur);
}
const categoriasOrdenadas = Array.from(conteoPorCategoria.entries())
  .sort((a, b) => b[1].n - a[1].n);

// Vista agrupada
const grupos = new Map<string, typeof filtered>();
for (const r of filtered) {
  const cat = normalizarCategoria(r.a.categoria, r.a.tipo);
  if (!grupos.has(cat)) grupos.set(cat, []);
  grupos.get(cat)!.push(r);
}
const gruposOrdenados = Array.from(grupos.entries()).sort((a, b) => b[1].length - a[1].length);

// Accesos rápidos del inventario biomédico: los números cuentan los equipos vigentes.
const esBioLista = area === "biomedico";
const verClase = !area || area === "biomedico";
const vigentesBio = todas.filter((r) => r.fila.area === "biomedico" && r.fila.estado !== "baja");
const cuenta = (pred: (r: (typeof todas)[number]) => boolean) => vigentesBio.filter(pred).length;
const nSinClase = cuenta((r) => !r.fila.claseRiesgo);
const nSinCentro = cuenta((r) => r.fila.centroCostoId == null);
const nRegVencido = cuenta((r) => estadoRegistroDeFila(r.fila, hoy) === "vencido");
const nSinRegistro = cuenta((r) => estadoRegistroDeFila(r.fila, hoy) === "sin_registro");
const enlaceBio = (extra: Partial<FiltrosInventario>) =>
  `/activos?${filtrosAQuery({ ...leerFiltrosInventario(new URLSearchParams(""), { estadoPorDefecto: "vigentes" }), area: "biomedico", ...extra })}`;
const accesos = esBioLista ? [
  { href: enlaceBio({}), texto: "Biomédicos en servicio" },
  { href: enlaceBio({ clase: "III" }), texto: "Clase III" },
  { href: enlaceBio({ clase: "sin" }), texto: `Sin clase (${nSinClase})`, alerta: nSinClase > 0 },
  { href: enlaceBio({ centro: "sin" }), texto: `Sin centro de costo (${nSinCentro})`, alerta: nSinCentro > 0 },
  { href: enlaceBio({ registro: "vencido" }), texto: `Registro vencido (${nRegVencido})`, alerta: nRegVencido > 0 },
  { href: enlaceBio({ registro: "sin_registro" }), texto: `Sin registro sanitario (${nSinRegistro})`, alerta: nSinRegistro > 0 },
  { href: enlaceBio({ estado: "baja" }), texto: "Dados de baja" },
] : [];
const consultaActual = filtrosAQuery({ ...filtros, q: null });

const conFiltros = filtros.estado !== "vigentes" || filtros.clase || filtros.centro != null || filtros.registro
  || filtros.sucursal != null || filtros.ubicacion != null || filtros.tipo || filtros.categoria || filtros.criticidad;

function urlConVista(v: string) {
  return `?${consultaActual}&vista=${v}`;
}
const estadoLabel = (e: string) => ESTADO_ACTIVO_LABEL[e as EstadoActivo] ?? e;
const estadoColor = (e: string) => ESTADO_ACTIVO_COLOR[e as EstadoActivo] ?? "bg-slate-100 text-slate-600";
const ESTADOS_FILTRO: FiltroEstado[] = ["vigentes", "todos", "operativo", "averiado", "mantenimiento", "baja"];
const columnasTabla = 10 + (verClase ? 1 : 0);
---

<Layout title={area ? `${AREAS[area].inventoryLabel} · ${AREAS[area].label}` : "Inventario"}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-sm font-semibold text-brand-700">{area ? AREAS[area].label : "Todas las áreas"}</p>
      <h1 class="text-2xl font-bold">{area ? AREAS[area].inventoryLabel : "Inventario de activos"}</h1>
      <p class="text-sm text-slate-500">{rows.length} registros · mostrando <span id="visibleCount">{filtered.length}</span></p>
    </div>
    <div class="flex flex-wrap gap-2">
      {gestiona && <a href={areaHref("/activos/clasificar", area)} class="btn-secondary text-sm">Clasificar</a>}
      {gestiona && <a href="/centros-costo" class="btn-secondary text-sm">Centros de costo</a>}
      {ESCANEO_ACTIVOS_HABILITADO && <a href={areaHref("/activos/qr-print", area)} class="btn-secondary text-sm">Imprimir códigos</a>}
      {gestiona && <a href={areaHref("/activos/importar", area)} class="btn-secondary text-sm">Carga masiva</a>}
      {puedeDescargar && <a href={`/api/reportes/equipos?${consultaActual}`} class="btn-secondary text-sm" data-con-busqueda>Descargar CSV</a>}
      {puedeDescargar && <a href={`/activos/imprimir?${consultaActual}`} class="btn-secondary text-sm" data-con-busqueda>Imprimir</a>}
      {canCreate && <a href={areaHref("/activos/nuevo", area)} class="btn-primary">+ {area ? AREAS[area].createLabel : "Registrar activo"}</a>}
    </div>
  </div>
  {puedeDescargar && <p class="mt-1 text-right text-xs text-slate-400">La descarga usa los filtros y la búsqueda.</p>}

  <nav class="mt-4 flex flex-wrap gap-2" aria-label="Inventario por área">
    {AREA_KEYS.map((key) => <a href={areaHref("/activos", key)} aria-current={area === key ? "page" : undefined} class:list={["rounded-lg border px-3 py-2 text-sm", area === key ? "border-brand-600 bg-brand-600 text-white" : "border-slate-200 bg-white text-slate-600 hover:border-brand-400"]}>{AREAS[key].label}</a>)}
  </nav>

  {accesos.length > 0 && (
    <nav class="mt-3 flex flex-wrap gap-2 text-xs" aria-label="Accesos rápidos del inventario biomédico">
      {accesos.map((x) => (
        <a href={x.href} class:list={["rounded-full border px-3 py-1", x.alerta ? "border-red-200 bg-red-50 text-red-700 hover:bg-red-100" : "border-slate-200 bg-white text-slate-600 hover:border-brand-400"]}>{x.texto}</a>
      ))}
    </nav>
  )}

  <!-- Búsqueda en vivo -->
  <div class="mt-4">
    <input
      id="searchBox"
      class="input w-full"
      type="search"
      placeholder="Buscar por código, nombre, marca, modelo, serie, número de activo, ubicación, sucursal o centro de costo..."
    />
  </div>

  <!-- Filtros -->
  <div class="card mt-3 p-3">
    <form id="filterForm" class="flex flex-wrap items-end gap-3" method="get">
      {area && <input type="hidden" name="area" value={area} />}
      <input type="hidden" name="vista" value={vistaParam} />
      <div>
        <label class="label text-xs" for="fEstado">Estado</label>
        <select name="estado" id="fEstado" class="input text-sm">
          {ESTADOS_FILTRO.map((e) => <option value={e} selected={filtros.estado === e}>{FILTRO_ESTADO_LABEL[e]}</option>)}
        </select>
      </div>
      {verClase && (
        <div>
          <label class="label text-xs" for="fClase">Clase de riesgo</label>
          <select name="clase" id="fClase" class="input text-sm">
            <option value="">Todas</option>
            {CLASES_RIESGO.map((c) => <option value={c.valor} selected={filtros.clase === c.valor}>{c.etiqueta}</option>)}
            <option value="sin" selected={filtros.clase === "sin"}>Sin clase</option>
          </select>
        </div>
      )}
      <div>
        <label class="label text-xs" for="fCentro">Centro de costo</label>
        <select name="centro" id="fCentro" class="input text-sm">
          <option value="">Todos</option>
          <option value="sin" selected={filtros.centro === "sin"}>Sin centro de costo</option>
          {centrosList.map((c) => <option value={c.id} selected={filtros.centro === c.id}>{c.codigo} · {c.nombre}{c.activo ? "" : " (desactivado)"}</option>)}
        </select>
      </div>
      {esBioLista && (
        <div>
          <label class="label text-xs" for="fRegistro">Registro sanitario</label>
          <select name="registro" id="fRegistro" class="input text-sm">
            <option value="">Todos</option>
            {ESTADOS_REGISTRO.map((r) => <option value={r} selected={filtros.registro === r}>{ESTADO_REGISTRO_LABEL[r]}</option>)}
          </select>
        </div>
      )}
      <div>
        <label class="label text-xs" for="sucursalSel">Sucursal</label>
        <select name="sucursal" id="sucursalSel" class="input text-sm">
          <option value="">Todas</option>
          {sucursalesList.map((s) => <option value={s.id} selected={s.id === filtros.sucursal}>{s.nombre}</option>)}
        </select>
      </div>
      <div>
        <label class="label text-xs" for="ubicacionSel">Ubicación</label>
        <select name="ubicacion" id="ubicacionSel" class="input text-sm" disabled={filtros.sucursal == null}>
          <option value="">{filtros.sucursal != null ? "Todas las de la sucursal" : "Selecciona una sucursal primero"}</option>
        </select>
      </div>
      <div>
        <label class="label text-xs" for="criticidad">Criticidad</label>
        <select name="criticidad" id="criticidad" class="input text-sm">
          <option value="">Todas</option>
          {(["alta", "media", "baja"] as const).map((key) => <option value={key} selected={filtros.criticidad === key}>{CRITICIDAD_LABEL[key]}</option>)}
        </select>
      </div>
      <div>
        <label class="label text-xs" for="fCategoria">Categoría</label>
        <select name="categoria" id="fCategoria" class="input text-sm">
          <option value="">Todas</option>
          {categoriasOrdenadas.map(([cat, info]) => (
            <option value={cat} selected={cat === filtros.categoria}>{cat} ({info.n})</option>
          ))}
        </select>
      </div>
      {filtros.tipo && <input type="hidden" name="tipo" value={filtros.tipo} />}
      <button class="btn-primary text-sm">Filtrar</button>
      {conFiltros && <a href={areaHref(`/activos?vista=${vistaParam}`, area)} class="btn-secondary text-sm">Limpiar</a>}
      <div class="ml-auto flex gap-1 text-xs">
        <a href={urlConVista("tabla")} class:list={["rounded px-3 py-1.5", vistaParam === "tabla" ? "bg-brand-600 text-white" : "bg-slate-100 text-slate-700"]}>Tabla</a>
        <a href={urlConVista("grupos")} class:list={["rounded px-3 py-1.5", vistaParam === "grupos" ? "bg-brand-600 text-white" : "bg-slate-100 text-slate-700"]}>Por categoría</a>
      </div>
    </form>
  </div>

  {vistaParam === "grupos" ? (
    <div class="mt-4 space-y-4" id="resultsContainer">
      {gruposOrdenados.length === 0 && (
        <div class="card p-6 text-center text-slate-400">No hay registros en esta área con esos filtros.</div>
      )}
      {gruposOrdenados.map(([categoria, items]) => (
        <div class="card overflow-x-auto grupo-card" data-search={`${categoria}`.toLowerCase()}>
          <div class="flex items-center justify-between bg-slate-50 px-4 py-2.5">
            <h3 class="font-semibold text-slate-700">
              {categoria}
            </h3>
            <span class="text-xs font-medium text-slate-500"><span class="grupo-count">{items.length}</span> registros</span>
          </div>
          <table class="w-full text-left text-sm">
            <thead class="bg-white text-xs uppercase text-slate-500">
              <tr class="border-t border-slate-100">
                <th class="px-4 py-1.5">Código</th>
                <th class="px-4 py-1.5">Nombre</th>
                <th class="px-4 py-1.5">Marca / Modelo</th>
                <th class="px-4 py-1.5">Sucursal</th>
                <th class="px-4 py-1.5">Ubicación</th>
                <th class="px-4 py-1.5">Centro de costo</th>
                <th class="px-4 py-1.5">Criticidad</th>
                <th class="px-4 py-1.5">Estado</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {items.map((r) => (
                <tr class="hover:bg-slate-50 row-search" data-search={textoBusqueda(r.fila)}>
                  <td class="px-4 py-1.5 font-mono text-xs">{r.a.codigo}{r.a.numeroActivo && <div class="text-[10px] text-slate-400">{r.a.numeroActivo}</div>}</td>
                  <td class="px-4 py-1.5">
                    <a href={areaHref(`/activos/${r.a.id}`, rubroDeActivo(r.a.rubro, r.a.tipo))} class="font-medium text-brand-700 hover:underline">{r.a.nombre}</a>
                    {r.a.serial && <div class="text-[11px] text-slate-400">Serie {r.a.serial}</div>}
                  </td>
                  <td class="px-4 py-1.5 text-xs text-slate-600">{[r.a.marca, r.a.modelo].filter(Boolean).join(" / ") || "-"}</td>
                  <td class="px-4 py-1.5 text-xs text-slate-600">{r.suc?.nombre ?? "-"}</td>
                  <td class="px-4 py-1.5 text-xs text-slate-600">{r.ub?.nombre ?? r.a.ubicacion ?? "-"}</td>
                  <td class="px-4 py-1.5 text-xs text-slate-600">{r.cc ? <span title={r.cc.nombre}>{r.cc.codigo}</span> : "—"}</td>
                  <td class="px-4 py-1.5"><span class={`badge ${CRITICIDAD_COLOR[r.a.criticidadOperacional ?? "media"]}`}>{CRITICIDAD_LABEL[r.a.criticidadOperacional ?? "media"]}</span></td>
                  <td class="px-4 py-1.5"><span class={`badge ${estadoColor(r.a.estado)}`}>{estadoLabel(r.a.estado)}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </div>
  ) : (
    <div class="card mt-4 overflow-x-auto" id="resultsContainer">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase text-slate-500">
          <tr>
            <th class="px-4 py-2">Código</th>
            <th class="px-4 py-2">Nombre</th>
            <th class="px-4 py-2">Área / Categoría</th>
            <th class="px-4 py-2">Marca / Modelo</th>
            <th class="px-4 py-2">Sucursal</th>
            <th class="px-4 py-2">Ubicación</th>
            <th class="px-4 py-2">Centro de costo</th>
            {verClase && <th class="px-4 py-2">Clase</th>}
            <th class="px-4 py-2">Criticidad</th>
            <th class="px-4 py-2">Estado</th>
            <th class="px-4 py-2">Cronograma</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100" id="tableBody">
          {filtered.length === 0 && (
            <tr><td colspan={columnasTabla} class="px-4 py-6 text-center text-slate-500">No hay registros en esta área con esos filtros.</td></tr>
          )}
          {filtered.map((r) => (
            <tr class="hover:bg-slate-50 row-search" data-search={textoBusqueda(r.fila)}>
              <td class="px-4 py-2 font-mono text-xs">{r.a.codigo}{r.a.numeroActivo && <div class="text-[10px] text-slate-400">{r.a.numeroActivo}</div>}</td>
              <td class="px-4 py-2">
                <a href={areaHref(`/activos/${r.a.id}`, rubroDeActivo(r.a.rubro, r.a.tipo))} class="font-medium text-brand-700 hover:underline">{r.a.nombre}</a>
                {r.a.serial && <div class="text-[11px] text-slate-400">Serie {r.a.serial}</div>}
              </td>
              <td class="px-4 py-2 text-xs">
                <span class="badge bg-brand-50 text-brand-700">{AREAS[rubroDeActivo(r.a.rubro, r.a.tipo)].label}</span>
                {r.a.categoria && <div class="mt-0.5 text-slate-500">{normalizarCategoria(r.a.categoria, r.a.tipo)}</div>}
              </td>
              <td class="px-4 py-2 text-xs text-slate-600">{[r.a.marca, r.a.modelo].filter(Boolean).join(" / ") || "-"}</td>
              <td class="px-4 py-2 text-xs text-slate-600">{r.suc?.nombre ?? "-"}</td>
              <td class="px-4 py-2 text-xs text-slate-600">{r.ub?.nombre ?? r.a.ubicacion ?? "-"}</td>
              <td class="px-4 py-2 text-xs text-slate-600">{r.cc ? <span title={r.cc.nombre}>{r.cc.codigo}</span> : "—"}</td>
              {verClase && (
                <td class="px-4 py-2 text-xs">
                  {r.fila.area !== "biomedico" ? <span class="text-slate-300">—</span>
                    : r.a.claseRiesgo ? <span class="badge bg-slate-100 text-slate-700">{r.a.claseRiesgo}</span>
                    : <span class="badge bg-red-100 text-red-700">Sin clase</span>}
                </td>
              )}
              <td class="px-4 py-2"><span class={`badge ${CRITICIDAD_COLOR[r.a.criticidadOperacional ?? "media"]}`}>{CRITICIDAD_LABEL[r.a.criticidadOperacional ?? "media"]}</span></td>
              <td class="px-4 py-2"><span class={`badge ${estadoColor(r.a.estado)}`}>{estadoLabel(r.a.estado)}</span></td>
              <td class="px-4 py-2">
                {planesByActivo.get(r.a.id) ? (
                  <a href={areaHref(`/activos/${r.a.id}#planes`, rubroDeActivo(r.a.rubro, r.a.tipo))} class="badge bg-blue-100 text-blue-700 hover:bg-blue-200">{planesByActivo.get(r.a.id)} plan(es)</a>
                ) : r.a.estado === "baja" ? (
                  <span class="text-xs text-slate-400">—</span>
                ) : canEdit ? (
                  <button type="button" class="prog-btn text-xs font-medium text-brand-700 hover:underline" data-activo-id={r.a.id} data-activo-label={`${r.a.codigo} · ${r.a.nombre}`} data-activo-lugar={[r.suc?.nombre, r.ub?.nombre ?? r.a.ubicacion].filter(Boolean).join(" · ")}>+ Programar</button>
                ) : (
                  <span class="text-xs text-slate-400">sin cronograma</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {canEdit && (
    <div id="programarModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 p-4">
      <div class="card w-full max-w-md p-5">
        <h3 class="text-lg font-semibold text-slate-900">Programar mantenimiento preventivo</h3>
        <p id="progSubtitle" class="mt-0.5 text-sm font-medium text-slate-700"></p>
        <p id="progLugar" class="text-xs text-slate-500"></p>
        <div class="mt-4 grid gap-3">
          <div>
            <label class="label text-xs">Próxima fecha</label>
            <input id="progFecha" type="date" class="input w-full" required />
          </div>
          <div>
            <label class="label text-xs">Frecuencia</label>
            <select id="progFreq" class="input w-full">
              <option value="diaria">Diaria</option>
              <option value="semanal">Semanal</option>
              <option value="quincenal">Quincenal</option>
              <option value="mensual" selected>Mensual</option>
              <option value="bimestral">Bimestral</option>
              <option value="trimestral">Trimestral</option>
              <option value="semestral">Semestral</option>
              <option value="anual">Anual</option>
            </select>
            <p class="mt-1 text-xs text-slate-400">Tras cerrar la OT, el cron calcula la siguiente fecha con esta frecuencia.</p>
          </div>
          <p id="progMsg" class="hidden text-sm"></p>
        </div>
        <div class="mt-5 flex justify-end gap-2">
          <button id="progCancel" type="button" class="btn-secondary">Cancelar</button>
          <button id="progSave" type="button" class="btn-primary">Guardar</button>
        </div>
      </div>
    </div>
  )}

  <script>
    import { hoySV, sumarDias } from "@/lib/biomedico";
    const progModal = document.getElementById("programarModal");
    if (progModal) {
      const progFecha = document.getElementById("progFecha") as HTMLInputElement;
      const progFreq = document.getElementById("progFreq") as HTMLSelectElement;
      const progMsg = document.getElementById("progMsg") as HTMLElement;
      const progSubtitle = document.getElementById("progSubtitle") as HTMLElement;
      const progLugar = document.getElementById("progLugar") as HTMLElement;
      const progSave = document.getElementById("progSave") as HTMLButtonElement;
      const progCancel = document.getElementById("progCancel");
      let progActivoId: number | null = null;

      const showMsg = (txt: string, ok = false) => {
        progMsg.textContent = txt;
        progMsg.className = `text-sm ${ok ? "text-emerald-600" : "text-red-600"}`;
        progMsg.classList.remove("hidden");
      };
      const closeModal = () => {
        progModal.classList.add("hidden");
        progModal.classList.remove("flex");
        progActivoId = null;
      };

      document.querySelectorAll<HTMLButtonElement>(".prog-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          progActivoId = Number(btn.dataset.activoId);
          progSubtitle.textContent = btn.dataset.activoLabel ?? "";
          const lugar = btn.dataset.activoLugar ?? "";
          progLugar.textContent = lugar || "Sin sede / ubicación asignada";
          progLugar.classList.toggle("italic", !lugar);
          // Por defecto: dentro de 30 días (mensual), contando desde hoy en El Salvador.
          const hoy = hoySV();
          progFecha.value = sumarDias(hoy, 30);
          progFecha.min = hoy;
          progFreq.value = "mensual";
          progMsg.classList.add("hidden");
          progModal.classList.remove("hidden");
          progModal.classList.add("flex");
          progFecha.focus();
        });
      });

      progCancel?.addEventListener("click", closeModal);
      progModal.addEventListener("click", (e) => { if (e.target === progModal) closeModal(); });

      progSave?.addEventListener("click", async () => {
        if (!progActivoId) return;
        const fecha = progFecha.value;
        if (!fecha) { showMsg("Selecciona la próxima fecha."); return; }
        progSave.disabled = true;
        const r = await fetch(`/api/activos/${progActivoId}/planes`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ titulo: "Mantenimiento preventivo", frecuencia: progFreq.value, proximaFecha: fecha }),
        });
        if (r.ok) { showMsg("Programado.", true); location.reload(); return; }
        progSave.disabled = false;
        const j = await r.json().catch(() => ({}));
        const err = typeof j?.error === "string" ? j.error : (j?.error?.formErrors?.[0] ?? "No se pudo guardar el plan");
        showMsg(err);
      });
    }
  </script>

  <script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({ ubicacionesJson, sucursalActualId: filtros.sucursal, ubicacionActualId: filtros.ubicacion, qInicial: filtros.q ?? "" }) }}>
    const { ubicacionesJson, sucursalActualId, ubicacionActualId, qInicial } = JSON.parse(decodeURIComponent(__encodedScriptVars));
    // ── Filtro ubicación dependiente de sucursal ─────────────────────────────
    const ubs = JSON.parse(ubicacionesJson);
    const sucEl = document.getElementById("sucursalSel");
    const ubEl = document.getElementById("ubicacionSel");

    function poblarUbicaciones(sucId, seleccionarId) {
      ubEl.innerHTML = "";
      if (!sucId) {
        const o = document.createElement("option");
        o.value = ""; o.textContent = "Selecciona una sucursal primero";
        ubEl.appendChild(o);
        ubEl.disabled = true;
        return;
      }
      ubEl.disabled = false;
      const todasOpt = document.createElement("option");
      todasOpt.value = ""; todasOpt.textContent = "Todas las de la sucursal";
      ubEl.appendChild(todasOpt);
      const filtradas = ubs.filter((u) => u.sucursalId === sucId);
      filtradas.forEach((u) => {
        const o = document.createElement("option");
        o.value = u.id;
        o.textContent = `${u.nombre} (${u.tipo})`;
        if (u.id === seleccionarId) o.selected = true;
        ubEl.appendChild(o);
      });
    }

    if (sucursalActualId) poblarUbicaciones(sucursalActualId, ubicacionActualId);

    sucEl?.addEventListener("change", () => {
      const sid = Number(sucEl.value) || null;
      poblarUbicaciones(sid, null);
    });

    // ── Búsqueda en vivo (minúsculas y sin tildes, como el servidor) ─────────
    const searchBox = document.getElementById("searchBox");
    const visibleCount = document.getElementById("visibleCount");
    const normalizar = (s) => String(s ?? "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().replace(/\s+/g, " ").trim();

    function aplicarBusqueda() {
      const q = normalizar(searchBox.value);
      let visibles = 0;
      document.querySelectorAll(".row-search").forEach((tr) => {
        const txt = tr.dataset.search ?? "";
        const match = !q || txt.includes(q);
        tr.style.display = match ? "" : "none";
        if (match) visibles++;
      });
      // En vista grupos, oculta cards con 0 filas visibles
      document.querySelectorAll(".grupo-card").forEach((card) => {
        const filasVisibles = Array.from(card.querySelectorAll(".row-search")).filter((tr) => tr.style.display !== "none").length;
        const countEl = card.querySelector(".grupo-count");
        if (countEl) countEl.textContent = filasVisibles;
        card.style.display = filasVisibles > 0 || !q ? "" : "none";
      });
      if (visibleCount) visibleCount.textContent = visibles;
    }

    searchBox?.addEventListener("input", aplicarBusqueda);
    if (searchBox && qInicial) { searchBox.value = qInicial; aplicarBusqueda(); }

    // «Descargar CSV» e «Imprimir» llevan también lo escrito en el buscador.
    document.querySelectorAll("[data-con-busqueda]").forEach((a) => {
      a.addEventListener("click", () => {
        const destino = new URL(a.getAttribute("href"), location.origin);
        const q = (searchBox?.value ?? "").trim();
        if (q) destino.searchParams.set("q", q); else destino.searchParams.delete("q");
        a.setAttribute("href", destino.pathname + destino.search);
      });
    });
  </script>
</Layout>
