---
// Historial del equipo (requisito 9): indicadores de toda su vida y la línea de tiempo
// de todo lo que le pasó, con filtro de período, impresión y CSV. Los eventos salen
// del cargador único (src/lib/historial-equipo-db.ts), el mismo del CSV y de la hoja de vida.
import Layout from "@/layouts/Layout.astro";
import ActivoConjuntos from "@/components/ActivoConjuntos.astro";
import DocCabecera from "@/components/DocCabecera.astro";
import DocFolio from "@/components/DocFolio.astro";
import { getConjuntosDelActivo } from "@/lib/conjuntos";
import { getDb } from "@/lib/db";
import { activos, ordenes, usuarios, encuestasSatisfaccion } from "@/lib/schema";
import { eq, and, isNotNull } from "drizzle-orm";
import { AREAS, areaHref, parseArea } from "@/lib/areas";
import { rubroDeActivo } from "@/lib/rubros";
import { diaSV, fechaCorta, horaSV, hoySV, puedeVerBio } from "@/lib/biomedico";
import {
  TIPO_EVENTO_LABEL, claveTiempo, colorEvento, construirEventos, enPeriodo, enlaceEvento, enlaceIncidentes, ordenarEventos,
  periodoValido, textoIncidente, textoPeriodo,
} from "@/lib/historial-equipo";
import { cargarHistorialEquipo } from "@/lib/historial-equipo-db";
export const prerender = false;

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect(areaHref("/activos", parseArea(Astro.url.searchParams.get("area"))));

const db = getDb(Astro);
const [a] = await db
  .select({ id: activos.id, codigo: activos.codigo, nombre: activos.nombre, tipo: activos.tipo, rubro: activos.rubro })
  .from(activos).where(eq(activos.id, id)).limit(1);
if (!a) return Astro.redirect(areaHref("/activos", parseArea(Astro.url.searchParams.get("area"))));
const user = Astro.locals.user!;
if (!puedeVerBio(user.rol)) return Astro.redirect("/");
const area = rubroDeActivo(a.rubro, a.tipo);
if (parseArea(Astro.url.searchParams.get("area")) !== area) return Astro.redirect(areaHref(Astro.url.pathname + Astro.url.search, area));
const conjuntosHistorial = await getConjuntosDelActivo(Astro, id);

// Período (opcional): solo filtra la línea de tiempo. Los indicadores son de toda la vida del equipo.
const desdeTxt = Astro.url.searchParams.get("desde") ?? "";
const hastaTxt = Astro.url.searchParams.get("hasta") ?? "";
const periodo = periodoValido(desdeTxt, hastaTxt);
const { desde, hasta } = periodo;
const periodoTxt = textoPeriodo(desde, hasta);

const historial = await cargarHistorialEquipo(db, id);
const ots = historial.ots;

// ─── Indicadores (toda la vida del equipo) ───────────────────────────────────
const totalOts = ots.length;
const totalCorrectivos = ots.filter((o) => o.tipo === "correctivo").length;
const totalPreventivos = ots.filter((o) => o.tipo === "preventivo").length;

// Costo: horas por la tarifa de quien la tenía asignada, más repuestos.
const tarifas = await db.select({ id: usuarios.id, t: usuarios.tarifaHora }).from(usuarios);
const tarifaUserMap = new Map(tarifas.map((u) => [u.id, Number(u.t)]));
let costoMOTotal = 0;
let costoRepTotal = 0;
const costoPorOt = new Map<number, { mo: number; rep: number }>();
for (const o of ots) {
  const tarifa = o.asignadoId ? tarifaUserMap.get(o.asignadoId) ?? 0 : 0;
  const mo = Number(o.horasTrabajadas ?? 0) * tarifa;
  costoMOTotal += mo;
  costoPorOt.set(o.id, { mo, rep: 0 });
}
for (const r of historial.repuestos) {
  const sub = r.cantidad * Number(r.precioUnitario ?? 0);
  costoRepTotal += sub;
  const cur = costoPorOt.get(r.ordenId) ?? { mo: 0, rep: 0 };
  cur.rep += sub;
  costoPorOt.set(r.ordenId, cur);
}
const costoTotal = costoMOTotal + costoRepTotal;

// Tiempo medio entre fallas correctivas (MTBF)
const correctivosConFecha = ots
  .filter((o) => o.tipo === "correctivo")
  .map((o) => claveTiempo(o.createdAt))
  .filter((ms) => ms > 0)
  .sort((x, y) => x - y);
let mtbfDias: number | null = null;
if (correctivosConFecha.length >= 2) {
  const diffs: number[] = [];
  for (let i = 1; i < correctivosConFecha.length; i++) diffs.push((correctivosConFecha[i] - correctivosConFecha[i - 1]) / 86400_000);
  mtbfDias = diffs.reduce((s, x) => s + x, 0) / diffs.length;
}

// Repuestos más usados
const repuestosCount = new Map<string, { codigo: string | null; nombre: string | null; cantidad: number; subtotal: number }>();
for (const r of historial.repuestos) {
  const key = `${r.codigo ?? ""}|${r.nombre ?? ""}`;
  const cur = repuestosCount.get(key) ?? { codigo: r.codigo, nombre: r.nombre, cantidad: 0, subtotal: 0 };
  cur.cantidad += r.cantidad;
  cur.subtotal += r.cantidad * Number(r.precioUnitario ?? 0);
  repuestosCount.set(key, cur);
}
const topRepuestos = Array.from(repuestosCount.values()).sort((x, y) => y.cantidad - x.cantidad).slice(0, 10);

// Encuestas de satisfacción de las órdenes de este equipo (por JOIN, sin listas de ids).
const sats = await db
  .select({ calificacion: encuestasSatisfaccion.calificacion })
  .from(encuestasSatisfaccion)
  .innerJoin(ordenes, eq(ordenes.id, encuestasSatisfaccion.ordenId))
  .where(and(eq(ordenes.activoId, id), isNotNull(encuestasSatisfaccion.respondidaEn)));
const satAvg = sats.length > 0 ? sats.reduce((s, r) => s + (r.calificacion ?? 0), 0) / sats.length : null;

// Costo por mes (últimos 12 meses, por el día de El Salvador en que se creó la orden)
const MESES_CORTOS = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
const hoy = hoySV();
const mesesHoy = Number(hoy.slice(0, 4)) * 12 + Number(hoy.slice(5, 7)) - 1;
type CostoMes = { mes: string; mo: number; rep: number; total: number; ots: number };
const costoMes: CostoMes[] = [];
for (let i = 11; i >= 0; i--) {
  const total = mesesHoy - i;
  const anio = Math.floor(total / 12);
  const mes = (total % 12) + 1;
  const clave = `${anio}-${String(mes).padStart(2, "0")}`;
  let mo = 0, rep = 0, count = 0;
  for (const o of ots) {
    if ((diaSV(o.createdAt) ?? "").slice(0, 7) !== clave) continue;
    const c = costoPorOt.get(o.id) ?? { mo: 0, rep: 0 };
    mo += c.mo; rep += c.rep; count++;
  }
  costoMes.push({ mes: `${MESES_CORTOS[mes - 1]} ${String(anio).slice(2)}`, mo, rep, total: mo + rep, ots: count });
}
const maxCosto = Math.max(1, ...costoMes.map((m) => m.total));

// ─── Línea de tiempo ─────────────────────────────────────────────────────────
// Las páginas del equipo y de las órdenes llevan el área; los archivos (/api/) y las páginas de otros módulos, no.
const hrefEvento = (link: string) => (/^\/(ordenes|activos)\//.test(link) ? areaHref(link, area) : link);
// Sin enlace a una página que este rol no abre (Incidentes no es del técnico, K-G2).
const hrefIncidentes = enlaceIncidentes(a.id, user.rol);
// Pantalla: fechas DD/MM/AAAA, también en los valores de la bitácora (el CSV las deja en AAAA-MM-DD).
const eventos = ordenarEventos(construirEventos(historial, { hoy }))
  .filter((e) => enPeriodo(e.fecha, desde, hasta))
  .map((e) => {
    const link = enlaceEvento(e.link, user.rol);
    return { ...e, href: link ? hrefEvento(link) : null };
  });

const filtros = new URLSearchParams();
if (desde) filtros.set("desde", desde);
if (hasta) filtros.set("hasta", hasta);
const qsFiltros = filtros.toString();
const csvHref = `/api/activos/${a.id}/historial${qsFiltros ? `?${qsFiltros}` : ""}`;
---

<Layout title={`Historial · ${a.codigo}`}>
  <div class="no-print">
    <ActivoConjuntos relaciones={conjuntosHistorial} />
    <a href={areaHref(`/activos/${a.id}`, area)} class="text-sm text-slate-500 hover:underline">← Volver al equipo</a>
    <div class="mt-2 flex flex-wrap items-start justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold">Historial: {a.codigo}</h1>
        <p class="text-sm text-slate-500">{a.nombre} · {AREAS[area].label}</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href={areaHref(`/activos/${a.id}/hoja-vida${qsFiltros ? `?${qsFiltros}` : ""}`, area)} class="btn-secondary">Hoja de vida</a>
        <button type="button" onclick="window.print()" class="btn-secondary">Imprimir</button>
        <a href={csvHref} class="btn-primary" download>Descargar CSV</a>
      </div>
    </div>

    <form method="get" class="card mt-4 flex flex-wrap items-end gap-3 p-4">
      <input type="hidden" name="area" value={area} />
      <div>
        <label class="label text-xs" for="f_desde">Desde</label>
        <input id="f_desde" name="desde" type="date" class="input" value={desde ?? desdeTxt} />
      </div>
      <div>
        <label class="label text-xs" for="f_hasta">Hasta</label>
        <input id="f_hasta" name="hasta" type="date" class="input" value={hasta ?? hastaTxt} />
      </div>
      <button type="submit" class="btn-primary">Aplicar</button>
      {(desdeTxt || hastaTxt) && <a href={areaHref(`/activos/${a.id}/historial`, area)} class="btn-secondary">Quitar filtro</a>}
      <p class="w-full text-xs text-slate-500">
        El período filtra la línea de tiempo y el CSV. Los indicadores y los costos son de toda la vida del equipo.
      </p>
      {periodo.error && <p class="w-full text-sm font-medium text-red-600">{periodo.error} No se aplicó el filtro.</p>}
    </form>
  </div>

  <DocCabecera soloImpresion titulo="Historial del equipo" subtitulo={`${a.codigo} · ${a.nombre}${periodoTxt ? ` · Período ${periodoTxt}` : ""}`} codigo={a.codigo} fecha={hoy} />

  <!-- KPIs del equipo -->
  <div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-6">
    <div class="card p-4">
      <div class="text-xs uppercase text-slate-500">Total OTs</div>
      <div class="mt-1 text-2xl font-bold text-slate-700">{totalOts}</div>
      <div class="text-[10px] text-slate-500">Desde el registro del equipo</div>
    </div>
    <div class="card p-4">
      <div class="text-xs uppercase text-slate-500">Correctivos</div>
      <div class="mt-1 text-2xl font-bold text-red-600">{totalCorrectivos}</div>
    </div>
    <div class="card p-4">
      <div class="text-xs uppercase text-slate-500">Preventivos</div>
      <div class="mt-1 text-2xl font-bold text-emerald-600">{totalPreventivos}</div>
    </div>
    <div class="card p-4">
      <div class="text-xs uppercase text-slate-500">MTBF</div>
      <div class="mt-1 text-2xl font-bold text-purple-600">{mtbfDias != null ? `${mtbfDias.toFixed(0)}d` : "—"}</div>
      <div class="text-[10px] text-slate-500">Entre correctivos</div>
    </div>
    <div class="card p-4">
      <div class="text-xs uppercase text-slate-500">Costo total</div>
      <div class="mt-1 text-2xl font-bold text-slate-700">${costoTotal.toFixed(0)}</div>
      <div class="text-[10px] text-slate-500">MO ${costoMOTotal.toFixed(0)} · Rep ${costoRepTotal.toFixed(0)}</div>
    </div>
    <div class="card p-4">
      <div class="text-xs uppercase text-slate-500">Satisfacción</div>
      {satAvg != null ? (
        <>
          <div class="mt-1 text-2xl font-bold text-violet-600">{satAvg.toFixed(1)}<span class="text-sm text-slate-400">/5</span></div>
          <div class="text-[10px] text-slate-500">{sats.length} respuestas</div>
        </>
      ) : (
        <>
          <div class="mt-1 text-2xl font-bold text-slate-300">—</div>
          <div class="text-[10px] text-slate-500">Sin encuestas</div>
        </>
      )}
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
    <!-- Costo mensual -->
    <div class="card lg:col-span-2 p-5">
      <h2 class="font-semibold text-slate-900">Costo de mantenimiento (12 meses)</h2>
      <div class="mt-4 flex items-end gap-1.5 overflow-x-auto pb-2" style="height:160px">
        {costoMes.map((m) => {
          const hMo = (m.mo / maxCosto) * 130;
          const hRep = (m.rep / maxCosto) * 130;
          return (
            <div class="flex min-w-[40px] flex-1 flex-col items-center gap-1">
              <div class="flex flex-1 flex-col-reverse gap-0 w-5">
                <div class="w-full rounded-b bg-amber-400" style={`height:${hRep}px`} title={`Repuestos $${m.rep.toFixed(0)}`}></div>
                <div class="w-full rounded-t bg-blue-500" style={`height:${hMo}px`} title={`Mano obra $${m.mo.toFixed(0)}`}></div>
              </div>
              <div class="text-[9px] text-slate-500 capitalize whitespace-nowrap">{m.mes}</div>
              <div class="text-[9px] text-slate-700 font-mono">${m.total.toFixed(0)}</div>
            </div>
          );
        })}
      </div>
      <div class="mt-2 flex gap-4 text-xs text-slate-600">
        <span><span class="inline-block h-3 w-3 rounded bg-blue-500"></span> Mano de obra</span>
        <span><span class="inline-block h-3 w-3 rounded bg-amber-400"></span> Repuestos</span>
      </div>
    </div>

    <!-- Top repuestos -->
    <div class="card p-5">
      <h2 class="font-semibold text-slate-900">Top repuestos usados</h2>
      <ul class="mt-3 divide-y divide-slate-100 text-sm">
        {topRepuestos.length === 0 && <li class="py-2 text-slate-400">Sin repuestos consumidos.</li>}
        {topRepuestos.map((r) => (
          <li class="flex items-center justify-between py-2">
            <div class="min-w-0 flex-1">
              <div class="truncate font-medium">{[r.codigo, r.nombre].filter(Boolean).join(" · ")}</div>
              <div class="text-xs text-slate-500">{r.cantidad} usados · ${r.subtotal.toFixed(2)}</div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Línea de tiempo -->
  <div class="mt-6">
    <h2 class="font-semibold text-slate-900 mb-3">
      Línea de tiempo ({eventos.length} {eventos.length === 1 ? "evento" : "eventos"}){periodoTxt && <span class="font-normal text-slate-500"> · {periodoTxt}</span>}
    </h2>
    {eventos.length === 0 && (
      <div class="card p-6 text-center text-slate-400">
        {periodoTxt ? "Sin actividad registrada en este período." : "Sin actividad registrada en este equipo."}
      </div>
    )}
    <ul class="space-y-3">
      {eventos.map((e) => (
        <li class:list={["ml-1 border-l-4 pl-3", colorEvento(e)]}>
          <div class="card p-3">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0 flex-1">
                <div class="text-[10px] font-semibold uppercase tracking-wide text-slate-500">{TIPO_EVENTO_LABEL[e.tipo]}</div>
                {e.href ? (
                  <a
                    href={e.href}
                    target={e.href.startsWith("/api/") ? "_blank" : undefined}
                    class:list={["font-semibold text-brand-700 hover:underline", { "line-through": e.anulado }]}
                  >{e.titulo}</a>
                ) : (
                  <span class:list={["font-semibold", { "line-through": e.anulado }]}>{e.titulo}</span>
                )}
                {e.detalle && <p class="mt-1 text-sm text-slate-700 whitespace-pre-wrap">{e.detalle}</p>}
                {(e.responsable || e.resultado || e.orden) && (
                  <div class="mt-1 text-xs text-slate-500">
                    {[e.responsable, e.resultado, e.tipo === "comentario" || e.tipo === "repuesto" ? e.orden : null].filter(Boolean).join(" · ")}
                  </div>
                )}
                {e.incidente && e.tipo !== "incidente" && (hrefIncidentes
                  ? <a href={hrefIncidentes} class="mt-1 inline-block text-xs font-semibold text-red-700 hover:underline">{textoIncidente(e.incidente)}</a>
                  : <span class="mt-1 inline-block text-xs font-semibold text-red-700">{textoIncidente(e.incidente)}</span>
                )}
              </div>
              <span class="whitespace-nowrap text-xs text-slate-400">{fechaCorta(e.fecha)}{horaSV(e.fecha) ? ` ${horaSV(e.fecha)}` : ""}</span>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <DocFolio soloImpresion codigo={a.codigo} />
</Layout>
