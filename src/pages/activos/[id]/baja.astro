---
// Fase 59 · Baja del equipo: dar de baja con todos sus datos, revertir con motivo
// y bajas anteriores. Admin y jefe; los demás vuelven a la ficha.
import Layout from "@/layouts/Layout.astro";
import { getDb } from "@/lib/db";
import { activoBajas, activos, ordenes, planesMantenimiento, usuarios } from "@/lib/schema";
import { and, asc, desc, eq, inArray, sql } from "drizzle-orm";
import { areaHref } from "@/lib/areas";
import { rubroDeActivo } from "@/lib/rubros";
import {
  DESTINOS_BAJA, DESTINOS_CON_DETALLE, ESTADO_ACTIVO_LABEL, MOTIVOS_BAJA, fechaCorta, fechaHoraSV, folioActaBaja, hoySV, puedeGestionarBio,
  type EstadoActivo,
} from "@/lib/biomedico";
export const prerender = false;

const id = Number(Astro.params.id);
const user = Astro.locals.user!;
if (!Number.isInteger(id) || id <= 0) return Astro.redirect("/activos");
if (!puedeGestionarBio(user.rol)) return Astro.redirect(`/activos/${id}`);

const db = getDb(Astro);
const [a] = await db.select({ id: activos.id, codigo: activos.codigo, nombre: activos.nombre, estado: activos.estado, rubro: activos.rubro, tipo: activos.tipo })
  .from(activos).where(eq(activos.id, id)).limit(1);
if (!a) return Astro.redirect("/activos");
const area = rubroDeActivo(a.rubro, a.tipo);
const fichaHref = areaHref(`/activos/${id}`, area);
const deBaja = a.estado === "baja";

const bajas = await db.select().from(activoBajas).where(eq(activoBajas.activoId, id)).orderBy(desc(activoBajas.id));
const vigente = bajas.find((b) => b.estado === "vigente") ?? null;
const abiertas = deBaja ? [] : await db.select({ id: ordenes.id, codigo: ordenes.codigo, titulo: ordenes.titulo }).from(ordenes)
  .where(and(eq(ordenes.activoId, id), inArray(ordenes.estado, ["abierta", "en_proceso", "en_espera"])));
const [{ n: nPlanes }] = await db.select({ n: sql<number>`count(*)` }).from(planesMantenimiento)
  .where(and(eq(planesMantenimiento.activoId, id), eq(planesMantenimiento.activo, true)));
const evaluadores = deBaja ? [] : await db.select({ nombre: usuarios.nombre }).from(usuarios)
  .where(and(eq(usuarios.activo, true), inArray(usuarios.rol, ["tecnico", "jefe", "admin"]))).orderBy(asc(usuarios.nombre));
const hoy = hoySV();
const estadoLabel = (e: string) => ESTADO_ACTIVO_LABEL[e as EstadoActivo] ?? e;
const motivoLabel = (m: string) => MOTIVOS_BAJA[m as keyof typeof MOTIVOS_BAJA] ?? m;
const destinoLabel = (d: string) => DESTINOS_BAJA[d as keyof typeof DESTINOS_BAJA] ?? d;
const planesTxt = Number(nPlanes) === 1 ? "su plan preventivo" : `sus ${Number(nPlanes)} planes preventivos`;
---

<Layout title={`Baja · ${a.codigo}`}>
  <a href={fichaHref} class="text-sm text-slate-500 hover:underline">&larr; Volver al equipo</a>
  <h1 class="mt-2 text-2xl font-bold">{deBaja ? "Baja del equipo" : "Dar de baja"}</h1>
  <p class="text-sm text-slate-600"><span class="font-mono">{a.codigo}</span> · {a.nombre}</p>

  {!deBaja && (
    <section class="mt-4">
      <p class="rounded-lg border border-blue-200 bg-blue-50 p-3 text-sm text-blue-900">
        Al dar de baja, el equipo sale del inventario vigente, se desactivan {Number(nPlanes) ? planesTxt : "sus planes preventivos (no tiene activos)"} y no se le podrán abrir órdenes nuevas desde el celular.
      </p>
      {abiertas.length > 0 && (
        <div class="mt-3 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert">
          <p class="font-medium">{abiertas.length === 1 ? "Tiene 1 orden sin cerrar." : `Tiene ${abiertas.length} órdenes sin cerrar.`} Ciérralas o cancélalas antes de dar de baja:</p>
          <ul class="mt-1 list-disc pl-5">
            {abiertas.map((o) => <li><a href={`/ordenes/${o.id}?completa=1`} class="font-medium underline">{o.codigo ?? `#${o.id}`}</a> · {o.titulo}</li>)}
          </ul>
        </div>
      )}

      <form id="bajaForm" class="card mt-4 space-y-4 p-5" data-id={id} data-codigo={a.codigo} data-nombre={a.nombre} data-con-detalle={DESTINOS_CON_DETALLE.join(",")}>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="label" for="fecha">Fecha de baja *</label>
            <input class="input" id="fecha" type="date" value={hoy} max={hoy} required />
          </div>
          <div>
            <label class="label" for="motivo">Motivo *</label>
            <select class="input" id="motivo" required>
              <option value="" disabled selected>— Elegir —</option>
              {Object.entries(MOTIVOS_BAJA).map(([k, v]) => <option value={k}>{v}</option>)}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label class="label" for="motivoDetalle">Detalle del motivo *</label>
            <textarea class="input" id="motivoDetalle" rows="2" maxlength="1000" placeholder="Describe por qué se retira el equipo." required></textarea>
          </div>
          <div class="sm:col-span-2">
            <label class="label" for="evaluacionTecnica">Evaluación técnica *</label>
            <textarea class="input" id="evaluacionTecnica" rows="4" maxlength="4000" placeholder="Lo que sustenta la baja: falla encontrada, costo de reparación, repuestos, seguridad." required></textarea>
          </div>
          <div>
            <label class="label" for="evaluadoPor">Evaluó *</label>
            <input class="input" id="evaluadoPor" list="evaluadores" maxlength="200" required />
            <datalist id="evaluadores">{evaluadores.map((u) => <option value={u.nombre} />)}</datalist>
            <p class="mt-1 text-xs text-slate-500">Nombre y cargo; puede ser de un proveedor.</p>
          </div>
          <div></div>
          <div>
            <label class="label" for="autorizaNombre">Autoriza: nombre *</label>
            <input class="input" id="autorizaNombre" maxlength="200" value={user.nombre} required />
          </div>
          <div>
            <label class="label" for="autorizaCargo">Autoriza: cargo *</label>
            <input class="input" id="autorizaCargo" maxlength="200" placeholder="Ej: Jefe de Ingeniería Biomédica" required />
          </div>
          <div>
            <label class="label" for="destinoFinal">Destino final *</label>
            <select class="input" id="destinoFinal" required>
              <option value="" disabled selected>— Elegir —</option>
              {Object.entries(DESTINOS_BAJA).map(([k, v]) => <option value={k}>{v}</option>)}
            </select>
          </div>
          <div>
            <label class="label" for="destinoDetalle">Detalle del destino <span id="destinoReq" class="hidden">*</span></label>
            <input class="input" id="destinoDetalle" maxlength="500" placeholder="A quién se dona o se vende, o qué destino es" />
          </div>
          <div>
            <label class="label" for="empresaRetira">Empresa que retira</label>
            <input class="input" id="empresaRetira" maxlength="200" />
          </div>
          <div>
            <label class="label" for="fechaRetiro">Fecha de retiro</label>
            <input class="input" id="fechaRetiro" type="date" />
          </div>
          <div class="sm:col-span-2">
            <label class="label" for="residuosBaterias">Manejo de residuos y baterías *</label>
            <textarea class="input" id="residuosBaterias" rows="2" maxlength="1000" placeholder="Cómo se dispondrán baterías y residuos electrónicos o peligrosos. Si no aplica, escribe «No aplica»." required></textarea>
          </div>
        </div>
        <p id="bajaErr" class="hidden text-sm text-red-600" role="alert" tabindex="-1"></p>
        <div class="flex flex-wrap gap-2">
          <button id="bajaBtn" type="submit" class="btn-danger" disabled={abiertas.length > 0}>Dar de baja</button>
          <a href={fichaHref} class="btn-secondary">Cancelar</a>
        </div>
      </form>
    </section>
  )}

  {deBaja && (
    <section class="card mt-4 p-5">
      {vigente ? (
        <>
          <p class="text-sm text-slate-800">
            <strong>Dado de baja el {fechaCorta(vigente.fechaBaja)}</strong> · {motivoLabel(vigente.motivo)} · Destino: {destinoLabel(vigente.destinoFinal)}{vigente.destinoDetalle ? ` (${vigente.destinoDetalle})` : ""}
          </p>
          <p class="mt-1 text-xs text-slate-500">Autorizó {vigente.autorizaNombre} ({vigente.autorizaCargo}) · registró {vigente.registradoPorNombre} el {fechaHoraSV(vigente.createdAt)}.</p>
          <a href={areaHref(`/activos/${id}/acta-baja?baja=${vigente.id}`, area)} class="btn-secondary mt-3 inline-block text-sm">Ver acta {folioActaBaja(vigente.id)}</a>
        </>
      ) : (
        <p class="text-sm text-slate-700">Figura como dado de baja, sin acta registrada.</p>
      )}
      <form id="revertirForm" class="mt-5 border-t border-slate-200 pt-4" data-id={id}>
        <h2 class="font-semibold">Revertir baja</h2>
        <p class="mt-1 text-xs text-slate-500">
          El equipo vuelve a {vigente ? `«${estadoLabel(vigente.estadoAnterior)}»` : "«Operativo»"}. Los planes preventivos siguen desactivados: reactívalos en «Planes» si corresponde.
        </p>
        <label class="label mt-3" for="motivoReversion">Motivo de la reversión *</label>
        <textarea class="input" id="motivoReversion" rows="2" maxlength="1000" required></textarea>
        <p id="revertirMsg" class="mt-2 hidden text-sm" role="status"></p>
        <button id="revertirBtn" type="submit" class="btn-primary mt-3">Revertir baja</button>
      </form>
    </section>
  )}

  <section class="card mt-4 overflow-x-auto">
    <h2 class="px-4 pt-4 font-semibold">Bajas anteriores</h2>
    <table class="mt-2 w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase text-slate-500">
        <tr><th class="px-4 py-2">Folio</th><th class="px-4 py-2">Fecha</th><th class="px-4 py-2">Motivo</th><th class="px-4 py-2">Estado</th><th class="px-4 py-2">Revertida el</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {bajas.length === 0 && <tr><td colspan="5" class="px-4 py-4 text-center text-slate-400">Este equipo no tiene bajas registradas.</td></tr>}
        {bajas.map((b) => (
          <tr>
            <td class="px-4 py-2"><a href={areaHref(`/activos/${id}/acta-baja?baja=${b.id}`, area)} class="font-mono text-brand-700 hover:underline">{folioActaBaja(b.id)}</a></td>
            <td class="px-4 py-2">{fechaCorta(b.fechaBaja)}</td>
            <td class="px-4 py-2">{motivoLabel(b.motivo)}</td>
            <td class="px-4 py-2"><span class:list={["badge", b.estado === "vigente" ? "bg-slate-200 text-slate-700" : "bg-amber-100 text-amber-700"]}>{b.estado === "vigente" ? "Vigente" : "Revertida"}</span></td>
            <td class="px-4 py-2">{b.revertidaEn ? `${fechaHoraSV(b.revertidaEn)} · ${b.revertidaPorNombre ?? ""}` : "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <script>
    const bajaForm = document.getElementById("bajaForm") as HTMLFormElement | null;
    if (bajaForm) {
      const conDetalle = (bajaForm.dataset.conDetalle ?? "").split(",");
      const destino = document.getElementById("destinoFinal") as HTMLSelectElement;
      const detalle = document.getElementById("destinoDetalle") as HTMLInputElement;
      const marca = document.getElementById("destinoReq") as HTMLElement;
      const pintarDestino = () => {
        const obligatorio = conDetalle.includes(destino.value);
        detalle.required = obligatorio;
        marca.classList.toggle("hidden", !obligatorio);
      };
      destino.addEventListener("change", pintarDestino);
      pintarDestino();
      const err = document.getElementById("bajaErr") as HTMLElement;
      const boton = document.getElementById("bajaBtn") as HTMLButtonElement;
      const valor = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
      bajaForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        err.classList.add("hidden");
        if (!confirm(`¿Dar de baja ${bajaForm.dataset.codigo} · ${bajaForm.dataset.nombre}? Queda registrado.`)) return;
        boton.disabled = true;
        const datos = {
          fecha: valor("fecha"), motivo: valor("motivo"), motivoDetalle: valor("motivoDetalle"), evaluacionTecnica: valor("evaluacionTecnica"),
          evaluadoPor: valor("evaluadoPor"), autorizaNombre: valor("autorizaNombre"), autorizaCargo: valor("autorizaCargo"),
          destinoFinal: valor("destinoFinal"), destinoDetalle: valor("destinoDetalle") || null, empresaRetira: valor("empresaRetira") || null,
          fechaRetiro: valor("fechaRetiro") || null, residuosBaterias: valor("residuosBaterias"),
        };
        try {
          const r = await fetch(`/api/activos/${bajaForm.dataset.id}/baja`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(datos) });
          const j = await r.json().catch(() => ({}));
          if (!r.ok) {
            err.textContent = typeof j.error === "string" ? j.error : "No se pudo dar de baja.";
            err.classList.remove("hidden");
            err.focus();
            boton.disabled = false;
            return;
          }
          location.href = `/activos/${bajaForm.dataset.id}/acta-baja?baja=${j.baja.id}`;
        } catch {
          err.textContent = "Sin conexión. Revisa la ficha antes de volver a intentarlo.";
          err.classList.remove("hidden");
          boton.disabled = false;
        }
      });
    }

    const revertirForm = document.getElementById("revertirForm") as HTMLFormElement | null;
    if (revertirForm) {
      const msg = document.getElementById("revertirMsg") as HTMLElement;
      const boton = document.getElementById("revertirBtn") as HTMLButtonElement;
      revertirForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!confirm("¿Revertir la baja? El equipo vuelve al inventario vigente.")) return;
        boton.disabled = true;
        const motivo = (document.getElementById("motivoReversion") as HTMLTextAreaElement).value.trim();
        try {
          const r = await fetch(`/api/activos/${revertirForm.dataset.id}/baja-revertir`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ motivo }) });
          const j = await r.json().catch(() => ({}));
          msg.classList.remove("hidden");
          if (!r.ok) {
            msg.textContent = typeof j.error === "string" ? j.error : "No se pudo revertir la baja.";
            msg.className = "mt-2 text-sm text-red-600";
            boton.disabled = false;
            return;
          }
          msg.textContent = j.mensaje ?? "Baja revertida.";
          msg.className = "mt-2 text-sm text-emerald-700";
          setTimeout(() => location.reload(), 2500);
        } catch {
          msg.textContent = "Sin conexión. Vuelve a intentarlo.";
          msg.className = "mt-2 text-sm text-red-600";
          msg.classList.remove("hidden");
          boton.disabled = false;
        }
      });
    }
  </script>
</Layout>
