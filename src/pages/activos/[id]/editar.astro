---
import Layout from "@/layouts/Layout.astro";
import { getDb } from "@/lib/db";
import { activos, sucursales, ubicaciones, proveedores, usuarios } from "@/lib/schema";
import { eq, and, inArray, asc } from "drizzle-orm";
import { CATEGORIAS_POR_AREA } from "@/lib/categorias-equipos";
import { CRITICIDAD_LABEL, CRITICIDAD_DESC } from "@/lib/inventario-jci";
import ActivoAreaFields from "@/components/ActivoAreaFields.astro";
import UppercaseFields from "@/components/UppercaseFields.astro";
import { AREAS, areaHref, parseArea } from "@/lib/areas";
import { rubroDeActivo } from "@/lib/rubros";
export const prerender = false;

const id = Number(Astro.params.id);
if (!Number.isFinite(id)) return Astro.redirect(areaHref("/activos", parseArea(Astro.url.searchParams.get("area"))));

const user = Astro.locals.user!;
if (!["admin", "jefe", "tecnico"].includes(user.rol)) return Astro.redirect(`/activos/${id}`);

const db = getDb(Astro);
const [a] = await db.select().from(activos).where(eq(activos.id, id)).limit(1);
if (!a) return Astro.redirect(areaHref("/activos", parseArea(Astro.url.searchParams.get("area"))));
const area = rubroDeActivo(a.rubro, a.tipo);
if (parseArea(Astro.url.searchParams.get("area")) !== area) return Astro.redirect(areaHref(Astro.url.pathname + Astro.url.search, area));

// Determina sucursal actual a partir de la ubicación (si la tiene)
let sucursalActualId: number | null = null;
if (a.ubicacionId) {
  const [u] = await db.select({ sucursalId: ubicaciones.sucursalId }).from(ubicaciones).where(eq(ubicaciones.id, a.ubicacionId)).limit(1);
  sucursalActualId = u?.sucursalId ?? null;
}

const sucRows = await db.select({ id: sucursales.id, nombre: sucursales.nombre }).from(sucursales).where(eq(sucursales.activa, true)).orderBy(sucursales.nombre);
const ubRows = await db.select().from(ubicaciones).where(eq(ubicaciones.activa, true));
const provRows = await db.select({ id: proveedores.id, nombre: proveedores.nombre }).from(proveedores).where(eq(proveedores.activo, true)).orderBy(proveedores.nombre);
const userRows = await db
  .select({ id: usuarios.id, nombre: usuarios.nombre, rol: usuarios.rol })
  .from(usuarios)
  .where(and(eq(usuarios.activo, true), inArray(usuarios.rol, ["tecnico", "jefe", "admin"])))
  .orderBy(asc(usuarios.nombre));

const ubJson = JSON.stringify(ubRows);
---

<Layout title={`Editar · ${a.nombre}`}>
  <a href={areaHref(`/activos/${id}`, area)} class="text-sm text-slate-500 hover:underline">&larr; Volver al equipo</a>
  <h1 class="mt-2 text-2xl font-bold">Editar {area === "infraestructura" ? "instalación" : area === "aires" ? "unidad" : "equipo"}</h1>
  <p class="mt-1 text-sm font-medium text-brand-700">{AREAS[area].label}</p>
  <p class="text-sm text-slate-500 font-mono">{a.codigo}</p>

  <form id="form" class="card mt-4 space-y-5 p-5">
    <ActivoAreaFields area={area} datosTecnicos={a.datosTecnicos} />
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <input type="hidden" id="tipo" value={area === "biomedico" ? "biomedico" : "general"} />
      <div>
        <label class="label">Categoría</label>
        <input class="input" id="categoria" data-uppercase autocapitalize="characters" list="categoriasList" value={a.categoria ?? ""} />
        <datalist id="categoriasList"></datalist>
        <p class="mt-1 text-xs text-slate-500">Las sugerencias corresponden al área seleccionada.</p>
      </div>
      <div>
        <label class="label" for="codigo">Código</label>
        <input class="input bg-slate-50" id="codigo" readonly value={a.codigo} />
        <p class="mt-1 text-xs text-slate-500">El código asignado se conserva.</p>
      </div>
      <div>
        <label class="label">Número de activo</label>
        <input class="input" id="numeroActivo" data-uppercase autocapitalize="characters" value={a.numeroActivo ?? ""} />
      </div>
      <div class="sm:col-span-2">
        <label class="label" for="nombre">Nombre</label>
        <input class="input" id="nombre" data-uppercase autocapitalize="characters" value={a.nombre} aria-describedby="nombreHelp" />
        <p class="mt-1 text-xs text-slate-500" id="nombreHelp">Si lo dejas vacío, se registrará como pendiente de identificar.</p>
      </div>
      <div class="sm:col-span-2">
        <label class="label">Descripción</label>
        <textarea class="input" id="descripcion" data-uppercase autocapitalize="characters" rows="2">{a.descripcion ?? ""}</textarea>
      </div>
      <div>
        <label class="label">Marca</label>
        <input class="input" id="marca" data-uppercase autocapitalize="characters" value={a.marca ?? ""} />
      </div>
      <div>
        <label class="label">Modelo</label>
        <input class="input" id="modelo" data-uppercase autocapitalize="characters" value={a.modelo ?? ""} />
      </div>
      <div>
        <label class="label">Número de serie</label>
        <input class="input" id="serial" data-uppercase autocapitalize="characters" value={a.serial ?? ""} />
      </div>
      <div>
        <label class="label">Año</label>
        <input class="input" id="anio" type="number" min="1900" max="2100" value={a.anio ?? ""} />
      </div>

      {sucRows.length > 0 && (
        <>
          <div>
            <label class="label">Sucursal</label>
            <select class="input" id="sucursalSel">
              <option value="">— Seleccionar —</option>
              {sucRows.map((s) => <option value={s.id} selected={s.id === sucursalActualId}>{s.nombre}</option>)}
            </select>
          </div>
          <div>
            <label class="label">Ubicación</label>
            <select class="input" id="ubicacionSel">
              <option value="">— Seleccionar —</option>
            </select>
          </div>
        </>
      )}

      <div class="sm:col-span-2">
        <label class="label">Detalle de ubicación / texto libre</label>
        <input class="input" id="ubicacion" data-uppercase autocapitalize="characters" value={a.ubicacion ?? ""} />
      </div>

      <div>
        <label class="label">Estado</label>
        <select class="input" id="estado">
          <option value="operativo" selected={a.estado === "operativo"}>Operativo</option>
          <option value="averiado" selected={a.estado === "averiado"}>Averiado</option>
          <option value="mantenimiento" selected={a.estado === "mantenimiento"}>En mantenimiento</option>
          <option value="baja" selected={a.estado === "baja"}>Dado de baja</option>
        </select>
      </div>

      {provRows.length > 0 && (
        <div>
          <label class="label">Proveedor / Fabricante</label>
          <select class="input" id="proveedorSel">
            <option value="">— Sin proveedor —</option>
            {provRows.map((p) => <option value={p.id} selected={p.id === a.proveedorId}>{p.nombre}</option>)}
          </select>
        </div>
      )}
    </div>

    <div class="border-t border-slate-200 pt-5">
      <h2 class="mb-3 font-semibold text-amber-700">⏱ SLA del equipo (horas para completar OT)</h2>
      <p class="text-xs text-slate-500 mb-3">Define el tiempo máximo según la prioridad. Usado para calcular vencimientos automáticos en nuevas OT.</p>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div>
          <label class="label">🔴 Urgente</label>
          <input class="input" id="slaUrgenteHoras" type="number" min="0" value={a.slaUrgenteHoras} />
          <p class="mt-1 text-xs text-slate-400">horas</p>
        </div>
        <div>
          <label class="label">🟠 Alta</label>
          <input class="input" id="slaAltaHoras" type="number" min="0" value={a.slaAltaHoras} />
          <p class="mt-1 text-xs text-slate-400">horas</p>
        </div>
        <div>
          <label class="label">🟡 Media</label>
          <input class="input" id="slaMediaHoras" type="number" min="0" value={a.slaMediaHoras} />
          <p class="mt-1 text-xs text-slate-400">horas</p>
        </div>
        <div>
          <label class="label">🟢 Baja</label>
          <input class="input" id="slaBajaHoras" type="number" min="0" value={a.slaBajaHoras} />
          <p class="mt-1 text-xs text-slate-400">horas</p>
        </div>
      </div>
    </div>

    <div class="border-t border-slate-200 pt-5">
      <h2 class="mb-3 font-semibold text-brand-700">🏷 Datos patrimoniales y criticidad</h2>
      <p class="text-xs text-slate-500 mb-3">La criticidad evalúa el impacto de una falla del equipo o instalación. Es independiente de la urgencia de una solicitud.</p>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="label">Fecha de adquisición</label>
          <input class="input" id="fechaAdquisicion" type="date" value={a.fechaAdquisicion ?? ""} />
        </div>
        <div>
          <label class="label">Vida útil estimada (años)</label>
          <input class="input" id="vidaUtilAnios" type="number" min="0" max="100" value={a.vidaUtilAnios ?? ""} />
        </div>
        <div>
          <label class="label">Valor de adquisición (USD)</label>
          <input class="input" id="valorAdquisicion" type="number" min="0" step="0.01" value={a.valorAdquisicion ?? ""} />
        </div>
        <div>
          <label class="label">Responsable del equipo</label>
          <select class="input" id="responsableSel">
            <option value="">— Sin asignar —</option>
            {userRows.map((u) => <option value={u.id} selected={u.id === a.responsableId}>{u.nombre}</option>)}
          </select>
        </div>
        <div>
          <label class="label">Criticidad operacional</label>
          <select class="input" id="criticidadOperacional">
            {(["alta", "media", "baja"] as const).map((c) => (
              <option value={c} selected={(a.criticidadOperacional ?? "media") === c}>{CRITICIDAD_LABEL[c]}</option>
            ))}
          </select>
          <p class="mt-1 text-xs text-slate-500" id="critDesc">{CRITICIDAD_DESC[(a.criticidadOperacional ?? "media") as "alta" | "media" | "baja"]}</p>
        </div>
        <div class="flex items-center gap-2 pt-6">
          <input type="checkbox" id="requiereCalibracion" class="h-4 w-4" checked={a.requiereCalibracion} />
          <label for="requiereCalibracion" class="text-sm text-slate-700">Requiere calibración (aunque no sea biomédico)</label>
        </div>
      </div>
    </div>

    <div id="bioFields" class:list={["border-t border-slate-200 pt-5", a.tipo !== "biomedico" && "hidden"]}>
      <h2 class="mb-3 font-semibold text-purple-700">Datos biomédicos</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="label">Registro sanitario (DNM)</label>
          <input class="input" id="registroSanitario" data-uppercase autocapitalize="characters" value={a.registroSanitario ?? ""} />
        </div>
        <div>
          <label class="label">Clase de riesgo</label>
          <select class="input" id="claseRiesgo">
            <option value="">- Sin clasificar -</option>
            <option value="I" selected={a.claseRiesgo === "I"}>Clase I</option>
            <option value="IIa" selected={a.claseRiesgo === "IIa"}>Clase IIa</option>
            <option value="IIb" selected={a.claseRiesgo === "IIb"}>Clase IIb</option>
            <option value="III" selected={a.claseRiesgo === "III"}>Clase III</option>
          </select>
        </div>
        <div>
          <label class="label">Última calibración</label>
          <input class="input" id="ultimaCalibracion" type="date" value={a.ultimaCalibracion ?? ""} />
        </div>
        <div>
          <label class="label">Próxima calibración</label>
          <input class="input" id="proximaCalibracion" type="date" value={a.proximaCalibracion ?? ""} />
        </div>
      </div>
    </div>

    <p id="err" class="hidden text-sm text-red-600"></p>
    <div class="flex gap-2">
      <button class="btn-primary" type="submit">Guardar cambios</button>
      <a class="btn-secondary" href={areaHref(`/activos/${id}`, area)}>Cancelar</a>
    </div>
  </form>
  <UppercaseFields />

  <script define:vars={{ id, ubJson, sucursalActualId, ubicacionActualId: a.ubicacionId, categoriasPorArea: CATEGORIAS_POR_AREA, critDescJson: CRITICIDAD_DESC }}>
    const allUbs = JSON.parse(ubJson);

    // Descripción de criticidad operacional
    const critSel = document.getElementById("criticidadOperacional");
    const critDescEl = document.getElementById("critDesc");
    critSel?.addEventListener("change", () => {
      if (critDescEl) critDescEl.textContent = critDescJson[critSel.value] ?? "";
    });

    const areaSel = document.getElementById("rubro");
    const tipoSel = document.getElementById("tipo");
    function actualizarArea() {
      const key = areaSel.value;
      tipoSel.value = key === "biomedico" ? "biomedico" : "general";
      document.getElementById("bioFields").classList.toggle("hidden", key !== "biomedico");
      document.getElementById("aireFields").classList.toggle("hidden", key !== "aires");
      document.getElementById("infraFields").classList.toggle("hidden", key !== "infraestructura");
      document.getElementById("servicioFields").classList.toggle("hidden", !["equipo_general", "biomedico"].includes(key));
      for (const el of document.querySelectorAll("#aireFields input, #infraFields input, #servicioFields input")) el.disabled = el.closest(".hidden") !== null;
      const list = document.getElementById("categoriasList");
      list.replaceChildren(...(categoriasPorArea[key] ?? []).map((c) => { const option = document.createElement("option"); option.value = c; return option; }));
    }
    areaSel.addEventListener("change", actualizarArea);
    actualizarArea();

    // Sucursal → ubicación
    const sucEl = document.getElementById("sucursalSel");
    const ubEl = document.getElementById("ubicacionSel");

    function poblarUbicaciones(sucId, selectId) {
      if (!ubEl) return;
      const filtered = sucId ? allUbs.filter((u) => u.sucursalId === sucId) : [];
      ubEl.innerHTML = '<option value="">— Seleccionar —</option>';
      filtered.forEach((u) => {
        const o = document.createElement("option");
        o.value = u.id;
        o.textContent = `${u.nombre} (${u.tipo})`;
        if (u.id === selectId) o.selected = true;
        ubEl.appendChild(o);
      });
    }

    if (sucEl) {
      // Inicializa con la sucursal actual y selecciona la ubicación actual
      poblarUbicaciones(sucursalActualId, ubicacionActualId);
      sucEl.addEventListener("change", () => {
        poblarUbicaciones(Number(sucEl.value) || null, null);
      });
    }

    document.getElementById("form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const err = document.getElementById("err");
      err.classList.add("hidden");
      const v = (id) => document.getElementById(id)?.value?.trim() ?? "";
      const sv = (id) => document.getElementById(id)?.value ?? "";
      const num = (id) => { const x = sv(id); return x === "" ? null : Number(x); };
      const isBio = sv("tipo") === "biomedico";
      const ubVal = ubEl?.value;
      const provVal = document.getElementById("proveedorSel")?.value;

      const payload = {
        nombre: v("nombre"),
        descripcion: v("descripcion") || null,
        ubicacion: v("ubicacion") || null,
        estado: sv("estado"),
        tipo: sv("tipo"),
        rubro: sv("rubro"),
        datosTecnicos: sv("rubro") === "aires" ? { tipoUnidad: v("tipoUnidad") || null, capacidadBtuH: v("capacidadBtuH") ? Number(v("capacidadBtuH")) : null, refrigerante: v("refrigerante") || null }
          : sv("rubro") === "infraestructura" ? { tipoInstalacion: v("tipoInstalacion") || null, sector: v("sector") || null }
          : { servicio: v("servicio") || null },
        categoria: v("categoria") || null,
        numeroActivo: v("numeroActivo") || null,
        marca: v("marca") || null,
        modelo: v("modelo") || null,
        serial: v("serial") || null,
        anio: num("anio"),
        ubicacionId: ubVal ? Number(ubVal) : null,
        proveedorId: provVal ? Number(provVal) : null,
        slaUrgenteHoras: Number(sv("slaUrgenteHoras") || 4),
        slaAltaHoras: Number(sv("slaAltaHoras") || 24),
        slaMediaHoras: Number(sv("slaMediaHoras") || 72),
        slaBajaHoras: Number(sv("slaBajaHoras") || 168),
        fechaAdquisicion: v("fechaAdquisicion") || null,
        vidaUtilAnios: num("vidaUtilAnios"),
        valorAdquisicion: num("valorAdquisicion"),
        responsableId: document.getElementById("responsableSel")?.value ? Number(document.getElementById("responsableSel").value) : null,
        criticidadOperacional: sv("criticidadOperacional") || "media",
        requiereCalibracion: document.getElementById("requiereCalibracion")?.checked ?? false,
      };
      if (isBio) {
        payload.registroSanitario = v("registroSanitario") || null;
        payload.claseRiesgo = sv("claseRiesgo") || null;
        payload.ultimaCalibracion = v("ultimaCalibracion") || null;
        payload.proximaCalibracion = v("proximaCalibracion") || null;
      } else {
        payload.registroSanitario = null;
        payload.claseRiesgo = null;
        payload.ultimaCalibracion = null;
        payload.proximaCalibracion = null;
      }

      const res = await fetch(`/api/activos/${id}`, {
        method: "PATCH",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        const j = await res.json().catch(() => ({}));
        err.textContent = typeof j.error === "string" ? j.error : "Error al guardar";
        err.classList.remove("hidden");
        return;
      }
      location.href = `/activos/${id}?area=${encodeURIComponent(sv("rubro"))}`;
    });
  </script>
</Layout>
