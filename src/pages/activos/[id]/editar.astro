---
import { encodeInlineScriptVars } from "@/lib/inline-script-vars";
import Layout from "@/layouts/Layout.astro";
import { getDb } from "@/lib/db";
import { activos, centrosCosto, sucursales, ubicaciones, proveedores, usuarios } from "@/lib/schema";
import { eq, and, inArray, asc, or } from "drizzle-orm";
import { CATEGORIAS_POR_AREA } from "@/lib/categorias-equipos";
import { CRITICIDAD_LABEL, CRITICIDAD_DESC } from "@/lib/inventario-jci";
import ActivoAreaFields from "@/components/ActivoAreaFields.astro";
import UppercaseFields from "@/components/UppercaseFields.astro";
import { AREAS, areaHref, parseArea } from "@/lib/areas";
import { rubroDeActivo, SUBCAT_KEYS, SUBCATS_BIOMEDICO } from "@/lib/rubros";
import { CLASES_RIESGO, ENTIDADES_REGISTRO, fechaCorta } from "@/lib/biomedico";
import { CODIGO_MAX } from "@/lib/registro-activos";
export const prerender = false;

const id = Number(Astro.params.id);
if (!Number.isFinite(id)) return Astro.redirect(areaHref("/activos", parseArea(Astro.url.searchParams.get("area"))));

const user = Astro.locals.user!;
if (!["admin", "jefe", "tecnico"].includes(user.rol)) return Astro.redirect(`/activos/${id}`);

const db = getDb(Astro);
const [a] = await db.select().from(activos).where(eq(activos.id, id)).limit(1);
if (!a) return Astro.redirect(areaHref("/activos", parseArea(Astro.url.searchParams.get("area"))));
const area = rubroDeActivo(a.rubro, a.tipo);
if (parseArea(Astro.url.searchParams.get("area")) !== area) return Astro.redirect(areaHref(Astro.url.pathname + Astro.url.search, area));

// Determina sucursal actual a partir de la ubicación (si la tiene)
let sucursalActualId: number | null = null;
if (a.ubicacionId) {
  const [u] = await db.select({ sucursalId: ubicaciones.sucursalId }).from(ubicaciones).where(eq(ubicaciones.id, a.ubicacionId)).limit(1);
  sucursalActualId = u?.sucursalId ?? null;
}

const sucRows = await db.select({ id: sucursales.id, nombre: sucursales.nombre }).from(sucursales).where(eq(sucursales.activa, true)).orderBy(sucursales.nombre);
const ubRows = await db.select().from(ubicaciones).where(eq(ubicaciones.activa, true));
const provRows = await db.select({ id: proveedores.id, nombre: proveedores.nombre }).from(proveedores).where(eq(proveedores.activo, true)).orderBy(proveedores.nombre);
const userRows = await db
  .select({ id: usuarios.id, nombre: usuarios.nombre, rol: usuarios.rol })
  .from(usuarios)
  .where(and(eq(usuarios.activo, true), inArray(usuarios.rol, ["tecnico", "jefe", "admin"])))
  .orderBy(asc(usuarios.nombre));
// Centros activos y el que ya tiene el equipo, aunque esté desactivado.
const centros = await db
  .select({ id: centrosCosto.id, codigo: centrosCosto.codigo, nombre: centrosCosto.nombre, sucursalId: centrosCosto.sucursalId, activo: centrosCosto.activo, sede: sucursales.nombre })
  .from(centrosCosto)
  .leftJoin(sucursales, eq(sucursales.id, centrosCosto.sucursalId))
  .where(a.centroCostoId != null ? or(eq(centrosCosto.activo, true), eq(centrosCosto.id, a.centroCostoId)) : eq(centrosCosto.activo, true))
  .orderBy(asc(centrosCosto.codigo));

const ubJson = JSON.stringify(ubRows);
const gestiona = user.rol === "admin" || user.rol === "jefe";
const deBaja = a.estado === "baja";
const llevaCalibracion = area === "biomedico" || a.requiereCalibracion || a.esPatron;
const entidadFija = (ENTIDADES_REGISTRO as readonly string[]).includes(a.registroSanitarioEntidad ?? "");
const entidadSel = entidadFija ? a.registroSanitarioEntidad! : a.registroSanitarioEntidad ? "__otra__" : "";
---

<Layout title={`Editar · ${a.nombre}`}>
  <a href={areaHref(`/activos/${id}`, area)} class="text-sm text-slate-500 hover:underline">&larr; Volver al equipo</a>
  <h1 class="mt-2 text-2xl font-bold">Editar {area === "infraestructura" ? "instalación" : area === "aires" ? "unidad" : "equipo"}</h1>
  <p class="mt-1 text-sm font-medium text-brand-700">{AREAS[area].label}</p>
  <p class="text-sm text-slate-500 font-mono">{a.codigo}</p>

  <form id="form" class="card mt-4 space-y-5 p-5">
    <ActivoAreaFields area={area} datosTecnicos={a.datosTecnicos} />
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <input type="hidden" id="tipo" value={area === "biomedico" ? "biomedico" : "general"} />
      <div>
        <label class="label">Categoría</label>
        <input class="input" id="categoria" data-uppercase autocapitalize="characters" list="categoriasList" value={a.categoria ?? ""} />
        <datalist id="categoriasList"></datalist>
        <p class="mt-1 text-xs text-slate-500">Las sugerencias corresponden al área seleccionada.</p>
      </div>
      <div>
        <label class="label" for="codigo">Código institucional</label>
        {gestiona ? (
          <>
            <input class="input" id="codigo" data-uppercase autocapitalize="characters" maxlength={CODIGO_MAX} value={a.codigo} data-original={a.codigo} autocomplete="off" />
            <p class="mt-1 text-xs text-slate-500">Corrígelo solo si está mal. Las etiquetas impresas quedan con el código anterior.</p>
          </>
        ) : (
          <>
            <input class="input bg-slate-50" id="codigo" readonly value={a.codigo} />
            <p class="mt-1 text-xs text-slate-500">Solo la jefatura o el administrador pueden corregir el código.</p>
          </>
        )}
      </div>
      <div>
        <label class="label">Número de activo</label>
        <input class="input" id="numeroActivo" data-uppercase autocapitalize="characters" value={a.numeroActivo ?? ""} />
      </div>
      <div class="sm:col-span-2">
        <label class="label" for="nombre">Nombre</label>
        <input class="input" id="nombre" data-uppercase autocapitalize="characters" value={a.nombre} aria-describedby="nombreHelp" />
        <p class="mt-1 text-xs text-slate-500" id="nombreHelp">Si lo dejas vacío, se registrará como pendiente de identificar.</p>
      </div>
      <div class="sm:col-span-2">
        <label class="label">Descripción</label>
        <textarea class="input" id="descripcion" data-uppercase autocapitalize="characters" rows="2">{a.descripcion ?? ""}</textarea>
      </div>
      <div>
        <label class="label">Marca</label>
        <input class="input" id="marca" data-uppercase autocapitalize="characters" value={a.marca ?? ""} />
      </div>
      <div>
        <label class="label">Modelo</label>
        <input class="input" id="modelo" data-uppercase autocapitalize="characters" value={a.modelo ?? ""} />
      </div>
      <div>
        <label class="label" for="serial">Número de serie</label>
        <input class="input" id="serial" data-uppercase autocapitalize="characters" value={a.serial ?? ""} aria-describedby="serieAviso" />
        <p id="serieAviso" class="mt-1 hidden rounded bg-amber-50 p-2 text-xs text-amber-800" role="status"></p>
      </div>
      <div>
        <label class="label">Año</label>
        <input class="input" id="anio" type="number" min="1900" max="2100" value={a.anio ?? ""} />
      </div>

      {sucRows.length > 0 && (
        <>
          <div>
            <label class="label">Sucursal</label>
            <select class="input" id="sucursalSel">
              <option value="">— Seleccionar —</option>
              {sucRows.map((s) => <option value={s.id} selected={s.id === sucursalActualId}>{s.nombre}</option>)}
            </select>
          </div>
          <div>
            <label class="label">Ubicación</label>
            <select class="input" id="ubicacionSel">
              <option value="">— Seleccionar —</option>
            </select>
          </div>
        </>
      )}

      <div>
        <label class="label" for="centroCostoSel">Centro de costo</label>
        <select class="input" id="centroCostoSel">
          <option value="">— Sin centro de costo —</option>
          {centros.map((c) => <option value={c.id} data-sucursal={c.sucursalId ?? ""} selected={c.id === a.centroCostoId}>{c.codigo} · {c.nombre}{c.sede ? ` (${c.sede})` : ""}{c.activo ? "" : " · desactivado"}</option>)}
        </select>
        <p class="mt-1 text-xs text-slate-500">Opcional. Aparecen los centros sin sede o de la sede elegida.</p>
      </div>

      <div class="sm:col-span-2">
        <label class="label">Detalle de ubicación / texto libre</label>
        <input class="input" id="ubicacion" data-uppercase autocapitalize="characters" value={a.ubicacion ?? ""} />
      </div>

      <div>
        <label class="label">Estado</label>
        {deBaja ? (
          <p class="rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-700">
            Dado de baja · <a href={areaHref(`/activos/${id}/baja`, area)} class="font-medium text-brand-700 hover:underline">Ver o revertir la baja</a>
          </p>
        ) : (
          <select class="input" id="estado">
            <option value="operativo" selected={a.estado === "operativo"}>Operativo</option>
            <option value="averiado" selected={a.estado === "averiado"}>Averiado</option>
            <option value="mantenimiento" selected={a.estado === "mantenimiento"}>En mantenimiento</option>
          </select>
        )}
      </div>

      {provRows.length > 0 && (
        <div>
          <label class="label">Proveedor / Fabricante</label>
          <select class="input" id="proveedorSel">
            <option value="">— Sin proveedor —</option>
            {provRows.map((p) => <option value={p.id} selected={p.id === a.proveedorId}>{p.nombre}</option>)}
          </select>
        </div>
      )}
    </div>

    <div id="bioFields" class:list={["border-t border-slate-200 pt-5", area !== "biomedico" && "hidden"]}>
      <h2 class="mb-3 font-semibold text-purple-700">Datos biomédicos</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="label" for="claseRiesgo">Clase de riesgo *</label>
          <select class="input" id="claseRiesgo">
            <option value="" disabled selected={!a.claseRiesgo}>— Elegir —</option>
            {CLASES_RIESGO.map((c) => <option value={c.valor} selected={a.claseRiesgo === c.valor}>{c.etiqueta} ({c.descripcion})</option>)}
          </select>
          <p class="mt-1 text-xs text-slate-500">Obligatoria en equipos biomédicos.</p>
        </div>
        <div>
          <label class="label" for="subcategoria">Subcategoría clínica</label>
          <select class="input" id="subcategoria">
            <option value="">— Sin segmentar —</option>
            {SUBCAT_KEYS.map((k) => <option value={k} selected={a.subcategoria === k}>{SUBCATS_BIOMEDICO[k].label}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <h3 class="text-sm font-semibold text-slate-700">Registro sanitario</h3>
          <label class="mt-2 flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" id="registroNoRequiere" class="h-4 w-4" checked={a.registroSanitarioNoRequiere} />
            No requiere registro sanitario
          </label>
        </div>
        <div class="registro-campo">
          <label class="label" for="registroEntidad">Entidad</label>
          <select class="input" id="registroEntidad">
            <option value="">— Elegir —</option>
            {ENTIDADES_REGISTRO.map((e) => <option value={e} selected={entidadSel === e}>{e}</option>)}
            <option value="__otra__" selected={entidadSel === "__otra__"}>Otra</option>
          </select>
        </div>
        <div class="registro-campo hidden" id="registroEntidadOtraBox">
          <label class="label" for="registroEntidadOtra">¿Cuál?</label>
          <input class="input" id="registroEntidadOtra" data-uppercase autocapitalize="characters" maxlength="60" value={entidadFija ? "" : a.registroSanitarioEntidad ?? ""} />
        </div>
        <div class="registro-campo">
          <label class="label" for="registroSanitario">Número de registro</label>
          <input class="input" id="registroSanitario" data-uppercase autocapitalize="characters" value={a.registroSanitario ?? ""} />
        </div>
        <div class="registro-campo">
          <label class="label" for="registroEmision">Fecha de emisión</label>
          <input class="input" id="registroEmision" type="date" value={a.registroSanitarioEmision ?? ""} />
        </div>
        <div class="registro-campo">
          <label class="label" for="registroVencimiento">Fecha de vencimiento</label>
          <input class="input" id="registroVencimiento" type="date" value={a.registroSanitarioVencimiento ?? ""} />
        </div>
      </div>
    </div>

    <div class="border-t border-slate-200 pt-5">
      <h2 class="mb-3 font-semibold text-amber-700">SLA del equipo (horas para completar OT)</h2>
      <p class="text-xs text-slate-500 mb-3">Define el tiempo máximo según la prioridad. Usado para calcular vencimientos automáticos en nuevas OT.</p>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div>
          <label class="label">Urgente</label>
          <input class="input" id="slaUrgenteHoras" type="number" min="0" value={a.slaUrgenteHoras} />
          <p class="mt-1 text-xs text-slate-400">horas</p>
        </div>
        <div>
          <label class="label">Alta</label>
          <input class="input" id="slaAltaHoras" type="number" min="0" value={a.slaAltaHoras} />
          <p class="mt-1 text-xs text-slate-400">horas</p>
        </div>
        <div>
          <label class="label">Media</label>
          <input class="input" id="slaMediaHoras" type="number" min="0" value={a.slaMediaHoras} />
          <p class="mt-1 text-xs text-slate-400">horas</p>
        </div>
        <div>
          <label class="label">Baja</label>
          <input class="input" id="slaBajaHoras" type="number" min="0" value={a.slaBajaHoras} />
          <p class="mt-1 text-xs text-slate-400">horas</p>
        </div>
      </div>
    </div>

    <div class="border-t border-slate-200 pt-5">
      <h2 class="mb-3 font-semibold text-brand-700">Datos patrimoniales y criticidad</h2>
      <p class="text-xs text-slate-500 mb-3">La criticidad evalúa el impacto de una falla del equipo o instalación. Es independiente de la urgencia de una solicitud.</p>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="label">Fecha de adquisición</label>
          <input class="input" id="fechaAdquisicion" type="date" value={a.fechaAdquisicion ?? ""} />
        </div>
        <div>
          <label class="label">Vida útil estimada (años)</label>
          <input class="input" id="vidaUtilAnios" type="number" min="0" max="100" value={a.vidaUtilAnios ?? ""} />
        </div>
        <div>
          <label class="label">Valor de adquisición (USD)</label>
          <input class="input" id="valorAdquisicion" type="number" min="0" step="0.01" value={a.valorAdquisicion ?? ""} />
        </div>
        <div>
          <label class="label">Responsable del equipo</label>
          <select class="input" id="responsableSel">
            <option value="">— Sin asignar —</option>
            {userRows.map((u) => <option value={u.id} selected={u.id === a.responsableId}>{u.nombre}</option>)}
          </select>
        </div>
        <div>
          <label class="label">Criticidad operacional</label>
          <select class="input" id="criticidadOperacional">
            {(["alta", "media", "baja"] as const).map((c) => (
              <option value={c} selected={(a.criticidadOperacional ?? "media") === c}>{CRITICIDAD_LABEL[c]}</option>
            ))}
          </select>
          <p class="mt-1 text-xs text-slate-500" id="critDesc">{CRITICIDAD_DESC[(a.criticidadOperacional ?? "media") as "alta" | "media" | "baja"]}</p>
        </div>
        <div class="pt-6">
          <div class="flex items-center gap-2">
            <input type="checkbox" id="requiereCalibracion" class="h-4 w-4" checked={a.requiereCalibracion || a.esPatron} disabled={a.esPatron} />
            <label for="requiereCalibracion" class="text-sm text-slate-700">Requiere calibración (aunque no sea biomédico)</label>
          </div>
          {a.esPatron && <p class="mt-1 text-xs text-slate-500">Equipo patrón: siempre requiere calibración.</p>}
        </div>
        {llevaCalibracion && (
          <p class="text-xs text-slate-500 sm:col-span-2">
            Última calibración: {fechaCorta(a.ultimaCalibracion)} · Próxima: {fechaCorta(a.proximaCalibracion)}. Se actualizan al registrar una calibración.
          </p>
        )}
      </div>
    </div>

    <p id="err" class="hidden text-sm text-red-600" role="alert" tabindex="-1"></p>
    <div class="flex gap-2">
      <button class="btn-primary" type="submit" id="saveBtn">Guardar cambios</button>
      <a class="btn-secondary" href={areaHref(`/activos/${id}`, area)}>Cancelar</a>
    </div>
  </form>
  <UppercaseFields />

  <script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({ id, ubJson, sucursalActualId, ubicacionActualId: a.ubicacionId, categoriasPorArea: CATEGORIAS_POR_AREA, critDescJson: CRITICIDAD_DESC, gestiona, deBaja, esPatron: a.esPatron }) }}>
    const { id, ubJson, sucursalActualId, ubicacionActualId, categoriasPorArea, critDescJson, gestiona, deBaja, esPatron } = JSON.parse(decodeURIComponent(__encodedScriptVars));
    const allUbs = JSON.parse(ubJson);

    // Descripción de criticidad operacional
    const critSel = document.getElementById("criticidadOperacional");
    const critDescEl = document.getElementById("critDesc");
    critSel?.addEventListener("change", () => {
      if (critDescEl) critDescEl.textContent = critDescJson[critSel.value] ?? "";
    });

    const areaSel = document.getElementById("rubro");
    const tipoSel = document.getElementById("tipo");
    function actualizarArea() {
      const key = areaSel.value;
      tipoSel.value = key === "biomedico" ? "biomedico" : "general";
      document.getElementById("bioFields").classList.toggle("hidden", key !== "biomedico");
      document.getElementById("aireFields").classList.toggle("hidden", key !== "aires");
      document.getElementById("infraFields").classList.toggle("hidden", key !== "infraestructura");
      document.getElementById("servicioFields").classList.toggle("hidden", !["equipo_general", "biomedico"].includes(key));
      for (const el of document.querySelectorAll("#aireFields input, #infraFields input, #servicioFields input")) el.disabled = el.closest(".hidden") !== null;
      const list = document.getElementById("categoriasList");
      list.replaceChildren(...(categoriasPorArea[key] ?? []).map((c) => { const option = document.createElement("option"); option.value = c; return option; }));
    }
    areaSel.addEventListener("change", actualizarArea);
    actualizarArea();

    // Sucursal → ubicación y centros de costo de esa sede (o sin sede)
    const sucEl = document.getElementById("sucursalSel");
    const ubEl = document.getElementById("ubicacionSel");
    const centroSel = document.getElementById("centroCostoSel");

    function poblarUbicaciones(sucId, selectId) {
      if (!ubEl) return;
      const filtered = sucId ? allUbs.filter((u) => u.sucursalId === sucId) : [];
      ubEl.innerHTML = '<option value="">— Seleccionar —</option>';
      filtered.forEach((u) => {
        const o = document.createElement("option");
        o.value = u.id;
        o.textContent = `${u.nombre} (${u.tipo})`;
        if (u.id === selectId) o.selected = true;
        ubEl.appendChild(o);
      });
    }
    // Al abrir se conserva el centro que ya tiene; al cambiar de sede, uno de otra sede se quita.
    function filtrarCentros(conservar) {
      const sid = sucEl?.value ?? "";
      for (const o of centroSel.options) {
        if (!o.value) continue;
        const visible = !sid || !o.dataset.sucursal || o.dataset.sucursal === sid || (conservar && o.selected);
        o.hidden = !visible;
        o.disabled = !visible;
        if (!visible && o.selected) centroSel.value = "";
      }
    }

    if (sucEl) {
      // Inicializa con la sucursal actual y selecciona la ubicación actual
      poblarUbicaciones(sucursalActualId, ubicacionActualId);
      filtrarCentros(true);
      sucEl.addEventListener("change", () => {
        poblarUbicaciones(Number(sucEl.value) || null, null);
        filtrarCentros(false);
      });
    }

    // Registro sanitario: «no requiere» oculta los demás campos; «Otra» pide cuál.
    const noRequiere = document.getElementById("registroNoRequiere");
    const entidadSel = document.getElementById("registroEntidad");
    const otraBox = document.getElementById("registroEntidadOtraBox");
    function pintarRegistro() {
      for (const el of document.querySelectorAll(".registro-campo")) el.classList.toggle("hidden", noRequiere.checked);
      otraBox.classList.toggle("hidden", noRequiere.checked || entidadSel.value !== "__otra__");
    }
    noRequiere.addEventListener("change", pintarRegistro);
    entidadSel.addEventListener("change", pintarRegistro);
    pintarRegistro();

    // Serie repetida (sin contar este equipo): solo avisa.
    const serialEl = document.getElementById("serial");
    const serieAviso = document.getElementById("serieAviso");
    const ESTADO = { operativo: "Operativo", averiado: "Averiado", mantenimiento: "En mantenimiento", baja: "Dado de baja" };
    serialEl.addEventListener("blur", async () => {
      serieAviso.classList.add("hidden");
      const valor = serialEl.value.trim();
      if (!valor) return;
      try {
        const r = await fetch(`/api/activos/serie?valor=${encodeURIComponent(valor)}&excluir=${id}`);
        if (!r.ok) return;
        const { coincidencias } = await r.json();
        if (!coincidencias?.length) return;
        const lista = coincidencias.map((c) => `${c.codigo} · ${c.nombre} (${ESTADO[c.estado] ?? c.estado})`).join("; ");
        serieAviso.textContent = `Esta serie ya está registrada en ${lista}. Revisa que no sea el mismo equipo.`;
        serieAviso.classList.remove("hidden");
      } catch { /* sin conexión: no se avisa */ }
    });

    const err = document.getElementById("err");
    const mostrarError = (texto) => { err.textContent = texto; err.classList.remove("hidden"); err.focus(); };
    document.getElementById("form").addEventListener("submit", async (e) => {
      e.preventDefault();
      err.classList.add("hidden");
      const v = (id) => document.getElementById(id)?.value?.trim() ?? "";
      const sv = (id) => document.getElementById(id)?.value ?? "";
      const num = (id) => { const x = sv(id); return x === "" ? null : Number(x); };
      const isBio = sv("tipo") === "biomedico";
      const ubVal = ubEl?.value;
      const provVal = document.getElementById("proveedorSel")?.value;

      // Fase 59: nunca se mandan las fechas de calibración (las escribe Calibraciones).
      const payload = {
        nombre: v("nombre"),
        descripcion: v("descripcion") || null,
        ubicacion: v("ubicacion") || null,
        tipo: sv("tipo"),
        rubro: sv("rubro"),
        datosTecnicos: sv("rubro") === "aires" ? { tipoUnidad: v("tipoUnidad") || null, capacidadBtuH: v("capacidadBtuH") ? Number(v("capacidadBtuH")) : null, refrigerante: v("refrigerante") || null }
          : sv("rubro") === "infraestructura" ? { tipoInstalacion: v("tipoInstalacion") || null, sector: v("sector") || null }
          : { servicio: v("servicio") || null },
        categoria: v("categoria") || null,
        numeroActivo: v("numeroActivo") || null,
        marca: v("marca") || null,
        modelo: v("modelo") || null,
        serial: v("serial") || null,
        anio: num("anio"),
        ubicacionId: ubVal ? Number(ubVal) : null,
        centroCostoId: sv("centroCostoSel") ? Number(sv("centroCostoSel")) : null,
        proveedorId: provVal ? Number(provVal) : null,
        slaUrgenteHoras: Number(sv("slaUrgenteHoras") || 4),
        slaAltaHoras: Number(sv("slaAltaHoras") || 24),
        slaMediaHoras: Number(sv("slaMediaHoras") || 72),
        slaBajaHoras: Number(sv("slaBajaHoras") || 168),
        fechaAdquisicion: v("fechaAdquisicion") || null,
        vidaUtilAnios: num("vidaUtilAnios"),
        valorAdquisicion: num("valorAdquisicion"),
        responsableId: document.getElementById("responsableSel")?.value ? Number(document.getElementById("responsableSel").value) : null,
        criticidadOperacional: sv("criticidadOperacional") || "media",
      };
      // Un equipo patrón siempre requiere calibración: la casilla no se manda.
      if (!esPatron) payload.requiereCalibracion = document.getElementById("requiereCalibracion")?.checked ?? false;
      // Un equipo de baja no cambia de estado aquí: se revierte en su pantalla de baja.
      if (!deBaja) payload.estado = sv("estado");
      if (isBio) {
        if (!sv("claseRiesgo")) { mostrarError("Elige la clase de riesgo."); document.getElementById("claseRiesgo")?.focus(); return; }
        payload.claseRiesgo = sv("claseRiesgo");
        payload.subcategoria = sv("subcategoria") || null;
        if (noRequiere.checked) {
          payload.registroSanitarioNoRequiere = true;
        } else {
          const emision = v("registroEmision"), vence = v("registroVencimiento");
          if (emision && vence && vence < emision) { mostrarError("El vencimiento no puede ser anterior a la emisión."); return; }
          const entidad = sv("registroEntidad") === "__otra__" ? v("registroEntidadOtra") : sv("registroEntidad");
          payload.registroSanitarioNoRequiere = false;
          payload.registroSanitario = v("registroSanitario") || null;
          payload.registroSanitarioEntidad = entidad || null;
          payload.registroSanitarioEmision = emision || null;
          payload.registroSanitarioVencimiento = vence || null;
        }
      } else {
        payload.claseRiesgo = null;
        payload.subcategoria = null;
        payload.registroSanitario = null;
        payload.registroSanitarioEntidad = null;
        payload.registroSanitarioEmision = null;
        payload.registroSanitarioVencimiento = null;
        payload.registroSanitarioNoRequiere = false;
      }
      // El código se manda solo si la jefatura o el administrador lo cambiaron.
      const codigoEl = document.getElementById("codigo");
      if (gestiona && codigoEl && codigoEl.value.trim().toUpperCase() !== String(codigoEl.dataset.original ?? "").trim().toUpperCase()) {
        if (!codigoEl.value.trim()) { mostrarError("El código no puede quedar vacío."); codigoEl.focus(); return; }
        if (!confirm("Cambiar el código no cambia el historial. Las etiquetas, viñetas y certificados impresos quedan con el código anterior. ¿Continuar?")) return;
        payload.codigo = codigoEl.value.trim();
      }

      const res = await fetch(`/api/activos/${id}`, {
        method: "PATCH",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        const j = await res.json().catch(() => ({}));
        mostrarError(typeof j.error === "string" ? j.error : "No se pudo guardar.");
        return;
      }
      location.href = `/activos/${id}?area=${encodeURIComponent(sv("rubro"))}`;
    });
  </script>
</Layout>
