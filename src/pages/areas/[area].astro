---
import Layout from "@/layouts/Layout.astro";
import AppIcon from "@/components/AppIcon.astro";
import { parseArea, AREAS, areaHref, activoAreaCondition } from "@/lib/areas";
import { getDb } from "@/lib/db";
import { activos, ordenes, tickets } from "@/lib/schema";
import { sql, eq, and, desc, inArray, or, isNull } from "drizzle-orm";
import { ESTADO_LABEL, ESTADO_COLOR } from "@/lib/ordenes";
import { CRITICIDAD_LABEL, CRITICIDAD_COLOR } from "@/lib/inventario-jci";
export const prerender = false;
const area = parseArea(Astro.params.area);
if (!area) return new Response("Área no encontrada",{status:404});
const info = AREAS[area];
const db=getDb(Astro), user=Astro.locals.user!;
const isTech=user.rol==="tecnico";
const assetWhere=activoAreaCondition(area);
const [assetStats]=await db.select({n:sql<number>`count(*)`,alta:sql<number>`sum(case when ${activos.criticidadOperacional}='alta' then 1 else 0 end)`}).from(activos).where(assetWhere);
const orderWhere=and(eq(ordenes.rubro,area),inArray(ordenes.estado,["abierta","en_proceso","en_espera","completada"]),isTech?eq(ordenes.asignadoA,user.id):undefined);
const [orderStats]=await db.select({n:sql<number>`count(*)`}).from(ordenes).where(orderWhere);
const [ticketStats]=await db.select({n:sql<number>`count(*)`}).from(tickets).where(and(eq(tickets.rubro,area),inArray(tickets.estado,["nuevo","asignado","en_proceso"]),isTech?or(eq(tickets.asignadoA,user.id),isNull(tickets.asignadoA)):undefined));
const recent=await db.select({o:ordenes,a:activos}).from(ordenes).leftJoin(activos,eq(activos.id,ordenes.activoId)).where(orderWhere).orderBy(desc(ordenes.id)).limit(6);
const canPlan=["admin","jefe","tecnico","visualizador"].includes(user.rol);
const isOperativo=["admin","jefe","tecnico"].includes(user.rol);
const canCreate=["admin","tecnico"].includes(user.rol);
---
<Layout title={`${info.label} · Mantenimiento`}>
  <div class="workspace-heading"><div><h1>Resumen de {info.label}</h1><p>{info.description}</p></div>{canCreate&&<a class="btn-primary" href={areaHref("/activos/nuevo",area)}>+ {info.createLabel}</a>}</div>
  <div class="workspace-stats">
    <a href={areaHref("/activos",area)}><span>{info.inventoryLabel}</span><strong>{Number(assetStats?.n??0)}</strong><small>{Number(assetStats?.alta??0)} de criticidad alta</small></a>
    <a href={areaHref("/ordenes",area)}><span>Órdenes abiertas</span><strong>{Number(orderStats?.n??0)}</strong><small>Trabajo de esta área</small></a>
    <a href={areaHref("/tickets",area)}><span>Solicitudes pendientes</span><strong>{Number(ticketStats?.n??0)}</strong><small>Por atender o en seguimiento</small></a>
  </div>
  <section class="card mt-6 overflow-hidden"><div class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4"><h2 class="font-medium">Trabajo de {info.label}</h2><a class="text-sm text-brand-700" href={areaHref("/ordenes",area)}>Ver órdenes →</a></div>
    {recent.length===0?<div class="workspace-empty"><span class="area-symbol"><AppIcon name={info.icon}/></span><h3>Todo listo para comenzar</h3><p>Registra {info.inventoryLabel.toLowerCase()}, recibe solicitudes y programa el mantenimiento de esta área.</p><a class="btn-secondary" href={areaHref("/soporte",area)}>Nueva solicitud</a></div>:<ul class="divide-y divide-slate-100">{recent.map(({o,a})=><li><a class="area-work-row" href={areaHref(`/ordenes/${o.id}`,area)}><div><strong>{o.titulo}</strong><small>OT #{o.id}{a?` · ${a.nombre}`:" · Trabajo por ubicación"}</small></div><div class="flex flex-wrap items-center gap-2">{a?.criticidadOperacional&&<span class={`badge ${CRITICIDAD_COLOR[a.criticidadOperacional]}`}>Criticidad {CRITICIDAD_LABEL[a.criticidadOperacional].toLowerCase()}</span>}<span class={`badge ${ESTADO_COLOR[o.estado]}`}>{ESTADO_LABEL[o.estado]}</span></div></a></li>)}</ul>}
  </section>
  {canPlan && <div class="mt-5 flex flex-wrap gap-3"><a class="btn-secondary" href={areaHref("/cronograma",area)}>Calendario</a><a class="btn-secondary" href={areaHref("/actividades",area)}>Actividades por ubicación</a>{area==="infraestructura"&&<a class="btn-secondary" href="/electrico">Sistemas eléctricos</a>}<a class="btn-secondary" href={areaHref("/plan-mantenimiento",area)}>Plan anual</a>{isOperativo && <a class="btn-secondary" href="/proyectos">Proyectos</a>}</div>}
</Layout>
