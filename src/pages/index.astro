---
import Layout from "@/layouts/Layout.astro";
import AppIcon from "@/components/AppIcon.astro";
import { AREA_KEYS, AREAS, activoAreaExpression } from "@/lib/areas";
import { getDb } from "@/lib/db";
import { activos, ordenes } from "@/lib/schema";
import { sql, eq, and, inArray } from "drizzle-orm";
import CadenaAhora from "@/components/CadenaAhora.astro";
import { bloqueRonda, estadoAhora, ordenarPorTono, tituloAhora, type BloqueAhora } from "@/lib/ahora";
import { datosTablero, leerFiltros, esJefatura, DIAS_POR_DEFECTO } from "@/lib/preventivos";
export const prerender = false;
const db = getDb(Astro);
const user = Astro.locals.user!;
const now = new Date();
const isTech = user.rol === "tecnico";
const assetCounts = await db.select({area:activoAreaExpression,n:sql<number>`count(*)`}).from(activos).groupBy(activoAreaExpression);
const orderCounts = await db.select({area:ordenes.rubro,n:sql<number>`count(*)`}).from(ordenes).where(and(inArray(ordenes.estado,["abierta","en_proceso","en_espera","completada"]),isTech?eq(ordenes.asignadoA,user.id):undefined)).groupBy(ordenes.rubro);
const count = (rows: {area:string|null,n:number}[], area:string) => Number(rows.find(r=>r.area===area)?.n??0);
// «Ahora mismo»: la cadena de los cinco documentos, lo primero para la jefatura.
let bloquesAhora: BloqueAhora[] = [];
let ahoraNoDisponible = false;
try {
  if (["admin", "jefe"].includes(user.rol)) {
    bloquesAhora = ordenarPorTono(await estadoAhora(db, { usuarioId: user.id, rol: user.rol, sucursalId: null, soloMias: false, incluirCobertura: true }));
  } else if (user.rol === "visualizador") {
    // Quien supervisa ve si se hizo la ronda; AOP y EOP no son de su rol.
    bloquesAhora = [await bloqueRonda(db)];
  }
} catch {
  ahoraNoDisponible = true;
  console.error("ahora_unavailable");
}
// Tablero de preventivos: el aviso de la jefatura.
let preventivos: { sinAsignar: number; asignados: number; programados: number; programadosSinAsignar: number } | null = null;
if (esJefatura(user.rol)) {
  try {
    const d = await datosTablero(db, leerFiltros(new URLSearchParams()).filtros);
    preventivos = { sinAsignar: d.atrasados.sinAsignar.length, asignados: d.atrasados.asignados.length, programados: d.programados.length, programadosSinAsignar: d.programados.filter((f) => !f.tecnico).length };
  } catch {
    console.error("preventivos_unavailable");
  }
}
// El visualizador solo consulta la ronda: su resumen no puede hablar de desviaciones ni de emergencias.
const resumenAhora = !bloquesAhora.length ? null
  : user.rol === "visualizador" ? { texto: bloquesAhora[0].detalle, tono: bloquesAhora[0].tono }
  : tituloAhora(bloquesAhora);
---
<Layout title="Panorama general">
  <div class="workspace-heading"><div><span class="area-eyebrow">Operación</span><h1>Panorama general</h1><p>Elige el área en la que vas a trabajar.</p></div><span class="workspace-date">{now.toLocaleDateString("es-SV",{day:"numeric",month:"long",timeZone:"America/El_Salvador"})}</span></div>
  {resumenAhora && <div class="mb-6"><CadenaAhora bloques={bloquesAhora} resumen={resumenAhora} /></div>}
  {ahoraNoDisponible && <section class="card mb-6 p-5" aria-labelledby="ahora-no-disponible"><h2 id="ahora-no-disponible" class="font-semibold">Ronda de turno</h2><p class="mt-2 text-sm text-slate-600">No se pudo cargar el estado de la ronda. Recarga la página o consulta el tablero.</p><a class="mt-3 inline-block text-sm font-semibold text-emerald-800 underline" href="/ronda">Abrir el tablero</a></section>}
  {preventivos && (
    <a href="/preventivos" class:list={["card mb-6 flex flex-wrap items-center justify-between gap-3 border-l-4 p-5 hover:shadow-md", preventivos.sinAsignar + preventivos.asignados > 0 ? "border-red-500" : "border-emerald-500"]}>
      <div>
        <h2 class="font-semibold">Tablero de preventivos</h2>
        <p class="mt-1 text-sm text-slate-600">
          {preventivos.sinAsignar + preventivos.asignados > 0
            ? `${preventivos.sinAsignar + preventivos.asignados} atrasados de 1 día o más (${preventivos.sinAsignar} sin asignar).`
            : "Sin preventivos atrasados."}
          {` ${preventivos.programados} programados en los próximos ${DIAS_POR_DEFECTO} días`}{preventivos.programadosSinAsignar ? `, ${preventivos.programadosSinAsignar} sin técnico.` : "."}
        </p>
      </div>
      <span class="text-sm font-semibold text-brand-700">Asignar técnicos →</span>
    </a>
  )}
  <h2 class="mb-4 text-lg font-semibold">Áreas de mantenimiento</h2>
  <div class="workspace-grid">
    {AREA_KEYS.map(key=><a href={`/areas/${key}`} class="workspace-card"><span class="area-symbol"><AppIcon name={AREAS[key].icon} size={24}/></span><h3>{AREAS[key].label}</h3><p>{AREAS[key].description}</p><div class="workspace-counts"><span>{count(assetCounts,key)} {AREAS[key].inventoryLabel.toLowerCase()}</span><span>{count(orderCounts,key)} órdenes abiertas</span></div><span class="workspace-enter">Entrar al área <AppIcon name="arrow" size={18}/></span></a>)}
  </div>
  <div class="workspace-footer"><span>Usuarios, ubicaciones y recursos compartidos.</span><a href="/mi-panel">Ver mi trabajo →</a></div>
</Layout>
<style>
  .workspace-card h3 { font-size:21px; letter-spacing:-.4px; font-weight:500; }
</style>
