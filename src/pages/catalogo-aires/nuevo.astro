---
import ConjuntoShell from "@/components/ConjuntoShell.astro";
import CatalogoAireFields from "@/components/CatalogoAireFields.astro";
import UppercaseFields from "@/components/UppercaseFields.astro";
import { areaHref } from "@/lib/areas";
export const prerender = false;
const user = Astro.locals.user;
if (!user) return Astro.redirect("/login");
if (!["admin", "tecnico"].includes(user.rol)) return new Response("Solo administración y técnicos pueden crear fichas del catálogo.", { status: 403 });
if (Astro.url.searchParams.get("area") !== "aires") return Astro.redirect(areaHref(Astro.url.pathname + Astro.url.search, "aires"));
---
<ConjuntoShell title="Crear ficha de aire acondicionado">
  <a class="cq-link" href="/catalogo-aires?area=aires">← Volver al catálogo de aires</a>
  <header class="cq-head"><div><p class="cq-eyebrow">Aire acondicionado · Catálogo</p><h1>Crear ficha de modelo</h1><p class="cq-muted mt-2">Estos datos servirán para completar nuevas unidades del mismo modelo.</p></div></header>
  <form id="crearFichaAire" class="cq-panel cq-form">
    <CatalogoAireFields />
    <div class="cq-notice mt-6">La serie, ubicación, criticidad y mantenimiento se registran en cada unidad. Esta ficha solo contiene las características comunes del producto.</div>
    <p id="fichaError" class="cq-error mt-4" role="alert" tabindex="-1"></p>
    <div class="cq-actions mt-6"><button class="btn-primary" type="submit">Guardar ficha de modelo</button><a class="btn-secondary" href="/catalogo-aires?area=aires">Cancelar</a></div>
  </form>
  <UppercaseFields />
</ConjuntoShell>
<script>
  import { datosFichaAire, errorFichaAire } from "@/components/catalogo-aire-form";
  const form = document.querySelector<HTMLFormElement>("#crearFichaAire");
  let saving = false;
  form?.addEventListener("submit", async event => {
    event.preventDefault();
    if (saving) return;
    const error = document.querySelector<HTMLElement>("#fichaError")!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    error.textContent = "";
    const payload = datosFichaAire(form);
    if (!payload.nombre) { error.textContent = "Escribe un nombre para reconocer esta ficha."; error.focus(); return; }
    saving = true;
    button.disabled = true;
    button.textContent = "Guardando…";
    try {
      const result = await fetch("/api/catalogo-aires", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
      const json = await result.json().catch(() => ({}));
      if (!result.ok) throw new Error(errorFichaAire(json, "No se pudo guardar la ficha. Revisa los datos e inténtalo de nuevo."));
      if (!Number.isSafeInteger(json.modelo?.id)) throw new Error("Se recibió la solicitud, pero no se pudo abrir la ficha. Consulta el catálogo antes de volver a crearla.");
      window.location.assign(`/catalogo-aires/${json.modelo.id}?area=aires`);
    } catch (cause) {
      error.textContent = cause instanceof TypeError ? "No se pudo confirmar el guardado. Revisa tu conexión y consulta el catálogo antes de intentarlo otra vez." : cause instanceof Error ? cause.message : "No se pudo guardar la ficha. Consulta el catálogo antes de intentarlo otra vez.";
      error.focus();
      saving = false;
      button.disabled = false;
      button.textContent = "Guardar ficha de modelo";
    }
  });
</script>
