---
import Layout from "@/layouts/Layout.astro";
import DocCabecera from "@/components/DocCabecera.astro";
import DocFolio from "@/components/DocFolio.astro";
export const prerender = false;

const user = Astro.locals.user!;
const esAdminOJefe = user.rol === "admin" || user.rol === "jefe";

type Seccion = { icono: string; titulo: string; solo?: "adminjefe"; pasos: { t: string; d: string }[] };

const secciones: Seccion[] = [
  {
    icono: "",
    titulo: "Modo técnico: el trabajo desde el celular",
    pasos: [
      { t: "Entrar", d: "Abre mantenimiento.complejoavante.dev en Android o iPhone con tu usuario. Puedes agregarla a la pantalla de inicio: desde Ayuda en Android y con Compartir → Agregar a inicio en iPhone." },
      { t: "Hoy", d: "Muestra una sola cosa por hacer: una emergencia primero, después la ronda del turno y luego tu siguiente orden. Debajo está el resto del día, agrupado por ubicación." },
      { t: "Tiempos", d: "El celular no muestra cronómetro ni minutos estimados. Cada toque se guarda con su hora real y tu jefatura lo ve en la ficha. En una emergencia, una hora que ya tocaste no se cambia desde el celular: si quedó mal, la corrige tu jefatura. Sí verás «Vence…», «Actuar antes de» y «Escalar antes de». «Pausar» pide el motivo. Con eso se escribe solo el reporte de mantenimiento." },
      { t: "Emergencia", d: "En Hoy toca «Atender la emergencia»; arriba dice «Vence…». Al llegar, toca «Ya estoy en el sitio». Sigue las acciones del documento, una por pantalla: «Hecho» o «No se pudo» (escribe por qué). En «¿Ya está controlado?» toca «Sí» cuando la situación ya no empeore; si todavía no, la emergencia sigue primera en Hoy. En «¿Volvió a la normalidad?» toca «Sí, restablecido»; si todavía no, déjala en pausa con su motivo. Al final escribe qué encontraste y qué hiciste (puedes dictarlo) y agrega una foto si quieres. La causa raíz la escribe tu jefatura. Si hay otra emergencia, aparece debajo con «Atender» o «Seguir»; se ven hasta dos y, si hay más, dice «y N más en Hoy». Arriba queda la que estás atendiendo; si no atiendes ninguna, la que vence primero entre las que nadie atiende; si todas están en pausa, la pausada que vence primero." },
      { t: "Intervención", d: "Al abrirla ves cuántos permisos van («2 de 7 permisos cumplidos») y el que sigue. Registra cada uno con su referencia (n.º de permiso, candado…). «Empezar» aparece cuando los obligatorios están cumplidos. Al terminar, anota cada lectura de liberación; si tiene rango, escribe el número que marcó el instrumento. Si una lectura sale fuera de rango, el celular dice «No libera»: repite la lectura, marca que ejecutaste el plan de reversa o deja la orden en espera. Al cerrar, las lecturas se resumen en una línea." },
      { t: "Ronda y cambio de turno", d: "Si el turno cambia mientras estás dentro de la ronda, puedes terminarla y firmarla, con señal o sin ella: lo que anotas queda en esa ronda. Si la sede sigue haciendo ronda, al volver a Hoy aparece la del turno nuevo: la anterior ya no se ofrece aunque no la hayas firmado, y lo que anotaste en ella quedó guardado. Si sigues en una ronda que ya venció, el celular dice «Esa ronda ya venció. Lo que anotaste quedó guardado.» y vuelve a Hoy. Si tu jefatura marcó que la sede ya no hace ronda, desde el turno siguiente no se abre una nueva. La que ya empezaste puedes terminarla mientras sigas dentro de ella; sin señal, Hoy la sigue mostrando con el aviso «Desde el turno de las 14:00 esta sede no hace ronda.» hasta que la firmes." },
      { t: "Números", d: "Escribe los números sin separador de miles: 1200, no 1,200 ni 1.200. El decimal va con coma o con punto: 14,5 o 14.5. Si un número se puede leer de dos formas, el celular pregunta cuál es («¿1200 o 1,2?») y no lo guarda hasta que lo escribas sin separador. Vale en la ronda, en los pasos, en las lecturas de liberación y en el valor de una desviación. En un paso con rango escribe solo el número: la unidad ya está al lado del campo. Si escribes otra cosa («14,5 A», «ok»), el celular pide el número que marcó el instrumento y no lo guarda. Un número guardado con tres decimales vuelve a aparecer con un cero más, 12.3450, para que no se lea como miles." },
      { t: "Lo que escribes no se pierde", d: "Se guarda en el celular mientras escribes. Si recargas, cierras la app, vas a otra página o se va la señal, vuelves a la misma pantalla con tu texto y tus fotos. «Cancelar» en una hoja borra lo que escribiste y las fotos que tomaste en ella; lo que ya habías anotado se queda. Una foto que tomas en una hoja va con lo que anotas en ella, aunque toques «Anotar y seguir» mientras dice «Reduciendo la foto…»; si cancelas la hoja antes, esa foto no se envía. Si el sistema no acepta un registro, el texto vuelve a su orden para que lo corrijas: «Ver por qué» dice de qué orden es y el motivo, y la abre. Si la orden ya no se puede trabajar, no la abre: dice por qué (ya no está a tu nombre, se canceló o ya no se puede trabajar en tu celular) y lo que escribiste queda ahí para tu jefatura." },
      { t: "Buscar equipo", d: "Para un mantenimiento que no está en la lista: sede → ubicación → equipo. El escaneo de códigos está inhabilitado hasta que los equipos tengan su etiqueta GS1 Data Matrix." },
      { t: "Reportar falla", d: "Eliges el equipo o el sistema y el sistema dice qué documento manda y las tres primeras acciones. La emergencia y el correctivo quedan abiertos con su hora y vencen según el equipo y la prioridad, desde la hora en que los reportaste." },
      { t: "Sin señal", d: "Sigue trabajando. Todo se guarda en el celular con la hora real y se envía solo cuando vuelve la señal. La ronda cambia de turno sola, también sin señal. Solo buscar un equipo por primera vez y abrir una orden nueva desde la búsqueda necesitan señal. Una emergencia que reportas sin señal queda anotada con su hora y se trabaja paso a paso cuando el celular la envía." },
    ],
  },
  {
    icono: "",
    solo: "adminjefe",
    titulo: "Reporte de mantenimiento",
    pasos: [
      { t: "De una orden", d: "En la orden, «Reporte de mantenimiento»: equipo, inicio, fin, tiempo de trabajo, pausas, cada paso con su hora, lecturas, novedades, fotos y firmas. Se imprime o se guarda en PDF. En el historial, varios guardados seguidos de la causa raíz por la misma persona salen en una sola fila; si la causa quedó vacía, la fila dice «Causa raíz borrada». En el reporte de una emergencia, una acción que no se pudo hacer dice «No se pudo»." },
      { t: "De un periodo", d: "Indicadores y reportes → Reportes → «Reporte de mantenimiento». Filtra por fecha, sede, área, técnico y tipo. Se imprime o se descarga en CSV." },
    ],
  },
  {
    icono: "",
    solo: "adminjefe",
    titulo: "Ronda de turno: crear y cambiar el recorrido",
    pasos: [
      { t: "Dónde", d: "Ronda de turno → «Paradas del recorrido». Arriba dice qué editas: «Modelo», que usan todas las sedes sin recorrido propio, o «Recorrido propio» de una sede, que ya no recibe cambios del modelo." },
      { t: "Cambiar una parada", d: "«Editar» abre la ventana con todo: qué se verifica, instrucción, familia, si pide un número o es conforme/no conforme, unidad, mínimo y máximo o qué se considera conforme, AOP, crítica, activa, fuente y línea del SOP. En «Más opciones» van los minutos para actuar y escalar; vacíos, rigen los del AOP. Guardar no recarga la página." },
      { t: "Agregar, ordenar y quitar", d: "«+ Agregar parada» la pone al final. «Subir» y «Bajar» ordenan el recorrido. Una parada no se borra: se desactiva, y lo ya anotado se conserva." },
      { t: "Turnos", d: "Se escriben en HH:MM separados por coma, en el modelo o en el recorrido propio. Los turnos nuevos entran cuando empieza el primero de la lista nueva; hasta entonces siguen los de antes. Un turno de antes que empezaría menos de 2 horas antes del primer turno nuevo no se abre: el turno que corre sigue hasta el nuevo. Al guardar, la pantalla dice qué turno sigue y hasta qué hora, por ejemplo: «Los turnos nuevos entran a las 14:30 del 07/11/2026. El turno de las 06:00 sigue hasta esa hora; el de las 14:00 no se abre.» Si después cambias otra vez los turnos o cancelas el cambio, un turno que no se abrió y cuya hora ya pasó sigue sin abrirse. Si cancelas cuando ya pasó esa hora, la pantalla lo dice, también al volver a «Paradas del recorrido»: «Siguen los turnos de ahora. El turno de las 06:00 sigue hasta las 22:00; el de las 14:00 no se abre.» Si cancelas antes, ese turno se abre como siempre. Lo que el técnico anotó sin señal en el turno que corría se acepta cuando vuelve la señal." },
      { t: "Ronda sin firmar al cambiar el turno", d: "Lo anotado no se pierde: cada parada queda con la hora en que se anotó, y el servidor acepta después lo que llegue sin señal y la firma. El técnico puede terminarla y firmarla mientras siga dentro de ella, aunque ya corra otro turno, hasta 16 h después del inicio de su turno. Si la sede sigue haciendo ronda y el técnico sale de ella, el celular pasa a la del turno que corre: la anterior ya no se retoma desde el celular. En el tablero y en la revisión semanal ese turno queda «Incompleta» desde que empieza el siguiente hasta que se firma." },
      { t: "Sedes", d: "«Esta sede no hace ronda» entra en el siguiente turno que empieza. Desde ese turno el celular ya no abre una ronda nueva, aunque esté sin señal; un celular que no se actualizó con señal desde la marca todavía no lo sabe. La que ya empezó se puede terminar mientras el técnico siga dentro de ella. Si sale, con señal deja de aparecer cuando Hoy se actualiza; sin señal, Hoy la sigue mostrando con el aviso «Desde el turno de las 14:00 esta sede no hace ronda.» hasta que se firma. El servidor acepta sus lecturas y su firma. «Esta sede sí hace ronda» la devuelve. Ninguna de las dos copia nada. «Crear recorrido propio» copia el modelo y pide confirmación: desde ahí la sede ya no recibe cambios del modelo, y no se deshace desde esta pantalla. Una ronda que el técnico ya empezó sin señal se guarda con el recorrido que tenía." },
      { t: "Cuándo rige un cambio", d: "Un cambio entra en la ronda del turno que todavía no empezó; la ronda que ya empezó conserva lo que decía al abrir. La revisión semanal juzga cada turno con lo que regía cuando empezó. Evita apagar una parada o cambiarle el rango a mitad de un turno: si un técnico la anotó sin señal, esa lectura puede no entrar o juzgarse con el rango nuevo." },
    ],
  },
  {
    icono: "",
    titulo: "Tickets — reportar un problema",
    pasos: [
      { t: "Crear un ticket", d: "Menú Tickets → «+ Nuevo ticket». Describe el problema, indica la sede/ubicación y adjunta foto si ayuda. El equipo de mantenimiento lo recibe al instante." },
      { t: "Dar seguimiento", d: "En la lista de Tickets ves el estado de cada reporte y los días transcurridos (verde <7, ámbar 7-13, rojo ≥14). Entra al ticket para ver comentarios y avances." },
      { t: "Convertir en orden de trabajo (jefe/admin)", d: "Dentro del ticket usa «Generar OT» para crear la orden con el equipo y técnico correspondientes. El ticket queda vinculado y se cierra solo cuando la OT se completa." },
    ],
  },
  {
    icono: "",
    titulo: "Órdenes de trabajo (OT)",
    pasos: [
      { t: "Crear una OT", d: "Menú Órdenes → «+ Nueva orden». Elige tipo (correctivo/preventivo), prioridad, equipo y técnico asignado. Cada orden tiene un código fijo: OT-MG0001 en Mantenimiento General y OT-MB0001 en Biomédico." },
      { t: "Ejecutar una OT (técnico)", d: "En el celular, Hoy → «Empezar». Cada paso se marca con «Hecho» o, si pide lectura, con «Guardar lectura», y al final «Enviar a verificación». Si a un paso que pide lectura le falta, el celular no envía: te lleva a ese paso y dice «Escribe la lectura para seguir.» Lo mismo si en un paso con rango lo anotado no es un número: dice «Este paso tiene rango: anota el número que marcó el instrumento (por ejemplo 14,5).» Las emergencias y las intervenciones también se trabajan en el celular, paso a paso; la ficha completa de la orden queda para la jefatura." },
      { t: "Causa raíz (jefatura)", d: "En las emergencias y en los correctivos de equipos de criticidad alta, la jefatura escribe la causa raíz en la ficha de la orden, en «Causa raíz · la escribe la jefatura», dentro de las 72 h. En proceso o en espera se guarda como borrador. Enviada, verificada o cerrada, no puede quedar vacía ni con menos de 20 caracteres: la ficha dice cuántos faltan. Es obligatoria para verificar y cerrar. El técnico no la escribe ni la borra: solo escribe qué encontró y qué hizo." },
      { t: "Horas de la emergencia (jefatura)", d: "En una emergencia reportada desde el celular, la hora de alarma es la del reporte. La llegada, la situación controlada y el restablecimiento quedan con la hora del primer toque del técnico en el celular, también sin señal. Si una hora quedó mal, la jefatura la corrige en la ficha, también la de alarma; el técnico no puede escribir una hora a mano ni cambiar una ya registrada. «Guardar horas» guarda solo lo que cambiaste: lo que el técnico registró mientras tanto se conserva. Si cambias una hora mientras se guarda otra, la tuya queda en pantalla y la ficha dice «Guardado. Falta guardar lo último que escribiste.»; pasa lo mismo con la reversa." },
      { t: "Intervención sin lectura (jefatura)", d: "Si una lectura de liberación no se pudo tomar, la jefatura usa «Enviar a verificación sin lectura» y escribe el motivo. La orden queda pendiente de verificación, no cerrada, y quien verifica no vuelve a escribir el motivo. Una lectura fuera de rango no se salva así: se repite la medición o se marca la reversa." },
      { t: "Ficha de la orden (jefatura)", d: "Cada paso del checklist lleva su número («Paso 2»), el mismo que ve el técnico en el celular. Marcar un paso en la ficha no deshace lo que el técnico marcó en el celular; si el checklist cambió de forma, la ficha pide volver a cargarla. Si mientras tanto alguien cambió lo mismo en un paso que marcaste (por ejemplo, el técnico marcó una desviación desde el celular), tu marca en ese paso no se guarda: el paso queda como está guardado y el checklist avisa «El paso 2 cambió mientras tanto: revísalo y márcalo otra vez.» Lo demás que marcaste se guarda. Lo que marcas sin señal queda guardado en el equipo y se manda la próxima vez que abres la ficha, salvo un paso que cambió mientras tanto: ese lleva el mismo aviso. La reversa: el técnico escribe el plan desde que la orden está abierta y la marca después de empezar; enviada a verificación, la registra la jefatura, y cerrada o cancelada ya no se cambia. Si el técnico registra la reversa en el celular después de que la marcaste, sus notas se agregan debajo de las tuyas como «Técnico (celular): …»." },
      { t: "Lecturas en la ficha (jefatura)", d: "Una lectura con rango se anota solo con el número, con coma o punto decimal y sin separador de miles: «aprox 14 A» o «1,200» no se aceptan. Una lectura obligatoria con rango que quedó escrita así antes dice «Sin lectura — bloquea el cierre» y cuenta como lectura que falta al enviar a verificación o al cerrar; si no se midió, marca el paso N/A." },
      { t: "Enviar a verificación desde la ficha (jefatura)", d: "«Enviar a verificación» lleva también lo que marcaste y todavía no se guardaba. Si uno de esos pasos cambió mientras tanto, la orden no se envía, también con «Enviar a verificación sin lectura». La ficha no se vuelve a cargar: el checklist muestra ese paso como está guardado y avisa «El paso 2 cambió mientras tanto: revísalo y vuelve a enviar.» Lo demás que marcaste se guarda solo, y el motivo sin lectura que escribiste se queda. Revisa ese paso y vuelve a enviarla." },
      { t: "Seguimiento", d: "La columna «Días» muestra cuánto lleva asignada cada OT con semáforo de colores. Usa «Ver cerradas» para consultar el histórico." },
      { t: "Cierre administrativo (solo admin)", d: "Para OTs que se trabajaron fuera del sistema: botón en la OT o selección múltiple en la lista. Se cierra con un motivo y dispara la encuesta de satisfacción normal." },
    ],
  },
  {
    icono: "",
    titulo: "Cronograma y Gantt — planificar preventivos",
    pasos: [
      { t: "Vista por fechas", d: "Menú Cronograma: muestra lo vencido y lo que viene en 7/15/30 días. Usa el selector de sede para ver solo un hospital." },
      { t: "Vista Gantt", d: "Menú Gantt: los 12 meses de cada rutina proyectados según su frecuencia. «2×» significa dos veces ese mes; rojo = vencido; ámbar = equipo crítico." },
      { t: "Asignar técnico y fecha (jefe/admin)", d: "Directo en las tarjetas del Cronograma: cambia el técnico en el selector o la fecha en el campo de fecha — se guarda al instante." },
      { t: "Generar la OT del preventivo", d: "Botón «Generar OT» en la tarjeta cuando quieras crearla manualmente; si no, el sistema la genera solo al vencer la fecha." },
    ],
  },
  {
    icono: "",
    titulo: "Equipos e inventario de activos",
    pasos: [
      { t: "Registrar un equipo", d: "Entra en el área de mantenimiento → Equipos → «+ Registrar equipo». El código interno se asigna automáticamente. Los campos del formulario son opcionales; puedes completar los datos después. Los textos se guardan en mayúsculas aunque escribas o pegues en minúsculas." },
      { t: "Programar su preventivo", d: "En la lista de Equipos, columna Cronograma → «+ Programar»: eliges fecha y frecuencia, y queda en el cronograma." },
      { t: "Hoja de vida", d: "Entra al equipo para ver su historial completo: OTs, planes, documentos y trazabilidad." },
    ],
  },
  {
    icono: "",
    titulo: "Catálogo de aires acondicionados",
    pasos: [
      { t: "Crear una ficha reutilizable", d: "Entra en Aire acondicionado → Catálogo de aires → «Crear ficha de modelo». Registra una sola vez el nombre, marca, modelo, categoría y características comunes: tipo de unidad, capacidad y refrigerante. Solo el nombre de la ficha es obligatorio. Administración y técnicos pueden gestionar el catálogo." },
      { t: "Registrar cada unidad", d: "Desde la ficha pulsa «Registrar unidad», o selecciona una ficha del catálogo al registrar una unidad de aire. Se completan sus características comunes y puedes ajustarlas. Agrega la serie, ubicación y demás datos propios de esa unidad cuando los tengas; su código interno se genera automáticamente." },
      { t: "Registrar varias unidades del mismo modelo", d: "Usa «Guardar y registrar otra unidad» para guardar el registro actual y abrir el siguiente con la misma ficha seleccionada. La serie, ubicación y demás datos particulares quedan vacíos para evitar repetirlos por error." },
      { t: "Conservar la trazabilidad", d: "Cada unidad conserva su ficha individual, mantenimientos y la versión del catálogo utilizada al registrarla. Editar una ficha crea una nueva versión sin modificar las unidades anteriores. En la ficha del catálogo puedes consultar las unidades registradas y el historial de cambios con fecha y responsable." },
      { t: "Archivar una ficha", d: "Si ya no utilizarás un modelo para nuevas unidades, archiva su ficha. Desaparece de las opciones de registro, pero conserva sus unidades e historial. Puedes consultarla con «Incluir archivadas» y reactivarla después." },
    ],
  },
  {
    icono: "",
    titulo: "Actividades recurrentes (limpieza, puertas, fumigación…)",
    pasos: [
      { t: "¿Qué va aquí?", d: "Mantenimientos que no son de un equipo específico: lubricación de puertas, limpieza de tanques, jardinería, trampas de grasa, etc." },
      { t: "Crear una actividad", d: "Menú Actividades → «+ Nueva». Elige categoría (Puertas, Limpieza…), sede, frecuencia y responsable. Genera OTs automáticamente igual que los planes de equipos." },
    ],
  },
  {
    icono: "",
    titulo: "Control eléctrico",
    pasos: [
      { t: "Registrar subestaciones", d: "Menú Eléctrico → «+ Nueva subestación»: sede, capacidad en kVA y voltaje. (Solo admin/jefe editan.)" },
      { t: "Cargar el cuadro de cargas", d: "Entra a la subestación → «+ Agregar carga». Registra cada equipo con sus kW, o con amperaje + voltaje y el sistema calcula." },
      { t: "Consultar disponibilidad", d: "La barra de cada subestación muestra el % de uso y los kW libres. Verde = holgura; rojo = no conectar más equipos ahí." },
    ],
