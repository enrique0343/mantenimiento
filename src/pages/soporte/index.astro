---
import { requireUser } from "@/lib/auth";
import { equipoInicialSoporte } from "@/lib/soporte-equipo";
import { encodeInlineScriptVars } from "@/lib/inline-script-vars";
import "@/styles/globals.css";
import { getDb } from "@/lib/db";
import { sucursales, ubicaciones, empresa } from "@/lib/schema";
import { eq } from "drizzle-orm";
import { parseArea } from "@/lib/areas";
export const prerender = false;

const db = getDb(Astro);
const url = new URL(Astro.request.url);
const rawArea = url.searchParams.get("area");
let area = parseArea(rawArea);
if (rawArea !== null && !area) return new Response("Área de mantenimiento inválida", { status: 400 });

const { user: usuarioSesion } = await requireUser(Astro);
const equipoInicial = await equipoInicialSoporte(db, usuarioSesion, url.searchParams.get("activoId"), area);
if (equipoInicial) {
  area ??= equipoInicial.area;
  Astro.response.headers.set("Cache-Control", "private, no-store");
}

const [emp] = await db.select().from(empresa).limit(1);
const tieneLogo = !!emp?.logoR2Key;
const sucRows = await db.select({ id: sucursales.id, nombre: sucursales.nombre })
  .from(sucursales).where(eq(sucursales.activa, true)).orderBy(sucursales.nombre);
const ubRows = await db.select({ id: ubicaciones.id, nombre: ubicaciones.nombre, sucursalId: ubicaciones.sucursalId, tipo: ubicaciones.tipo })
  .from(ubicaciones).where(eq(ubicaciones.activa, true)).orderBy(ubicaciones.nombre);
const ubJson = JSON.stringify(ubRows);
const tipoReporte = area === "biomedico" || area === "tecnologia" ? area : area ? "general" : "";
const areaGeneral = tipoReporte === "general" ? area : "";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Soporte — {emp?.nombre ?? "Mantenimiento"}</title>
  </head>
  <body class="min-h-screen bg-slate-50">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
        {tieneLogo
          ? <img src="/api/empresa/logo" alt={emp?.nombre ?? "Logo"} class="h-10 w-auto max-w-[200px] object-contain" />
          : <h1 class="text-lg font-bold text-brand-600">{emp?.nombre ?? "Soporte"}</h1>
        }
        <a href="/soporte/track" class="text-sm text-brand-700 hover:underline">¿Ya enviaste un ticket? Consultar estado →</a>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-10">
      <div id="successBox" class="hidden card border-l-4 border-emerald-500 p-5">
        <h2 class="text-xl font-semibold text-emerald-700">✓ Ticket creado</h2>
        <p class="mt-2 text-sm text-slate-700">Tu solicitud fue recibida. Guarda este código de seguimiento:</p>
        <div class="mt-3 rounded-lg bg-slate-900 p-4 text-center font-mono text-2xl text-emerald-300" id="trackToken"></div>
        <p class="mt-3 text-sm text-slate-600">Puedes consultar el estado en cualquier momento en <a href="/soporte/track" class="text-brand-700 hover:underline">/soporte/track</a></p>
        <p class="mt-1 text-xs text-slate-500">Tiempo de respuesta estimado: <span id="slaInfo"></span></p>
      </div>

      <div id="formBox">
        <h2 class="text-2xl font-bold">Reportar un problema</h2>
        <p class="mt-1 text-sm text-slate-600">Un solo formulario para General, Biomédico y Tecnología. Elige dónde crees que corresponde el problema; el equipo que lo reciba podrá derivarlo si hace falta.</p>

        <form id="form" class="card mt-5 space-y-4 p-5">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label class="label">Tu nombre *</label>
              <input class="input" id="solicitanteNombre" required minlength="2" />
            </div>
            <div>
              <label class="label">Email *</label>
              <input class="input" id="solicitanteEmail" type="email" required />
            </div>
            <div>
              <label class="label">Teléfono</label>
              <input class="input" id="solicitanteTelefono" type="tel" />
            </div>
            <div>
              <label class="label" for="tipoReporte">¿Qué tipo de problema quieres reportar? *</label>
              <select class="input" id="tipoReporte" required aria-describedby="tipoReporteAyuda">
                <option value="">— Selecciona una opción —</option>
                <option value="general" selected={tipoReporte === "general"}>General</option>
                <option value="biomedico" selected={tipoReporte === "biomedico"}>Biomédico</option>
                <option value="tecnologia" selected={tipoReporte === "tecnologia"}>Tecnología</option>
              </select>
              <input type="hidden" id="rubro" value={area ?? ""} />
              <p class="mt-1 text-xs text-slate-500" id="tipoReporteAyuda">General: instalaciones y aires. Biomédico: equipos de atención médica. Tecnología: computadoras, impresoras, teléfonos y redes.</p>
            </div>
            <div class="sm:col-span-2" id="rubroGeneralBox" hidden={tipoReporte !== "general"}>
              <label class="label" for="rubroGeneral">Tipo de problema general <span class="font-normal text-slate-400">(opcional)</span></label>
              <select class="input" id="rubroGeneral">
                <option value="">— No estoy seguro —</option>
                <option value="aires" selected={areaGeneral === "aires"}>Aire acondicionado</option>
                <option value="infraestructura" selected={areaGeneral === "infraestructura"}>Infraestructura e instalaciones</option>
                <option value="equipo_general" selected={areaGeneral === "equipo_general"}>Equipos generales</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label class="label">Prioridad</label>
              <select class="input" id="prioridad">
                <option value="baja">Baja (asunto rutinario)</option>
                <option value="media" selected>Media</option>
                <option value="alta">Alta (afecta operaciones)</option>
                <option value="urgente">Urgente (paro / riesgo)</option>
              </select>
            </div>
          </div>
          <div>
            <label class="label">Asunto *</label>
            <input class="input" id="asunto" required minlength="3" placeholder="Breve descripción del problema" />
          </div>
          <div>
            <label class="label">Descripción detallada *</label>
            <textarea class="input" id="descripcion" rows="5" required minlength="10" placeholder="¿Qué está fallando? ¿Cuándo empezó? ¿Qué equipo o área se ve afectado?"></textarea>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label class="label">Sucursal *</label>
              <select class="input" id="sucursalId" required>
                <option value="">— Seleccionar —</option>
                {sucRows.map((s) => <option value={s.id}>{s.nombre}</option>)}
              </select>
            </div>
            <div>
              <label class="label">Ubicación <span class="text-slate-400 font-normal">(opcional)</span></label>
              <select class="input" id="ubicacionId">
                <option value="">— Selecciona primero la sucursal —</option>
              </select>
            </div>
            <div id="activoBox" class="sm:col-span-2 hidden">
              <label class="label" for="activoId">Equipo <span class="text-slate-400 font-normal">(opcional)</span></label>
              <select class="input" id="activoId">
                <option value="">— No sé / no está en la lista —</option>
              </select>
              <p class="mt-1 text-xs text-slate-500">Si el problema es de un equipo, elígelo. Si no aparece, escríbelo en la descripción.</p>
            </div>
            <div class="sm:col-span-2">
              <label class="label">Detalle adicional de ubicación (opcional)</label>
              <input class="input" id="ubicacion" placeholder="Ej: junto a la puerta, esquina noreste, mesa 4..." />
            </div>
          </div>

          <!-- Fotos del estado actual -->
          <div class="rounded-lg border-l-4 border-blue-300 bg-blue-50 p-3">
            <h3 class="text-sm font-semibold text-slate-900">Fotos del problema <span class="text-slate-400 font-normal">(opcional, recomendado)</span></h3>
            <p class="mt-1 text-xs text-slate-500">Adjunta fotos del equipo o área. Nos ayudará a diagnosticar más rápido y servirán como evidencia "antes" del trabajo.</p>
            <div class="mt-2 flex flex-wrap gap-2">
              <label class="cursor-pointer flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white text-brand-700 text-sm font-medium hover:bg-brand-50 border border-brand-200">
                <input type="file" id="fotoFile" accept="image/*" multiple class="hidden" />
                Seleccionar fotos
              </label>
              <label class="cursor-pointer flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white text-slate-700 text-sm font-medium hover:bg-slate-100 border border-slate-300">
                <input type="file" id="fotoCamara" accept="image/*" capture="environment" multiple class="hidden" />
                Cámara
              </label>
            </div>
            <div id="fotosPreview" class="mt-3 flex flex-wrap gap-2"></div>
          </div>

          <p id="err" class="hidden text-sm text-red-600"></p>
          <button class="btn-primary w-full justify-center" id="btnSubmit" type="submit">Enviar solicitud</button>
          <p class="text-center text-xs text-slate-400 mt-3">Gerencia de Operaciones &bull; Avante Complejo Hospitalario</p>
        </form>
      </div>
    </main>

    <script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({ ubJson, equipoInicial }) }}>
      const { ubJson, equipoInicial } = JSON.parse(decodeURIComponent(__encodedScriptVars));
      const allUbs = JSON.parse(ubJson);
      const sucEl = document.getElementById("sucursalId");
      const ubEl = document.getElementById("ubicacionId");
      function cargarUbicaciones() {
        const sid = Number(sucEl.value);
        const filtered = sid ? allUbs.filter((u) => u.sucursalId === sid) : [];
        ubEl.innerHTML = sid
          ? '<option value="">— Seleccionar ubicación —</option>'
          : '<option value="">— Selecciona primero la sucursal —</option>';
        filtered.forEach((u) => {
          const o = document.createElement("option");
          o.value = u.id;
          o.textContent = u.nombre;
          ubEl.appendChild(o);
        });
      }
      sucEl?.addEventListener("change", cargarUbicaciones);

      // ─── Equipo (opcional): los de la ubicación elegida, sin los dados de baja ───
      const rubroEl = document.getElementById("rubro");
      const actBox = document.getElementById("activoBox");
      const actEl = document.getElementById("activoId");
      const tipoEl = document.getElementById("tipoReporte");
      const generalEl = document.getElementById("rubroGeneral");
      const generalBox = document.getElementById("rubroGeneralBox");
      const tipoDeArea = (area) => ["biomedico", "tecnologia"].includes(area) ? area : "general";
      let permitirEquipoInicial = !!equipoInicial;
      function ajustarTipo() {
        generalBox.hidden = tipoEl.value !== "general";
        generalEl.disabled = tipoEl.value !== "general";
        rubroEl.value = tipoEl.value === "general" ? (generalEl.value || "equipo_general") : tipoEl.value;
      }
      ajustarTipo();
      const OPCION_VACIA = "— No sé / no está en la lista —";
      let consultaEquipos = 0;
      function vaciarEquipos() {
        if (!actEl || !actBox) return;
        actEl.innerHTML = "";
        const o = document.createElement("option");
        o.value = "";
        o.textContent = OPCION_VACIA;
        actEl.appendChild(o);
        actBox.classList.add("hidden");
      }
      async function cargarEquipos() {
        if (!actEl || !actBox) return;
        const n = ++consultaEquipos;
        const ubicacionId = ubEl?.value || "";
        const previo = actEl.value;
        if (!ubicacionId) {
          vaciarEquipos();
          if (permitirEquipoInicial && equipoInicial && !equipoInicial.ubicacionId && rubroEl.value === equipoInicial.area) agregarEquipoInicial();
          return;
        }
        const area = tipoEl.value === "general" ? generalEl.value : rubroEl.value;
        const conservaInicial = permitirEquipoInicial && equipoInicial && previo === String(equipoInicial.id)
          && ubicacionId === String(equipoInicial.ubicacionId)
          && sucEl.value === String(equipoInicial.sucursalId)
          && tipoEl.value === tipoDeArea(equipoInicial.area) && (!area || area === equipoInicial.area);
        if (!tipoEl.value) { vaciarEquipos(); return; }
        try {
          const res = await fetch("/api/tickets/publico/equipos?ubicacionId=" + encodeURIComponent(ubicacionId)
            + "&espacio=" + encodeURIComponent(tipoEl.value) + (area ? "&area=" + encodeURIComponent(area) : ""));
          if (!res.ok) throw new Error("No se pudo cargar la lista de equipos");
          const j = await res.json();
          if (!Array.isArray(j?.equipos)) throw new Error("Respuesta de equipos inválida");
          if (n !== consultaEquipos) return; // llegó una consulta más nueva
          const equipos = Array.isArray(j?.equipos) ? j.equipos : [];
          vaciarEquipos();
          for (const e of equipos) {
            const o = document.createElement("option");
            o.value = String(e.id);
            o.textContent = e.codigo + " · " + e.nombre;
            o.dataset.area = e.area || "";
            actEl.appendChild(o);
          }
          if (previo && equipos.some((e) => String(e.id) === previo)) actEl.value = previo;
          actBox.classList.toggle("hidden", equipos.length === 0);
        } catch {
          if (n === consultaEquipos && !conservaInicial) vaciarEquipos();
        }
      }
      // Un cambio de ubicación o de destinatario elimina el equipo previo antes de consultar.
      // Así ni un envío inmediato ni una respuesta tardía conserva una selección incompatible.
      const cambiarUbicacion = () => { ajustarTipo(); vaciarEquipos(); void cargarEquipos(); };
      sucEl?.addEventListener("change", cambiarUbicacion);
      ubEl?.addEventListener("change", cambiarUbicacion);
      const cambiarTipo = () => {
        ajustarTipo();
        permitirEquipoInicial = false;
        vaciarEquipos();
        void cargarEquipos();
      };
      tipoEl.addEventListener("change", cambiarTipo);
      generalEl.addEventListener("change", cambiarTipo);
      // En General sin especialidad elegida, el equipo aporta su área concreta.
      actEl?.addEventListener("change", () => {
        const area = actEl.selectedOptions[0]?.dataset.area || "";
        if (area && tipoDeArea(area) === tipoEl.value) rubroEl.value = area;
        else ajustarTipo();
      });

      function agregarEquipoInicial() {
        const o = document.createElement("option");
        o.value = String(equipoInicial.id);
        o.textContent = equipoInicial.codigo + " · " + equipoInicial.nombre;
        o.dataset.area = equipoInicial.area;
        actEl.appendChild(o);
        actEl.value = o.value;
        actBox.classList.remove("hidden");
      }
      if (equipoInicial) {
        tipoEl.value = tipoDeArea(equipoInicial.area);
        if (tipoEl.value === "general") generalEl.value = equipoInicial.area;
        ajustarTipo();
        sucEl.value = equipoInicial.sucursalId ? String(equipoInicial.sucursalId) : "";
        cargarUbicaciones();
        ubEl.value = equipoInicial.ubicacionId ? String(equipoInicial.ubicacionId) : "";
        agregarEquipoInicial();
        if (equipoInicial.ubicacionId) cargarEquipos();
      }

      // ─── Fotos pendientes ──────────────────────────────────────────────
      const pendingFotos = [];
      const fotoFile = document.getElementById("fotoFile");
      const fotoCamara = document.getElementById("fotoCamara");
      const fotosPreview = document.getElementById("fotosPreview");
      function addFotos(files) {
        for (const f of Array.from(files)) {
          pendingFotos.push(f);
          const thumb = document.createElement("div");
          thumb.className = "relative w-20 h-20 rounded-lg overflow-hidden border border-slate-200 bg-white";
          const img = document.createElement("img");
          img.src = URL.createObjectURL(f);
          img.className = "w-full h-full object-cover";
          thumb.appendChild(img);
          const rm = document.createElement("button");
          rm.type = "button";
          rm.textContent = "×";
          rm.className = "absolute top-0.5 right-0.5 bg-black/60 text-xs w-5 h-5 rounded-full flex items-center justify-center hover:bg-white text-red-600 border border-red-600";
          rm.addEventListener("click", () => {
            const i = pendingFotos.indexOf(f); if (i >= 0) pendingFotos.splice(i, 1);
            thumb.remove();
          });
          thumb.appendChild(rm);
          fotosPreview.appendChild(thumb);
        }
      }
      fotoFile?.addEventListener("change", () => { addFotos(fotoFile.files); fotoFile.value = ""; });
      fotoCamara?.addEventListener("change", () => { addFotos(fotoCamara.files); fotoCamara.value = ""; });

      const form = document.getElementById("form");
      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const err = document.getElementById("err");
        const btn = document.getElementById("btnSubmit");
        err.classList.add("hidden");
        const v = (id) => document.getElementById(id)?.value?.trim() ?? "";

        if (!tipoEl.value) {
          err.textContent = "Selecciona General, Biomédico o Tecnología.";
          err.classList.remove("hidden");
          tipoEl.focus();
          return;
        }
        if (!sucEl?.value) {
          err.textContent = "La sucursal es obligatoria.";
          err.classList.remove("hidden");
          return;
        }

        // El equipo conserva su área concreta; sin equipo, se usa la selección actual.
        const areaEquipo = actEl?.selectedOptions[0]?.dataset.area || "";
        if (areaEquipo && tipoDeArea(areaEquipo) === tipoEl.value) rubroEl.value = areaEquipo;
        else ajustarTipo();
        btn.disabled = true;
        btn.textContent = "Enviando...";
        const payload = {
          solicitanteNombre: v("solicitanteNombre"),
          solicitanteEmail: v("solicitanteEmail"),
          solicitanteTelefono: v("solicitanteTelefono") || null,
          asunto: v("asunto"),
          descripcion: v("descripcion"),
          prioridad: v("prioridad"),
          rubro: v("rubro"),
          ubicacion: v("ubicacion") || null,
          sucursalId: Number(sucEl.value),
          ubicacionId: ubEl?.value ? Number(ubEl.value) : null,
          activoId: actEl?.value ? Number(actEl.value) : null,
        };
        let res;
        try {
          res = await fetch("/api/tickets/publico", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(payload),
          });
        } catch {
          // Sin red el botón quedaba en «Enviando...» y había que recargar y escribir todo otra vez.
          err.textContent = "No pudimos enviar tu solicitud: revisa tu conexión e inténtalo de nuevo. Lo que escribiste sigue aquí.";
          err.classList.remove("hidden");
          btn.disabled = false; btn.textContent = "Enviar solicitud";
          return;
        }
        if (!res.ok) {
          const j = await res.json().catch(() => ({}));
          err.textContent = typeof j.error === "string" ? j.error : "No pudimos enviar tu solicitud. Verifica los campos e intenta de nuevo.";
          err.classList.remove("hidden");
          btn.disabled = false; btn.textContent = "Enviar solicitud";
          return;
        }
        const j = await res.json();
        const token = j.ticket.trackingToken;

        // Subir fotos pendientes (best-effort)
        if (pendingFotos.length > 0) {
          btn.textContent = "Subiendo fotos...";
          for (const f of pendingFotos) {
            const fd = new FormData();
            fd.append("file", f);
            await fetch(`/api/tickets/publico/${token}/foto`, { method: "POST", body: fd }).catch(() => {});
          }
        }

        const slaH = { urgente: 2, alta: 8, media: 24, baja: 72 }[payload.prioridad] || 24;
        document.getElementById("formBox").classList.add("hidden");
        document.getElementById("trackToken").textContent = token;
        document.getElementById("slaInfo").textContent = `${slaH} horas`;
        document.getElementById("successBox").classList.remove("hidden");
      });
    </script>
  </body>
</html>
