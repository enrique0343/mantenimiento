---
import { encodeInlineScriptVars } from "@/lib/inline-script-vars";
// Página pública — accesible con token sin autenticación
// Registra la descarga del PDF y muestra la solicitud
export const prerender = false;

const token = Astro.params.token!;
// Fetch de datos + tracking de acceso via API
const apiUrl = `${Astro.url.origin}/api/solicitudes-compra/r/${token}`;
const res = await fetch(apiUrl, {
  headers: {
    "cf-connecting-ip": Astro.request.headers.get("cf-connecting-ip") ?? "",
    "x-forwarded-for": Astro.request.headers.get("x-forwarded-for") ?? "",
    "user-agent": Astro.request.headers.get("user-agent") ?? "",
  },
});
if (!res.ok) return Astro.redirect("/login");

const data = await res.json();
const { solicitud: sol, items, adjuntos, envio } = data;

const ESTADO_LABEL: Record<string, string> = {
  borrador: "Borrador", enviada: "Enviada", comprada: "Comprada",
  rechazada: "Rechazada", cancelada: "Cancelada",
};
import "@/styles/globals.css";
---

<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{sol.codigo} — Solicitud de Compra</title>
  <link rel="icon" href="/icons/favicon-64.png" sizes="64x64" type="image/png" />
  <style>
    .sol-card { background: #fff; border: 1px solid #BDC6D8; padding: 20px; }
    .sol-card table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .sol-card th, .sol-card td { padding: 8px 10px 8px 0; text-align: left; border-bottom: 1px solid #BDC6D8; }
    .sol-card th { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #23417D; border-bottom-color: #23417D; }
    .btn-pdf { background: #23417D; color: #fff; border: 0; border-radius: 2px; min-height: 44px; padding: 10px 20px; cursor: pointer; font-weight: 600; }
    .btn-pdf:hover { background: #1E2142; }
  </style>
</head>
<body class="min-h-full py-8">
  <div class="max-w-3xl mx-auto px-4 space-y-4">

    <div class="text-center mb-6">
      <img src="/brand/avante-logo.png" alt="Avante Complejo Hospitalario" style="height:44px;width:auto;margin:0 auto 8px" />
      <h1 class="text-2xl font-bold mt-1">{sol.codigo} — Solicitud de Compra</h1>
      {envio.destinatarioNombre && <p class="text-slate-500 text-sm mt-1">Enviada a: {envio.destinatarioNombre}</p>}
    </div>

    <div class="sol-card">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <span class="badge" style="background:#F2F4F7;color:#23417D">{ESTADO_LABEL[sol.estado] ?? sol.estado}</span>
          <h2 class="text-lg font-bold mt-2">{sol.titulo}</h2>
          {sol.descripcion && <p class="mt-1 text-sm text-slate-600 whitespace-pre-wrap">{sol.descripcion}</p>}
          <p class="mt-2 text-xs text-slate-400">Generada: {new Date(sol.createdAt).toLocaleString("es", { timeZone: "America/El_Salvador" })}</p>
        </div>
        <button class="btn-pdf" id="btnPdf">Descargar PDF</button>
      </div>
    </div>

    <div class="sol-card">
      <h2 class="font-semibold mb-3">Ítems solicitados</h2>
      <table>
        <thead><tr>
          <th>#</th><th>Descripción</th><th style="text-align:right">Cant.</th><th>Unidad</th><th>Notas</th>
        </tr></thead>
        <tbody>
          {items.map((item: any, i: number) => (
            <tr>
              <td style="color:#6B7280;font-size:12px">{i + 1}</td>
              <td style="font-weight:500">{item.descripcion}</td>
              <td style="text-align:right">{item.cantidad}</td>
              <td style="color:#6B7280">{item.unidad ?? "—"}</td>
              <td style="color:#6B7280;font-size:12px">{item.notas ?? ""}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {adjuntos.length > 0 && (
      <div class="sol-card">
        <h2 class="font-semibold mb-3">Fotos de referencia</h2>
        <div style="display:flex;flex-wrap:wrap;gap:12px">
          {adjuntos.map((a: any) => (
            <div style="width:120px;height:120px;border-radius:2px;overflow:hidden;border:1px solid #BDC6D8;background:#F2F4F7">
              {a.contentType.startsWith("image/")
                ? <img src={`/api/solicitudes-compra/adjunto/${a.id}`} style="width:100%;height:100%;object-fit:cover" loading="lazy" alt={a.nombre} />
                : <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:11px;color:#6B7280;padding:4px;text-align:center">{a.nombre}</div>
              }
            </div>
          ))}
        </div>
      </div>
    )}

    <p class="text-center text-xs text-slate-400">
      Este enlace es personal. Se registra su acceso para trazabilidad.
    </p>
  </div>

  <script is:inline src="/js/pdf-avante.js"></script>
  <script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({ sol, items, adjuntos }) }}>
    const { sol, items, adjuntos } = JSON.parse(decodeURIComponent(__encodedScriptVars));

    document.getElementById("btnPdf")?.addEventListener("click", async () => {
    const boton = document.getElementById("btnPdf");
    const textoBoton = boton.textContent;
    boton.disabled = true; boton.textContent = "Generando…";
    try {
      const fecha = new Date(Date.parse(sol.createdAt) - 6 * 3600000).toISOString();
      const P = await window.pdfAvante.crear({ titulo: "Solicitud de compra", subtitulo: sol.titulo, codigo: sol.codigo, destino: "Documento compartido", fecha: `${fecha.slice(8, 10)}/${fecha.slice(5, 7)}/${fecha.slice(0, 4)}` });
      P.etiqueta("Estado");
      P.texto(sol.estado, { despues: 3 });
      P.etiqueta("Solicitud");
      P.texto(sol.titulo, { estilo: "semibold", pt: 12, despues: 2 });
      if (sol.descripcion) P.texto(sol.descripcion, { despues: 4 });
      P.nivel1(null, "Ítems solicitados");
      P.tabla(
        [{ titulo: "#", w: 1 }, { titulo: "Descripción", w: 9 }, { titulo: "Cantidad", w: 2, alinear: "right" }, { titulo: "Unidad", w: 2, alinear: "right" }],
        items.map((it, i) => [String(i + 1), it.descripcion, String(it.cantidad), it.unidad ?? "—"]),
      );
      P.guardar(`${sol.codigo}.pdf`);
    } catch (e) {
      alert("No se pudo generar el PDF. Revisa tu conexión.");
    } finally {
      boton.disabled = false; boton.textContent = textoBoton;
    }
    });
  </script>
</body>
</html>
