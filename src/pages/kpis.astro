            <tr>
              <td class="px-4 py-2 font-mono text-xs">{i + 1}</td>
              <td class="px-4 py-2"><a href={`/activos/${e.activoId}`} class="text-brand-700 hover:underline">{e.codigo} — {e.nombre}</a></td>
              <td class="px-4 py-2 text-right font-bold text-red-600">{Number(e.n)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="card overflow-hidden">
      <div class="px-5 pt-4 pb-2"><h2 class="font-semibold text-slate-900">Top 10 técnicos por OTs completadas (año)</h2></div>
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase text-slate-500">
          <tr>
            <th class="px-4 py-2">#</th>
            <th class="px-4 py-2">Técnico</th>
            <th class="px-4 py-2 text-right">OTs</th>
            <th class="px-4 py-2 text-right">Horas</th>
            <th class="px-4 py-2 text-right">A tiempo</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {topTecnicos.length === 0 && <tr><td colspan="5" class="px-4 py-6 text-center text-slate-400">Sin datos.</td></tr>}
          {topTecnicos.map((t, i) => {
            const conSla = Number(t.conSla);
            const aTiempo = Number(t.aTiempo);
            const pctTiempo = conSla > 0 ? Math.round((aTiempo / conSla) * 100) : null;
            return (
              <tr>
                <td class="px-4 py-2 font-mono text-xs">{i + 1}</td>
                <td class="px-4 py-2">{t.nombre ?? "—"}</td>
                <td class="px-4 py-2 text-right font-bold text-emerald-700">{Number(t.completadas)}</td>
                <td class="px-4 py-2 text-right font-mono text-slate-600">{Number(t.horas).toFixed(1)}h</td>
                <td class="px-4 py-2 text-right">
                  {pctTiempo != null ? (
                    <span class:list={["badge", pctTiempo >= 90 ? "bg-emerald-100 text-emerald-700" : pctTiempo >= 70 ? "bg-amber-100 text-amber-700" : "bg-red-100 text-red-700"]}>{pctTiempo}%</span>
                  ) : <span class="text-slate-400 text-xs">—</span>}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline src="/js/pdf-avante.js"></script>
  <script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({ metricasJson, periodos: periodos12, scopeLabels: SCOPE_LABEL, scopes: SCOPES }) }}>
    const { metricasJson, periodos, scopeLabels, scopes } = JSON.parse(decodeURIComponent(__encodedScriptVars));
    // Tabs de alcance
    document.querySelectorAll(".scope-tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        const scope = tab.dataset.scope;
        document.querySelectorAll(".scope-tab").forEach((t) => {
          const active = t.dataset.scope === scope;
          t.classList.toggle("border-brand-600", active);
          t.classList.toggle("text-brand-700", active);
          t.classList.toggle("border-transparent", !active);
          t.classList.toggle("text-slate-500", !active);
        });
        document.querySelectorAll(".scope-panel").forEach((p) => {
          p.classList.toggle("hidden", p.dataset.scope !== scope);
        });
      });
    });

    // Acciones admin
    document.getElementById("capturarBtn")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      btn.disabled = true; btn.textContent = "Capturando…";
      const r = await fetch("/api/cron/snapshot-kpis");
      if (r.ok) location.reload(); else { alert("Error al capturar"); btn.disabled = false; btn.textContent = "Capturar mes actual"; }
    });
    document.getElementById("recalcularBtn")?.addEventListener("click", async (e) => {
      const go = window.confirmAction
        ? await window.confirmAction("Recalcular KPIs", "¿Recalcular los KPIs de los últimos 12 meses desde el historial de OTs? Sobrescribe los snapshots existentes de ese rango.", { confirmLabel: "Recalcular" })
        : confirm("¿Recalcular los KPIs de los últimos 12 meses desde el historial de OTs? Sobrescribe los snapshots existentes de ese rango.");
      if (!go) return;
      const btn = e.currentTarget;
      btn.disabled = true; btn.textContent = "Recalculando…";
      const r = await fetch("/api/metricas/recalcular", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ meses: 12 }) });
      if (r.ok) location.reload(); else { alert("Error al recalcular"); btn.disabled = false; btn.textContent = "Recalcular 12 meses"; }
    });

    // ── PDF ──
    function mesLbl(p) {
      const [y, m] = p.split("-").map(Number);
      const d = new Date(Date.UTC(y, m - 1, 1));
      return d.toLocaleDateString("es", { month: "short", timeZone: "UTC" }).replace(".", "") + " " + String(y).slice(2);
    }
    const KPIS = [
      { key: "cumplimientoPreventivo", label: "Cumpl. preventivo (%)", fmt: (v) => v == null ? "—" : (Math.round(v * 10) / 10).toString() },
      { key: "disponibilidadPct", label: "Disponibilidad (%)", fmt: (v) => v == null ? "—" : (Math.round(v * 10) / 10).toString() },
      { key: "mttrHoras", label: "MTTR (h)", fmt: (v) => v == null ? "—" : (Math.round(v * 10) / 10).toString() },
      { key: "mtbfHoras", label: "MTBF (h)", fmt: (v) => v == null ? "—" : (Math.round(v * 10) / 10).toString() },
      { key: "backlogCorrectivos", label: "Backlog correctivos", fmt: (v) => v == null ? "—" : String(v) },
      { key: "costoPorActivo", label: "Costo por activo ($)", fmt: (v) => v == null ? "—" : Number(v).toFixed(0) },
    ];

    document.getElementById("pdfBtn")?.addEventListener("click", async () => {
      const boton = document.getElementById("pdfBtn");
      const texto = boton.textContent;
      boton.disabled = true; boton.textContent = "Generando…";
      try {
        const { serie } = JSON.parse(metricasJson);
        const cols = periodos.slice(-6); // últimos 6 meses para que quepan
        const P = await window.pdfAvante.crear({ titulo: "Reporte de indicadores JCI", subtitulo: `${mesLbl(cols[0])} a ${mesLbl(cols[cols.length - 1])}` });
        for (const scope of scopes) {
          P.nivel1(null, scopeLabels[scope]);
          P.tabla(
            [{ titulo: "Indicador", w: 3 }, ...cols.map((c) => ({ titulo: mesLbl(c), w: 1, alinear: "right" }))],
            KPIS.map((kpi) => [kpi.label, ...cols.map((c) => { const row = serie[scope]?.[c]; return row ? kpi.fmt(row[kpi.key]) : "—"; })]),
          );
        }
        P.guardar(`indicadores-jci-${new Date().toISOString().slice(0, 10)}.pdf`);
      } catch (e) {
        window.showToast?.("No se pudo generar el PDF. Revisa tu conexión.", "error");
      } finally {
        boton.disabled = false; boton.textContent = texto;
      }
    });
  </script>
  {puedeAceptarRiesgo && (
    <div id="riesgoModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50 p-4">
      <div class="card w-full max-w-lg p-5">
        <h3 class="text-lg font-semibold text-slate-900">Aceptar riesgo por escrito</h3>
        <p class="mt-1 text-sm text-slate-500">
          La OT sale del indicador de mantenimiento diferido y la aceptación queda registrada con tu nombre,
          la fecha y estas notas. No se puede borrar.
        </p>
        <div class="mt-3 rounded-md bg-slate-50 px-3 py-2 text-xs text-slate-700">
          <div id="r_ot" class="font-semibold"></div>
          <div id="r_meta" class="text-slate-500"></div>
        </div>
        <input type="hidden" id="r_id" />
        <div class="mt-4">
          <label class="label text-xs" for="r_notas">Riesgo aceptado, quién lo asume y hasta cuándo (obligatorio)</label>
          <textarea id="r_notas" class="input" rows="4"
            placeholder="Ej. Se difiere la prueba de flujo de la bomba contra incendios hasta la ventana del 12/12: Seguridad y Salud Ocupacional acepta el riesgo con ronda diaria de presión y el contratista confirmado."></textarea>
          <p class="mt-1 text-[11px] text-slate-400">Mínimo 15 caracteres. Queda en la OT y en el registro de auditoría.</p>
        </div>
        <p id="r_err" class="hidden mt-2 text-sm text-red-600"></p>
        <div class="mt-5 flex justify-end gap-2">
          <button type="button" id="r_cancel" class="btn-secondary">Cancelar</button>
          <button type="button" id="r_save" class="btn-primary">Registrar aceptación</button>
        </div>
      </div>
    </div>
  )}

  <script>
    // ── Mantenimiento diferido: aceptar riesgo por escrito (GO-GUI-011 §2.3) ──
    const riesgoModal = document.getElementById("riesgoModal");
    if (riesgoModal) {
      const el = (id: string) => document.getElementById(id);
      const showR = () => { riesgoModal.classList.remove("hidden"); riesgoModal.classList.add("flex"); };
      const hideR = () => { riesgoModal.classList.add("hidden"); riesgoModal.classList.remove("flex"); };

      document.querySelectorAll<HTMLButtonElement>(".riesgo-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          (el("r_id") as HTMLInputElement).value = btn.dataset.id ?? "";
          el("r_ot")!.textContent = `OT #${btn.dataset.id} · ${btn.dataset.titulo ?? ""}`;
          el("r_meta")!.textContent = `${btn.dataset.dias ?? "?"} días vencida · clase P1`;
          (el("r_notas") as HTMLTextAreaElement).value = "";
          el("r_err")!.classList.add("hidden");
          showR();
        });
      });

      el("r_cancel")?.addEventListener("click", hideR);
      riesgoModal.addEventListener("click", (e) => { if (e.target === riesgoModal) hideR(); });

      el("r_save")?.addEventListener("click", async (ev) => {
        const err = el("r_err")!;
        err.classList.add("hidden");
        const ordenId = Number((el("r_id") as HTMLInputElement).value);
        const notas = (el("r_notas") as HTMLTextAreaElement).value.trim();
        if (!ordenId) return;
        if (notas.length < 15) {
          err.textContent = "Describe el riesgo aceptado y quién lo asume (mínimo 15 caracteres).";
          err.classList.remove("hidden");
          return;
        }
        const ok = window.confirmAction
          ? await window.confirmAction("Aceptar riesgo por escrito", `La OT #${ordenId} saldrá del indicador de mantenimiento diferido y la aceptación quedará registrada a tu nombre. ¿Continuar?`, { confirmLabel: "Aceptar riesgo" })
          : confirm(`La OT #${ordenId} saldrá del indicador de mantenimiento diferido. ¿Continuar?`);
        if (!ok) return;

        const btn = ev.currentTarget as HTMLButtonElement;
        btn.disabled = true;
        const prev = btn.textContent;
        btn.textContent = "Registrando…";
        try {
          const res = await fetch("/api/metricas/aceptar-riesgo", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ ordenId, notas }),
          });
          if (res.ok) {
            const data = await res.json().catch(() => ({}));
            window.showToast?.(data.mensaje ?? "Riesgo aceptado por escrito", "success");
            location.reload();
            return;
          }
          const data = await res.json().catch(() => null);
          err.textContent = typeof data?.error === "string" ? data.error : "No se pudo registrar la aceptación.";
          err.classList.remove("hidden");
          window.showToast?.("No se pudo registrar la aceptación", "error");
        } catch {
          err.textContent = "Error de red al registrar la aceptación.";
          err.classList.remove("hidden");
        } finally {
          btn.disabled = false;
          btn.textContent = prev;
        }
      });
    }
  </script>
</Layout>
