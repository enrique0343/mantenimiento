---
import { encodeInlineScriptVars } from "@/lib/inline-script-vars";
import Layout from "@/layouts/Layout.astro";
import { getDb } from "@/lib/db";
import { ordenes, activos, ordenRepuestos, items as itemsTable, usuarios, encuestasSatisfaccion, metricasKpi } from "@/lib/schema";
import { eq, and, sql, isNotNull, desc, gte, inArray } from "drizzle-orm";
import { SCOPES, SCOPE_LABEL, ultimosPeriodos, KPI_BASELINE_DATE, aplicarLineaBase } from "@/lib/metricas";
// Indicadores del volumen GO-GUI-011-2026 (capítulos 02 y 08) — Fase 47.
import {
  mantenimientoDiferido, riesgosAceptados, tiemposPorSistema,
  cumplimientoPreventivoPorDominio, hoySV, sumarDiasFecha, DIAS_DIFERIDO,
} from "@/lib/metricas";
// El indicador 8 lo calcula el motor AOP, dueño de aop_eventos: no se duplica.
import { horasFueraRangoPorSala } from "@/lib/aop";
import { fmtFechaSolo, fmtFechaSoloCompacta, fmtFechaCompacta } from "@/lib/datetime";
export const prerender = false;

const user = Astro.locals.user!;
if (user.rol !== "admin" && user.rol !== "jefe") return Astro.redirect("/");
const esAdmin = user.rol === "admin";

const db = getDb(Astro);
const now = new Date();
const inicioAnoRaw = new Date(now.getFullYear(), 0, 1).toISOString().slice(0, 10);
const inicio30dRaw = new Date(Date.now() - 30 * 86400_000).toISOString().slice(0, 10);
// La línea base recorta cualquier ventana hacia atrás del corte de reinicio.
const inicioAno = aplicarLineaBase(inicioAnoRaw);
const inicio30d = aplicarLineaBase(inicio30dRaw);

// Total OTs y por estado
const totalesEstado = await db
  .select({ estado: ordenes.estado, n: sql<number>`count(*)` })
  .from(ordenes)
  .groupBy(ordenes.estado);
const total = totalesEstado.reduce((s, r) => s + Number(r.n), 0);
const get = (estado: string) => Number(totalesEstado.find((r) => r.estado === estado)?.n ?? 0);

// OTs vencidas (sin cerrar y vencimiento pasado). Solo contamos las creadas
// después de la línea base — las anteriores quedan excluidas por reinicio.
const vencidasRows = await db
  .select({ n: sql<number>`count(*)` })
  .from(ordenes)
  .where(sql`${ordenes.vencimiento} IS NOT NULL AND ${ordenes.vencimiento} < datetime('now') AND ${ordenes.estado} IN ('abierta','en_proceso','completada') AND ${ordenes.createdAt} >= ${KPI_BASELINE_DATE}`);
const vencidas = Number(vencidasRows[0]?.n ?? 0);

// % cumplimiento SLA: completadas a tiempo / total completadas con vencimiento
// (post línea base).
const slaRows = await db
  .select({
    total: sql<number>`COUNT(*)`,
    aTiempo: sql<number>`SUM(CASE WHEN ${ordenes.completadaEn} <= ${ordenes.vencimiento} THEN 1 ELSE 0 END)`,
  })
  .from(ordenes)
  .where(and(
    isNotNull(ordenes.completadaEn),
    isNotNull(ordenes.vencimiento),
    gte(ordenes.completadaEn, inicio30d),
    gte(ordenes.createdAt, KPI_BASELINE_DATE),
  ));
const slaTotal = Number(slaRows[0]?.total ?? 0);
const slaATiempo = Number(slaRows[0]?.aTiempo ?? 0);
const cumplimientoSla = slaTotal > 0 ? (slaATiempo / slaTotal) * 100 : 100;

// OTs por tipo
const porTipo = await db
  .select({ tipo: ordenes.tipo, n: sql<number>`count(*)` })
  .from(ordenes)
  .groupBy(ordenes.tipo);

// MTTR (30d): tiempo promedio creación → completada, sólo de OTs creadas
// después de la línea base (las heredadas se excluyen por reinicio).
const completadas30d = await db
  .select({ createdAt: ordenes.createdAt, completadaEn: ordenes.completadaEn })
  .from(ordenes)
  .where(and(
    gte(ordenes.completadaEn, inicio30d),
    isNotNull(ordenes.completadaEn),
    gte(ordenes.createdAt, KPI_BASELINE_DATE),
  ));
let mttrHoras = 0;
if (completadas30d.length > 0) {
  const totalMs = completadas30d.reduce((s, r) => {
    const a = new Date(r.createdAt).getTime();
    const b = r.completadaEn ? new Date(r.completadaEn).getTime() : a;
    return s + Math.max(b - a, 0);
  }, 0);
  mttrHoras = totalMs / completadas30d.length / 3_600_000;
}

// MTBF aproximado (correctivos en los 30d post línea base).
const correctivos30dRows = await db
  .select({ n: sql<number>`count(*)` })
  .from(ordenes)
  .where(and(eq(ordenes.tipo, "correctivo"), gte(ordenes.createdAt, inicio30d)));
const correctivos30d = Number(correctivos30dRows[0]?.n ?? 0);
const mtbfHoras = correctivos30d > 0 ? (30 * 24) / correctivos30d : 0;

// Top 10 equipos con más correctivos en el año
const topEquipos = await db
  .select({
    activoId: ordenes.activoId,
    codigo: activos.codigo,
    nombre: activos.nombre,
    n: sql<number>`count(*)`,
  })
  .from(ordenes)
  .leftJoin(activos, eq(activos.id, ordenes.activoId))
  .where(and(eq(ordenes.tipo, "correctivo"), gte(ordenes.createdAt, inicioAno), isNotNull(ordenes.activoId)))
  .groupBy(ordenes.activoId)
  .orderBy(desc(sql`count(*)`))
  .limit(10);

// Top 10 técnicos por OTs completadas en el año
const topTecnicos = await db
  .select({
    tecnicoId: ordenes.asignadoA,
    nombre: usuarios.nombre,
    completadas: sql<number>`COUNT(*)`,
    horas: sql<number>`SUM(COALESCE(${ordenes.horasTrabajadas}, 0))`,
    aTiempo: sql<number>`SUM(CASE WHEN ${ordenes.vencimiento} IS NOT NULL AND ${ordenes.completadaEn} <= ${ordenes.vencimiento} THEN 1 ELSE 0 END)`,
    conSla: sql<number>`SUM(CASE WHEN ${ordenes.vencimiento} IS NOT NULL THEN 1 ELSE 0 END)`,
  })
  .from(ordenes)
  .leftJoin(usuarios, eq(usuarios.id, ordenes.asignadoA))
  .where(and(isNotNull(ordenes.asignadoA), isNotNull(ordenes.completadaEn), gte(ordenes.completadaEn, inicioAno)))
  .groupBy(ordenes.asignadoA)
  .orderBy(desc(sql`COUNT(*)`))
  .limit(10);

// Disponibilidad estimada
const totalActivos = (await db.select({ n: sql<number>`count(*)` }).from(activos))[0]?.n ?? 0;
const operativos = (await db.select({ n: sql<number>`count(*)` }).from(activos).where(eq(activos.estado, "operativo")))[0]?.n ?? 0;
const disponibilidad = totalActivos > 0 ? (Number(operativos) / Number(totalActivos)) * 100 : 0;

// Costo estimado de repuestos en el año
const costoRepRows = await db
  .select({
    total: sql<number>`SUM(${ordenRepuestos.cantidad} * COALESCE(${ordenRepuestos.precioUnitario}, ${itemsTable.precioReferencia}, 0))`,
  })
  .from(ordenRepuestos)
  .leftJoin(itemsTable, eq(itemsTable.id, ordenRepuestos.itemId))
  .where(gte(ordenRepuestos.createdAt, inicioAno));
const costoTotal = Number(costoRepRows[0]?.total ?? 0);

// Satisfacción
const [satRow] = await db
  .select({
    n: sql<number>`COUNT(*)`,
    avg: sql<number>`AVG(${encuestasSatisfaccion.calificacion})`,
  })
  .from(encuestasSatisfaccion)
  .where(isNotNull(encuestasSatisfaccion.respondidaEn));
const satN = Number(satRow?.n ?? 0);
const satAvg = satRow?.avg != null ? Number(satRow.avg) : null;

// Tendencia mensual (últimos 12 meses): completadas y correctivas
const tendencia: { mes: string; completadas: number; correctivas: number }[] = [];
for (let i = 11; i >= 0; i--) {
  const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
  const inicio = d.toISOString().slice(0, 10);
  const fin = new Date(d.getFullYear(), d.getMonth() + 1, 1).toISOString().slice(0, 10);
  const [completadas] = await db
    .select({ n: sql<number>`COUNT(*)` })
    .from(ordenes)
    .where(and(gte(ordenes.completadaEn, inicio), sql`${ordenes.completadaEn} < ${fin}`));
  const [correctivas] = await db
    .select({ n: sql<number>`COUNT(*)` })
    .from(ordenes)
    .where(and(eq(ordenes.tipo, "correctivo"), gte(ordenes.createdAt, inicio), sql`${ordenes.createdAt} < ${fin}`));
  const mesEs = d.toLocaleDateString("es", { month: "short", timeZone: "America/El_Salvador" }).replace(".", "");
  tendencia.push({
    mes: `${mesEs} ${String(d.getFullYear()).slice(2)}`,
    completadas: Number(completadas?.n ?? 0),
    correctivas: Number(correctivas?.n ?? 0),
  });
}
const maxTendencia = Math.max(1, ...tendencia.map((t) => Math.max(t.completadas, t.correctivas)));

const TIPO_LABEL = { preventivo: "Preventivo", correctivo: "Correctivo", predictivo: "Predictivo" };
function pct(n: number) { return Math.round(n * 100) / 100; }
function fmtH(h: number) { return h < 1 ? `${(h * 60).toFixed(0)} min` : `${pct(h)} h`; }

// ─── Indicadores JCI persistidos (Fase 36): tendencia documentada ────────────
const periodos12 = ultimosPeriodos(12);
const metricasRows = await db.select().from(metricasKpi).where(inArray(metricasKpi.periodo, periodos12));
const serie: Record<string, Record<string, typeof metricasRows[number]>> = { global: {}, general: {}, biomedico: {} };
for (const r of metricasRows) { (serie[r.scope] ??= {})[r.periodo] = r; }
const hayMetricas = metricasRows.length > 0;
const periodosConDatos = periodos12.filter((p) => metricasRows.some((r) => r.periodo === p));
const ultimoPeriodo = periodosConDatos[periodosConDatos.length - 1] ?? null;
const metricasJson = JSON.stringify({ periodos: periodos12, serie });

function mesLabel(periodo: string): string {
  const [y, m] = periodo.split("-").map(Number);
  const d = new Date(Date.UTC(y, m - 1, 1));
  return d.toLocaleDateString("es", { month: "short", timeZone: "UTC" }).replace(".", "") + " " + String(y).slice(2);
}
function fmtKpiH(h: number | null): string {
  if (h == null) return "—";
  if (h >= 48) return `${(h / 24).toFixed(1)} d`;
  return h < 1 ? `${(h * 60).toFixed(0)} min` : `${h.toFixed(1)} h`;
}
function colorPct(v: number | null, bueno: number, regular: number): string {
  if (v == null) return "text-slate-300";
  return v >= bueno ? "text-emerald-600" : v >= regular ? "text-amber-600" : "text-red-600";
}
// Definición de los 6 indicadores para la tabla de tendencia.
const KPIS_DEF = [
  { key: "cumplimientoPreventivo", label: "Cumplimiento preventivo", fmt: (v: any) => v == null ? "—" : `${pct(v)}%` },
  { key: "disponibilidadPct", label: "Disponibilidad", fmt: (v: any) => v == null ? "—" : `${pct(v)}%` },
  { key: "mttrHoras", label: "MTTR", fmt: fmtKpiH },
  { key: "mtbfHoras", label: "MTBF", fmt: fmtKpiH },
  { key: "backlogCorrectivos", label: "Backlog correctivos", fmt: (v: any) => v == null ? "—" : String(v) },
  { key: "costoPorActivo", label: "Costo por activo", fmt: (v: any) => v == null ? "—" : `$${Number(v).toFixed(2)}` },
] as const;

// ═══ Indicadores del volumen GO-GUI-011-2026 · Biblioteca de procedimientos ══
// Se añaden a los 6 indicadores JCI de arriba; no modifican su cálculo ni la
// línea base. Ventana: año en curso (los históricos quedan topados por la
// línea base dentro de cada función).
const hoyKpi = hoySV();
const finVentana = sumarDiasFecha(hoyKpi, 1);
const corteDiferido = sumarDiasFecha(hoyKpi, -DIAS_DIFERIDO);
const puedeAceptarRiesgo = user.rol === "admin" || user.rol === "jefe";

// §2.3 — mantenimiento diferido (backlog vivo: no se recorta por línea base).
const diferidas = await mantenimientoDiferido(db, { hoy: hoyKpi });
const diferidoAceptado = await riesgosAceptados(db, { hoy: hoyKpi, limite: 10 });

// Indicadores 5 y 7 — respuesta y reparación por sistema.
const tiemposSistema = await tiemposPorSistema(db, inicioAnoRaw, finVentana);
const tRespAll = tiemposSistema.flatMap((r) => (r.respuestaHoras != null ? [{ h: r.respuestaHoras, n: r.conRespuesta }] : []));
const tRepAll = tiemposSistema.flatMap((r) => (r.reparacionHoras != null ? [{ h: r.reparacionHoras, n: r.conReparacion }] : []));
const nResp = tRespAll.reduce((s2, x) => s2 + x.n, 0);
const nRep = tRepAll.reduce((s2, x) => s2 + x.n, 0);
const respuestaGlobal = nResp > 0 ? tRespAll.reduce((s2, x) => s2 + x.h * x.n, 0) / nResp : null;
const reparacionGlobal = nRep > 0 ? tRepAll.reduce((s2, x) => s2 + x.h * x.n, 0) / nRep : null;

// Indicador 8 — horas fuera de rango por sala. Lo calcula `horasFueraRangoPorSala`
// de src/lib/aop.ts (dueño de aop_eventos y de la regla del episodio abierto),
// que trabaja por período 'AAAA-MM'. Aquí se acumulan los meses del año en
// curso y se guarda aparte el mes corriente, que es el resumen mensual que
// recibe Control de Infecciones.
// El año y el mes se toman de `ultimosPeriodos`, que ya trabaja en hora de El
// Salvador: usar now.getFullYear() (UTC en el worker) dejaría la tabla vacía
// durante las primeras horas del 1 de enero.
const periodosUlt12 = ultimosPeriodos(12);
const periodoMes = periodosUlt12[periodosUlt12.length - 1];
const periodosAnio = periodosUlt12.filter((p) => p.slice(0, 4) === periodoMes.slice(0, 4));
type SalaAgg = {
  ubicacionId: number | null; sala: string;
  horasAnio: number; desvAnio: number; escAnio: number;
  horasMes: number; desvMes: number; escMes: number;
};
const salasMap = new Map<string, SalaAgg>();
for (const per of periodosAnio) {
  const filas = await horasFueraRangoPorSala(db, per);
  const esMes = per === periodoMes;
  for (const f of filas) {
    const clave = String(f.ubicacionId ?? "sin-sala");
    const g = salasMap.get(clave) ?? {
      ubicacionId: f.ubicacionId, sala: f.sala,
      horasAnio: 0, desvAnio: 0, escAnio: 0, horasMes: 0, desvMes: 0, escMes: 0,
    };
    g.horasAnio += f.horasFueraRango;
    g.desvAnio += f.desviaciones;
    g.escAnio += f.desviacionesEscaladas;
    if (esMes) { g.horasMes += f.horasFueraRango; g.desvMes += f.desviaciones; g.escMes += f.desviacionesEscaladas; }
    salasMap.set(clave, g);
  }
}
const salasFueraRango = [...salasMap.values()]
  .map((g) => ({ ...g, horasAnio: Math.round(g.horasAnio * 10) / 10, horasMes: Math.round(g.horasMes * 10) / 10 }))
  .sort((a, b) => b.horasAnio - a.horasAnio || a.sala.localeCompare(b.sala, "es"));
const horasFueraTotal = Math.round(salasFueraRango.reduce((s2, r) => s2 + r.horasAnio, 0) * 10) / 10;
const horasFueraMes = Math.round(salasFueraRango.reduce((s2, r) => s2 + r.horasMes, 0) * 10) / 10;
const desviacionesTotal = salasFueraRango.reduce((s2, r) => s2 + r.desvAnio, 0);
const escaladasTotal = salasFueraRango.reduce((s2, r) => s2 + r.escAnio, 0);

// Indicador 1 — cumplimiento del preventivo por dominio.
const cumplDominio = await cumplimientoPreventivoPorDominio(db, inicioAnoRaw, finVentana);
const progDominio = cumplDominio.reduce((s2, r) => s2 + r.programados, 0);
const aTiempoDominio = cumplDominio.reduce((s2, r) => s2 + r.aTiempo, 0);
const cumplDominioGlobal = progDominio > 0 ? (aTiempoDominio / progDominio) * 100 : null;

const ESTADO_OT_BADGE: Record<string, string> = {
  abierta: "bg-blue-100 text-blue-700",
  en_proceso: "bg-amber-100 text-amber-700",
  en_espera: "bg-slate-200 text-slate-700",
  completada: "bg-emerald-100 text-emerald-700",
  verificada: "bg-teal-100 text-teal-700",
};
const ESTADO_OT_LABEL: Record<string, string> = {
  abierta: "Abierta", en_proceso: "En proceso", en_espera: "En espera",
  completada: "Completada", verificada: "Verificada", cerrada: "Cerrada", cancelada: "Cancelada",
};
// Semáforo de tiempos: < 1 h verde, < 4 h ámbar, el resto rojo (respuesta);
// reparación se mide en días porque el EOP admite mitigación intermedia.
const colorResp = (h: number | null) => h == null ? "text-slate-300" : h <= 1 ? "text-emerald-600" : h <= 4 ? "text-amber-600" : "text-red-600";
const colorRep = (h: number | null) => h == null ? "text-slate-300" : h <= 8 ? "text-emerald-600" : h <= 24 ? "text-amber-600" : "text-red-600";
const colorFuera = (h: number) => h === 0 ? "text-emerald-600" : h < 8 ? "text-amber-600" : "text-red-600";
---

<Layout title="KPIs">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div>
      <h1 class="text-2xl font-bold">Indicadores de mantenimiento</h1>
      <p class="text-sm text-slate-500">Vista ejecutiva · ventana: últimos 30 días / año en curso</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <button id="pdfBtn" class="btn-secondary" disabled={!hayMetricas}>Reporte JCI (PDF)</button>
      <a href="/reportes" class="btn-secondary">Reportes CSV</a>
    </div>
  </div>

  <!-- Aviso de línea base: KPIs reiniciados a partir de la fecha de corte. -->
  <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
    <div class="font-semibold">Línea base de KPIs: {fmtFechaSolo(KPI_BASELINE_DATE)}</div>
    <p class="mt-1 text-xs text-amber-800/90">
      Por retrasos y cambios de sistema que impidieron cerrar OTs/tickets a tiempo, los indicadores de mantenimiento
      (Cumplimiento SLA, MTTR, MTBF, Backlog vencido) cuentan únicamente OTs creadas a partir de esa fecha; el
      histórico previo queda excluido para no distorsionar la tendencia.
      <strong>Satisfacción</strong> y <strong>Disponibilidad</strong> no se ven afectadas y siguen reflejando toda la información disponible.
    </p>
  </div>

  <!-- ═══ Mantenimiento diferido · GO-GUI-011-2026 §2.3 ═══════════════════ -->
  <section id="diferidoSection" class="card mt-4 border-l-4 p-5" class:list={[diferidas.length === 0 ? "border-emerald-500" : "border-red-500"]}>
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <h2 class="font-semibold text-slate-900">Mantenimiento diferido</h2>
        <p class="mt-0.5 text-xs text-slate-500">
          GO-GUI-011-2026 §2.3: toda orden <strong>P1</strong> vencida más de {DIAS_DIFERIDO} días
          <strong>sin riesgo aceptado por escrito</strong>. Entran las de vencimiento anterior al {fmtFechaSoloCompacta(corteDiferido)}
          que siguen sin cerrar ni cancelar.
        </p>
      </div>
      <div class="shrink-0 text-right">
        <div class:list={["text-3xl font-bold", diferidas.length === 0 ? "text-emerald-600" : "text-red-600"]}>{diferidas.length}</div>
        <div class="text-[11px] text-slate-500">OT P1 diferidas</div>
      </div>
    </div>

    {diferidas.length === 0 ? (
      <p class="mt-3 rounded-md bg-emerald-50 px-3 py-2 text-sm text-emerald-800">
        ✓ Ninguna orden P1 lleva más de {DIAS_DIFERIDO} días vencida sin riesgo aceptado por escrito.
      </p>
    ) : (
      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 uppercase text-slate-500">
            <tr>
              <th class="px-3 py-2">OT</th>
              <th class="px-3 py-2">Equipo / procedimiento</th>
              <th class="px-3 py-2">Sistema o dominio</th>
              <th class="px-3 py-2">Vencimiento</th>
              <th class="px-3 py-2 text-right">Días</th>
              <th class="px-3 py-2">Estado</th>
              {puedeAceptarRiesgo && <th class="px-3 py-2 text-right">Riesgo</th>}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {diferidas.map((d) => (
              <tr>
                <td class="px-3 py-2 align-top">
                  <a href={`/ordenes/${d.id}`} class="font-semibold text-brand-700 hover:underline">#{d.id}</a>
                  <div class="max-w-[15rem] truncate text-[11px] text-slate-500" title={d.titulo}>{d.titulo}</div>
                </td>
                <td class="px-3 py-2 align-top">
                  {d.activoId != null ? (
                    <a href={`/activos/${d.activoId}`} class="text-slate-700 hover:underline">
                      <span class="font-mono text-[10px] text-slate-400">{d.activoCodigo}</span> {d.activoNombre}
                    </a>
                  ) : <span class="text-slate-400">Sin equipo</span>}
                  {d.procedimientoCodigo && (
                    <div class="mt-0.5"><span class="badge bg-slate-100 font-mono text-[10px] text-slate-600">{d.procedimientoCodigo}</span></div>
                  )}
                </td>
                <td class="px-3 py-2 align-top text-slate-600">{d.dominioLabel}</td>
                <td class="px-3 py-2 align-top whitespace-nowrap text-slate-600">{fmtFechaSoloCompacta(d.vencimiento)}</td>
                <td class="px-3 py-2 align-top text-right font-bold text-red-600">{d.diasVencida}</td>
                <td class="px-3 py-2 align-top">
                  <span class:list={["badge", ESTADO_OT_BADGE[d.estado] ?? "bg-slate-100 text-slate-600"]}>{ESTADO_OT_LABEL[d.estado] ?? d.estado}</span>
                  {d.nivelRiesgo === "alto" && <span class="badge ml-1 bg-red-100 text-red-700">riesgo alto</span>}
                </td>
                {puedeAceptarRiesgo && (
                  <td class="px-3 py-2 align-top text-right">
                    <button type="button" class="riesgo-btn btn-secondary btn-sm whitespace-nowrap"
                      data-id={String(d.id)} data-titulo={d.titulo} data-dias={String(d.diasVencida)}>
                      Aceptar riesgo por escrito
                    </button>
                  </td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {diferidoAceptado.length > 0 && (
      <details class="mt-4 rounded-md border border-slate-200 bg-slate-50/60 p-3">
        <summary class="cursor-pointer text-xs font-semibold text-slate-700">
          Riesgos aceptados por escrito ({diferidoAceptado.length}) — fuera del indicador, con la traza intacta
        </summary>
