---
// Viñetas de calibración (fase 59, WP-B · requisito 5). Etiquetas de 63,5 × 38,1 mm,
// 18 por hoja carta (3 × 6), solo texto. Por defecto, las de equipos al día; desde la
// ficha (?activos=ID), la del equipo en cualquier estado salvo sin calibración y «No requiere».
// Las medidas están en dos variables CSS (--vw y --vh).
import Layout from "@/layouts/Layout.astro";
import CalibracionesNav from "@/components/CalibracionesNav.astro";
import { asc } from "drizzle-orm";
import { getDb } from "@/lib/db";
import { sucursales } from "@/lib/schema";
import { ESTADO_CALIBRACION_LABEL, estaAlDia, fechaCorta, hoySV, normalizarTexto, puedeRegistrarBio, puedeVerBio } from "@/lib/biomedico";
import { RESULTADO_CALIB_LABEL } from "@/lib/inventario-jci";
import {
  AREAS_CAL, esResultadoCal, idLimpio, leerFiltrosCal, opcionesUbicacionVinetas, paginarVinetas, pasaFiltrosCal, tituloVineta,
  ubicacionVinetas, type FilaCal,
} from "@/lib/metrologia";
import { cargarFilasCal } from "@/lib/metrologia-db";
export const prerender = false;

const user = Astro.locals.user!;
if (!puedeRegistrarBio(user.rol)) return Astro.redirect(puedeVerBio(user.rol) ? "/calibraciones" : "/");

const POR_HOJA = 18;
const ESTADOS_VINETA = [
  { valor: "al_dia", etiqueta: "Al día (vigente o por vencer)" },
  { valor: "vigente", etiqueta: ESTADO_CALIBRACION_LABEL.vigente },
  { valor: "por_vencer", etiqueta: ESTADO_CALIBRACION_LABEL.por_vencer },
  { valor: "vencida", etiqueta: ESTADO_CALIBRACION_LABEL.vencida },
  { valor: "no_conforme", etiqueta: ESTADO_CALIBRACION_LABEL.no_conforme },
  { valor: "sin_certificado", etiqueta: ESTADO_CALIBRACION_LABEL.sin_certificado },
  { valor: "todas", etiqueta: "Todas las que tienen calibración" },
] as const;

const q = Astro.url.searchParams;
const hoy = hoySV();
// ?activos=1,2,3 (desde la ficha): manda sobre los demás filtros y no filtra por estado.
const ids = [...new Set((q.get("activos") ?? "").split(",").map((s) => idLimpio(s)).filter((n): n is number => n !== null))].slice(0, 500);
const porIds = ids.length > 0;
const filtros = { ...leerFiltrosCal(q), estado: null };
const estadoTxt = q.get("estado") ?? "";
const estado = ESTADOS_VINETA.some((e) => e.valor === estadoTxt) ? estadoTxt : "al_dia";
const ubicacionPedida = idLimpio(q.get("ubicacion"));
const codigo = (q.get("codigo") ?? "").trim();
const inicioNum = Number(q.get("inicio") ?? "1");
const inicio = Number.isInteger(inicioNum) && inicioNum >= 1 && inicioNum <= POR_HOJA ? inicioNum : 1;

const db = getDb(Astro);
const [todas, sedes] = await Promise.all([
  cargarFilasCal(db, { hoy }),
  db.select({ id: sucursales.id, nombre: sucursales.nombre, activa: sucursales.activa }).from(sucursales).orderBy(asc(sucursales.nombre)),
]);
// Los equipos sin calibración registrada no tienen viñeta; los «No requiere», tampoco.
const conVineta = todas.filter((f) => f.estado !== "sin_calibracion" && f.estado !== "no_aplica");
// Ubicaciones con equipos con viñeta (de la sede elegida, si hay una). Al cambiar de sede el
// formulario reenvía la ubicación anterior: si es de otra sede, no filtra.
const ubicaciones = opcionesUbicacionVinetas(conVineta, filtros.sede);
const ubicacion = ubicacionVinetas(ubicaciones, ubicacionPedida);
const pasaEstado = (f: FilaCal) => estado === "todas" || (estado === "al_dia" ? estaAlDia(f.estado) : f.estado === estado);
const idsElegidos = new Set(ids);
const elegidas = porIds
  ? conVineta.filter((f) => idsElegidos.has(f.activoId))
  : conVineta.filter((f) => pasaFiltrosCal(f, filtros, true)
      && (ubicacion === null || f.ubicacionId === ubicacion)
      && (!codigo || normalizarTexto(f.codigo).includes(normalizarTexto(codigo)))
      && pasaEstado(f));
const comparar = (a: string | null, b: string | null) => (a === b ? 0 : a === null ? 1 : b === null ? -1 : a.localeCompare(b, "es", { numeric: true }));
const filas = [...elegidas].sort((a, b) => comparar(a.sede, b.sede) || comparar(a.ubicacion, b.ubicacion) || a.codigo.localeCompare(b.codigo, "es", { numeric: true }));
const hojas = paginarVinetas(filas, POR_HOJA, inicio - 1);
const sinVineta = porIds ? ids.length - filas.length : 0;
const sedesSelect = sedes.filter((s) => s.activa || s.id === filtros.sede);
const resultadoTxt = (r: string | undefined) => (r && esResultadoCal(r) ? RESULTADO_CALIB_LABEL[r] : "");
---

<Layout title="Viñetas de calibración">
  <div class="no-print">
    <CalibracionesNav activo="vinetas" rol={user.rol} area={filtros.area} />
    <h1 class="mt-4 text-2xl font-bold">Viñetas de calibración</h1>
    <p class="text-sm text-slate-500">Etiquetas de 63,5 × 38,1 mm (2,5 × 1,5 pulgadas), 18 por hoja carta. Al imprimir elige tamaño real (100 %), sin ajustar a la página.</p>

    <form method="get" action="/calibraciones/vinetas" class="card mt-4 grid grid-cols-2 gap-3 p-4 md:grid-cols-4 xl:grid-cols-8">
      {porIds ? (
        <>
          <input type="hidden" name="activos" value={ids.join(",")} />
          <p class="col-span-2 self-end text-sm text-slate-600 md:col-span-3 xl:col-span-6">
            {ids.length === 1 ? "Viñeta del equipo elegido en su ficha." : `Viñetas de los ${ids.length} equipos elegidos.`}
            <a class="ml-1 text-brand-600 hover:underline" href="/calibraciones/vinetas">Ver todas</a>
          </p>
        </>
      ) : (
        <>
          <div>
            <label class="label" for="v_sede">Sede</label>
            <select class="input" id="v_sede" name="sede" onchange="this.form.submit()">
              <option value="">Todas</option>
              {sedesSelect.map((s) => <option value={s.id} selected={s.id === filtros.sede}>{s.nombre}</option>)}
            </select>
          </div>
          <div>
            <label class="label" for="v_ubicacion">Ubicación</label>
            <select class="input" id="v_ubicacion" name="ubicacion">
              <option value="">Todas</option>
              {ubicaciones.map(([id, nombre]) => <option value={id} selected={id === ubicacion}>{nombre}</option>)}
            </select>
          </div>
          <div>
            <label class="label" for="v_area">Área</label>
            <select class="input" id="v_area" name="area">
              <option value="">Todas</option>
              {AREAS_CAL.map((a) => <option value={a.clave} selected={a.clave === filtros.area}>{a.etiqueta}</option>)}
            </select>
          </div>
          <div>
            <label class="label" for="v_estado">Estado</label>
            <select class="input" id="v_estado" name="estado">
              {ESTADOS_VINETA.map((e) => <option value={e.valor} selected={e.valor === estado}>{e.etiqueta}</option>)}
            </select>
          </div>
          <div>
            <label class="label" for="v_codigo">Código contiene</label>
            <input class="input" id="v_codigo" name="codigo" value={codigo} placeholder="Ej.: BIO-00" />
          </div>
          <div class="flex items-end">
            <label class="flex items-center gap-2 pb-2 text-sm font-semibold text-slate-700">
              <input type="checkbox" name="criticos" value="1" checked={filtros.criticos} class="h-4 w-4" />
              Solo críticos
            </label>
          </div>
        </>
      )}
      <div>
        <label class="label" for="v_inicio">Empezar en la posición</label>
        <input class="input" id="v_inicio" name="inicio" type="number" min="1" max={POR_HOJA} value={inicio} />
      </div>
      <div class="flex items-end">
        <button type="submit" class="btn-primary w-full">Ver viñetas</button>
      </div>
    </form>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="font-semibold">{filas.length === 1 ? "1 viñeta" : `${filas.length} viñetas`} en {hojas.length === 1 ? "1 hoja" : `${hojas.length} hojas`}.</p>
        <p class="text-xs text-slate-500">Los equipos sin calibración registrada no tienen viñeta.{inicio > 1 ? ` La primera hoja deja libres las ${inicio - 1} primeras posiciones.` : ""}</p>
        {sinVineta > 0 && (
          <p class="mt-1 text-sm text-amber-700">{sinVineta === 1 ? "Un equipo elegido no tiene viñeta" : `${sinVineta} equipos elegidos no tienen viñeta`}: sin calibración registrada, marcado «No requiere» o dado de baja.</p>
        )}
      </div>
      <button type="button" class="btn-primary" onclick="window.print()" disabled={filas.length === 0}>Imprimir viñetas</button>
    </div>
  </div>

  {filas.length === 0 ? (
    <p class="card mt-4 p-6 text-center text-sm text-slate-500 no-print">No hay viñetas con esos filtros.</p>
  ) : (
    <div class="vinetas-scroll mt-4">
      {hojas.map((hoja) => (
        <div class="hoja-vinetas">
          {hoja.map((f) => f ? (
            <div class="vineta" data-estado={f.estado}>
              <div class="vineta-cab"><span>{tituloVineta(f.estado)}</span><b>{f.codigo}</b></div>
              <div class="vineta-nombre">{f.nombre}</div>
              <div class="vineta-linea">Calibrado: {fechaCorta(f.ultima)}</div>
              <div class="vineta-proxima">Próxima: {fechaCorta(f.proxima)}</div>
              <div class="vineta-linea">Cert.: {f.cal?.numeroCertificado ?? "—"}{resultadoTxt(f.cal?.resultado) ? ` · ${resultadoTxt(f.cal?.resultado)}` : ""}</div>
              <div class="vineta-linea">Lab.: {f.cal?.laboratorio ?? "—"}{f.cal?.labAcreditado ? " (acreditado)" : ""}</div>
            </div>
          ) : <div class="vineta vacia" aria-hidden="true"></div>)}
        </div>
      ))}
    </div>
  )}
</Layout>

<style is:global>
  :root { --vw: 63.5mm; --vh: 38.1mm; }
  .vinetas-scroll { overflow-x: auto; }
  .hoja-vinetas {
    display: grid; grid-template-columns: repeat(3, var(--vw)); grid-auto-rows: var(--vh); gap: 3mm;
    page: vinetas; break-after: page; width: max-content; margin: 0 auto 8mm;
  }
  .hoja-vinetas:last-child { break-after: auto; }
  .vineta {
    box-sizing: border-box; width: var(--vw); height: var(--vh); overflow: hidden; padding: 2mm 2.5mm;
    border: .3mm solid #1E2142; border-radius: 1.5mm; font: 7.5pt/1.25 Figtree, Arial, sans-serif; background: #fff; color: #1A1A1A;
    display: flex; flex-direction: column; gap: .5mm;
  }
  .vineta-cab {
    display: flex; justify-content: space-between; gap: 2mm; font-size: 7pt; font-weight: 700; text-transform: uppercase;
    letter-spacing: .04em; color: #1E2142; border-bottom: .2mm solid #1E2142; padding-bottom: .6mm;
  }
  .vineta-cab b { white-space: nowrap; }
  .vineta[data-estado="vencida"] .vineta-cab, .vineta[data-estado="no_conforme"] .vineta-cab { color: #C03435; border-bottom-color: #C03435; }
  .vineta-nombre { font-weight: 600; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .vineta-proxima { font-size: 10pt; font-weight: 700; }
  .vineta-linea { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vineta.vacia { border: .2mm dashed #BDC6D8; background: transparent; }
  @page vinetas { size: letter; margin: 10mm 8mm; @bottom-right { content: none; } }
  @media print {
    .vinetas-scroll { overflow: visible; margin: 0; }
    .hoja-vinetas { margin: 0; }
    .vineta.vacia { border-color: transparent; }
  }
</style>
