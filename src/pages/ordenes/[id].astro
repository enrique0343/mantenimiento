---
import { fmtFechaCompacta, fmtFechaSoloCompacta } from "@/lib/datetime";
import { encodeInlineScriptVars } from "@/lib/inline-script-vars";
import Layout from "@/layouts/Layout.astro";
import { getConjuntoDeOrden } from "@/lib/conjuntos";
import { getDb } from "@/lib/db";
import { ordenes, activos, usuarios, comentarios, adjuntos, items as itemsTable, sucursales, ubicaciones, ordenRepuestos, stock, empresa, solicitudesCompra, ordenPrerrequisitos, ordenLiberaciones, procedimientos, eopFicha, planesMantenimiento } from "@/lib/schema";
import { eq, desc, and, inArray, asc } from "drizzle-orm";
import {
  ESTADO_LABEL, ESTADO_COLOR, TIPO_COLOR, TIPO_LABEL, TIPO_ICONO, PRIO_COLOR,
  TIPOS_OT, CLASES_PRIORIDAD, CLASE_PRIORIDAD_COLOR, CLASE_PRIORIDAD_LABEL,
  CLASE_PRIORIDAD_PLAZO, NIVEL_RIESGO_COLOR,
  transicionesPermitidas, puedeEditarEjecucion,
  parseChecklist, progresoChecklist, evaluarValorChecklist,
  PRERREQ_TIPOS, PRERREQ_LABEL, PRERREQ_ICONO, PRERREQ_REFERENCIA_HINT,
  validarPrerrequisitosParaIniciar, validarLiberacionesParaCierre,
  liberacionTieneLectura, evaluarConformeLiberacion, requiereCausaRaiz, causaRaizVencida,
  tiemposEmergencia, fmtDuracionHoras, etiquetaMitigacion, isoALocalInput,
  puedeCerrarSinLectura, HORAS_CAUSA_RAIZ, MIN_CAUSA_RAIZ,
  type EstadoOT, type TipoOT, type ClasePrioridad, type PrerrequisitoTipo,
} from "@/lib/ordenes";
import { etiquetaOT } from "@/lib/orden-codigo";
import { leerVerificacionOrden, leerOrigenesRondaOrden, puedeVerificarOrden, esRevisorOrden } from "@/lib/orden-verificacion";
import { fmtCantidad } from "@/lib/inventario";
import { queSigue, type QueSigue, type Situacion } from "@/lib/resolver";
import { TIPO_PROC, estadoInfo, puedeVerProcedimientos, type TipoProc } from "@/lib/procedimientos";
import { parseArea, areaHref, AREAS, activoAreaCondition } from "@/lib/areas";
export const prerender = false;

const id = Number(Astro.params.id);
if (!Number.isFinite(id)) return Astro.redirect("/ordenes");

const user = Astro.locals.user!;
const db = getDb(Astro);

// D1 corta el resultado a 100 columnas y ordenes(62) + activos(45) ya se pasa:
// la consulta fallaba entera y la ficha de la orden quedaba en error. Se piden
// solo las columnas que esta pantalla usa.
const [row] = await db
  .select({
    orden: ordenes,
    activo: {
      id: activos.id,
      codigo: activos.codigo,
      nombre: activos.nombre,
      tipo: activos.tipo,
      marca: activos.marca,
      modelo: activos.modelo,
      serial: activos.serial,
      ubicacion: activos.ubicacion,
      criticidadOperacional: activos.criticidadOperacional,
    },
    asignado: { id: usuarios.id, nombre: usuarios.nombre, email: usuarios.email, tarifaHora: usuarios.tarifaHora },
    ubicacion: { id: ubicaciones.id, nombre: ubicaciones.nombre, tipo: ubicaciones.tipo },
    sucursal: { id: sucursales.id, nombre: sucursales.nombre },
  })
  .from(ordenes)
  .leftJoin(activos, eq(activos.id, ordenes.activoId))
  .leftJoin(usuarios, eq(usuarios.id, ordenes.asignadoA))
  .leftJoin(ubicaciones, eq(ubicaciones.id, activos.ubicacionId))
  .leftJoin(sucursales, eq(sucursales.id, ubicaciones.sucursalId))
  .where(eq(ordenes.id, id))
  .limit(1);

if (!row) return Astro.redirect("/ordenes");

const o = row.orden;
const area = parseArea(o.rubro);
const rawArea = Astro.url.searchParams.get("area");
if (rawArea !== null && (!parseArea(rawArea) || parseArea(rawArea) !== area)) return new Response("El registro no pertenece al área seleccionada", { status: 400 });
if (area && !rawArea) return Astro.redirect(areaHref(Astro.url.pathname, area));
const estadoActual = o.estado as EstadoOT;
const esAsignado = o.asignadoA === user.id;
const esTecnico = user.rol === "tecnico";
const esJefatura = user.rol === "admin" || user.rol === "jefe";
// El técnico no ve tiempos de medición: cuándo inició, cuánto lleva o tardó,
// horas trabajadas, minutos estimados ni las duraciones del EOP. Se siguen
// registrando igual. Los plazos operativos (vence, clase P1) sí los ve.
const verTiempos = !esTecnico;
// Equipo y asignación solo cambian antes de enviar la orden a verificación.
const ordenSinEnviar = estadoActual === "abierta" || estadoActual === "en_proceso" || estadoActual === "en_espera";
const conjuntoOrigen = ["admin", "jefe", "tecnico", "visualizador"].includes(user.rol)
  ? await getConjuntoDeOrden(Astro, id) : null;

// Si la OT NO tiene activo pero SÍ tiene sucursalId/ubicacionId propios
// (porque se creó como trabajo general con sucursal/ubicación), los cargamos.
let ordenSucursal: { id: number; nombre: string } | null = null;
let ordenUbicacion: { id: number; nombre: string; tipo: string } | null = null;
if (!row.activo && (o as any).sucursalId) {
  const [s] = await db.select({ id: sucursales.id, nombre: sucursales.nombre }).from(sucursales).where(eq(sucursales.id, (o as any).sucursalId)).limit(1);
  ordenSucursal = s ?? null;
}
if (!row.activo && (o as any).ubicacionId) {
  const [u] = await db.select({ id: ubicaciones.id, nombre: ubicaciones.nombre, tipo: ubicaciones.tipo }).from(ubicaciones).where(eq(ubicaciones.id, (o as any).ubicacionId)).limit(1);
  ordenUbicacion = u as any ?? null;
}

const [verifUsr] = o.verificadoPor
  ? await db.select({ id: usuarios.id, nombre: usuarios.nombre }).from(usuarios).where(eq(usuarios.id, o.verificadoPor)).limit(1)
  : [null];
const [cierraUsr] = o.cerradoPor
  ? await db.select({ id: usuarios.id, nombre: usuarios.nombre }).from(usuarios).where(eq(usuarios.id, o.cerradoPor)).limit(1)
  : [null];

const coms = await db
  .select({ c: comentarios, u: { id: usuarios.id, nombre: usuarios.nombre } })
  .from(comentarios)
  .leftJoin(usuarios, eq(usuarios.id, comentarios.usuarioId))
  .where(eq(comentarios.ordenId, id))
  .orderBy(comentarios.id);

const adjs = await db.select().from(adjuntos).where(eq(adjuntos.ordenId, id));
const tecnicos = await db
  .select({ id: usuarios.id, nombre: usuarios.nombre, rol: usuarios.rol })
  .from(usuarios)
  .where(and(eq(usuarios.activo, true), inArray(usuarios.rol, ["tecnico", "jefe", "proveedor"])))
  .orderBy(asc(usuarios.nombre));

// Repuestos consumidos en esta OT (bodega única)
const repuestosRows = await db
  .select({ rep: ordenRepuestos, it: itemsTable })
  .from(ordenRepuestos)
  .leftJoin(itemsTable, eq(itemsTable.id, ordenRepuestos.itemId))
  .where(eq(ordenRepuestos.ordenId, id))
  .orderBy(desc(ordenRepuestos.id));

const totalRepuestos = repuestosRows.reduce(
  (s, r) => s + (r.rep.precioUnitario ?? 0) * r.rep.cantidad,
  0
);

// Costo: mano de obra (horas × tarifa del técnico asignado) + repuestos
const tarifaTecnico = Number(row.asignado?.tarifaHora ?? 0);
const horasTrab = Number(o.horasTrabajadas ?? 0);
const costoManoObra = horasTrab * tarifaTecnico;
const costoTotal = costoManoObra + totalRepuestos;

// Para el formulario de agregar repuesto
const itemsActivos = await db
  .select({ id: itemsTable.id, codigo: itemsTable.codigo, nombre: itemsTable.nombre, unidad: itemsTable.unidad, precio: itemsTable.precioReferencia })
  .from(itemsTable)
  .where(eq(itemsTable.activo, true))
  .orderBy(itemsTable.nombre);

const itemsRepJson = JSON.stringify(itemsActivos);

// Selectores en cascada: sucursal → ubicación → equipo. Se ofrecen solo cuando
// el servidor acepta el cambio: jefatura, orden sin enviar, fuera de un PM y
// sin conjunto trazado. Al técnico se lo rechaza siempre.
const puedeAsignarActivo = esJefatura && ordenSinEnviar && !o.planId && !conjuntoOrigen;
const activosLista = puedeAsignarActivo
  ? await db
      .select({ id: activos.id, codigo: activos.codigo, nombre: activos.nombre, ubicacionId: activos.ubicacionId })
      .from(activos)
      .where(area ? activoAreaCondition(area) : eq(activos.id, -1))
      .orderBy(asc(activos.codigo))
  : [];
const ubicacionesLista = puedeAsignarActivo
  ? await db
      .select({ id: ubicaciones.id, nombre: ubicaciones.nombre, tipo: ubicaciones.tipo, sucursalId: ubicaciones.sucursalId })
      .from(ubicaciones)
      .where(eq(ubicaciones.activa, true))
      .orderBy(asc(ubicaciones.nombre))
  : [];
const sucursalesLista = puedeAsignarActivo
  ? await db
      .select({ id: sucursales.id, nombre: sucursales.nombre })
      .from(sucursales)
      .where(eq(sucursales.activa, true))
      .orderBy(asc(sucursales.nombre))
  : [];

const checklistItems = parseChecklist(o.checklistEjecucion);
const progreso = progresoChecklist(checklistItems);

// ══════════════════════════════════════════════════════════════════════════
// MOP y EOP sobre la orden de trabajo (Fase 47 · GO-GUI-011-2026, cap. 02,
// 05 y 06). El MOP vive como una OT tipo "intervención" con prerrequisitos
// bloqueantes y lecturas de liberación; el EOP como una OT tipo "emergencia"
// con los tres tiempos y la causa raíz a 72 h.
// Las consultas van en try/catch: si un entorno todavía no tiene la migración
// 0047 aplicada, la ficha de la OT sigue abriéndose.
// ══════════════════════════════════════════════════════════════════════════
const esMop = o.tipo === "intervencion";
const esEop = o.tipo === "emergencia";

let prerrequisitos: any[] = [];
let liberaciones: any[] = [];
let procedimientoRef: { id: number; codigoCorto: string; titulo: string; version: string | null; tipo: string; estado: string } | null = null;
let accionesVinculadas: string[] = [];
let etiquetaMit = etiquetaMitigacion(null);
let etiquetaMitFicha: string | null = null;
let fase47Error: string | null = null;
try {
  const pr = await db
    .select({ p: ordenPrerrequisitos, u: usuarios })
    .from(ordenPrerrequisitos)
    .leftJoin(usuarios, eq(usuarios.id, ordenPrerrequisitos.cumplidoPor))
    .where(eq(ordenPrerrequisitos.ordenId, id))
    .orderBy(asc(ordenPrerrequisitos.orden), asc(ordenPrerrequisitos.id));
  prerrequisitos = pr.map((r) => ({ ...r.p, cumplidoNombre: r.u?.nombre ?? null }));

  const lb = await db
    .select({ l: ordenLiberaciones, u: usuarios })
    .from(ordenLiberaciones)
    .leftJoin(usuarios, eq(usuarios.id, ordenLiberaciones.medidoPor))
    .where(eq(ordenLiberaciones.ordenId, id))
    .orderBy(asc(ordenLiberaciones.orden), asc(ordenLiberaciones.id));
  liberaciones = lb.map((r) => ({ ...r.l, medidoNombre: r.u?.nombre ?? null }));

  if (o.procedimientoId) {
    const [pd] = await db
      .select({ id: procedimientos.id, codigoCorto: procedimientos.codigoCorto, titulo: procedimientos.titulo, version: procedimientos.version, tipo: procedimientos.tipo, estado: procedimientos.estado })
      .from(procedimientos)
      .where(eq(procedimientos.id, o.procedimientoId))
      .limit(1);
    procedimientoRef = pd ?? null;
    // La hora intermedia cambia de nombre según el EOP (energía de emergencia,
    // reserva en servicio…): la ficha del procedimiento la fija.
    const [fi] = await db
      .select({
        etiqueta: eopFicha.etiquetaHoraMitigacion,
        accion1: eopFicha.accion1,
        accion2: eopFicha.accion2,
        accion3: eopFicha.accion3,
      })
      .from(eopFicha)
      .where(eq(eopFicha.procedimientoId, o.procedimientoId))
      .limit(1);
    etiquetaMitFicha = fi?.etiqueta?.trim() || null;
    etiquetaMit = etiquetaMitigacion(etiquetaMitFicha);
    // Las tres primeras acciones del EOP ya vinculado, para no obligar a nadie
    // a abrir otra pantalla cuando la orden es una emergencia.
    if (fi) accionesVinculadas = [fi.accion1, fi.accion2, fi.accion3].filter(Boolean) as string[];
  }
} catch (e: any) {
  fase47Error = String(e?.message ?? e);
}

// ══════════════════════════════════════════════════════════════════════════
// Qué procedimiento rige esta orden (GO-GUI-011-2026, cap. 02)
// Si la orden no trae documento vinculado, el sistema resuelve cuál le toca
// según su tipo: el SOP opera la rutina, el AOP la desviación, el EOP la falla
// y el MOP la intervención. Es una referencia visible y el registro de bajo qué
// documento se trabajó — NO un asistente que reemplace la hoja impresa.
// ══════════════════════════════════════════════════════════════════════════
const SITUACION_DE_TIPO: Record<string, Situacion> = {
  preventivo: "preventivo",
  predictivo: "desviacion",
  correctivo: "falla",
  intervencion: "intervencion",
  emergencia: "falla",
};
const puedeVerProcs = puedeVerProcedimientos(user.rol);
const sucursalDeOrden = (o as any).sucursalId ?? row.sucursal?.id ?? null;
let rige: QueSigue | null = null;
let rigeError: string | null = null;
if (o.activoId) {
  try {
    rige = await queSigue(db, o.activoId, SITUACION_DE_TIPO[o.tipo] ?? "falla", sucursalDeOrden);
  } catch (e: any) {
    rigeError = String(e?.message ?? e);
  }
}
// El documento que manda: el vinculado si lo hay; si no, el que resuelve el
// sistema y que se puede vincular con un clic.
const docRige = procedimientoRef ?? rige?.documento ?? null;
const docEsVinculado = !!procedimientoRef;
const docSugerido = !procedimientoRef ? rige?.documento ?? null : null;
const tipoDocRige = (docRige?.tipo ?? "eop") as TipoProc;
// Las tres primeras acciones salen de la ficha del documento que rige.
const accionesRige = docEsVinculado
  ? (procedimientoRef!.tipo === "eop" ? accionesVinculadas : [])
  : rige?.documento?.tipo === "eop" ? rige.primerasAcciones : [];
// Sin EOP vinculado, la hora intermedia se nombra como la nombra el EOP que
// resolvió el sistema: es el mismo rótulo que ve el técnico en el celular.
if (esEop && !docEsVinculado && rige?.documento?.tipo === "eop") {
  try {
    const [fi] = await db
      .select({ etiqueta: eopFicha.etiquetaHoraMitigacion })
      .from(eopFicha)
      .where(eq(eopFicha.procedimientoId, rige.documento.id))
      .limit(1);
    etiquetaMitFicha = fi?.etiqueta?.trim() || null;
    etiquetaMit = etiquetaMitigacion(etiquetaMitFicha);
  } catch {}
}

const criticidadActivo = (row.activo as any)?.criticidadOperacional ?? null;
const reqCausa = requiereCausaRaiz(o.tipo, criticidadActivo);
const tiempos = tiemposEmergencia(o);
const causaVencida = causaRaizVencida(o.causaRaizVencimiento, o.causaRaiz);
// Causa raíz: la escribe la jefatura dentro de las 72 h, también con la orden
// enviada, verificada o cerrada. Es obligatoria para verificar y cerrar cuando
// el tipo la exige. El técnico escribe qué encontró y qué hizo, no la causa.
const muestraSolucion = o.tipo === "correctivo" || esEop || esMop || reqCausa.requiere;
const muestraCausa = muestraSolucion || !!o.causaRaiz?.trim();
const puedeEscribirCausa = esJefatura && ["en_proceso", "en_espera", "completada", "verificada", "cerrada"].includes(estadoActual);
const faltaCausa = reqCausa.requiere && (o.causaRaiz ?? "").trim().length < MIN_CAUSA_RAIZ;
// Lo que el técnico ve de una emergencia: qué pasos quedaron registrados, sin
// horas. El celular las fija al primer toque y la jefatura las corrige aquí.
const hitosEop = [
  { etiqueta: "Llegada al sitio", hecho: !!o.horaLlegada },
  { etiqueta: etiquetaMitFicha ?? "Situación controlada", hecho: !!o.horaMitigacion },
  { etiqueta: "Restablecimiento", hecho: !!o.horaRestablecimiento },
];
const bloqueoInicio = validarPrerrequisitosParaIniciar(o.tipo, prerrequisitos);
const bloqueoCierre = validarLiberacionesParaCierre(o.tipo, liberaciones);
const prerreqCumplidos = prerrequisitos.filter((p) => p.cumplido).length;
const liberacionesConLectura = liberaciones.filter((l) => liberacionTieneLectura(l)).length;
const liberacionesNoConformes = liberaciones.filter((l) => l.conforme === false).length;
// Quién puede tocar las tarjetas del MOP/EOP: la jefatura mientras la OT no
// esté cerrada; el técnico asignado mientras no la envíe a verificación (en una
// emergencia actúa primero y registra después, así que no exigimos que ya esté
// "en proceso"). Enviada, la corrige la jefatura o la devuelve.
const otAbiertaParaRegistro = estadoActual !== "cerrada" && estadoActual !== "cancelada";
const puedeRegistrarMop =
  otAbiertaParaRegistro &&
  (esJefatura || (esTecnico && esAsignado && ordenSinEnviar));
const puedeConfigurarMop = otAbiertaParaRegistro && (user.rol === "admin" || user.rol === "jefe");
// Los tres tiempos del EOP se corrigen hacia atrás incluso con la orden ya
// cerrada: de ellos salen los indicadores 5 y 7, y una hora mal escrita hay
// que poder arreglarla. Queda en el audit log de la OT.
// Al técnico no se le muestran: el celular las registra al primer toque.
const puedeEditarTiempos = esJefatura;
// El plan de reversa se guarda en la orden: del técnico, el servidor solo lo
// acepta si la tiene asignada.
const puedeGuardarReversa = puedeRegistrarMop;
const muestraMop = esMop || prerrequisitos.length > 0 || liberaciones.length > 0 || !!o.planReversa;
const muestraEop = esEop || !!o.horaAlarma || !!o.horaLlegada || !!o.horaMitigacion || !!o.horaRestablecimiento;

// Solicitudes de compra vinculadas a esta OT
const solicitudesVinculadas = await db
  .select({ id: solicitudesCompra.id, codigo: solicitudesCompra.codigo, titulo: solicitudesCompra.titulo, estado: solicitudesCompra.estado })
  .from(solicitudesCompra)
  .where(eq(solicitudesCompra.ordenId, id));
const puedeSolicitarCompra = (estadoActual === "en_proceso" || estadoActual === "en_espera") &&
  ["admin", "jefe", "tecnico"].includes(user.rol);
const verComprasSection = ["admin", "jefe", "tecnico"].includes(user.rol);

const seguimiento = await leerVerificacionOrden(db, id);
const roundsOrigins = await leerOrigenesRondaOrden(db, id);
const [scheduledPM] = o.planId ? await db.select().from(planesMantenimiento).where(eq(planesMantenimiento.id, o.planId)).limit(1) : [];
const esRevisor = esRevisorOrden(user, seguimiento.control);
const puedeVerificar = puedeVerificarOrden(user, o, seguimiento.control);
// El técnico solo mueve una orden suya o toma una abierta sin asignar: lo demás
// el servidor se lo rechaza, así que no se le ofrece.
const tecnicoMueve = !esTecnico || esAsignado || (estadoActual === "abierta" && !o.asignadoA);
const proximas = (tecnicoMueve ? transicionesPermitidas(estadoActual, user.rol, esAsignado) : [])
  .filter((s) => !["verificada", "cerrada"].includes(s));
if (["completada", "verificada"].includes(estadoActual) && puedeVerificar) proximas.push("verificada");
if (["completada", "verificada", "cerrada"].includes(estadoActual) && esRevisor && !proximas.includes("en_proceso")) proximas.push("en_proceso");
const revisores = ["admin", "jefe"].includes(user.rol)
  ? await db.select({ id: usuarios.id, nombre: usuarios.nombre }).from(usuarios).where(and(eq(usuarios.activo, true), inArray(usuarios.rol, ["admin", "jefe", "tecnico"]))).orderBy(asc(usuarios.nombre)) : [];
const puedeEditar = puedeEditarEjecucion(user.rol, esAsignado, estadoActual);

// Las fotos "antes" SÍ se pueden subir desde el estado "abierta" (no requiere
// haber pulsado Iniciar). El flujo correcto es: verificar lugar → foto antes
// → Iniciar → trabajar → foto después. Bloqueadas solo en cerrada/cancelada.
const puedeSubirAntes =
  estadoActual !== "cerrada" && estadoActual !== "cancelada" &&
  (esJefatura || (esTecnico && (esAsignado || esRevisor))) &&
  // Enviada a verificación, solo quien revisa agrega evidencia.
  (ordenSinEnviar || esRevisor);
// Retirar una foto: jefatura o técnico asignado, antes de enviar la orden.
const puedeBorrarAntes = ordenSinEnviar && (esJefatura || (esTecnico && esAsignado));
// La asignación la cambia la jefatura antes de enviar la orden. El técnico solo
// puede tomar una orden abierta sin asignar.
const puedeCambiarAsignacion = esJefatura && ordenSinEnviar;
const puedeTomarOrden = esTecnico && estadoActual === "abierta" && !o.asignadoA;
// Revertir un consumo devuelve stock: el servidor solo se lo deja a la jefatura.
const puedeRevertirRepuesto = puedeEditar && esJefatura;
// Lo que el servidor exige al MOP para enviarlo y verificarlo: las lecturas de
// liberación obligatorias, medidas y dentro de rango. Con la reversa ejecutada
// el sistema volvió a como estaba y no hay nada que liberar.
const reversaHecha = !!o.reversaEjecutada;
const faltanLecturas = esMop && !reversaHecha && bloqueoCierre.faltantes.length > 0;
const lecturasFuera = esMop && !reversaHecha
  ? liberaciones.filter((l) => l.obligatoria && evaluarConformeLiberacion(l.minAceptable, l.maxAceptable, l.valorMedido ?? null) === false)
  : [];
const envioBloqueado = faltanLecturas || lecturasFuera.length > 0;
// Sin lectura (no fuera de rango), la jefatura lo envía a verificación con
// motivo escrito. No lo cierra: queda pendiente de verificación.
const puedeEnviarSinLectura = faltanLecturas && lecturasFuera.length === 0 && puedeCerrarSinLectura(user.rol) && estadoActual === "en_proceso";
// Al verificar, el motivo ya registrado no se vuelve a pedir.
const verifSinLectura: "registrado" | "pedir" | "bloqueada" | "fuera" | null =
  lecturasFuera.length > 0 ? "fuera"
  : !faltanLecturas ? null
  : o.cierreSinLecturaMotivo?.trim() ? "registrado"
  : puedeCerrarSinLectura(user.rol) ? "pedir" : "bloqueada";
// Quien revisa sin ser jefatura no puede escribir la causa raíz que falta.
const verifSinCausa = faltaCausa && !esJefatura;

const ESTADO_PROGRESO: Record<EstadoOT, number> = {
  abierta: 1, en_proceso: 2, en_espera: 2, completada: 3, verificada: 4, cerrada: 5, cancelada: 0,
};
const stepActual = ESTADO_PROGRESO[estadoActual];

// Fechas DD/MM/AAAA en hora de El Salvador.
const fmt = (s: string | null) => (s ? fmtFechaCompacta(s) : "-");
const fmtDia = (s: string | null) =>
  s ? new Date(s).toLocaleDateString("es", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "America/El_Salvador" }) : "-";
// Un vencimiento guardado solo con fecha (AAAA-MM-DD) no pasa por Date: lo leería
// como medianoche UTC y mostraría el día anterior.
const fmtVence = (s: string | null) =>
  !s ? "-" : /^\d{4}-\d{2}-\d{2}$/.test(s.trim()) ? fmtFechaSoloCompacta(s) : fmtFechaCompacta(s);

const adjsAntes = adjs.filter((a) => a.categoria === "antes");
const adjsDespues = adjs.filter((a) => a.categoria === "despues");
const adjsDocumento = adjs.filter((a) => a.categoria === "documento");
const adjsGeneral = adjs.filter((a) => a.categoria === "general");
---

<Layout title={etiquetaOT(o)}>
  <a href={user.rol === "tecnico" ? "/campo" : areaHref("/ordenes", area)} class="text-sm text-slate-500 hover:underline">&larr; Volver</a>

  {conjuntoOrigen && <section class="card mt-4 border-l-4 border-brand-500 p-4 text-sm">
    <p class="font-medium">Conjunto registrado al vincular esta orden</p>
    <a class="mt-1 inline-block text-brand-700 hover:underline" href={areaHref(`/conjuntos/${conjuntoOrigen.conjuntoId}#mantenimiento`, conjuntoOrigen.rubro)}>{conjuntoOrigen.codigo} · {conjuntoOrigen.nombre}</a>
    <p class="mt-1 text-slate-600">{conjuntoOrigen.funcion}: {conjuntoOrigen.activoCodigo} · {conjuntoOrigen.activoNombre}</p>
    <p class="mt-1 text-xs text-slate-500">Esta referencia se conserva aunque el componente sea reemplazado.</p>
  </section>}

  {(roundsOrigins.length > 0 || scheduledPM) && <section class="card mt-4 border-l-4 border-teal-500 p-4 text-sm" aria-label="Origen y trazabilidad de la orden">
    <h2 class="font-semibold">Origen y trazabilidad de la orden</h2>
    {scheduledPM && <div class="mt-3 rounded bg-slate-50 p-3">
      <a class="font-medium text-brand-700 underline" href={areaHref(`/activos/${scheduledPM.activoId}#plan-${scheduledPM.id}`, area)}>PM programado #{scheduledPM.id} · {scheduledPM.titulo}</a>
      <p class="mt-1 text-slate-600">Frecuencia: {scheduledPM.frecuencia} · Próxima fecha del plan: {fmtFechaSoloCompacta(scheduledPM.proximaFecha)}</p>
    </div>}
    {roundsOrigins.map(origin => <div class="mt-3 rounded bg-teal-50 p-3">
      <a class="font-medium text-brand-700 underline" href={origin.href}>Ronda de las {origin.turno} · {origin.sede} · {fmtFechaSoloCompacta(origin.fecha)}</a>
      <p class="mt-1">{origin.etiqueta}{origin.valor != null ? ` · leído ${origin.valor}` : ""}</p>
      {origin.nota && <p class="mt-1 whitespace-pre-wrap">{origin.nota}</p>}
      <p class="mt-1 text-xs text-slate-500">{origin.registradoPor} · la ronda conserva su propio registro.</p>
    </div>)}
  </section>}

  <div class="mt-2 flex flex-wrap items-start justify-between gap-4">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-2xl font-bold">{o.titulo}</h1>
        {area && <span class="badge bg-teal-100 text-teal-800">{AREAS[area].label}</span>}
        <span class={`badge ${TIPO_COLOR[o.tipo]}`}>{TIPO_ICONO[o.tipo]} {TIPO_LABEL[o.tipo]}</span>
        {o.clasePrioridad && (
          <span class={`badge ${CLASE_PRIORIDAD_COLOR[o.clasePrioridad as ClasePrioridad]}`}
                title={CLASE_PRIORIDAD_PLAZO[o.clasePrioridad as ClasePrioridad]}>
            {CLASE_PRIORIDAD_LABEL[o.clasePrioridad as ClasePrioridad]} · {CLASE_PRIORIDAD_PLAZO[o.clasePrioridad as ClasePrioridad]}
          </span>
        )}
        {o.nivelRiesgo && (
          <span class={`badge ${NIVEL_RIESGO_COLOR[o.nivelRiesgo] ?? "bg-slate-100 text-slate-600"}`}>Riesgo {o.nivelRiesgo}</span>
        )}
        <span class={`badge ${PRIO_COLOR[o.prioridad]} capitalize`}>{o.prioridad}</span>
        <span class={`badge ${ESTADO_COLOR[estadoActual]}`}>{ESTADO_LABEL[estadoActual]}</span>
      </div>
      <p class="mt-1 text-sm text-slate-500">
        {etiquetaOT(o)} - creada {verTiempos ? fmt(o.createdAt) : fmtDia(o.createdAt)}
        {procedimientoRef && (
          <span> · procedimiento <strong class="font-mono">{procedimientoRef.codigoCorto}</strong> v{procedimientoRef.version} — {procedimientoRef.titulo}</span>
        )}
      </p>
    </div>
    <div class="flex gap-2">
      {user.rol === "admin" && (
        <button id="historialBtn" type="button" class="btn-secondary text-sm">Historial</button>
      )}
      {user.rol === "admin" && !conjuntoOrigen && (
        <button id="deleteOtBtn" type="button" class="btn-secondary text-sm text-red-600 hover:bg-red-50">Eliminar OT</button>
      )}
    </div>


  </div>

  {user.rol === "admin" && (
    <div id="historialModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
      <div class="bg-white rounded-xl shadow-xl w-full max-w-3xl max-h-[90vh] overflow-y-auto">
        <div class="sticky top-0 bg-white border-b border-slate-200 px-5 py-3 flex items-center justify-between">
          <h2 class="font-bold text-lg">Historial de la <span class="whitespace-nowrap">{etiquetaOT(o)}</span></h2>
          <button id="closeHistorial" class="text-slate-400 hover:text-slate-600 text-xl">×</button>
        </div>
        <div id="historialContent" class="p-5">
          <div class="text-center text-slate-400 py-6">Cargando...</div>
        </div>
      </div>
    </div>

    <script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({ otId: o.id }) }}>
      const { otId } = JSON.parse(decodeURIComponent(__encodedScriptVars));
      const ACCION_ICON = {
        create: "", update: "", estado: "", asignacion: "", delete: "",
      };
      const ACCION_LABEL = {
        create: "Creación", update: "Edición", estado: "Cambio de estado",
        asignacion: "Asignación", delete: "Eliminación",
      };

      const historialBtn = document.getElementById("historialBtn");
      const modal = document.getElementById("historialModal");
      const content = document.getElementById("historialContent");
      const closeBtn = document.getElementById("closeHistorial");

      function fmtDate(s) {
        if (!s) return "—";
        return new Date(s).toLocaleString("es", { dateStyle: "medium", timeStyle: "short", timeZone: "America/El_Salvador" });
      }
      function escHtml(s) {
        if (s == null) return "";
        return String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
      }

      historialBtn?.addEventListener("click", async () => {
        modal.classList.remove("hidden");
        content.innerHTML = '<div class="text-center text-slate-400 py-6">Cargando...</div>';
        try {
          const res = await fetch(`/api/ordenes/${otId}/historial`);
          if (!res.ok) {
            content.innerHTML = '<div class="text-red-600 py-4">Error al cargar el historial</div>';
            return;
          }
          const j = await res.json();

          let html = '';

          // Origen
          if (j.ticketOrigen) {
            html += `<div class="mb-5 rounded-lg border-l-4 border-blue-400 bg-blue-50 p-4 text-sm">
              <p class="text-xs font-semibold text-blue-700 uppercase mb-1">Origen: Ticket público</p>
              <p><strong>Solicitante:</strong> ${escHtml(j.ticketOrigen.solicitanteNombre)}</p>
              <p><strong>Email:</strong> <a href="mailto:${escHtml(j.ticketOrigen.solicitanteEmail)}" class="text-blue-600 hover:underline">${escHtml(j.ticketOrigen.solicitanteEmail)}</a></p>
              ${j.ticketOrigen.solicitanteTelefono ? `<p><strong>Teléfono:</strong> ${escHtml(j.ticketOrigen.solicitanteTelefono)}</p>` : ""}
              <p><strong>Ticket #${j.ticketOrigen.id}:</strong> <a href="/tickets/${j.ticketOrigen.id}" class="text-blue-600 hover:underline">${escHtml(j.ticketOrigen.asunto)}</a></p>
              <p class="text-xs text-slate-500 mt-1">Recibido: ${fmtDate(j.ticketOrigen.createdAt)}</p>
            </div>`;
          } else if (j.creador) {
            html += `<div class="mb-5 rounded-lg border-l-4 border-slate-300 bg-slate-50 p-4 text-sm">
              <p class="text-xs font-semibold text-slate-600 uppercase mb-1">OT creada manualmente</p>
              <p><strong>Por:</strong> ${escHtml(j.creador.nombre)} <span class="text-slate-500">&lt;${escHtml(j.creador.email)}&gt;</span></p>
              <p class="text-xs text-slate-500 mt-1">Fecha: ${fmtDate(j.orden.createdAt)}</p>
            </div>`;
          }

          // Hitos clave
          html += '<div class="mb-5 grid grid-cols-2 gap-2 text-sm sm:grid-cols-4">';
          [
            ["Creada", j.orden.createdAt, "bg-slate-100"],
            ["Iniciada", j.orden.iniciadaEn, "bg-amber-50"],
            ["Completada", j.orden.completadaEn, "bg-emerald-50"],
            ["Cerrada", j.orden.cerradoEn, "bg-slate-200"],
          ].forEach(([lbl, t, cls]) => {
            html += `<div class="${cls} rounded p-2">
              <div class="text-xs uppercase text-slate-500">${lbl}</div>
              <div class="text-xs">${fmtDate(t)}</div>
            </div>`;
          });
          html += '</div>';

          // Timeline de eventos
          html += '<h3 class="font-semibold text-sm mb-2">Eventos registrados (' + j.eventos.length + ')</h3>';
          if (j.eventos.length === 0) {
            html += '<p class="text-sm text-slate-400">Sin eventos en el audit log.</p>';
          } else {
            html += '<ol class="space-y-2 border-l-2 border-slate-200 pl-4">';
            j.eventos.forEach((ev) => {
              const icon = ACCION_ICON[ev.accion] || "•";
              const label = ACCION_LABEL[ev.accion] || ev.accion;
              const color = ev.accion === "delete" ? "border-red-400" :
                            ev.accion === "estado" ? "border-amber-400" :
                            ev.accion === "asignacion" ? "border-purple-400" :
                            ev.accion === "create" ? "border-emerald-400" : "border-slate-300";
              html += `<li class="relative -ml-6 pl-6 border-l-2 ${color} pb-2">
                <div class="absolute -left-[7px] top-1 w-3 h-3 rounded-full bg-white border-2 ${color}"></div>
                <div class="flex items-baseline justify-between gap-2 flex-wrap">
                  <span class="text-sm font-medium">${icon} ${escHtml(ev.resumen ?? label)}</span>
                  <span class="text-xs text-slate-400 whitespace-nowrap">${fmtDate(ev.createdAt)}</span>
                </div>
                <div class="text-xs text-slate-500 mt-0.5">
                  ${ev.usuario ? escHtml(ev.usuario.nombre) + ' <span class="text-slate-400">&lt;' + escHtml(ev.usuario.email) + '&gt;</span>' : '<em class="text-slate-400">sistema</em>'}
                </div>
                ${ev.cambios ? '<details class="mt-1"><summary class="cursor-pointer text-xs text-slate-400 hover:text-slate-600">Ver detalle de cambios</summary><pre class="mt-1 text-xs bg-slate-50 p-2 rounded overflow-x-auto">' + escHtml(JSON.stringify(ev.cambios, null, 2)) + '</pre></details>' : ''}
              </li>`;
            });
            html += '</ol>';
          }

          content.innerHTML = html;
        } catch (e) {
          content.innerHTML = '<div class="text-red-600 py-4">Error: ' + escHtml(String(e)) + '</div>';
        }
      });

      closeBtn?.addEventListener("click", () => modal.classList.add("hidden"));
      modal?.addEventListener("click", (e) => { if (e.target === modal) modal.classList.add("hidden"); });
    </script>
  )}

  {fase47Error && (
    <div class="card mt-4 border-l-4 border-amber-500 bg-amber-50 p-4 text-sm text-amber-800">
      <strong>No se pudieron leer los prerrequisitos ni las lecturas de liberación.</strong> La ficha de la orden sigue operativa, pero las tarjetas del MOP y del EOP van vacías.
      <pre class="mt-1 whitespace-pre-wrap text-xs">{fase47Error}</pre>
    </div>
  )}
  {estadoActual === "abierta" && (
    <div class="card mt-4 border-l-4 border-amber-500 bg-amber-50 p-4 text-sm text-amber-800">
      <strong>OT no iniciada.</strong> Verifica el lugar y los datos del equipo.
      {verTiempos
        ? <Fragment> Cuando estés en sitio listo para trabajar, pulsa <strong>"Iniciar"</strong> para activar el cronómetro y desbloquear los campos de ejecución.</Fragment>
        : proximas.includes("en_proceso")
          ? <Fragment> Cuando estés en sitio listo para trabajar, pulsa <strong>«Iniciar»</strong> para desbloquear los campos de ejecución.</Fragment>
          : row.asignado ? <Fragment> Está asignada a {row.asignado.nombre}.</Fragment> : null}
    </div>
  )}
  {estadoActual === "en_espera" && (
    <div class="card mt-4 border-l-4 border-purple-500 bg-purple-50 p-4 text-sm text-purple-800">
      <strong>OT en espera.</strong> La OT está pausada pendiente de compra u otro insumo.
      {solicitudesVinculadas.length > 0 && (
        <span> Solicitudes vinculadas: {solicitudesVinculadas.map((s) => (
          <a href={`/solicitudes-compra/${s.id}`} class="ml-1 font-medium underline">{s.codigo} ({s.estado})</a>
        ))}</span>
      )}
      {" "}Cuando tengas los materiales, pulsa <strong>"Reanudar"</strong> para continuar.
    </div>
  )}

  <section class="card mt-4 p-4" aria-label="Verificación independiente">
    <h2 class="font-semibold">Ejecución y verificación independiente</h2>
    <p class="mt-1 text-sm text-slate-600">Completar el trabajo lo deja pendiente de revisión. Una persona autorizada distinta del ejecutor comprueba la evidencia antes de cerrar.</p>
    {estadoActual === "completada" && <p class="mt-2 rounded bg-amber-50 p-2 text-sm text-amber-800">Pendiente de verificación. La programación preventiva aún no avanza.</p>}
    {estadoActual === "cerrada" && !seguimiento.control?.ejecutadoPor && <p class="mt-2 text-sm text-amber-800">Registro histórico: no se atribuye una verificación independiente que no esté documentada.</p>}
    {seguimiento.control?.ultimoMotivo && <p class="mt-2 text-sm"><strong>Último motivo:</strong> {seguimiento.control.ultimoMotivo}</p>}
    {["admin", "jefe"].includes(user.rol) && <div class="mt-3 flex flex-wrap items-end gap-2">
      <label class="text-xs">Revisor designado<select id="revisorId" class="input mt-1"><option value="">Jefatura independiente</option>{revisores.map(r => <option value={r.id} selected={r.id === seguimiento.control?.revisorId}>{r.nombre}</option>)}</select></label>
      <label class="text-xs">Suplente<select id="revisorSuplenteId" class="input mt-1"><option value="">Sin suplente</option>{revisores.map(r => <option value={r.id} selected={r.id === seguimiento.control?.revisorSuplenteId}>{r.nombre}</option>)}</select></label>
      <button id="guardarRevisor" type="button" class="btn-secondary">Guardar revisores</button>
    </div>}
    {seguimiento.eventos.length > 0 && <details class="mt-3"><summary class="cursor-pointer text-sm font-medium">Historial de ejecución, revisión y devoluciones ({seguimiento.eventos.length})</summary>
      <ol class="mt-2 space-y-2 text-sm">{seguimiento.eventos.map(e => <li class="rounded border border-slate-200 p-2"><strong>{e.accion.replaceAll("_", " ")}</strong> · {e.actorNombre} · {verTiempos ? fmt(e.ocurridoEn) : fmtDia(e.ocurridoEn)}<p>{ESTADO_LABEL[e.estadoAntes as EstadoOT]} → {ESTADO_LABEL[e.estadoDespues as EstadoOT]} · Ciclo {e.ciclo}</p>{e.motivo && <p class="whitespace-pre-wrap">{e.motivo}</p>}</li>)}</ol>
    </details>}
  </section>

  <!-- Wizard de estados -->
  {estadoActual !== "cancelada" && (
    <div class="card mt-4 p-4">
      <div class="flex items-center justify-between gap-2">
        {(["abierta", "en_proceso", "completada", "verificada", "cerrada"] as EstadoOT[]).map((s, idx) => (
          <div class="flex flex-1 items-center gap-2">
            <div class:list={[
              "flex h-7 w-7 items-center justify-center rounded-full text-xs font-bold",
              ESTADO_PROGRESO[s] <= stepActual ? "bg-brand-600 text-white" : "bg-slate-200 text-slate-500",
            ]}>{idx + 1}</div>
            <span class:list={["text-xs font-medium", ESTADO_PROGRESO[s] <= stepActual ? "text-slate-900" : "text-slate-400"]}>
              {ESTADO_LABEL[s]}
            </span>
            {idx < 4 && <div class:list={["h-0.5 flex-1", ESTADO_PROGRESO[s] < stepActual ? "bg-brand-600" : "bg-slate-200"]} />}
          </div>
        ))}
      </div>
      {proximas.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {proximas.map((s) => {
            // El MOP no deja empezar sin el permiso firmado ni enviarse sin sus
            // lecturas de liberación: el botón va bloqueado (la API lo rechaza
            // igual, pero aquí se ve por qué).
            const inicioBloqueado = s === "en_proceso" && ["abierta", "en_espera"].includes(estadoActual) && esMop && bloqueoInicio.faltantes.length > 0;
            const cierreBloqueado = s === "completada" && envioBloqueado;
            const bloqueado = inicioBloqueado || cierreBloqueado;
            return (
            <button
              data-transition={s}
              disabled={bloqueado}
              title={inicioBloqueado ? `Faltan prerrequisitos obligatorios: ${bloqueoInicio.faltantes.join(" · ")}` : cierreBloqueado ? "Faltan lecturas de liberación o alguna quedó fuera de rango" : undefined}
              class:list={[
                "rounded-md px-3 py-1.5 text-sm font-medium",
                bloqueado ? "cursor-not-allowed bg-slate-200 text-slate-500" :
                s === "cancelada" ? "bg-red-50 text-red-700 hover:bg-red-100" :
                s === "cerrada" ? "bg-slate-700 text-white hover:bg-slate-800" :
                s === "verificada" ? "bg-brand-600 text-white hover:bg-brand-800" :
                s === "en_espera" ? "bg-purple-600 text-white hover:bg-purple-700" :
                "bg-brand-600 text-white hover:bg-brand-700",
              ]}
            >
              {s === "abierta" ? "Reabrir" :
               s === "en_proceso" ? (estadoActual === "cerrada" ? "Reabrir con motivo" : ["completada", "verificada"].includes(estadoActual) ? "Devolver con motivo" : estadoActual === "en_espera" ? "› Reanudar" : "› Iniciar") :
               s === "en_espera" ? "Poner en espera" :
               s === "completada" ? "✓ Enviar a verificación" :
               s === "verificada" ? "✓✓ Verificar y cerrar" :
               s === "cerrada" ? "Cerrar definitivamente" :
               s === "cancelada" ? "✕ Cancelar" : s}
            </button>
            );
          })}
        </div>
      )}
      {proximas.includes("en_proceso") && ["abierta", "en_espera"].includes(estadoActual) && esMop && bloqueoInicio.faltantes.length > 0 && (
        <p class="mt-2 text-xs text-slate-600">Para iniciar faltan prerrequisitos obligatorios: márcalos en «Prerrequisitos de la intervención».</p>
      )}
      {proximas.includes("completada") && envioBloqueado && (
        <p class="mt-2 text-xs text-slate-600">Para enviar a verificación faltan lecturas de liberación o alguna quedó fuera de rango: revisa «Lecturas de liberación».</p>
      )}
    </div>
  )}

  <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
    <!-- Detalles + ejecucion -->
    <div class="lg:col-span-2 space-y-4">
      <div class="card p-5">
        <h2 class="font-semibold text-slate-900">Descripción</h2>
        <p class="mt-2 whitespace-pre-wrap text-sm text-slate-700">{o.descripcion || "Sin descripción."}</p>
      </div>

      <!-- ══ PROCEDIMIENTO QUE RIGE · referencia y registro, no un asistente ══ -->
      {(docRige || rige || rigeError || esMop || esEop) && (
        <div class:list={["card p-5 border-l-4", docRige ? "border-brand-500" : "border-amber-500"]}>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="font-semibold text-slate-900">Procedimiento que rige</h2>
            <span class="flex flex-wrap items-center gap-2">
              {docRige && <span class={`badge ${TIPO_PROC[tipoDocRige].color}`}>{TIPO_PROC[tipoDocRige].icono} {TIPO_PROC[tipoDocRige].label}</span>}
              {docRige && <span class={`badge ${estadoInfo(docRige.estado).color}`}>{estadoInfo(docRige.estado).label}</span>}
              <span id="rigeMsg" class="text-xs text-slate-400"></span>
            </span>
          </div>

          {docRige ? (
            <Fragment>
              <p class="mt-2 text-sm text-slate-900">
                <strong>Se rige por {docRige.codigoCorto} · {docRige.titulo}</strong>
              </p>
              <p class="mt-0.5 text-xs text-slate-500">
                <span class="font-mono">{docRige.codigoCorto}</span> v{docRige.version} ·
                {docEsVinculado
                  ? " vinculado a esta orden: es el documento bajo el que queda el registro."
                  : ` resuelto por el sistema para una orden tipo ${TIPO_LABEL[o.tipo]}. Todavía no está vinculado.`}
              </p>

              {esEop && accionesRige.length > 0 && (
                <Fragment>
                  <p class="mt-3 text-xs font-medium uppercase tracking-wide text-slate-500">Las tres primeras acciones</p>
                  <ol class="mt-1.5 space-y-2">
                    {accionesRige.map((acc, i) => (
                      <li class="flex gap-3 rounded-lg bg-red-50 p-3 text-sm text-red-900">
                        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white text-red-600 border border-red-600 text-xs font-bold ">{i + 1}</span>
                        <span>{acc}</span>
                      </li>
                    ))}
                  </ol>
                </Fragment>
              )}
              {esEop && tipoDocRige === "eop" && accionesRige.length === 0 && (
                <p class="mt-3 rounded-lg bg-amber-50 p-3 text-xs text-amber-800">
                  {docRige.codigoCorto} todavía no tiene escritas sus tres primeras acciones. Complétalas en su ficha: son las que se hacen de memoria.
                </p>
              )}

              {!docEsVinculado && rige?.aviso && (
                <p class="mt-3 rounded-lg bg-amber-50 p-3 text-xs text-amber-800">{rige.aviso}</p>
              )}

              {/* Lo que este documento exige ya vive en las tarjetas de abajo:
                  aquí solo se dice que existen, no se repiten. */}
              {esMop && (
                <p class="mt-3 rounded-lg bg-slate-50 p-3 text-xs text-slate-600">
                  Por ser una intervención, no inicia sin sus <strong>{prerrequisitos.length} prerrequisito{prerrequisitos.length === 1 ? "" : "s"}</strong> ({prerreqCumplidos} cumplido{prerreqCumplidos === 1 ? "" : "s"}) ni se envía a verificación sin sus <strong>{liberaciones.length} lectura{liberaciones.length === 1 ? "" : "s"} de liberación</strong> ({liberacionesConLectura} medida{liberacionesConLectura === 1 ? "" : "s"}). Se registran más abajo, en esta misma ficha.
                </p>
              )}
              {esEop && (
                <p class="mt-3 rounded-lg bg-slate-50 p-3 text-xs text-slate-600">
                  {verTiempos
                    ? <Fragment>Por ser una emergencia, los <strong>tres tiempos</strong> y la <strong>causa raíz</strong> se registran más abajo: de ahí salen los indicadores 5 y 7.</Fragment>
                    : <Fragment>Por ser una emergencia, cada paso se registra desde tu celular, en «Hoy».</Fragment>}
                </p>
              )}

              <div class="mt-3 flex flex-wrap items-center gap-2">
                {puedeVerProcs && (
                  <a href={`/procedimientos/${docRige.id}`} class="btn-secondary btn-sm">Ver {docRige.codigoCorto} →</a>
                )}
                {docSugerido && puedeConfigurarMop && (
                  <button id="rigeVincular" type="button" class="btn-primary btn-sm" data-proc={docSugerido.id}>
                    Vincular {docSugerido.codigoCorto} a esta orden
                  </button>
                )}
              </div>
              <p class="mt-2 text-[11px] text-slate-400">
                Esto es la referencia visible y el registro. {esEop ? "En una emergencia se actúa con la hoja impresa del EOP de la pared, no con esta pantalla." : "El procedimiento se ejecuta con su hoja; aquí solo queda constancia de cuál rige."}
              </p>
            </Fragment>
          ) : (
            <div class="mt-2 rounded-lg bg-amber-50 p-3 text-sm text-amber-900">
              <strong>Esta orden no tiene todavía un documento que la gobierne.</strong>
              <p class="mt-1 text-xs">
                {o.activoId
                  ? rigeError
                    ? "El sistema no pudo resolverlo en este momento."
                    : rige?.aviso ?? "Regístralo en Procedimientos para que el sistema pueda decir qué rige."
                  : "La orden no está sobre un equipo registrado, así que el sistema no puede resolver qué documento la rige. Asígnale el equipo y se resolverá solo."}
              </p>
              {puedeVerProcs && <a href="/procedimientos" class="btn-secondary btn-sm mt-2">Ir a Procedimientos</a>}
            </div>
          )}

          {rigeError && (
            <p class="mt-3 rounded-lg bg-amber-50 p-3 text-xs text-amber-800">
              No se pudo resolver qué procedimiento rige esta orden. La ficha sigue operativa. {rigeError}
            </p>
          )}
        </div>
      )}

      <!-- ══ Clasificación del procedimiento (MOP/EOP, clase P1–P4, riesgo) ══ -->
      {puedeConfigurarMop && (
        <div class="card p-5">
          <div class="flex items-center justify-between gap-2">
            <h2 class="font-semibold text-slate-900">Clasificación del procedimiento</h2>
            <span id="clasifMsg" class="text-xs text-slate-400"></span>
          </div>
          <p class="mt-1 text-xs text-slate-500">
            El tipo decide qué exige la orden: una <strong>intervención (MOP)</strong> no inicia sin prerrequisitos ni se envía a verificación sin lecturas de liberación; una <strong>emergencia (EOP)</strong> no se verifica ni se cierra sin causa raíz. La clase fija el compromiso de respuesta del plan maestro de 52 semanas.
          </p>
          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label class="label text-xs" for="clasifTipo">Tipo de orden</label>
              <select id="clasifTipo" class="input text-sm">
                {(TIPOS_OT as readonly TipoOT[]).map((t) => (
                  <option value={t} selected={o.tipo === t}>{TIPO_LABEL[t]}</option>
                ))}
              </select>
            </div>
            <div>
              <label class="label text-xs" for="clasifClase">Clase de prioridad</label>
              <select id="clasifClase" class="input text-sm">
                <option value="" selected={!o.clasePrioridad}>— Sin clasificar —</option>
                {(CLASES_PRIORIDAD as readonly ClasePrioridad[]).map((c) => (
                  <option value={c} selected={o.clasePrioridad === c}>{CLASE_PRIORIDAD_LABEL[c]} · {CLASE_PRIORIDAD_PLAZO[c]}</option>
                ))}
              </select>
            </div>
            <div>
              <label class="label text-xs" for="clasifRiesgo">Nivel de riesgo</label>
              <select id="clasifRiesgo" class="input text-sm">
                <option value="" selected={!o.nivelRiesgo}>— Sin definir —</option>
                {["bajo", "medio", "alto"].map((n) => (
                  <option value={n} selected={o.nivelRiesgo === n}>{n}</option>
                ))}
              </select>
            </div>
          </div>
          <div class="mt-3 flex justify-end">
            <button id="clasifSave" type="button" class="btn-secondary text-xs">Guardar clasificación</button>
          </div>
        </div>
      )}

      <!-- ══ EOP · LOS TRES TIEMPOS (indicadores 5 y 7) ══ -->
      {muestraEop && (
        <div class="card p-5 border-l-4 border-red-500">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <h2 class="font-semibold text-slate-900">{verTiempos ? "Emergencia · los tres tiempos" : "Emergencia · pasos registrados"}</h2>
            <span id="eopMsg" class="text-xs text-slate-400"></span>
          </div>
          {verTiempos ? (
          <Fragment>
          <p class="mt-1 text-xs text-slate-600">
            En una emergencia nadie abre una pantalla: se toma el EOP de la pared y se actúa. <strong>Estas horas se registran después y se pueden corregir hacia atrás</strong> — escribe la hora real, no la hora en que llenas el formulario.
          </p>
          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <label class="label text-xs" for="horaAlarma">Hora de alarma</label>
              <input id="horaAlarma" type="datetime-local" class="input text-sm" value={isoALocalInput(o.horaAlarma)} disabled={!puedeEditarTiempos} />
              <p class="mt-0.5 text-[11px] text-slate-400">Cuando sonó la alarma o alguien detectó la falla. Es el cero de todos los tiempos.</p>
            </div>
            <div>
              <label class="label text-xs" for="horaLlegada">Hora de llegada</label>
              <input id="horaLlegada" type="datetime-local" class="input text-sm" value={isoALocalInput(o.horaLlegada)} disabled={!puedeEditarTiempos} />
              <p class="mt-0.5 text-[11px] text-slate-400">Cuando el técnico llegó al sitio.</p>
            </div>
            <div>
              <label class="label text-xs" for="horaMitigacion">{etiquetaMit}</label>
              <input id="horaMitigacion" type="datetime-local" class="input text-sm" value={isoALocalInput(o.horaMitigacion)} disabled={!puedeEditarTiempos} />
              <p class="mt-0.5 text-[11px] text-slate-400">La hora que su EOP nombra: energía de emergencia en carga, reserva de gas en servicio, sala vuelta a rango…</p>
            </div>
            <div>
              <label class="label text-xs" for="horaRestablecimiento">Hora de restablecimiento</label>
              <input id="horaRestablecimiento" type="datetime-local" class="input text-sm" value={isoALocalInput(o.horaRestablecimiento)} disabled={!puedeEditarTiempos} />
              <p class="mt-0.5 text-[11px] text-slate-400">Cuando el sistema volvió a su configuración normal del SCP.</p>
            </div>
          </div>
          {puedeEditarTiempos && (
            <div class="mt-3 flex items-center gap-2">
              <button id="eopSave" type="button" class="btn-secondary text-xs">Guardar horas</button>
              <span class="text-[11px] text-slate-400">Puedes corregirlas cuantas veces haga falta{estadoActual === "cerrada" ? ", incluso con la orden ya cerrada: cada corrección queda en el historial" : ""}.</span>
            </div>
          )}
          <div class="mt-4 grid grid-cols-1 gap-3 text-sm sm:grid-cols-3">
            <div class="rounded-lg bg-slate-50 p-3">
              <div class="text-xs uppercase text-slate-500">Tiempo de respuesta</div>
              <div class="mt-0.5 text-lg font-semibold text-slate-900">{fmtDuracionHoras(tiempos.respuestaHoras)}</div>
              <div class="text-[11px] text-slate-500">llegada − alarma (indicador 5)</div>
            </div>
            <div class="rounded-lg bg-slate-50 p-3">
              <div class="text-xs uppercase text-slate-500">Hasta la mitigación</div>
              <div class="mt-0.5 text-lg font-semibold text-slate-900">{fmtDuracionHoras(tiempos.mitigacionHoras)}</div>
              <div class="text-[11px] text-slate-500">{etiquetaMit.toLowerCase()} − alarma</div>
            </div>
            <div class="rounded-lg bg-slate-50 p-3">
              <div class="text-xs uppercase text-slate-500">Tiempo de reparación</div>
              <div class="mt-0.5 text-lg font-semibold text-slate-900">{fmtDuracionHoras(tiempos.reparacionHoras)}</div>
              <div class="text-[11px] text-slate-500">restablecimiento − alarma (indicador 7)</div>
            </div>
          </div>
          {(tiempos.respuestaHoras !== null && tiempos.respuestaHoras < 0) && (
            <p class="mt-2 rounded bg-amber-50 px-3 py-2 text-xs text-amber-800">La hora de llegada es anterior a la de alarma. Revisa las dos horas: alguna quedó mal escrita.</p>
          )}
          </Fragment>
          ) : (
            <Fragment>
              {/* El técnico ve qué pasos quedaron registrados, no sus horas. */}
              <ul class="mt-3 space-y-2 text-sm" aria-label="Pasos de la emergencia">
                {hitosEop.map((h) => (
                  <li class:list={["flex items-center justify-between gap-3 rounded-lg border p-3", h.hecho ? "border-emerald-200 bg-emerald-50" : "border-slate-200 bg-white"]}>
                    <span class="font-medium text-slate-900">{h.etiqueta}</span>
                    <span class:list={["shrink-0 text-xs font-semibold", h.hecho ? "text-emerald-700" : "text-slate-500"]}>{h.hecho ? "Registrado" : "Pendiente"}</span>
                  </li>
                ))}
              </ul>
              {otAbiertaParaRegistro && (esAsignado || !o.asignadoA) && (
                <p class="mt-3 text-xs text-slate-600">Cada paso se registra desde tu celular, en <a href="/campo" class="font-medium text-brand-700 underline">Hoy</a>, al tocarlo. Si alguno quedó mal, avisa a tu jefatura: ella lo corrige aquí.</p>
              )}
            </Fragment>
          )}
          {!esTecnico && o.causaRaizVencimiento && (
            <p class:list={["mt-3 rounded px-3 py-2 text-xs", causaVencida ? "bg-red-50 text-red-700 font-medium" : "bg-blue-50 text-blue-700"]}>
              Análisis de causa raíz: plazo de {HORAS_CAUSA_RAIZ} h desde la alarma — vence {fmt(o.causaRaizVencimiento)}.
              {causaVencida
                ? " VENCIDO y sin causa raíz escrita. Documéntalo hoy e informa al Comité de Seguridad."
                : o.causaRaiz ? " Ya hay causa raíz registrada."
                : esJefatura ? " Escríbela en «Causa raíz», más abajo, antes del plazo." : " La escribe la jefatura antes del plazo."}
            </p>
          )}
        </div>
      )}

      <!-- ══ MOP · PRERREQUISITOS QUE BLOQUEAN INICIAR ══ -->
      {muestraMop && (
        <div class="card p-5 border-l-4 border-indigo-500">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <h2 class="font-semibold text-slate-900">Prerrequisitos de la intervención</h2>
            <span class="text-xs text-slate-500">
              {prerreqCumplidos} / {prerrequisitos.length} cumplidos
              {bloqueoInicio.faltantes.length > 0 && <span class="ml-2 rounded bg-white text-red-600 border border-red-600 px-1.5 py-0.5 font-medium ">{bloqueoInicio.faltantes.length} bloquea{bloqueoInicio.faltantes.length === 1 ? "" : "n"} el inicio</span>}
              <span id="prerreqMsg" class="ml-2 text-slate-400"></span>
            </span>
          </div>
          <p class="mt-1 text-xs text-slate-500">
            El permiso de trabajo se emite <strong>inmediatamente antes de empezar</strong>, en el punto de trabajo. Cada prerrequisito se marca cumplido <strong>con su referencia</strong>: n.º de permiso, clase de la ICRA (I a V), id del candado y la tarjeta, hora exacta del aviso a los servicios.
          </p>
          {esMop && bloqueoInicio.faltantes.length > 0 && estadoActual === "abierta" && (
            <div class="mt-3 rounded-lg bg-red-50 p-3 text-sm text-red-800">
              <strong>Esta orden no se puede iniciar todavía.</strong> Falta{bloqueoInicio.faltantes.length === 1 ? "" : "n"}:
              <ul class="mt-1 list-disc pl-5">
                {bloqueoInicio.faltantes.map((f) => <li>{f}</li>)}
              </ul>
            </div>
          )}
          {prerrequisitos.length === 0 ? (
            <p class="mt-3 text-sm text-slate-400">Sin prerrequisitos cargados. {puedeConfigurarMop ? "Agrega los del MOP (permiso, ICRA, notificación, LOTO, ventana, instrumento)." : "Pide a la jefatura que cargue los del MOP."}</p>
          ) : (
            <ul class="mt-3 space-y-2">
              {prerrequisitos.map((pre) => {
                const t = (pre.tipo ?? "otro") as PrerrequisitoTipo;
                return (
                  <li class:list={["rounded-lg border p-3", pre.cumplido ? "border-emerald-200 bg-emerald-50" : pre.obligatorio ? "border-red-200 bg-red-50/50" : "border-slate-200 bg-white"]}>
                    <div class="flex flex-wrap items-start justify-between gap-2">
                      <div class="min-w-0">
                        <div class="text-sm font-medium text-slate-900">
                          <span class="mr-1">{PRERREQ_ICONO[t]}</span>
                          {PRERREQ_LABEL[t]}
                          {pre.obligatorio
                            ? <span class="ml-2 rounded bg-red-100 px-1.5 py-0.5 text-[10px] font-semibold text-red-700">OBLIGATORIO</span>
                            : <span class="ml-2 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-500">opcional</span>}
                          {pre.cumplido && <span class="ml-2 rounded bg-emerald-100 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-700">✓ CUMPLIDO</span>}
                        </div>
                        <div class="mt-0.5 text-sm text-slate-700">{pre.texto}</div>
                        {pre.cargoResponsable && <div class="text-xs text-slate-500">Responsable: {pre.cargoResponsable}</div>}
                        {pre.cumplido && (
                          <div class="mt-0.5 text-[11px] text-emerald-700">
                            Marcado por {pre.cumplidoNombre ?? "—"} el {fmt(pre.cumplidoEn)}
                          </div>
                        )}
                      </div>
                      {puedeConfigurarMop && !pre.cumplido && (
                        <button type="button" class="prerreq-del text-xs text-slate-400 hover:text-red-600" data-id={pre.id} title="Eliminar prerrequisito">✕</button>
                      )}
                    </div>
                    <div class="mt-2 flex flex-wrap items-end gap-2">
                      <div class="min-w-0 flex-1">
                        <label class="mb-1 block text-xs text-slate-600">Referencia — {PRERREQ_REFERENCIA_HINT[t]}</label>
                        <input class="prerreq-ref input w-full text-sm" data-id={pre.id} value={pre.referencia ?? ""}
                               placeholder={PRERREQ_REFERENCIA_HINT[t]} disabled={!puedeRegistrarMop || pre.cumplido} />
                      </div>
                      {puedeRegistrarMop && (
                        pre.cumplido ? (
                          <button type="button" class="prerreq-toggle btn-secondary text-xs" data-id={pre.id} data-cumplido="0">Revertir</button>
                        ) : (
                          <button type="button" class="prerreq-toggle btn-primary text-xs" data-id={pre.id} data-cumplido="1">✓ Marcar cumplido</button>
                        )
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
          {puedeConfigurarMop && (
            <div class="mt-4 rounded-lg border border-dashed border-slate-300 p-3">
              <div class="grid grid-cols-1 gap-2 sm:grid-cols-[180px_1fr]">
                <div>
                  <label class="label text-xs" for="prerreqTipo">Tipo</label>
                  <select id="prerreqTipo" class="input text-sm">
                    {(PRERREQ_TIPOS as readonly PrerrequisitoTipo[]).map((t) => (
                      <option value={t}>{PRERREQ_ICONO[t]} {PRERREQ_LABEL[t]}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label class="label text-xs" for="prerreqTexto">Qué se exige</label>
                  <input id="prerreqTexto" class="input text-sm w-full" placeholder="Ej. ICRA firmada por Control de Infecciones con la clase de precaución" />
                </div>
              </div>
              <div class="mt-2 flex flex-wrap items-center gap-3">
                <input id="prerreqCargo" class="input text-sm max-w-xs" placeholder="Cargo responsable (opcional)" />
                <label class="flex items-center gap-1.5 text-xs text-slate-600">
                  <input id="prerreqObligatorio" type="checkbox" checked />
                  Bloquea el inicio
                </label>
                <button id="prerreqAdd" type="button" class="btn-secondary text-xs ml-auto">+ Agregar prerrequisito</button>
              </div>
            </div>
          )}
        </div>
      )}

      <!-- ══ MOP · PLAN DE REVERSA (se escribe antes de empezar) ══ -->
      {muestraMop && (
        <div class="card p-5">
          <div class="flex items-center justify-between gap-2">
            <h2 class="font-semibold text-slate-900">Plan de reversa</h2>
            <span id="reversaMsg" class="text-xs text-slate-400"></span>
          </div>
          <p class="mt-1 text-xs text-slate-500">
            Se escribe <strong>antes de empezar</strong>: qué se hace si el sistema no vuelve solo a su estado normal. Cualquier reversa ejecutada se informa a la jefatura antes de cerrar.
          </p>
          {o.planReversa && estadoActual === "abierta" && (
            <div class="mt-3 rounded-lg bg-amber-50 p-3 text-sm whitespace-pre-wrap text-amber-900">
              <strong>Léelo antes de iniciar:</strong> {o.planReversa}
            </div>
          )}
          <div class="mt-3 space-y-3 text-sm">
            <div>
              <label class="label text-xs" for="planReversa">Plan de reversa</label>
              <textarea id="planReversa" class="input" rows="3" disabled={!puedeGuardarReversa}
                        placeholder="Ej. Si la planta arranca pero la transferencia no retorna a normal: operar la retransferencia en manual según el SCP-ELE-01 con dos técnicos, mantener la planta hasta confirmar red estable y abrir orden correctiva.">{o.planReversa ?? ""}</textarea>
            </div>
            <label class:list={["flex items-start gap-2 rounded-lg p-2", o.reversaEjecutada ? "bg-amber-50" : ""]}>
              <input id="reversaEjecutada" type="checkbox" class="mt-0.5" checked={o.reversaEjecutada} disabled={!puedeGuardarReversa} />
              <span>
                <span class="text-sm font-medium text-slate-900">Se ejecutó la reversa</span>
                <span class="block text-xs text-slate-500">El sistema no volvió solo: hubo que revertir. Describe abajo qué se revirtió y cómo quedó. Con la reversa marcada no se exigen las lecturas de liberación: el sistema quedó como estaba.</span>
              </span>
            </label>
            <div>
              <label class="label text-xs" for="reversaNotas">Qué se revirtió y cómo quedó el sistema</label>
              <textarea id="reversaNotas" class="input" rows="2" disabled={!puedeGuardarReversa}
                        placeholder="Mínimo 10 caracteres. Ej. Retransferencia en manual con dos técnicos; planta sostenida hasta confirmar red estable; se abrió la orden correctiva OT-MG...">{o.reversaNotas ?? ""}</textarea>
            </div>
            {puedeGuardarReversa && (
              <div class="flex justify-end">
                <button id="reversaSave" type="button" class="btn-secondary text-xs">Guardar plan de reversa</button>
              </div>
            )}
          </div>
        </div>
      )}

      <!-- Tarjeta de identificación del equipo (verifica el lugar de intervención) -->
      {row.activo && (
        <div class="card p-5 border-l-4 border-blue-400">
          <div class="flex items-center justify-between">
            <h2 class="font-semibold text-slate-900">Lugar a intervenir</h2>
            {puedeAsignarActivo && (
              <button id="editActivoBtn" type="button" class="text-xs text-brand-600 hover:underline">Cambiar equipo</button>
            )}
          </div>
          <div class="mt-3 grid grid-cols-2 gap-3 text-sm">
            <div class="col-span-2">
              <div class="text-xs uppercase text-slate-500">Equipo</div>
              <div id="activoLabel" class="mt-0.5">
                <a class="font-medium text-brand-700 hover:underline" href={areaHref(`/activos/${row.activo.id}`, area)}>
                  {row.activo.codigo} · {row.activo.nombre}
                </a>
                <span class="ml-2 text-xs text-slate-500">
                  {row.activo.tipo === "biomedico" ? "Biomédico" : "General"}
                </span>
              </div>
            </div>
            <div>
              <div class="text-xs uppercase text-slate-500">Sucursal</div>
              <div class="mt-0.5">{row.sucursal?.nombre ?? <span class="text-slate-400">—</span>}</div>
            </div>
            <div>
              <div class="text-xs uppercase text-slate-500">Ubicación</div>
              <div class="mt-0.5">
                {row.ubicacion?.nombre ?? row.activo.ubicacion ?? <span class="text-slate-400">—</span>}
                {row.ubicacion?.tipo && <span class="ml-1 text-xs text-slate-400 capitalize">({row.ubicacion.tipo})</span>}
              </div>
            </div>
            <div>
              <div class="text-xs uppercase text-slate-500">N° de serie</div>
              <div class="mt-0.5 font-mono text-xs">{row.activo.serial ?? <span class="text-slate-400 font-sans">—</span>}</div>
            </div>
            <div>
              <div class="text-xs uppercase text-slate-500">Marca / Modelo</div>
              <div class="mt-0.5">{[row.activo.marca, row.activo.modelo].filter(Boolean).join(" / ") || <span class="text-slate-400">—</span>}</div>
            </div>
          </div>
          {puedeAsignarActivo && (
            <div id="activoEditor" class="hidden mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3">
              <div>
                <label class="label text-xs">1. Sucursal</label>
                <select id="sucSel" class="input text-sm">
                  <option value="">— Selecciona —</option>
                  {sucursalesLista.map((s) => <option value={s.id}>{s.nombre}</option>)}
                </select>
              </div>
              <div>
                <label class="label text-xs">2. Ubicación</label>
                <select id="ubSel" class="input text-sm" disabled>
                  <option value="">Selecciona la sucursal</option>
                </select>
              </div>
              <div>
                <label class="label text-xs">3. Equipo</label>
                <select id="activoSelect" class="input text-sm" disabled>
                  <option value="">Selecciona la ubicación</option>
                </select>
              </div>
              <div class="sm:col-span-3 flex items-center justify-end gap-2">
                <p id="activoMsg" class="hidden mr-auto text-xs"></p>
                <button id="activoCancel" type="button" class="btn-secondary text-sm">Cancelar</button>
                <button id="activoSave" type="button" class="btn-primary text-sm">Guardar</button>
              </div>
            </div>
          )}
        </div>
      )}

      {/* Sin equipo, la tarjeta dice dónde es el trabajo. El botón solo sale a
          quien el servidor le acepta el cambio. */}
      {!row.activo && (puedeAsignarActivo || ordenSucursal || ordenUbicacion || (o as any).ubicacionDetalle) && (
        <div class="card p-5 border-l-4 border-slate-300">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="font-semibold text-slate-900">Lugar a intervenir (sin equipo)</h2>
              <p class="text-xs text-slate-400 italic mt-0.5">Trabajo general — no asociado a un equipo registrado</p>
            </div>
            {puedeAsignarActivo && (
              <button id="editActivoBtn" type="button" class="btn-secondary text-sm">Asignar equipo</button>
            )}
          </div>
          {(ordenSucursal || ordenUbicacion || (o as any).ubicacionDetalle) && (
            <div class="mt-3 grid grid-cols-2 gap-3 text-sm">
              <div>
                <div class="text-xs uppercase text-slate-500">Sucursal</div>
                <div class="mt-0.5">{ordenSucursal?.nombre ?? <span class="text-slate-400">—</span>}</div>
              </div>
              <div>
                <div class="text-xs uppercase text-slate-500">Ubicación</div>
                <div class="mt-0.5">
                  {ordenUbicacion?.nombre ?? <span class="text-slate-400">—</span>}
                  {ordenUbicacion?.tipo && <span class="ml-1 text-xs text-slate-400 capitalize">({ordenUbicacion.tipo})</span>}
                </div>
              </div>
              {(o as any).ubicacionDetalle && (
                <div class="col-span-2">
                  <div class="text-xs uppercase text-slate-500">Detalle</div>
                  <div class="mt-0.5 text-slate-700">{(o as any).ubicacionDetalle}</div>
                </div>
              )}
            </div>
          )}
          {puedeAsignarActivo && (
          <div id="activoEditor" class="hidden mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3">
            <div>
              <label class="label text-xs">1. Sucursal</label>
              <select id="sucSel" class="input text-sm">
                <option value="">— Selecciona —</option>
                {sucursalesLista.map((s) => <option value={s.id}>{s.nombre}</option>)}
              </select>
            </div>
            <div>
              <label class="label text-xs">2. Ubicación</label>
              <select id="ubSel" class="input text-sm" disabled>
                <option value="">Selecciona la sucursal</option>
              </select>
            </div>
            <div>
              <label class="label text-xs">3. Equipo</label>
              <select id="activoSelect" class="input text-sm" disabled>
                <option value="">Selecciona la ubicación</option>
              </select>
            </div>
            <div class="sm:col-span-3 flex items-center justify-end gap-2">
              <p id="activoMsg" class="hidden mr-auto text-xs"></p>
              <button id="activoCancel" type="button" class="btn-secondary text-sm">Cancelar</button>
              <button id="activoSave" type="button" class="btn-primary text-sm">Guardar</button>
            </div>
          </div>
          )}
        </div>
      )}

      <!-- Foto ANTES de la OT (verificación del estado inicial) -->
      <div class="card p-5 border-l-4 border-blue-300">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="font-semibold text-slate-900">Foto del estado inicial (antes)</h2>
            <p class="mt-1 text-xs text-slate-500">Opcional: toma esta foto al llegar al sitio, antes de pulsar "Iniciar". Sirve como evidencia del estado en que se recibió el equipo.</p>
          </div>
          <span class="text-xs text-slate-500">{adjsAntes.length} foto(s)</span>
        </div>

        {adjsAntes.length > 0 && (
          <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
            {adjsAntes.map((a) => (
              <div class="relative group rounded bg-slate-50 p-2 text-xs">
                {puedeBorrarAntes && (
                  <button class="adj-del-btn absolute top-1 right-1 z-10 rounded-full bg-white text-red-600 border border-red-600 w-6 h-6 flex items-center justify-center shadow sm:opacity-0 sm:group-hover:opacity-100 transition" data-id={a.id} title="Eliminar">×</button>
                )}
                {a.contentType.startsWith("image/") && (
                  <a href={`/api/adjuntos/${a.id}`} target="_blank">
                    <img src={`/api/adjuntos/${a.id}`} alt={a.nombre} class="mb-1 h-24 w-full rounded object-cover" loading="lazy" />
                  </a>
                )}
                <a href={`/api/adjuntos/${a.id}`} target="_blank" class="block truncate font-medium text-brand-700 hover:underline">{a.nombre}</a>
                <span class="text-slate-500">{(a.tamano / 1024).toFixed(1)} KB</span>
              </div>
            ))}
          </div>
        )}

        {puedeSubirAntes && (
          <form class="upForm mt-3" data-categoria="antes">
            <label class="block">
              <input type="file" accept="image/*,application/pdf" capture="environment" class="hidden upFile" />
              <span class="btn-primary w-full justify-center py-3 cursor-pointer block text-center">{adjsAntes.length === 0 ? "Tomar foto del estado inicial" : "Agregar otra foto"}</span>
            </label>
            <button type="submit" class="hidden">Subir</button>
          </form>
        )}
      </div>

      <!-- Línea de tiempo de la OT. Al técnico solo a quién está asignada y el plazo. -->
      <div class="card p-5">
        <h2 class="font-semibold text-slate-900">{verTiempos ? "Tiempos" : "Asignación y plazo"}</h2>
        <div class="mt-3 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
          <div>
            <div class="text-xs uppercase text-slate-500">Asignado</div>
            <div class="mt-0.5">{row.asignado?.nombre ?? <span class="text-slate-400">Sin asignar</span>}</div>
          </div>
          <div>
            <div class="text-xs uppercase text-slate-500">Vence</div>
            <div class="mt-0.5">{fmtVence(o.vencimiento)}</div>
          </div>
          {verTiempos && (
            <Fragment>
              <div>
                <div class="text-xs uppercase text-slate-500">Iniciada</div>
                <div class="mt-0.5">{fmt(o.iniciadaEn)}</div>
              </div>
              <div>
                <div class="text-xs uppercase text-slate-500">Completada</div>
                <div class="mt-0.5">{fmt(o.completadaEn)}</div>
              </div>
            </Fragment>
          )}
        </div>
        {verTiempos && o.iniciadaEn && (
          <div class:list={["mt-3 rounded px-3 py-2 text-xs", estadoActual === "en_espera" ? "bg-purple-50 text-purple-700" : "bg-emerald-50 text-emerald-700"]}>
            {o.completadaEn ? (
              <>
                Duración real: <strong>{((new Date(o.completadaEn).getTime() - new Date(o.iniciadaEn).getTime()) / 3600_000).toFixed(2)} h</strong>
                {(o.tiempoPausadoMin ?? 0) > 0 && <> · Pausado: <strong>{((o.tiempoPausadoMin ?? 0) / 60).toFixed(1)} h</strong></>}
                {o.horasTrabajadas != null && <> · Registradas: <strong>{Number(o.horasTrabajadas).toFixed(2)} h</strong></>}
              </>
            ) : estadoActual === "en_espera" ? (
              <>OT pausada{o.pausadaEn ? ` desde ${fmt(o.pausadaEn)}` : ""}. Tiempo pausado acumulado: <strong>{((o.tiempoPausadoMin ?? 0) / 60).toFixed(1)} h</strong></>
            ) : (
              <>En proceso desde {fmt(o.iniciadaEn)} — el cronómetro corre.</>
            )}
          </div>
        )}
      </div>

      <!-- Checklist -->
      {checklistItems.length > 0 && (
        <div class="card p-5">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <h2 class="font-semibold text-slate-900">Checklist de puntos críticos</h2>
            <div class="flex items-center gap-2 text-xs">
              <span class="text-slate-500">{progreso.hechos} / {progreso.total}</span>
              {progreso.desviaciones > 0 && (
                <span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 font-medium">{progreso.desviaciones} desviación{progreso.desviaciones === 1 ? "" : "es"}</span>
              )}
              {progreso.pendientes > 0 && (
                <span class="px-1.5 py-0.5 rounded bg-red-100 text-red-700 font-medium">{progreso.pendientes} pendiente{progreso.pendientes === 1 ? "" : "s"}</span>
              )}
              {progreso.bloqueantesAbiertos > 0 && (
                <span class="px-1.5 py-0.5 rounded bg-white text-red-600 border border-red-600 font-medium">{progreso.bloqueantesAbiertos} crítico{progreso.bloqueantesAbiertos === 1 ? "" : "s"} en desviación</span>
              )}
              {progreso.valoresFaltantes > 0 && (
                <span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 font-medium">{progreso.valoresFaltantes} sin lectura</span>
              )}
              {progreso.fueraDeRango > 0 && (
                <span class="px-1.5 py-0.5 rounded bg-red-100 text-red-700 font-medium">{progreso.fueraDeRango} fuera de rango</span>
              )}
              <span id="ckAutosave" class="text-slate-400"></span>
            </div>
          </div>
          <div class="mt-2 h-2 overflow-hidden rounded bg-slate-100">
            <div class="h-full bg-emerald-500" style={`width: ${progreso.pct}%`}></div>
          </div>
          <p class="mt-3 text-xs text-slate-500">El técnico debe marcar cada punto. Las líneas marcadas <strong>lectura obligatoria</strong> piden un número: <strong>la orden no se completa sin él</strong> (márcala N/A si de verdad no se midió). Donde haya criterio de aceptación, registra el <strong>valor medido</strong>. Si encuentra algo fuera de norma, marca <strong>Desviación</strong> y describe qué pasó (mínimo 10 caracteres). <strong>No se puede cerrar la OT</strong> si hay puntos pendientes, desviaciones sin describir, o un <strong>punto crítico en desviación</strong> (el equipo no vuelve a servicio: resuélvelo o escala a correctivo).</p>
          <ul id="checklistList" class="mt-4 space-y-2">
            {checklistItems.map((it, idx) => {
              const filaColor =
                it.estado === "ok" ? "bg-emerald-50 border border-emerald-200" :
                it.estado === "na" ? "bg-slate-100 border border-slate-200" :
                it.estado === "desviacion" ? "bg-amber-50 border border-amber-300" :
                "bg-white border border-slate-200";
              return (
                <li class:list={["ck-row rounded-lg p-3 transition", filaColor]} data-idx={idx}>
                  <div class="text-sm font-medium text-slate-900">
                    {it.bloqueante && <span class="mr-1 align-middle rounded bg-red-100 px-1.5 py-0.5 text-[10px] font-semibold text-red-700">CRÍTICO</span>}
                    {it.texto}
                  </div>
                  {(it.criterio || (verTiempos && it.minutos) || it.materiales) && (
                    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                      {it.criterio && <span class="rounded bg-blue-50 px-1.5 py-0.5 text-blue-700">Criterio: {it.criterio}</span>}
                      {verTiempos && it.minutos && <span class="text-slate-500">{it.minutos} min</span>}
                      {it.materiales && <span class="text-slate-500">{it.materiales}</span>}
                    </div>
                  )}
                  {it.requiereValor ? (() => {
                    const ev = evaluarValorChecklist(it);
                    return (
                      <div class:list={["mt-2 rounded-lg p-2", ev.dentro === false ? "bg-red-50 ring-1 ring-red-300" : ev.dentro === true ? "bg-emerald-50" : !ev.tiene ? "bg-amber-50" : "bg-slate-50"]}>
                        <div class="flex flex-wrap items-end gap-2">
                          <div>
                            <label class="mb-1 block text-xs font-medium text-slate-700">
                              Lectura obligatoria{it.unidad ? ` (${it.unidad})` : ""}
                            </label>
                            <input class="ck-num input text-sm w-28" type="number" step="any" data-idx={idx}
                                   data-min={it.esperadoMin ?? ""} data-max={it.esperadoMax ?? ""} data-unidad={it.unidad ?? ""}
                                   value={it.valorMedido ?? ""} disabled={!puedeEditar} />
                          </div>
                          {ev.rangoTexto && (
                            <span class="rounded bg-blue-50 px-1.5 py-0.5 text-xs text-blue-700">Rango normal: {ev.rangoTexto}</span>
                          )}
                          <span class="ck-rango text-xs font-medium" data-idx={idx}>
                            {!ev.tiene ? <span class="text-amber-700">Sin lectura — bloquea el cierre</span>
                              : ev.dentro === true ? <span class="text-emerald-700">✓ Dentro del rango</span>
                              : ev.dentro === false ? <span class="text-red-700">FUERA DE RANGO — no libera el sistema</span>
                              : <span class="text-slate-500">Registrado</span>}
                          </span>
                        </div>
                        <div class="mt-2 flex flex-wrap items-end gap-2">
                          <div>
                            <label class="mb-1 block text-[11px] text-slate-500">Hora</label>
                            <input class="ck-hora input text-xs w-28" data-idx={idx} value={it.hora ?? ""} placeholder="hh:mm" disabled={!puedeEditar} />
                          </div>
                          <div>
                            <label class="mb-1 block text-[11px] text-slate-500">Iniciales</label>
                            <input class="ck-iniciales input text-xs w-24" data-idx={idx} value={it.iniciales ?? ""} placeholder="A.M." disabled={!puedeEditar} maxlength="12" />
                          </div>
                          <span class="text-[11px] text-slate-400">Las columnas de hora e iniciales se llenan durante la ejecución: un MOP sin firmas es un MOP sin evidencia.</span>
                        </div>
                      </div>
                    );
                  })() : it.criterio && (
                    <div class="mt-2">
                      <label class="mb-1 block text-xs text-slate-600">Valor medido / resultado</label>
                      <input class="ck-valor input text-sm w-full max-w-xs" data-idx={idx} value={it.valorMedido ?? ""} placeholder="Ej: 125 psi" disabled={!puedeEditar} />
                    </div>
                  )}
                  {puedeEditar ? (
                    <div class="mt-2 flex flex-wrap gap-1">
                      {(["pendiente","ok","na","desviacion"] as const).map((e) => {
                        const labels = { pendiente: "Pendiente", ok: "✓ OK", na: "⊘ N/A", desviacion: "Desviación" };
                        const colors = {
                          pendiente: it.estado === e ? "bg-slate-700 text-white" : "bg-white text-slate-600 border border-slate-300 hover:bg-slate-50",
                          ok: it.estado === e ? "bg-brand-600 text-white" : "bg-white text-emerald-700 border border-emerald-300 hover:bg-emerald-50",
                          na: it.estado === e ? "bg-slate-500 text-white" : "bg-white text-slate-600 border border-slate-300 hover:bg-slate-50",
                          desviacion: it.estado === e ? "bg-white text-amber-800 border border-amber-500 " : "bg-white text-amber-700 border border-amber-300 hover:bg-amber-50",
                        };
                        return (
                          <button type="button" class={`ck-estado-btn text-xs px-2 py-1 rounded-md font-medium transition ${colors[e]}`} data-idx={idx} data-estado={e}>{labels[e]}</button>
                        );
                      })}
                    </div>
                  ) : (
                    <div class="mt-1 text-xs">
                      Estado: <span class="font-medium">{it.estado === "ok" ? "✓ OK" : it.estado === "na" ? "⊘ N/A" : it.estado === "desviacion" ? "Desviación" : "Pendiente"}</span>
                    </div>
                  )}
                  <div class:list={["ck-nota-wrap mt-2", it.estado !== "desviacion" && "hidden"]} data-idx={idx}>
                    <label class="text-xs text-slate-600 block mb-1">Describe la desviación <span class="text-red-500">*</span></label>
                    <textarea
                      class="ck-nota input text-sm w-full"
                      rows="2"
                      placeholder="Ej: el filtro estaba quebrado y se reemplazó por uno equivalente..."
                      data-idx={idx}
                      disabled={!puedeEditar}
                    >{it.notas ?? ""}</textarea>
                    <p class="mt-0.5 text-[11px] text-slate-400">Mínimo 10 caracteres.</p>
                  </div>
                  {it.notas && it.estado !== "desviacion" && (
                    <div class="mt-1 text-xs text-slate-500">{it.notas}</div>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )}

      <!-- ══ MOP · LECTURAS DE LIBERACIÓN QUE BLOQUEAN CERRAR ══ -->
      {muestraMop && (
        <div class="card p-5 border-l-4 border-emerald-500">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <h2 class="font-semibold text-slate-900">Lecturas de liberación</h2>
            <span class="text-xs text-slate-500">
              {liberacionesConLectura} / {liberaciones.length} medidas
              {liberacionesNoConformes > 0 && <span class="ml-2 rounded bg-white text-red-600 border border-red-600 px-1.5 py-0.5 font-medium ">{liberacionesNoConformes} fuera de rango</span>}
              {faltanLecturas && <span class="ml-2 rounded bg-red-100 px-1.5 py-0.5 font-medium text-red-700">{bloqueoCierre.faltantes.length} bloquea{bloqueoCierre.faltantes.length === 1 ? "" : "n"} el envío</span>}
              <span id="liberMsg" class="ml-2 text-slate-400"></span>
            </span>
          </div>
          <p class="mt-1 text-xs text-slate-500">
            Es la sección de cierre del MOP: <strong>la orden no se envía a verificación sin la lectura de liberación</strong>. Al escribir el valor medido se calcula si quedó conforme contra el rango del SCP. Una lectura fuera de rango no libera el sistema: no se devuelve a servicio.
          </p>
          {envioBloqueado && ordenSinEnviar && (
            <div id="liberBloqueo" class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-900">
              <strong>Esta orden no se puede enviar a verificación todavía.</strong>
              {faltanLecturas && (
                <Fragment>
                  {" "}Falta{bloqueoCierre.faltantes.length === 1 ? "" : "n"} medir:
                  <ul class="mt-1 list-disc pl-5">
                    {bloqueoCierre.faltantes.map((f) => <li>{f}</li>)}
                  </ul>
                </Fragment>
              )}
              {lecturasFuera.length > 0 ? (
                <Fragment>
                  <p class="mt-1">Fuera de rango: {lecturasFuera.map((l) => l.etiqueta).join(" · ")}.</p>
                  <p class="mt-2 text-xs">Una lectura fuera de rango no libera el sistema: repite la medición o, si revertiste el trabajo, marca la reversa.</p>
                </Fragment>
              ) : puedeCerrarSinLectura(user.rol)
                ? <p class="mt-2 text-xs">Si de verdad no se pudo medir, la jefatura puede enviarla a verificación sin la lectura, con motivo escrito, usando <strong>«Enviar a verificación sin lectura»</strong>. La orden no se cierra: queda pendiente de verificación y el motivo queda registrado con tu nombre.</p>
                : <p class="mt-2 text-xs">Si no se pudo medir, pide a tu jefatura que la envíe a verificación sin lectura, con motivo escrito: tú no puedes saltarte la lectura. Si revertiste el trabajo, marca la reversa.</p>}
            </div>
          )}
          {o.cierreSinLecturaMotivo && (
            <div class="mt-3 rounded-lg border-l-4 border-amber-500 bg-amber-50 p-3 text-sm text-amber-900">
              <strong>Enviada a verificación sin lectura de liberación.</strong> {fmt(o.cierreSinLecturaEn)}{(estadoActual === "completada" || estadoActual === "verificada") && " · Pendiente de verificación."}
              <p class="mt-1 whitespace-pre-wrap">{o.cierreSinLecturaMotivo}</p>
            </div>
          )}
          {liberaciones.length === 0 ? (
            <p class="mt-3 text-sm text-slate-400">Sin lecturas de liberación cargadas. {puedeConfigurarMop ? "Agrega las del registro de liberación del MOP." : "Pide a la jefatura que cargue las del MOP."}</p>
          ) : (
            <ul class="mt-3 space-y-2">
              {liberaciones.map((lib) => {
                const medida = liberacionTieneLectura(lib);
                return (
                  <li class:list={["rounded-lg border p-3",
                    lib.conforme === false ? "border-red-300 bg-red-50" :
                    lib.conforme === true ? "border-emerald-200 bg-emerald-50" :
                    medida ? "border-slate-200 bg-slate-50" :
                    lib.obligatoria ? "border-amber-200 bg-amber-50/40" : "border-slate-200 bg-white"]}>
                    <div class="flex flex-wrap items-start justify-between gap-2">
                      <div class="min-w-0">
                        <div class="text-sm font-medium text-slate-900">
                          {lib.etiqueta}
                          {lib.obligatoria
                            ? <span class="ml-2 rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-semibold text-amber-800">OBLIGATORIA</span>
                            : <span class="ml-2 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-500">opcional</span>}
                          {lib.conforme === true && <span class="ml-2 rounded bg-emerald-100 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-700">✓ CONFORME</span>}
                          {lib.conforme === false && <span class="ml-2 rounded bg-white text-red-600 border border-red-600 px-1.5 py-0.5 text-[10px] font-semibold ">✕ FUERA DE RANGO</span>}
                        </div>
                        <div class="mt-0.5 text-xs text-slate-600">
                          {lib.valorEsperado && <span class="mr-2">Esperado: {lib.valorEsperado}</span>}
                          {(lib.minAceptable != null || lib.maxAceptable != null) && (
                            <span class="rounded bg-blue-50 px-1.5 py-0.5 text-blue-700">
                              Rango: {lib.minAceptable != null ? lib.minAceptable : "—"} a {lib.maxAceptable != null ? lib.maxAceptable : "—"}{lib.unidad ? ` ${lib.unidad}` : ""}
                            </span>
                          )}
                        </div>
                        {medida && (
                          <div class="mt-0.5 text-[11px] text-slate-500">Medido por {lib.medidoNombre ?? "—"} el {fmt(lib.medidoEn)}</div>
                        )}
                      </div>
                      {puedeConfigurarMop && !medida && (
                        <button type="button" class="liber-del text-xs text-slate-400 hover:text-red-600" data-id={lib.id} title="Eliminar lectura">✕</button>
                      )}
                    </div>
                    <div class="mt-2 flex flex-wrap items-end gap-2">
                      <div>
                        <label class="mb-1 block text-xs text-slate-600">Valor medido{lib.unidad ? ` (${lib.unidad})` : ""}</label>
                        <input class="liber-valor input w-32 text-sm" type="number" step="any" data-id={lib.id}
                               data-min={lib.minAceptable ?? ""} data-max={lib.maxAceptable ?? ""}
                               value={lib.valorMedido ?? ""} disabled={!puedeRegistrarMop} />
                      </div>
                      <div class="min-w-0 flex-1">
                        <label class="mb-1 block text-xs text-slate-600">O anótalo en texto (cuando no es un número)</label>
                        <input class="liber-texto input w-full text-sm" data-id={lib.id} value={lib.valorMedidoTexto ?? ""}
                               placeholder="Ej. sin alarmas · selectores en automático" disabled={!puedeRegistrarMop} />
                      </div>
                      {puedeRegistrarMop && (
                        <button type="button" class="liber-save btn-primary text-xs" data-id={lib.id}>Registrar lectura</button>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
          {puedeConfigurarMop && (
            <div class="mt-4 rounded-lg border border-dashed border-slate-300 p-3">
              <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                <div class="sm:col-span-2">
                  <label class="label text-xs" for="liberEtiqueta">Qué se mide para liberar</label>
                  <input id="liberEtiqueta" class="input text-sm w-full" placeholder="Ej. Presión diferencial inicial del filtro HEPA terminal" />
                </div>
                <div>
                  <label class="label text-xs" for="liberEsperado">Valor esperado (texto)</label>
                  <input id="liberEsperado" class="input text-sm w-full" placeholder="Ej. ≥ 18 renovaciones/hora" />
                </div>
                <div>
                  <label class="label text-xs" for="liberUnidad">Unidad</label>
                  <input id="liberUnidad" class="input text-sm w-full" placeholder="Pa · °C · kW · Hz" />
                </div>
                <div>
                  <label class="label text-xs" for="liberMin">Mínimo aceptable</label>
                  <input id="liberMin" type="number" step="any" class="input text-sm w-full" />
                </div>
                <div>
                  <label class="label text-xs" for="liberMax">Máximo aceptable</label>
                  <input id="liberMax" type="number" step="any" class="input text-sm w-full" />
                </div>
              </div>
              <div class="mt-2 flex flex-wrap items-center gap-3">
                <label class="flex items-center gap-1.5 text-xs text-slate-600">
                  <input id="liberObligatoria" type="checkbox" checked />
                  Bloquea el cierre
                </label>
                <button id="liberAdd" type="button" class="btn-secondary text-xs ml-auto">+ Agregar lectura</button>
              </div>
            </div>
          )}
          {puedeEnviarSinLectura && (
            <div class="mt-3 flex justify-end">
              <button id="sinLecturaBtn" type="button" class="btn-secondary text-xs border-amber-300 text-amber-700 hover:bg-amber-50">Enviar a verificación sin lectura (requiere motivo)</button>
            </div>
          )}
        </div>
      )}

      <!-- Ejecución: qué se encontró y qué se hizo. La causa raíz va aparte: la escribe la jefatura. -->
      <div class="card p-5">
        <div class="flex items-center justify-between gap-2">
          <h2 class="font-semibold text-slate-900">Ejecución del trabajo</h2>
          <span id="autosaveIndicador" class="text-xs text-slate-400" data-status="idle"></span>
        </div>
        <div class="mt-3 space-y-3 text-sm">
          <div>
            <label class="label" for="trabajosRealizados">Trabajos realizados</label>
            <textarea id="trabajosRealizados" class="input" rows="3" placeholder="Qué encontraste y qué hiciste." disabled={!puedeEditar}>{o.trabajosRealizados ?? ""}</textarea>
          </div>
          {muestraSolucion && (
            <div>
              <label class="label" for="solucionAplicada">Solución aplicada</label>
              <textarea id="solucionAplicada" class="input" rows="2" disabled={!puedeEditar}>{o.solucionAplicada ?? ""}</textarea>
            </div>
          )}
          {esTecnico && muestraCausa && (
            <p class="rounded bg-slate-50 px-3 py-2 text-xs text-slate-600">La causa raíz la escribe tu jefatura.</p>
          )}
          {verTiempos && (
            <div>
              <label class="label" for="horasTrabajadas">Horas trabajadas</label>
              <input id="horasTrabajadas" type="number" min="0" step="0.25" class="input w-32 bg-slate-100 cursor-not-allowed" value={o.horasTrabajadas ?? ""} readonly disabled />
              <p class="mt-1 text-xs text-slate-500">Se calcula automáticamente del cronómetro: <strong>inicio → cierre</strong>, descontando el tiempo en estado "en espera". No es editable para garantizar trazabilidad real del tiempo.</p>
            </div>
          )}
          {puedeEditar && (
            <div class="flex items-center gap-2 flex-wrap">
              <p class="text-xs text-emerald-700 mr-auto">✓ Tus cambios se guardan automáticamente al escribir.</p>
              <button id="ejecSave" class="btn-secondary text-xs">Guardar ahora</button>
            </div>
          )}
          <p id="ejecMsg" class="hidden text-xs"></p>
        </div>
      </div>

      <!-- ══ Causa raíz · la escribe la jefatura, dentro de las 72 h ══ -->
      {muestraCausa && !esTecnico && (
        <div id="causaCard" class:list={["card p-5", reqCausa.requiere && "border-l-4", causaVencida ? "border-red-500" : "border-brand-500"]}>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="font-semibold text-slate-900"><label for="causaRaiz">Causa raíz · la escribe la jefatura</label></h2>
            <span id="causaMsg" class="text-xs text-slate-400"></span>
          </div>
          <p class:list={["mt-1 text-xs", causaVencida ? "font-medium text-red-700" : "text-slate-600"]}>
            {reqCausa.requiere
              ? <Fragment><strong>Obligatoria para verificar y cerrar.</strong> {reqCausa.motivo}</Fragment>
              : <Fragment>Opcional en esta orden.</Fragment>}
            {o.causaRaizVencimiento
              ? <Fragment> Plazo: {HORAS_CAUSA_RAIZ} h desde la alarma, vence {fmt(o.causaRaizVencimiento)}{causaVencida ? ". Vencido" : ""}.</Fragment>
              : <Fragment> Se escribe dentro de las {HORAS_CAUSA_RAIZ} h.</Fragment>}
          </p>
          <textarea id="causaRaiz" class:list={["input mt-3", faltaCausa && "border-red-300"]} rows={reqCausa.requiere ? 4 : 2}
                    disabled={!puedeEscribirCausa} placeholder="Por qué falló, no qué se hizo.">{o.causaRaiz ?? ""}</textarea>
          {puedeEscribirCausa ? (
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <p class="mr-auto text-xs text-slate-500">Mínimo {MIN_CAUSA_RAIZ} caracteres. Se guarda sola al escribir{ordenSinEnviar ? "" : ", aunque la orden ya esté enviada o cerrada"}.</p>
              <button id="causaSave" type="button" class="btn-secondary text-xs">Guardar causa raíz</button>
            </div>
          ) : esJefatura && (
            <p class="mt-2 text-xs text-slate-500">{estadoActual === "abierta" ? "Se escribe una vez iniciada la orden." : "La orden está cancelada."}</p>
          )}
        </div>
      )}

      <!-- Repuestos consumidos -->
      {(itemsActivos.length > 0 || repuestosRows.length > 0) && (
        <div class="card p-5">
          <div class="flex items-center justify-between">
            <h2 class="font-semibold text-slate-900">Repuestos consumidos</h2>
            <span class="text-xs text-slate-500">
              {repuestosRows.length} líneas
              {totalRepuestos > 0 && <span> · ${totalRepuestos.toFixed(2)}</span>}
            </span>
          </div>
          {repuestosRows.length === 0 && <p class="mt-2 text-sm text-slate-500">Sin repuestos registrados.</p>}
          {repuestosRows.length > 0 && (
            <div class="mt-3 overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                  <tr>
                    <th class="px-3 py-1.5">Item</th>
                    <th class="px-3 py-1.5 text-right">Cant.</th>
                    <th class="px-3 py-1.5 text-right">P. unit.</th>
                    <th class="px-3 py-1.5 text-right">Subtotal</th>
                    {puedeRevertirRepuesto && <th class="px-3 py-1.5"></th>}
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {repuestosRows.map((r) => {
                    const sub = (r.rep.precioUnitario ?? 0) * r.rep.cantidad;
                    return (
                      <tr id={`rep-${r.rep.id}`}>
                        <td class="px-3 py-1.5">
                          <a class="text-brand-700 hover:underline" href={`/inventario/${r.it?.id}`}>{r.it?.codigo} · {r.it?.nombre}</a>
                        </td>
                        <td class="px-3 py-1.5 text-right font-mono">{fmtCantidad(r.rep.cantidad, r.it?.unidad)}</td>
                        <td class="px-3 py-1.5 text-right font-mono">{r.rep.precioUnitario != null ? `$${r.rep.precioUnitario.toFixed(2)}` : "—"}</td>
                        <td class="px-3 py-1.5 text-right font-mono">{sub > 0 ? `$${sub.toFixed(2)}` : "—"}</td>
                        {puedeRevertirRepuesto && (
                          <td class="px-3 py-1.5 text-right">
                            <button class="rep-del-btn text-xs text-red-500 hover:underline" data-id={r.rep.id}>Revertir</button>
                          </td>
                        )}
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}

          {puedeEditar && itemsActivos.length > 0 && (
            <div class="mt-4 rounded border border-dashed border-slate-300 p-3">
              <h3 class="mb-2 text-sm font-semibold text-slate-700">+ Registrar consumo</h3>
              <div class="grid grid-cols-1 gap-2 sm:grid-cols-4">
                <select id="rep_item" class="input text-sm sm:col-span-2">
                  <option value="">— Item —</option>
                  {itemsActivos.map((it) => <option value={it.id} data-precio={it.precio ?? ""} data-unidad={it.unidad}>{it.codigo} · {it.nombre}</option>)}
                </select>
                <input id="rep_cant" type="number" min="0" step="0.01" placeholder="Cantidad" class="input text-sm" />
                <input id="rep_precio" type="number" min="0" step="0.01" placeholder="Precio unit. (opcional)" class="input text-sm" />
              </div>
              <div class="mt-2 flex items-center justify-between gap-2">
                <input id="rep_notas" placeholder="Notas (opcional)" class="input flex-1 text-sm" />
                <button id="rep_save" class="btn-primary text-sm">Registrar</button>
              </div>
              <p id="rep_msg" class="mt-2 hidden text-xs"></p>
            </div>
          )}
        </div>
      )}

      <!-- Costo total estimado de la OT -->
      {/* Costo solo visible para admin/jefe (técnicos no lo ven) */}
      {(user.rol === "admin" || user.rol === "jefe") && (costoManoObra > 0 || totalRepuestos > 0) && (
        <div class="card p-5 border-l-4 border-emerald-500">
          <div class="flex items-center justify-between">
            <h2 class="font-semibold text-slate-900">Costo de la OT</h2>
            <span class="text-xs text-slate-500">Estimado</span>
          </div>
          <dl class="mt-3 space-y-1.5 text-sm">
            <div class="flex justify-between">
              <dt class="text-slate-600">Mano de obra</dt>
              <dd class="font-mono">
                {horasTrab.toFixed(1)}h × ${tarifaTecnico.toFixed(2)}/h
                <span class="ml-2 font-bold text-slate-700">${costoManoObra.toFixed(2)}</span>
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-slate-600">Repuestos consumidos</dt>
              <dd class="font-mono font-bold text-slate-700">${totalRepuestos.toFixed(2)}</dd>
            </div>
            <div class="flex justify-between border-t border-slate-200 pt-2">
              <dt class="font-semibold text-slate-900">Total</dt>
              <dd class="font-mono text-lg font-bold text-emerald-700">${costoTotal.toFixed(2)}</dd>
            </div>
          </dl>
          {tarifaTecnico === 0 && row.asignado && (
            <p class="mt-3 rounded bg-amber-50 p-2 text-xs text-amber-700">
              El técnico asignado no tiene tarifa horaria configurada. Configúrala en <a href="/usuarios" class="font-medium underline">Usuarios</a> para calcular el costo de mano de obra.
            </p>
          )}
        </div>
      )}

      <!-- Foto DESPUÉS (estado final) — visible cuando OT está en proceso o más allá -->
      {estadoActual !== "abierta" && estadoActual !== "cancelada" && (
        <div class="card p-5 border-l-4 border-emerald-300">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="font-semibold text-slate-900">Foto del estado final (después)</h2>
              <p class="mt-1 text-xs text-slate-500">Opcional: foto del estado final como evidencia del cierre. Recomendable cuando hubo intervención visible (cambio de pieza, reparación), pero no es obligatoria para completar.</p>
            </div>
            <span class="text-xs text-slate-500">{adjsDespues.length} foto(s)</span>
          </div>

          {adjsDespues.length > 0 && (
            <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
              {adjsDespues.map((a) => (
                <div class="relative group rounded bg-slate-50 p-2 text-xs">
                  {puedeEditar && (
                    <button class="adj-del-btn absolute top-1 right-1 z-10 rounded-full bg-white text-red-600 border border-red-600 w-6 h-6 flex items-center justify-center shadow sm:opacity-0 sm:group-hover:opacity-100 transition" data-id={a.id} title="Eliminar">×</button>
                  )}
                  {a.contentType.startsWith("image/") && (
                    <a href={`/api/adjuntos/${a.id}`} target="_blank">
                      <img src={`/api/adjuntos/${a.id}`} alt={a.nombre} class="mb-1 h-24 w-full rounded object-cover" loading="lazy" />
                    </a>
                  )}
                  <a href={`/api/adjuntos/${a.id}`} target="_blank" class="block truncate font-medium text-brand-700 hover:underline">{a.nombre}</a>
                  <span class="text-slate-500">{(a.tamano / 1024).toFixed(1)} KB</span>
                </div>
              ))}
            </div>
          )}

          {puedeEditar && (
            <form class="upForm mt-3" data-categoria="despues">
              <label class="block">
                <input type="file" accept="image/*,application/pdf" capture="environment" class="hidden upFile" />
                <span class="btn-primary w-full justify-center py-3 cursor-pointer block text-center bg-emerald-600 hover:bg-emerald-700">{adjsDespues.length === 0 ? "Tomar foto del estado final" : "Agregar otra foto"}</span>
              </label>
              <button type="submit" class="hidden">Subir</button>
            </form>
          )}
        </div>
      )}

      <!-- Verificacion (cuando ya esta verificada o cerrada) -->
      {(o.verificadoEn || o.verificacionNotas) && (
        <div class="card p-5 border-l-4 border-teal-500">
          <h2 class="font-semibold text-teal-700">Verificación</h2>
          <div class="mt-2 text-sm">
            {o.verificadoEn && (
              <p class="text-slate-600">
                Verificada por <strong>{verifUsr?.nombre ?? "—"}</strong> el {fmt(o.verificadoEn)}
              </p>
            )}
            {o.verificacionNotas && (
              <p class="mt-2 whitespace-pre-wrap rounded bg-teal-50 p-3 text-slate-700">{o.verificacionNotas}</p>
            )}
          </div>
        </div>
      )}

      {o.cerradoEn && (
        <div class="card p-5 border-l-4 border-slate-700">
          <h2 class="font-semibold text-slate-700">Cerrada</h2>
          <p class="mt-2 text-sm text-slate-600">
            Cerrada por <strong>{cierraUsr?.nombre ?? "—"}</strong> el {fmt(o.cerradoEn)}
          </p>
        </div>
      )}
    </div>

    <!-- Sidebar: Asignacion + Comentarios -->
    <div class="space-y-4">
      {puedeTomarOrden && (
        <div class="card p-5">
          <h2 class="font-semibold text-slate-900">Asignación</h2>
          <p class="mt-2 text-sm text-slate-600">Esta orden no tiene técnico asignado.</p>
          <button id="tomarOrdenBtn" type="button" class="btn-primary mt-3 w-full justify-center">Tomar esta orden</button>
        </div>
      )}
      {puedeCambiarAsignacion && (
        <div class="card p-5">
          <h2 class="font-semibold text-slate-900">Asignación</h2>
          <div class="mt-3 space-y-2 text-sm">
            <select class="input" id="asignadoA">
              <option value="">— Sin asignar —</option>
              {tecnicos.map((t) => (
                <option value={t.id} selected={o.asignadoA === t.id}>{t.nombre} ({t.rol})</option>
              ))}
            </select>
            {o.asignadoA && (
              <div>
                <label class="text-xs text-slate-500 block mb-1">Motivo de reasignación <span class="text-slate-400">(opcional)</span></label>
                <input class="input text-sm" id="motivoReasignacion" placeholder="Ej: Cobertura por ausencia, mejor especialidad…" />
                <p class="mt-0.5 text-[11px] text-slate-400">Se incluye en el correo al técnico nuevo. Déjalo vacío si no aplica.</p>
              </div>
            )}
            <button id="asignarBtn" class="btn-secondary w-full justify-center">Guardar asignación</button>
          </div>
        </div>
      )}

      <!-- Solicitudes de compra vinculadas -->
      {verComprasSection && (
        <div class="card p-5">
          <div class="flex items-center justify-between mb-2">
            <h2 class="font-semibold text-slate-900">Compras</h2>
            {puedeSolicitarCompra && (
              <a href={`/solicitudes-compra/nueva?ordenId=${o.id}`} class="text-xs text-brand-600 hover:underline font-medium">
                + Nueva solicitud
              </a>
            )}
          </div>

          {!puedeSolicitarCompra && solicitudesVinculadas.length === 0 && (
            <div class="rounded-lg bg-amber-50 border border-amber-200 p-3 text-xs text-amber-800">
              {estadoActual === "abierta"
                ? <>Pulsa <strong>"Iniciar"</strong> para activar la OT y poder solicitar compras de contingencia.</>
                : <>Esta OT está en estado <strong>{ESTADO_LABEL[estadoActual]}</strong>. Solo se pueden generar solicitudes mientras la OT está en proceso o en espera.</>
              }
            </div>
          )}

          {solicitudesVinculadas.map((s) => {
            const sc = {
              borrador: "bg-slate-100 text-slate-600", enviada: "bg-blue-100 text-blue-700",
              comprada: "bg-emerald-100 text-emerald-700", rechazada: "bg-red-100 text-red-700",
              cancelada: "bg-slate-200 text-slate-500",
            } as const;
            const sl = {
              borrador: "Borrador", enviada: "Enviada", comprada: "Comprada", rechazada: "Rechazada", cancelada: "Cancelada",
            } as const;
            return (
              <a href={`/solicitudes-compra/${s.id}`} class="mt-2 flex items-center justify-between rounded-lg bg-slate-50 p-2 text-sm hover:bg-slate-100 no-underline block">
                <div>
                  <span class="font-mono text-xs text-slate-400">{s.codigo}</span>
                  <p class="text-sm font-medium text-slate-800 truncate">{s.titulo}</p>
                </div>
                <span class:list={["ml-2 shrink-0 text-xs px-2 py-0.5 rounded-full font-medium", sc[s.estado]]}>{sl[s.estado]}</span>
              </a>
            );
          })}
          {puedeSolicitarCompra && solicitudesVinculadas.length === 0 && (
            <a href={`/solicitudes-compra/nueva?ordenId=${o.id}`}
               class="mt-2 flex items-center justify-center gap-2 rounded-lg border border-dashed border-purple-300 p-3 text-sm text-purple-600 hover:bg-purple-50 no-underline">
              Solicitar compra de contingencia
            </a>
          )}
        </div>
      )}

      <div class="card p-5">
        <h2 class="font-semibold text-slate-900">Comentarios ({coms.length})</h2>
        <ul class="mt-3 space-y-3 text-sm">
          {coms.length === 0 && <li class="text-slate-500">Sin comentarios.</li>}
          {coms.map((r) => (
            <li class="rounded-md bg-slate-50 p-3">
              <div class="text-xs text-slate-500">{r.u?.nombre} - {fmt(r.c.createdAt)}</div>
              <div class="mt-1 whitespace-pre-wrap">{r.c.texto}</div>
            </li>
          ))}
        </ul>
        {puedeEditar ? (
          <form id="comForm" class="mt-3 space-y-2">
            <textarea id="comTexto" class="input" rows="2" placeholder="Agregar comentario..." required></textarea>
            <button class="btn-primary w-full justify-center" type="submit">Comentar</button>
          </form>
        ) : (
          <p class="mt-3 text-xs text-slate-400">
            {estadoActual === "abierta" ? "Inicia la OT para agregar comentarios" : "Comentarios bloqueados en este estado"}
          </p>
        )}
      </div>
    </div>
  </div>

  <!-- Documentos y archivos generales (las fotos antes/después están en sus tarjetas) -->
  <div class="mt-6 card p-5">
    <h2 class="font-semibold text-slate-900">Documentos y archivos ({adjsDocumento.length + adjsGeneral.length})</h2>
    <p class="text-xs text-slate-500">Para subir manuales, facturas u otros archivos. Las fotos antes/después están en sus secciones correspondientes.</p>
    <div class="mt-3 grid grid-cols-1 gap-4 md:grid-cols-2">
      {([
        { key: "documento", label: "Documentos", color: "bg-amber-50", items: adjsDocumento },
        { key: "general", label: "General", color: "bg-slate-50", items: adjsGeneral },
      ] as const).map((cat) => (
        <div class={`${cat.color} rounded-lg p-3`}>
          <div class="mb-2 flex items-center justify-between">
            <h3 class="text-sm font-semibold text-slate-700">{cat.label}</h3>
            <span class="text-xs text-slate-500">{cat.items.length}</span>
          </div>
          <ul class="space-y-1">
            {cat.items.length === 0 && <li class="text-xs text-slate-400">Vacío.</li>}
            {cat.items.map((a) => (
              <li class="relative group rounded bg-white p-2 text-xs">
                {puedeEditar && (
                  <button class="adj-del-btn absolute top-1 right-1 z-10 rounded-full bg-white text-red-600 border border-red-600 w-6 h-6 flex items-center justify-center shadow sm:opacity-0 sm:group-hover:opacity-100 transition" data-id={a.id} title="Eliminar">×</button>
                )}
                {a.contentType.startsWith("image/") && (
                  <a href={`/api/adjuntos/${a.id}`} target="_blank">
                    <img src={`/api/adjuntos/${a.id}`} alt={a.nombre} class="mb-1 h-24 w-full rounded object-cover" loading="lazy" />
                  </a>
                )}
                <a href={`/api/adjuntos/${a.id}`} target="_blank" class="block truncate font-medium text-brand-700 hover:underline">
                  {a.nombre}
                </a>
                <span class="text-slate-500">{(a.tamano / 1024).toFixed(1)} KB</span>
              </li>
            ))}
          </ul>
          {puedeEditar && (
            <form class="upForm mt-2 space-y-1" data-categoria={cat.key}>
              <label class="block">
                <input type="file" accept="image/*,application/pdf" capture="environment" class="hidden upFile" />
                <span class="btn-secondary w-full justify-center py-2 text-xs cursor-pointer block text-center">Tomar foto / subir archivo</span>
              </label>
              <button type="submit" class="hidden">Subir</button>
            </form>
          )}
        </div>
      ))}
    </div>
    <p id="upErr" class="mt-2 hidden text-sm text-red-600"></p>
  </div>

  <!-- Firmas digitales + PDF -->
  <div class="card mt-6 p-5">
    <div class="flex items-center justify-between">
      <h2 class="font-semibold text-slate-900">Firmas digitales</h2>
      {/* El reporte trae los tiempos de medición: es de la jefatura. */}
      {verTiempos && <a href={`/ordenes/${o.id}/reporte`} class="btn-primary text-sm">Reporte de mantenimiento</a>}
    </div>
    <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
      {(["tecnico", "jefe", "solicitante"] as const).map((rol) => {
        const r2 = rol === "tecnico" ? o.firmaTecnicoR2 : rol === "jefe" ? o.firmaJefeR2 : o.firmaSolicitanteR2;
        const nombre = rol === "tecnico" ? o.firmaTecnicoNombre : rol === "jefe" ? o.firmaJefeNombre : o.firmaSolicitanteNombre;
        const fecha = rol === "tecnico" ? o.firmaTecnicoFecha : rol === "jefe" ? o.firmaJefeFecha : o.firmaSolicitanteFecha;
        const labels = { tecnico: "Técnico", jefe: "Jefe / Supervisor", solicitante: "Solicitante / Usuario" };
        // La firma de la jefatura solo la pone la jefatura: el servidor se la rechaza a los demás.
        const puedeFirmar = rol !== "jefe" || esJefatura;
        return (
          <div class="rounded-lg border border-slate-200 p-3">
            <div class="text-xs font-medium uppercase text-slate-500">{labels[rol]}</div>
            {r2 ? (
              <div class="mt-2">
                <img src={`/api/firmas/${o.id}/${rol}`} alt={`Firma ${rol}`} class="h-20 w-full rounded bg-white object-contain" />
                <div class="mt-1 text-xs text-slate-600"><strong>{nombre}</strong></div>
                <div class="text-[10px] text-slate-400">{fecha ? fmt(fecha) : ""}</div>
                {puedeFirmar && <button class="firma-clear-btn mt-1 text-[10px] text-red-500 hover:underline" data-rol={rol}>Volver a firmar</button>}
              </div>
            ) : puedeFirmar ? (
              <button class="firma-add-btn mt-2 w-full rounded border border-dashed border-slate-300 py-3 text-xs text-slate-500 hover:border-brand-500 hover:text-brand-700" data-rol={rol}>
                + Agregar firma
              </button>
            ) : (
              <p class="mt-2 text-xs text-slate-400">Sin firma. La pone la jefatura.</p>
            )}
          </div>
        );
      })}
    </div>
  </div>

  <!-- Modal de firma -->
  <div id="firmaModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-lg rounded-lg bg-white p-5 shadow-xl">
      <h3 id="firmaTitulo" class="font-semibold">Firmar como técnico</h3>
      <p class="mt-1 text-xs text-slate-500">Dibuja con el mouse o el dedo (touch).</p>
      <input id="firmaNombre" class="input mt-3" placeholder="Nombre completo del firmante" />
      <canvas id="firmaCanvas" width="500" height="180" class="mt-3 w-full rounded border-2 border-dashed border-slate-300 bg-white" style="touch-action:none"></canvas>
      <div class="mt-3 flex justify-end gap-2">
        <button id="firmaClear" class="btn-secondary">Limpiar</button>
        <button id="firmaCancel" class="btn-secondary">Cancelar</button>
        <button id="firmaSave" class="btn-primary">Guardar firma</button>
      </div>
      <p id="firmaErr" class="mt-2 hidden text-xs text-red-600"></p>
    </div>
  </div>

  <!-- Modal verificacion (capturar notas): solo para quien puede verificar -->
  {proximas.includes("verificada") && (
  <div id="verifModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4" role="dialog">
    <div class="w-full max-w-md rounded-lg bg-white p-5 shadow-xl">
      <h3 class="font-semibold text-slate-900">Verificar y cerrar orden</h3>
      <p class="mt-1 text-xs text-slate-500">Confirmas que el trabajo está conforme. La OT pasará a <strong>cerrada</strong> y se enviará la encuesta de satisfacción al solicitante. Debes registrar qué evidencia comprobaste y el resultado. No puedes verificar tu propia ejecución.</p>
      {verifSinLectura === "registrado" && (
        <div id="verifSinLecturaRegistrado" class="mt-3 rounded border-l-4 border-amber-500 bg-amber-50 p-3 text-xs text-amber-900">
          <strong>Enviada a verificación sin lectura de liberación.</strong> El motivo ya quedó registrado; no hace falta escribirlo otra vez.
          <p class="mt-1 whitespace-pre-wrap">{o.cierreSinLecturaMotivo}</p>
        </div>
      )}
      {verifSinLectura === "pedir" && (
        <div class="mt-3">
          <label class="label text-xs" for="verifSinLecturaMotivo">Faltan lecturas de liberación. Motivo para cerrar sin ellas (mínimo 20 caracteres)</label>
          <textarea id="verifSinLecturaMotivo" class="input" rows="3"></textarea>
        </div>
      )}
      {verifSinLectura === "bloqueada" && (
        <p class="mt-3 rounded bg-red-50 p-3 text-xs text-red-800">Faltan lecturas de liberación obligatorias y solo la jefatura puede cerrar sin ellas. Devuelve la orden para que se midan.</p>
      )}
      {verifSinLectura === "fuera" && (
        <p class="mt-3 rounded bg-red-50 p-3 text-xs text-red-800">Una lectura de liberación quedó fuera de rango: el sistema no se libera. Devuelve la orden para repetir la medición.</p>
      )}
      {verifSinCausa && (
        <p class="mt-3 rounded bg-red-50 p-3 text-xs text-red-800">Falta la causa raíz. La escribe la jefatura: hasta entonces no se puede verificar.</p>
      )}
      <textarea id="verifNotas" class="input mt-3" rows="3" minlength="10" required placeholder="Evidencia revisada, pruebas realizadas y resultado (obligatorio)"></textarea>
      <div class="mt-3 flex justify-end gap-2">
        <button id="verifCancel" class="btn-secondary">Cancelar</button>
        <button id="verifConfirm" class="btn-primary bg-teal-600 hover:bg-teal-700" disabled={verifSinLectura === "bloqueada" || verifSinLectura === "fuera" || verifSinCausa}>Verificar y cerrar</button>
      </div>
    </div>
  </div>
  )}

  <script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({
    id,
    area,
    estadoActual,
    checklistJson: o.checklistEjecucion ?? null,
    itemsRepJson,
    ubicacionesData: ubicacionesLista,
    activosData: activosLista,
    sucursalActualId: row.sucursal?.id ?? null,
    ubicacionActualId: row.ubicacion?.id ?? null,
    activoActualId: row.activo?.id ?? null,
    usuarioId: user.id,
    causaObligatoria: reqCausa.requiere,
    minCausa: MIN_CAUSA_RAIZ,
  }) }}>
    const { id, area, estadoActual, checklistJson, itemsRepJson, ubicacionesData, activosData, sucursalActualId, ubicacionActualId, activoActualId, usuarioId, causaObligatoria, minCausa } = JSON.parse(decodeURIComponent(__encodedScriptVars));
    const $ = (id) => document.getElementById(id);
    // Blindaje: si checklistEjecucion quedara con datos no-JSON, no debe romper
    // toda la página (botones incluidos). Ante error, se trata como vacío.
    let checklist = [];
    try { checklist = checklistJson ? JSON.parse(checklistJson) : []; } catch { checklist = []; }

    async function patchOrden(payload) {
      const res = await fetch(`/api/ordenes/${id}`, {
        method: "PATCH",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        const j = await res.json().catch(() => ({}));
        alert(typeof j.error === "string" ? j.error : "Error");
        return null;
      }
      return await res.json();
    }

    // ── Asignar / cambiar equipo (en cascada: sucursal → ubicación → equipo)
    (function () {
      const sucSel = $("sucSel");
      const ubSel = $("ubSel");
      const acSel = $("activoSelect");
      if (!sucSel || !ubSel || !acSel) return;

      function poblarUbicaciones(sucId, preselectUbId) {
        ubSel.innerHTML = "";
        if (!sucId) {
          ubSel.disabled = true;
          ubSel.appendChild(new Option("Selecciona la sucursal", ""));
          poblarActivos(null, null);
          return;
        }
        const ubs = (ubicacionesData || []).filter((u) => u.sucursalId === sucId);
        ubSel.disabled = ubs.length === 0;
        ubSel.appendChild(new Option(ubs.length === 0 ? "Sin ubicaciones" : "— Selecciona —", ""));
        ubs.forEach((u) => {
          const opt = new Option(`${u.nombre} (${u.tipo})`, String(u.id));
          if (u.id === preselectUbId) opt.selected = true;
          ubSel.appendChild(opt);
        });
        poblarActivos(preselectUbId ?? null, activoActualId);
      }

      function poblarActivos(ubId, preselectActivoId) {
        acSel.innerHTML = "";
        if (!ubId) {
          acSel.disabled = true;
          acSel.appendChild(new Option("Selecciona la ubicación", ""));
          return;
        }
        const eqs = (activosData || []).filter((a) => a.ubicacionId === ubId);
        acSel.disabled = eqs.length === 0;
        acSel.appendChild(new Option(eqs.length === 0 ? "Sin equipos en esta ubicación" : "— Sin equipo —", ""));
        eqs.forEach((a) => {
          const opt = new Option(`${a.codigo} · ${a.nombre}`, String(a.id));
          if (a.id === preselectActivoId) opt.selected = true;
          acSel.appendChild(opt);
        });
      }

      sucSel.addEventListener("change", () => {
        const sid = Number(sucSel.value) || null;
        poblarUbicaciones(sid, null);
      });
      ubSel.addEventListener("change", () => {
        const uid = Number(ubSel.value) || null;
        poblarActivos(uid, null);
      });

      $("editActivoBtn")?.addEventListener("click", () => {
        $("activoEditor")?.classList.remove("hidden");
        $("editActivoBtn").classList.add("hidden");
        // Pre-seleccionar el actual si lo hay
        if (sucursalActualId) {
          sucSel.value = String(sucursalActualId);
          poblarUbicaciones(sucursalActualId, ubicacionActualId);
        }
      });
      $("activoCancel")?.addEventListener("click", () => {
        $("activoEditor")?.classList.add("hidden");
        $("editActivoBtn").classList.remove("hidden");
      });
      $("activoSave")?.addEventListener("click", async () => {
        const newId = acSel.value ? Number(acSel.value) : null;
        const msg = $("activoMsg");
        msg.classList.add("hidden");
        const r = await patchOrden({ activoId: newId });
        if (r) location.reload();
      });
    })();

    // Eliminar OT (solo admin)
    $("deleteOtBtn")?.addEventListener("click", async () => {
      if (!confirm("¿Eliminar esta OT permanentemente?\n\nEsta acción borra la OT, sus comentarios y adjuntos. Si vino de un plan o actividad recurrente, el cron podrá generar otra en el siguiente ciclo. No se puede deshacer.")) return;
      const r = await fetch(`/api/ordenes/${id}`, { method: "DELETE" });
      if (r.ok) {
        location.href = `/ordenes?area=${encodeURIComponent(area || "")}`;
      } else {
        alert("Error al eliminar la OT");
      }
    });

    // Transiciones
    document.querySelectorAll("[data-transition]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const estado = btn.dataset.transition;
        // La causa raíz pendiente sale antes que cualquier cambio de estado.
        const causaAlDia = await guardarCausa();
        if (estado === "verificada") {
          if (!causaAlDia) { $("causaCard")?.scrollIntoView?.({ behavior: "smooth", block: "center" }); return; }
          if (!causaLista()) return;
          $("verifModal").classList.remove("hidden");
          $("verifModal").classList.add("flex");
          return;
        }
        if (estado === "cancelada" && !confirm("¿Cancelar esta orden?")) return;
        if (estado === "cerrada" && !confirm("¿Cerrar definitivamente la orden? Ya no se podrá modificar.")) return;
        // Submit notes and checklist with completion in one atomic request.
        let evidencia = {};
        if (estado === "completada") evidencia = evidenciaPendiente();
        let motivo;
        if (estado === "en_espera" || (estado === "en_proceso" && ["completada", "verificada", "cerrada"].includes(estadoActual))) {
          motivo = prompt(estado === "en_espera" ? "Motivo del bloqueo o espera:" : "Motivo de devolución o reapertura (mínimo 10 caracteres):");
          if (!motivo?.trim()) return;
        }
        const r = await patchOrden({ estado, ...evidencia, ...(motivo ? { motivo } : {}) });
        if (r) location.reload();
      });
    });

    // Verificacion modal
    $("verifCancel")?.addEventListener("click", () => {
      $("verifModal").classList.add("hidden");
      $("verifModal").classList.remove("flex");
    });
    $("verifConfirm")?.addEventListener("click", async () => {
      const notas = $("verifNotas").value.trim();
      if (notas.length < 10) { alert("Describe la evidencia revisada y el resultado (mínimo 10 caracteres)."); return; }
      // Un MOP enviado sin lectura ya trae su motivo: no se vuelve a pedir ni a
      // mandar. Solo se escribe cuando faltan lecturas y nadie lo registró.
      let sinLectura = null;
      const pedido = $("verifSinLecturaMotivo");
      if (pedido) {
        sinLectura = pedido.value.trim();
        if (sinLectura.length < 20) { alert("Explica por qué no se pudo medir y con qué evidencia se libera el sistema (mínimo 20 caracteres)."); pedido.focus(); return; }
      }
      const r = await patchOrden({ estado: "verificada", verificacionNotas: notas, ...(sinLectura ? { cierreSinLecturaMotivo: sinLectura } : {}) });
      if (r) location.reload();
    });

    $("guardarRevisor")?.addEventListener("click", async () => {
      const r = await patchOrden({ revisorId: Number($("revisorId").value) || null, revisorSuplenteId: Number($("revisorSuplenteId").value) || null });
      if (r) location.reload();
    });

    // Asignacion
    $("asignarBtn")?.addEventListener("click", async () => {
      const v = $("asignadoA").value;
      const motivoEl = $("motivoReasignacion");
      const motivo = motivoEl ? motivoEl.value.trim() : "";
      const payload = { asignadoA: v ? Number(v) : null };
      if (motivo) payload.motivoReasignacion = motivo;
      const r = await patchOrden(payload);
      if (r) location.reload();
    });

    // El técnico toma una orden abierta sin asignar.
    $("tomarOrdenBtn")?.addEventListener("click", async () => {
      const r = await patchOrden({ asignadoA: usuarioId });
      if (r) location.reload();
    });

    // Checklist con 3 estados (ok / na / desviacion / pendiente).
    // Normalizar items por si vienen del formato viejo {hecho:bool}.
    checklist = (Array.isArray(checklist) ? checklist : []).map((it) => {
      let estado = it.estado;
      if (!["pendiente","ok","na","desviacion"].includes(estado)) {
        estado = typeof it.hecho === "boolean" ? (it.hecho ? "ok" : "pendiente") : "pendiente";
      }
      // Preservar la metadata del procedimiento estándar (no perderla al guardar).
      return {
        texto: it.texto, estado, notas: it.notas ?? "",
        criterio: it.criterio ?? null,
        bloqueante: it.bloqueante === true || it.bloqueante === 1,
        minutos: it.minutos ?? null,
        materiales: it.materiales ?? null,
        valorMedido: it.valorMedido ?? "",
        // SOP con lectura obligatoria (Fase 47). Si se pierden aquí, el
        // servidor deja de exigir el valor medido: hay que conservarlos.
        requiereValor: it.requiereValor === true || it.requiereValor === 1,
        unidad: it.unidad ?? null,
        esperadoMin: it.esperadoMin ?? null,
        esperadoMax: it.esperadoMax ?? null,
        variableId: it.variableId ?? null,
        hora: it.hora ?? "",
        iniciales: it.iniciales ?? "",
      };
    });

    function actualizarColorFila(idx) {
      const it = checklist[idx];
      const row = document.querySelector(`.ck-row[data-idx="${idx}"]`);
      if (!row || !it) return;
      // Limpiar clases anteriores
      row.className = row.className
        .replace(/bg-(emerald|slate|amber|white)-(50|100|200|300)/g, "")
        .replace(/border-(emerald|slate|amber)-(200|300)/g, "");
      const colorMap = {
        ok: "bg-emerald-50 border border-emerald-200",
        na: "bg-slate-100 border border-slate-200",
        desviacion: "bg-amber-50 border border-amber-300",
        pendiente: "bg-white border border-slate-200",
      };
      row.classList.add(...colorMap[it.estado].split(" "));
    }

    function actualizarBotonesEstado(idx) {
      const it = checklist[idx];
      if (!it) return;
      document.querySelectorAll(`.ck-estado-btn[data-idx="${idx}"]`).forEach((btn) => {
        const e = btn.dataset.estado;
        const isActive = it.estado === e;
        const colors = {
          pendiente: isActive ? "bg-slate-700 text-white" : "bg-white text-slate-600 border border-slate-300 hover:bg-slate-50",
          ok: isActive ? "bg-brand-600 text-white" : "bg-white text-emerald-700 border border-emerald-300 hover:bg-emerald-50",
          na: isActive ? "bg-slate-500 text-white" : "bg-white text-slate-600 border border-slate-300 hover:bg-slate-50",
          desviacion: isActive ? "bg-white text-amber-800 border border-amber-500 " : "bg-white text-amber-700 border border-amber-300 hover:bg-amber-50",
        };
        btn.className = `ck-estado-btn text-xs px-2 py-1 rounded-md font-medium transition ${colors[e]}`;
      });
    }

    function actualizarNotaVisible(idx) {
      const it = checklist[idx];
      const wrap = document.querySelector(`.ck-nota-wrap[data-idx="${idx}"]`);
      if (!wrap || !it) return;
      wrap.classList.toggle("hidden", it.estado !== "desviacion");
    }

    let ckSaveTimer = null;
    function programarGuardadoChecklist() {
      const ind = $("ckAutosave");
      if (ind) { ind.textContent = "Guardando…"; ind.className = "text-amber-600"; }
      if (ckSaveTimer) clearTimeout(ckSaveTimer);
      ckSaveTimer = setTimeout(async () => {
        const r = await patchOrden({ checklistEjecucion: JSON.stringify(checklist) });
        if (ind) {
          ind.textContent = r ? "✓ Guardado" : "Sin guardar";
          ind.className = r ? "text-emerald-600" : "text-red-600";
          setTimeout(() => { ind.textContent = ""; }, 2000);
        }
      }, 1000);
    }

    document.querySelectorAll(".ck-estado-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = Number(btn.dataset.idx);
        const nuevoEstado = btn.dataset.estado;
        if (!checklist[idx]) return;
        checklist[idx].estado = nuevoEstado;
        actualizarColorFila(idx);
        actualizarBotonesEstado(idx);
        actualizarNotaVisible(idx);
        programarGuardadoChecklist();
      });
    });

    document.querySelectorAll(".ck-nota").forEach((ta) => {
      ta.addEventListener("input", () => {
        const idx = Number(ta.dataset.idx);
        if (!checklist[idx]) return;
        checklist[idx].notas = ta.value;
        programarGuardadoChecklist();
      });
    });

    document.querySelectorAll(".ck-valor").forEach((inp) => {
      inp.addEventListener("input", () => {
        const idx = Number(inp.dataset.idx);
        if (!checklist[idx]) return;
        checklist[idx].valorMedido = inp.value;
        programarGuardadoChecklist();
      });
    });

    // ── Lectura obligatoria del SOP: número, rango y constancia ───────────
    // Si el valor cae fuera del rango normal del SCP, lo marcamos en pantalla,
    // ponemos la línea en Desviación y dejamos la constancia escrita en sus
    // notas. NO abrimos el evento AOP desde aquí: eso lo hace el módulo de
    // condición anormal; aquí solo queda el dato listo.
    function evaluarLectura(idx) {
      const it = checklist[idx];
      if (!it) return { tiene: false, dentro: null };
      const crudo = it.valorMedido;
      const tiene = crudo !== null && crudo !== undefined && String(crudo).trim() !== "";
      const n = tiene ? Number(String(crudo).replace(",", ".")) : NaN;
      const num = Number.isFinite(n) ? n : null;
      const min = it.esperadoMin === null || it.esperadoMin === undefined ? null : Number(it.esperadoMin);
      const max = it.esperadoMax === null || it.esperadoMax === undefined ? null : Number(it.esperadoMax);
      let dentro = null;
      if (num !== null && (min !== null || max !== null)) {
        dentro = (min === null || num >= min) && (max === null || num <= max);
      }
      return { tiene, num, dentro, min, max };
    }

    function rangoTexto(idx) {
      const it = checklist[idx];
      const u = it.unidad ? ` ${it.unidad}` : "";
      const min = it.esperadoMin ?? null, max = it.esperadoMax ?? null;
      if (min !== null && max !== null) return `${min} a ${max}${u}`;
      if (min !== null) return `≥ ${min}${u}`;
      if (max !== null) return `≤ ${max}${u}`;
      return null;
    }

    function pintarLectura(idx) {
      const it = checklist[idx];
      const ev = evaluarLectura(idx);
      const caja = document.querySelector(`.ck-num[data-idx="${idx}"]`)?.closest("div.mt-2");
      const etiqueta = document.querySelector(`.ck-rango[data-idx="${idx}"]`);
      if (caja) {
        caja.className = "mt-2 rounded-lg p-2 " + (
          ev.dentro === false ? "bg-red-50 ring-1 ring-red-300" :
          ev.dentro === true ? "bg-emerald-50" :
          !ev.tiene ? "bg-amber-50" : "bg-slate-50"
        );
      }
      if (etiqueta) {
        etiqueta.innerHTML =
          !ev.tiene ? '<span class="text-amber-700">Sin lectura — bloquea el cierre</span>' :
          ev.dentro === true ? '<span class="text-emerald-700">✓ Dentro del rango</span>' :
          ev.dentro === false ? '<span class="text-red-700">FUERA DE RANGO — no libera el sistema</span>' :
          '<span class="text-slate-500">Registrado</span>';
      }
      // Constancia escrita en las notas de la línea. Se regenera en cada
      // tecleo, así que corregir un dedazo también limpia la constancia; el
      // texto que escribió el técnico se conserva siempre.
      const AUTO = /^Lectura fuera de rango:[^\n]*\n?/;
      const humanas = String(it.notas || "").replace(AUTO, "").trim();
      if (ev.dentro === false) {
        const u = it.unidad ? ` ${it.unidad}` : "";
        const rt = rangoTexto(idx);
        const constancia = `Lectura fuera de rango: ${it.valorMedido}${u}${rt ? ` (rango normal ${rt})` : ""}${it.hora ? ` a las ${it.hora}` : ""}.`;
        it.notas = humanas ? `${constancia}\n${humanas}` : constancia;
        if (it.estado !== "desviacion") {
          it.estado = "desviacion";
          actualizarColorFila(idx);
          actualizarBotonesEstado(idx);
        }
      } else if (it.notas !== humanas) {
        it.notas = humanas;
      }
      actualizarNotaVisible(idx);
      const ta = document.querySelector(`.ck-nota[data-idx="${idx}"]`);
      if (ta && ta.value !== it.notas) ta.value = it.notas;
    }

    function horaAhora() {
      return new Date().toLocaleTimeString("es", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "America/El_Salvador" });
    }

    document.querySelectorAll(".ck-num").forEach((inp) => {
      inp.addEventListener("input", () => {
        const idx = Number(inp.dataset.idx);
        if (!checklist[idx]) return;
        checklist[idx].valorMedido = inp.value;
        // La hora de la lectura se sella sola la primera vez: en el formato
        // impreso del MOP esa columna se llena durante la ejecución.
        if (inp.value !== "" && !String(checklist[idx].hora || "").trim()) {
          checklist[idx].hora = horaAhora();
          const h = document.querySelector(`.ck-hora[data-idx="${idx}"]`);
          if (h) h.value = checklist[idx].hora;
        }
        pintarLectura(idx);
        programarGuardadoChecklist();
      });
    });

    document.querySelectorAll(".ck-hora").forEach((inp) => {
      inp.addEventListener("input", () => {
        const idx = Number(inp.dataset.idx);
        if (!checklist[idx]) return;
        checklist[idx].hora = inp.value;
        programarGuardadoChecklist();
      });
    });

    document.querySelectorAll(".ck-iniciales").forEach((inp) => {
      inp.addEventListener("input", () => {
        const idx = Number(inp.dataset.idx);
        if (!checklist[idx]) return;
        checklist[idx].iniciales = inp.value;
        programarGuardadoChecklist();
      });
    });

    // ── Ejecución: auto-guardado con debounce + backup en localStorage ────
    const STORAGE_KEY = `ot-${id}-draft`;
    // La causa raíz no va aquí: la escribe la jefatura y se guarda aparte, para
    // que lo que guarda el técnico nunca la borre.
    const ejecFields = ["trabajosRealizados", "solucionAplicada"];
    const ejecIndicador = $("autosaveIndicador");

    function setIndicador(estado, texto) {
      if (!ejecIndicador) return;
      ejecIndicador.dataset.status = estado;
      ejecIndicador.textContent = texto;
      const colores = {
        idle: "text-slate-400",
        guardando: "text-amber-600",
        guardado: "text-emerald-600",
        error: "text-red-600",
        offline: "text-amber-700",
      };
      ejecIndicador.className = "text-xs " + (colores[estado] || colores.idle);
    }

    function leerEjecPayload() {
      // horasTrabajadas se calcula en el servidor automaticamente al cerrar.
      // No se envia desde el cliente. Solo viajan los campos que hay en pantalla
      // y se pueden escribir: un campo ausente no se manda vacío.
      const payload = {};
      for (const campo of ejecFields) {
        const el = $(campo);
        if (el && !el.disabled) payload[campo] = el.value.trim() || null;
      }
      return payload;
    }

    function guardarLocal(payload) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ payload, savedAt: Date.now() }));
      } catch {}
    }
    function limpiarLocal() {
      try { localStorage.removeItem(STORAGE_KEY); } catch {}
    }

    let debounceTimer = null;
    let inFlight = false;
    let pending = false;

    async function ejecutarGuardado() {
      if (inFlight) { pending = true; return; }
      inFlight = true;
      setIndicador("guardando", "Guardando…");
      const payload = leerEjecPayload();
      // Backup local antes de mandar al servidor
      guardarLocal(payload);
      try {
        const r = await patchOrden(payload);
        if (r) {
          limpiarLocal();
          setIndicador("guardado", "✓ Guardado");
          setTimeout(() => { if (ejecIndicador?.dataset.status === "guardado") setIndicador("idle", ""); }, 2000);
        } else {
          setIndicador("offline", "Sin conexión — guardado localmente");
        }
      } catch {
        setIndicador("offline", "Sin conexión — guardado localmente");
      } finally {
        inFlight = false;
        if (pending) { pending = false; ejecutarGuardado(); }
      }
    }

    function programarGuardado() {
      // Mostrar inmediatamente que hay cambios pendientes
      setIndicador("guardando", "Editando…");
      // Backup local instantáneo
      guardarLocal(leerEjecPayload());
      // Debounce 1.5s
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(ejecutarGuardado, 1500);
    }

    // Conectar listeners a cada campo de ejecución
    ejecFields.forEach((fieldId) => {
      const el = $(fieldId);
      if (!el || el.disabled) return;
      el.addEventListener("input", programarGuardado);
      el.addEventListener("change", programarGuardado);
    });

    // Botón "Guardar ahora" (forzar sin esperar el debounce)
    $("ejecSave")?.addEventListener("click", async () => {
      if (debounceTimer) { clearTimeout(debounceTimer); debounceTimer = null; }
      await ejecutarGuardado();
    });

    // Al cargar la página: si hay un draft local más reciente que el servidor,
    // ofrecer restaurarlo
    (function checkDraftLocal() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const { payload, savedAt } = JSON.parse(raw);
        if (!payload) return;
        // Comparar con valores actuales del DOM (que vienen del servidor). Solo
        // cuentan los campos que hoy se pueden escribir en pantalla.
        const campos = ejecFields.filter((c) => $(c) && !$(c).disabled && payload[c] !== undefined);
        if (!campos.length) return;
        const cambios = campos.filter((c) => (payload[c] ?? "") !== ($(c).value || "").trim());
        if (!cambios.length) { limpiarLocal(); return; }
        const fechaSave = new Date(savedAt).toLocaleString("es", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "America/El_Salvador" });
        const mensaje = `Tienes cambios sin guardar de ${fechaSave} en esta OT. ¿Restaurarlos? (Cancelar = descartar)`;
        if (confirm(mensaje)) {
          for (const c of cambios) if (payload[c] != null) $(c).value = payload[c];
          // Disparar guardado inmediato al servidor
          ejecutarGuardado();
        } else {
          limpiarLocal();
        }
      } catch {}
    })();

    // Avisar al usuario si intenta cerrar la pestaña con cambios pendientes
    window.addEventListener("beforeunload", (e) => {
      if (debounceTimer || inFlight || causaTimer) {
        e.preventDefault();
        e.returnValue = "";
      }
    });

    // Lo escrito y marcado que todavía no salió al servidor, para mandarlo
    // junto con el envío a verificación (también el envío sin lectura).
    function evidenciaPendiente() {
      if (ckSaveTimer) { clearTimeout(ckSaveTimer); ckSaveTimer = null; }
      if (debounceTimer) { clearTimeout(debounceTimer); debounceTimer = null; }
      return { ...leerEjecPayload(), checklistEjecucion: JSON.stringify(checklist ?? []) };
    }
    window.otEvidenciaPendiente = evidenciaPendiente;

    // ── Causa raíz: la escribe la jefatura, también con la orden enviada ──
    // Viaja sola, nunca junto con lo que escribe el técnico.
    const causaEl = $("causaRaiz");
    const causaEditable = !!causaEl && !causaEl.disabled;
    const CAUSA_KEY = `ot-${id}-causa`;
    let causaTimer = null;
    let causaGuardada = causaEl ? causaEl.value.trim() : "";

    function avisoCausa(texto, color) {
      const m = $("causaMsg");
      if (m) { m.textContent = texto; m.className = "text-xs " + color; }
    }

    async function guardarCausa() {
      if (causaTimer) { clearTimeout(causaTimer); causaTimer = null; }
      if (!causaEditable) return true;
      const valor = causaEl.value.trim();
      if (valor === causaGuardada) return true;
      avisoCausa("Guardando…", "text-amber-600");
      try {
        const res = await fetch(`/api/ordenes/${id}`, {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ causaRaiz: valor || null }),
        });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) {
          avisoCausa(typeof j.error === "string" ? `Sin guardar: ${j.error}` : "Sin guardar", "text-red-600");
          return false;
        }
        causaGuardada = valor;
        try { localStorage.removeItem(CAUSA_KEY); } catch {}
        avisoCausa("Guardada", "text-emerald-600");
        return true;
      } catch {
        avisoCausa("Sin conexión: queda guardada en este equipo", "text-amber-700");
        return false;
      }
    }

    // Verificar y cerrar exige la causa raíz cuando el tipo la pide.
    function causaLista() {
      if (!causaObligatoria || !causaEl) return true;
      if (causaEl.value.trim().length >= minCausa) return true;
      avisoCausa(`Falta la causa raíz: mínimo ${minCausa} caracteres.`, "text-red-600");
      $("causaCard")?.scrollIntoView?.({ behavior: "smooth", block: "center" });
      if (causaEditable) causaEl.focus();
      return false;
    }

    if (causaEditable) {
      causaEl.addEventListener("input", () => {
        try { localStorage.setItem(CAUSA_KEY, JSON.stringify({ valor: causaEl.value, savedAt: Date.now() })); } catch {}
        avisoCausa("Editando…", "text-amber-600");
        if (causaTimer) clearTimeout(causaTimer);
        causaTimer = setTimeout(guardarCausa, 1500);
      });
      $("causaSave")?.addEventListener("click", () => { guardarCausa(); });
      // Lo que quedó sin guardar (sin señal, pestaña cerrada) se ofrece al volver.
      try {
        const borrador = JSON.parse(localStorage.getItem(CAUSA_KEY) || "null");
        if (borrador && typeof borrador.valor === "string") {
          if (borrador.valor.trim() === causaGuardada) localStorage.removeItem(CAUSA_KEY);
          else {
            const cuando = new Date(borrador.savedAt).toLocaleString("es", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "America/El_Salvador" });
            if (confirm(`Tienes una causa raíz sin guardar del ${cuando}. ¿Recuperarla? (Cancelar = descartar)`)) {
              causaEl.value = borrador.valor;
              guardarCausa();
            } else localStorage.removeItem(CAUSA_KEY);
          }
        }
      } catch {}
    }

    // Lo que quedó escrito sin guardar sale al servidor aunque se cierre la
    // pestaña o se cambie de página; el respaldo local queda por si no llega.
    // Responde true si el servidor lo aceptó, false si lo rechazó, null sin señal.
    function enviarAlSalir(payload, alTerminar) {
      try {
        fetch(`/api/ordenes/${id}`, {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
          keepalive: true,
        }).then((res) => alTerminar(res.ok), () => alTerminar(null));
      } catch { alTerminar(null); }
    }
    function guardarAlSalir() {
      const payload = {};
      const conTexto = !!debounceTimer, conPasos = !!ckSaveTimer;
      if (conTexto) { clearTimeout(debounceTimer); debounceTimer = null; Object.assign(payload, leerEjecPayload()); }
      if (conPasos) { clearTimeout(ckSaveTimer); ckSaveTimer = null; payload.checklistEjecucion = JSON.stringify(checklist); }
      if (Object.keys(payload).length) enviarAlSalir(payload, (bien) => {
        if (conTexto) {
          if (bien) { limpiarLocal(); setIndicador("guardado", "✓ Guardado"); }
          else setIndicador(bien === false ? "error" : "offline", bien === false ? "Sin guardar" : "Sin conexión — guardado localmente");
        }
        const ind = $("ckAutosave");
        if (conPasos && ind) { ind.textContent = bien ? "✓ Guardado" : "Sin guardar"; ind.className = bien ? "text-emerald-600" : "text-red-600"; }
      });
      if (causaTimer) {
        clearTimeout(causaTimer); causaTimer = null;
        const valor = causaEl.value.trim();
        if (valor !== causaGuardada) enviarAlSalir({ causaRaiz: valor || null }, (bien) => {
          if (bien) {
            causaGuardada = valor;
            try { localStorage.removeItem(CAUSA_KEY); } catch {}
            avisoCausa("Guardada", "text-emerald-600");
          } else avisoCausa(bien === false ? "Sin guardar" : "Sin conexión: queda guardada en este equipo", bien === false ? "text-red-600" : "text-amber-700");
        });
      }
    }
    window.addEventListener("pagehide", guardarAlSalir);
    document.addEventListener("visibilitychange", () => { if (document.visibilityState === "hidden") guardarAlSalir(); });

    // Comentarios
    $("comForm")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const texto = $("comTexto").value.trim();
      if (!texto) return;
      const res = await fetch(`/api/ordenes/${id}/comentarios`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ texto }),
      });
      if (res.ok) location.reload();
    });

    // Repuestos: auto-rellenar precio cuando elige item
    const repItem = $("rep_item");
    const repPrecio = $("rep_precio");
    repItem?.addEventListener("change", () => {
      const opt = repItem.options[repItem.selectedIndex];
      const p = opt?.dataset?.precio;
      if (p && !repPrecio.value) repPrecio.value = p;
    });

    $("rep_save")?.addEventListener("click", async () => {
      const msg = $("rep_msg");
      msg.classList.add("hidden");
      const itemId = Number($("rep_item").value);
      const cantidad = Number($("rep_cant").value);
      const precio = $("rep_precio").value;
      if (!itemId || !cantidad || cantidad <= 0) {
        msg.textContent = "Completa item y cantidad.";
        msg.className = "text-xs text-red-600"; msg.classList.remove("hidden"); return;
      }
      const res = await fetch(`/api/ordenes/${id}/repuestos`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          itemId, cantidad,
          precioUnitario: precio ? Number(precio) : null,
          notas: $("rep_notas").value.trim() || null,
        }),
      });
      if (!res.ok) {
        const j = await res.json().catch(() => ({}));
        msg.textContent = typeof j.error === "string" ? j.error : "Error al registrar";
        msg.className = "text-xs text-red-600"; msg.classList.remove("hidden"); return;
      }
      location.reload();
    });

    document.querySelectorAll(".rep-del-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("¿Revertir este consumo y devolver al stock?")) return;
        const res = await fetch(`/api/ordenes/${id}/repuestos?repuesto_id=${btn.dataset.id}`, { method: "DELETE" });
        if (res.ok) location.reload();
      });
    });

    // Subida de adjuntos por categoría — auto-upload al seleccionar archivo
    async function subirAdjunto(form, file) {
      const err = $("upErr");
      err.classList.add("hidden");
      const btn = form.querySelector("button[type=submit]");
      if (btn) { btn.disabled = true; btn.textContent = "Subiendo…"; }
      try {
        const fd = new FormData();
        fd.append("file", file);
        fd.append("categoria", form.dataset.categoria);
        const res = await fetch(`/api/ordenes/${id}/adjuntos`, { method: "POST", body: fd });
        if (!res.ok) {
          const j = await res.json().catch(() => ({}));
          err.textContent = j.error || "Error al subir";
          err.classList.remove("hidden");
          if (btn) { btn.disabled = false; btn.textContent = "Subir / Tomar foto"; }
          return;
        }
        location.reload();
      } catch (e) {
        err.textContent = "Error de red al subir";
        err.classList.remove("hidden");
        if (btn) { btn.disabled = false; btn.textContent = "Subir / Tomar foto"; }
      }
    }

    document.querySelectorAll(".upForm").forEach((form) => {
      const fileInput = form.querySelector(".upFile");
      // Submit manual (botón) — opcional
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const file = fileInput.files[0];
        if (file) subirAdjunto(form, file);
      });
      // Auto-upload al seleccionar archivo (cámara o explorador)
      fileInput?.addEventListener("change", () => {
        const file = fileInput.files[0];
        if (file) subirAdjunto(form, file);
      });
    });

    // Eliminar adjuntos individuales
    document.querySelectorAll(".adj-del-btn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (!confirm("¿Eliminar esta foto/archivo? Esta acción no se puede deshacer.")) return;
        const adjId = btn.dataset.id;
        const r = await fetch(`/api/adjuntos/${adjId}`, { method: "DELETE" });
        if (r.ok) location.reload();
        else alert("Error al eliminar el archivo");
      });
    });
  </script>

  <!-- Firmas -->
  <script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({ id }) }}>
    const { id } = JSON.parse(decodeURIComponent(__encodedScriptVars));
    const $ = (s) => document.getElementById(s);
    const modal = $("firmaModal");
    const canvas = $("firmaCanvas");
    const ctx = canvas.getContext("2d");
    let drawing = false, currentRol = null;

    function clearCanvas() {
      ctx.fillStyle = "#fff";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.strokeStyle = "#1A1A1A";
      ctx.lineWidth = 2;
      ctx.lineCap = "round";
    }

    function getPos(e) {
      const r = canvas.getBoundingClientRect();
      const sx = canvas.width / r.width;
      const sy = canvas.height / r.height;
      const t = e.touches ? e.touches[0] : e;
      return { x: (t.clientX - r.left) * sx, y: (t.clientY - r.top) * sy };
    }

    canvas.addEventListener("pointerdown", (e) => { drawing = true; const p = getPos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); });
    canvas.addEventListener("pointermove", (e) => { if (!drawing) return; const p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); });
    canvas.addEventListener("pointerup", () => { drawing = false; });
    canvas.addEventListener("pointerleave", () => { drawing = false; });

    document.querySelectorAll(".firma-add-btn, .firma-clear-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        currentRol = btn.dataset.rol;
        const labels = { tecnico: "técnico", jefe: "jefe / supervisor", solicitante: "solicitante / usuario" };
        $("firmaTitulo").textContent = `Firmar como ${labels[currentRol]}`;
        $("firmaNombre").value = "";
        clearCanvas();
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      });
    });

    $("firmaCancel").addEventListener("click", () => { modal.classList.add("hidden"); modal.classList.remove("flex"); });
    $("firmaClear").addEventListener("click", clearCanvas);

    $("firmaSave").addEventListener("click", async () => {
      const err = $("firmaErr");
      err.classList.add("hidden");
      const nombre = $("firmaNombre").value.trim();
      if (!nombre) { err.textContent = "Nombre requerido"; err.classList.remove("hidden"); return; }
      const dataUrl = canvas.toDataURL("image/png");
      const res = await fetch(`/api/ordenes/${id}/firma`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ rol: currentRol, nombre, imagenDataUrl: dataUrl }),
      });
      if (!res.ok) { err.textContent = "Error al guardar firma"; err.classList.remove("hidden"); return; }
      location.reload();
    });
    clearCanvas();
  </script>

