  <!-- ══ MOP y EOP: prerrequisitos, liberaciones, horas y plan de reversa ══ -->
  <script define:vars={{ __encodedScriptVars: encodeInlineScriptVars({ otId: o.id, motivoPrevio: o.cierreSinLecturaMotivo ?? "" }) }}>
    const { otId, motivoPrevio } = JSON.parse(decodeURIComponent(__encodedScriptVars));
    const g = (x) => document.getElementById(x);

    function aviso(el, texto, ok) {
      if (!el) return;
      el.textContent = texto;
      el.className = "text-xs " + (ok ? "text-emerald-600" : "text-red-600");
      if (ok) setTimeout(() => { el.textContent = ""; }, 2500);
    }

    async function llamar(ruta, metodo, payload) {
      try {
        const res = await fetch(ruta, {
          method: metodo,
          headers: { "content-type": "application/json" },
          body: payload === undefined ? undefined : JSON.stringify(payload),
        });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) {
          const msg = typeof j.error === "string" ? j.error : "No se pudo guardar. Revisa los datos.";
          window.showToast?.(msg, "error");
          return { ok: false, error: msg, data: j };
        }
        return { ok: true, data: j };
      } catch (e) {
        window.showToast?.("Sin conexión: no se pudo guardar.", "error");
        return { ok: false, error: String(e) };
      }
    }

    // datetime-local ("YYYY-MM-DDTHH:mm", hora de El Salvador) → ISO con offset.
    // Fijamos -06:00 explícito: el servidor corre en UTC y sin el offset la hora
    // de alarma se guardaría seis horas adelante.
    function localAIso(v) {
      if (!v) return null;
      return `${v}:00-06:00`;
    }

    // ── Vincular a la orden el procedimiento que resolvió el sistema ────────
    g("rigeVincular")?.addEventListener("click", async () => {
      const btn = g("rigeVincular");
      const procId = Number(btn.dataset.proc);
      if (!procId) return;
      btn.disabled = true;
      const r = await llamar(`/api/ordenes/${otId}`, "PATCH", { procedimientoId: procId });
      btn.disabled = false;
      if (r.ok) {
        window.showToast?.("Procedimiento vinculado a la orden.", "success");
        location.reload();
      } else {
        aviso(g("rigeMsg"), "No se vinculó", false);
      }
    });

    // ── Clasificación: tipo (MOP/EOP), clase P1–P4, nivel de riesgo ─────────
    g("clasifSave")?.addEventListener("click", async () => {
      const btn = g("clasifSave");
      btn.disabled = true;
      const r = await llamar(`/api/ordenes/${otId}`, "PATCH", {
        tipo: g("clasifTipo").value,
        clasePrioridad: g("clasifClase").value || null,
        nivelRiesgo: g("clasifRiesgo").value || null,
      });
      btn.disabled = false;
      if (r.ok) {
        window.showToast?.("Clasificación guardada.", "success");
        location.reload();
      } else {
        aviso(g("clasifMsg"), "No se guardó", false);
      }
    });

    // ── EOP · los tres tiempos (editables hacia atrás) ──────────────────────
    g("eopSave")?.addEventListener("click", async () => {
      const btn = g("eopSave");
      btn.disabled = true;
      const r = await llamar(`/api/ordenes/${otId}`, "PATCH", {
        horaAlarma: localAIso(g("horaAlarma").value),
        horaLlegada: localAIso(g("horaLlegada").value),
        horaMitigacion: localAIso(g("horaMitigacion").value),
        horaRestablecimiento: localAIso(g("horaRestablecimiento").value),
      });
      btn.disabled = false;
      if (r.ok) {
        window.showToast?.("Horas registradas. El plazo de la causa raíz corre desde la alarma.", "success");
        location.reload();
      } else {
        aviso(g("eopMsg"), "No se guardó", false);
      }
    });

    // ── MOP · plan de reversa ───────────────────────────────────────────────
    g("reversaSave")?.addEventListener("click", async () => {
      const btn = g("reversaSave");
      btn.disabled = true;
      const r = await llamar(`/api/ordenes/${otId}`, "PATCH", {
        planReversa: g("planReversa").value.trim() || null,
        reversaEjecutada: g("reversaEjecutada").checked,
        reversaNotas: g("reversaNotas").value.trim() || null,
      });
      btn.disabled = false;
      if (r.ok) {
        aviso(g("reversaMsg"), "✓ Guardado", true);
        window.showToast?.("Plan de reversa guardado.", "success");
      } else {
        aviso(g("reversaMsg"), "No se guardó", false);
      }
    });

    // ── MOP · prerrequisitos ────────────────────────────────────────────────
    document.querySelectorAll(".prerreq-toggle").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const itemId = Number(btn.dataset.id);
        const cumplido = btn.dataset.cumplido === "1";
        const ref = document.querySelector(`.prerreq-ref[data-id="${itemId}"]`);
        if (cumplido && (!ref || ref.value.trim().length < 2)) {
          window.showToast?.("Escribe la referencia antes de marcarlo cumplido (n.º de permiso, clase de la ICRA, id del candado…).", "error");
          ref?.focus();
          return;
        }
        btn.disabled = true;
        const r = await llamar(`/api/ordenes/${otId}/prerrequisitos`, "PATCH", {
          itemId, cumplido, referencia: ref ? ref.value.trim() || null : null,
        });
        btn.disabled = false;
        if (r.ok) {
          window.showToast?.(cumplido ? "Prerrequisito cumplido." : "Prerrequisito de vuelta a pendiente.", "success");
          location.reload();
        }
      });
    });

    // Guarda la referencia sin marcar cumplido (se puede ir anotando)
    document.querySelectorAll(".prerreq-ref").forEach((inp) => {
      let t = null;
      inp.addEventListener("input", () => {
        if (t) clearTimeout(t);
        aviso(g("prerreqMsg"), "Guardando…", true);
        t = setTimeout(async () => {
          const r = await llamar(`/api/ordenes/${otId}/prerrequisitos`, "PATCH", {
            itemId: Number(inp.dataset.id),
            referencia: inp.value.trim() || null,
          });
          aviso(g("prerreqMsg"), r.ok ? "✓ Referencia guardada" : "Sin guardar", r.ok);
        }, 900);
      });
    });

    document.querySelectorAll(".prerreq-del").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const ok = await window.confirmAction?.("Eliminar prerrequisito", "¿Quitar este prerrequisito de la orden? Si ya estaba cumplido no se puede borrar.");
        if (ok === false) return;
        const r = await llamar(`/api/ordenes/${otId}/prerrequisitos`, "DELETE", { itemId: Number(btn.dataset.id) });
        if (r.ok) location.reload();
      });
    });

    g("prerreqAdd")?.addEventListener("click", async () => {
      const texto = g("prerreqTexto").value.trim();
      if (!texto) {
        window.showToast?.("Escribe qué se exige.", "error");
        g("prerreqTexto").focus();
        return;
      }
      const btn = g("prerreqAdd");
      btn.disabled = true;
      const r = await llamar(`/api/ordenes/${otId}/prerrequisitos`, "POST", {
        texto,
        tipo: g("prerreqTipo").value,
        obligatorio: g("prerreqObligatorio").checked,
        cargoResponsable: g("prerreqCargo").value.trim() || null,
      });
      btn.disabled = false;
      if (r.ok) location.reload();
    });

    // ── MOP · lecturas de liberación ────────────────────────────────────────
    document.querySelectorAll(".liber-save").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const itemId = Number(btn.dataset.id);
        const num = document.querySelector(`.liber-valor[data-id="${itemId}"]`);
        const txt = document.querySelector(`.liber-texto[data-id="${itemId}"]`);
        const crudo = num ? num.value.trim() : "";
        const texto = txt ? txt.value.trim() : "";
        if (crudo === "" && texto === "") {
          window.showToast?.("Escribe el valor medido (número) o anótalo en texto.", "error");
          num?.focus();
          return;
        }
        btn.disabled = true;
        const r = await llamar(`/api/ordenes/${otId}/liberaciones`, "PATCH", {
          itemId,
          valorMedido: crudo === "" ? null : Number(crudo),
          valorMedidoTexto: texto || null,
        });
        btn.disabled = false;
        if (r.ok) {
          const conforme = r.data?.liberacion?.conforme;
          if (conforme === false) {
            window.showToast?.("Lectura FUERA DE RANGO: el sistema no se libera. Abre un correctivo antes de devolverlo a servicio.", "error");
          } else {
            window.showToast?.("Lectura registrada.", "success");
          }
          location.reload();
        }
      });
    });

    document.querySelectorAll(".liber-del").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const ok = await window.confirmAction?.("Eliminar lectura", "¿Quitar esta lectura de liberación de la orden?");
        if (ok === false) return;
        const r = await llamar(`/api/ordenes/${otId}/liberaciones`, "DELETE", { itemId: Number(btn.dataset.id) });
        if (r.ok) location.reload();
      });
    });

    g("liberAdd")?.addEventListener("click", async () => {
      const etiqueta = g("liberEtiqueta").value.trim();
      if (!etiqueta) {
        window.showToast?.("Escribe qué se mide para liberar.", "error");
        g("liberEtiqueta").focus();
        return;
      }
      const min = g("liberMin").value.trim();
      const max = g("liberMax").value.trim();
      const btn = g("liberAdd");
      btn.disabled = true;
      const r = await llamar(`/api/ordenes/${otId}/liberaciones`, "POST", {
        etiqueta,
        unidad: g("liberUnidad").value.trim() || null,
        valorEsperado: g("liberEsperado").value.trim() || null,
        minAceptable: min === "" ? null : Number(min),
        maxAceptable: max === "" ? null : Number(max),
        obligatoria: g("liberObligatoria").checked,
      });
      btn.disabled = false;
      if (r.ok) location.reload();
    });

    // ── Escape: cerrar el MOP sin lectura, con motivo escrito ───────────────
    const sinLecturaBtn = g("sinLecturaBtn");
    const sinLecturaModal = g("sinLecturaModal");
    if (sinLecturaBtn && sinLecturaModal) {
      const cerrarModal = () => {
        sinLecturaModal.classList.add("hidden");
        sinLecturaModal.classList.remove("flex");
      };
      sinLecturaBtn.addEventListener("click", () => {
        // Si ya se envió una vez sin lectura y volvió, se parte del mismo motivo.
        g("sinLecturaMotivo").value = motivoPrevio;
        g("sinLecturaMsg").classList.add("hidden");
        sinLecturaModal.classList.remove("hidden");
        sinLecturaModal.classList.add("flex");
        g("sinLecturaMotivo").focus();
      });
      g("sinLecturaCancel")?.addEventListener("click", cerrarModal);
      sinLecturaModal.addEventListener("click", (e) => { if (e.target === sinLecturaModal) cerrarModal(); });
      g("sinLecturaConfirm")?.addEventListener("click", async () => {
        const motivo = g("sinLecturaMotivo").value.trim();
        const msg = g("sinLecturaMsg");
        if (motivo.length < 20) {
          msg.textContent = "El motivo tiene que explicar por qué no se pudo medir (mínimo 20 caracteres).";
          msg.className = "mt-2 text-sm text-red-600";
          msg.classList.remove("hidden");
          return;
        }
        const btn = g("sinLecturaConfirm");
        btn.disabled = true;
        // Lo escrito y marcado que aún no salió va en el mismo envío.
        const r = await llamar(`/api/ordenes/${otId}`, "PATCH", {
          ...(window.otEvidenciaPendiente?.() ?? {}),
          estado: "completada",
          cierreSinLecturaMotivo: motivo,
        });
        btn.disabled = false;
        if (r.ok) {
          window.showToast?.("Enviada a verificación sin lectura de liberación. Queda pendiente de verificación y registrada con tu nombre.", "success");
          location.reload();
          return;
        }
        msg.textContent = r.error || "No se pudo enviar a verificación.";
        msg.className = "mt-2 text-sm text-red-600";
        msg.classList.remove("hidden");
      });
    }
  </script>
</Layout>
