---
import ModuleHub from "@/components/ModuleHub.astro";
export const prerender=false;
const admin=Astro.locals.user!.rol==="admin";
if(!["admin","jefe"].includes(Astro.locals.user!.rol))return Astro.redirect("/");
const groups=[{label:"Personas y configuración",links:[
{href:"/usuarios",label:"Usuarios",description:"Cuentas, roles y permisos existentes.",show:admin},
{href:"/configuracion",label:"Empresa y configuración",description:"Identidad, correo y preferencias.",show:admin},
{href:"/raci",label:"Responsabilidades",description:"Responsables de los procesos y actividades."},
{href:"/ubicaciones",label:"Ubicaciones",description:"Sucursales, edificios y áreas físicas.",show:admin},
]},{label:"Procedimientos",links:[
{href:"/procedimientos",label:"Procedimientos",description:"Documentos y protocolos de mantenimiento."},
{href:"/contingencia",label:"Contingencia y escalamiento",description:"Continuidad operativa y atención de incidentes."},
]}];
---
<ModuleHub title="Administración" description="Personas, responsabilidades y configuración del sistema." groups={groups}/>
