---
// Panel de cumplimiento del equipo biomédico (JCI FMS.07/FMS.08). Cada indicador usa
// la regla de su dueño (biomedico.ts) por medio de cumplimiento-reglas.ts: la
// pantalla, el CSV (/api/cumplimiento/exportar) y el resumen diario cuentan igual.
// Lo ven admin, jefe y visualizador (la cuenta del auditor), solo lectura.
import Layout from "@/layouts/Layout.astro";
import DocCabecera from "@/components/DocCabecera.astro";
import DocFolio from "@/components/DocFolio.astro";
import { getDb } from "@/lib/db";
import { SUBCAT_KEYS, subcatLabel, subcatIcono } from "@/lib/rubros";
import { fmtFechaSolo } from "@/lib/datetime";
import { fechaCorta, hoySV } from "@/lib/biomedico";
import { cargarDatosCumplimiento } from "@/lib/cumplimiento-bio";
import { armarCumplimiento, esBiomedicoVigente, type ClaveIndicador, type Hallazgo } from "@/lib/cumplimiento-reglas";
// Tablero de la biblioteca de procedimientos modelo GO-GUI-011-2026 (cap. 08).
import { avanceBiblioteca, META_BIBLIOTECA } from "@/lib/metricas";
export const prerender = false;

const user = Astro.locals.user!;
if (user.rol !== "admin" && user.rol !== "jefe" && user.rol !== "visualizador") return Astro.redirect("/");
// Clasificar es de admin y jefe (/activos/clasificar redirige a los demás): el
// visualizador (la cuenta del auditor) no ve ese botón.
const puedeClasificar = user.rol === "admin" || user.rol === "jefe";
const db = getDb(Astro);

const hoy = hoySV();
const datos = await cargarDatosCumplimiento(db, hoy);
const { indicadores, hallazgos } = armarCumplimiento(datos);
const indicador = (clave: ClaveIndicador) => indicadores.find((i) => i.clave === clave)!;
const hallazgosDe = new Map<ClaveIndicador, Hallazgo[]>();
for (const h of hallazgos) hallazgosDe.set(h.indicador, [...(hallazgosDe.get(h.indicador) ?? []), h]);

// ── Equipos biomédicos vigentes (universo del panel) ─────────────────────────
const bio = datos.equipos.filter(esBiomedicoVigente);
const planesPorActivo = new Map<number, string[]>();
for (const p of datos.planes) planesPorActivo.set(p.activoId, [...(planesPorActivo.get(p.activoId) ?? []), p.proximaFecha]);
const fechasPlan = (id: number) => planesPorActivo.get(id) ?? [];

// ── Métricas de cobertura ────────────────────────────────────────────────────
const conPlan = bio.filter((e) => fechasPlan(e.id).length > 0);
const sinPlan = bio.filter((e) => fechasPlan(e.id).length === 0);
const conVencido = bio.filter((e) => fechasPlan(e.id).some((f) => f <= hoy));
const sinCriticidad = bio.filter((e) => !e.criticidadOperacional);
const sinSubcat = bio.filter((e) => !e.subcategoria);
const sinClase = bio.filter((e) => !String(e.claseRiesgo ?? "").trim());
const calib = indicador("calibracion");
const alertasAbiertas = datos.alertas.filter((a) => a.estado !== "cerrada").length;
const alertasSinAnalisis = datos.alertas.filter((a) => a.aplicabilidad === "pendiente").length;

const pct = (n: number, total: number) => (total > 0 ? Math.round((n / total) * 100) : 0);
const cobertura = bio.length > 0 ? pct(conPlan.length, bio.length) : null;
const colorPct = (p: number) => (p >= 95 ? "text-emerald-600" : p >= 80 ? "text-amber-600" : "text-red-600");
const barPct = (p: number) => (p >= 95 ? "bg-emerald-500" : p >= 80 ? "bg-amber-500" : "bg-red-500");

// ── Segmentación por subcategoría ────────────────────────────────────────────
const porSubcat = SUBCAT_KEYS.map((k) => {
  const eq_ = bio.filter((e) => e.subcategoria === k);
  return {
    subcat: k,
    total: eq_.length,
    conPlan: eq_.filter((e) => fechasPlan(e.id).length > 0).length,
    vencidos: eq_.filter((e) => fechasPlan(e.id).some((f) => f <= hoy)).length,
  };
}).filter((r) => r.total > 0);
const sinSegmentar = sinSubcat;

// ── Segmentación por sede ────────────────────────────────────────────────────
const porSede = new Map<string, { total: number; conPlan: number; vencidos: number }>();
for (const e of bio) {
  const sede = e.sede ?? "Sin sede";
  const s = porSede.get(sede) ?? { total: 0, conPlan: 0, vencidos: 0 };
  s.total++;
  const fechas = fechasPlan(e.id);
  if (fechas.length > 0) s.conPlan++;
  if (fechas.some((f) => f <= hoy)) s.vencidos++;
  porSede.set(sede, s);
}
const sedes = [...porSede.entries()].sort((a, b) => a[0].localeCompare(b[0], "es"));

const fechaGeneracion = fmtFechaSolo(hoy);

// Criticidad alta sin plan = hallazgo grave
const claseASinPlan = sinPlan.filter((e) => e.criticidadOperacional === "alta");

// ── Biblioteca de procedimientos modelo (GO-GUI-011-2026, capítulo 08) ──────
// Avance real de los 25 documentos y de la ruta de validación de cuatro
// semanas: SCP en la 1; SOP y AOP en la 2; EOP en la 3 (con simulacro de
// mesa); MOP en la 4. Regla 8.1: un campo en azul sin valor es trabajo
// pendiente, así que un documento con celdas vacías no está aprobado.
const biblio = await avanceBiblioteca(db);
const bt = biblio.totales;
---

<Layout title="Cumplimiento JCI">
  <div id="cumplimiento">
  <DocCabecera soloImpresion titulo="Cumplimiento del equipo biomédico" subtitulo="JCI FMS.07 y FMS.08: inventario, mantenimiento, metrología, expediente, regulación y seguridad" fecha={hoy} />
  <div class="no-print flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">✓ Cumplimiento — Equipo biomédico</h1>
      <p class="mt-1 text-sm text-slate-500">
        Programa de gestión de equipo médico (JCI FMS.07 y FMS.08): cobertura del inventario, mantenimiento, calibración, expediente, regulación y seguridad.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      {puedeClasificar && <a href="/activos/clasificar" class="btn-secondary">Clasificar</a>}
      <a href="/alertas" class="btn-secondary">Alertas</a>
      <a href="/calibraciones?criticos=1" class="btn-secondary">Equipos críticos: calibración</a>
      <a href="/api/cumplimiento/exportar" class="btn-secondary">Descargar CSV</a>
      <label class="inline-flex items-center gap-1.5 text-sm text-slate-600">
        <input id="conDetalle" type="checkbox" checked /> Imprimir con el detalle
      </label>
      <button onclick="window.print()" class="btn-primary" type="button">Imprimir evidencia</button>
    </div>
  </div>

  <!-- KPIs principales -->
  <div class="mt-5 grid grid-cols-2 gap-4 lg:grid-cols-5">
    <div class="card p-4">
      <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">Inventario biomédico</div>
      <div class="mt-1.5 text-3xl font-bold text-slate-800">{bio.length}</div>
      <div class="mt-0.5 text-[11px] text-slate-400">{bio.length === 0 ? "Todavía no hay equipos biomédicos cargados." : "equipos vigentes"}</div>
    </div>
    <div class="card p-4">
      <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">Cobertura preventiva</div>
      <div class={`mt-1.5 text-3xl font-bold ${cobertura === null ? "text-slate-400" : colorPct(cobertura)}`}>{cobertura === null ? "—" : `${cobertura}%`}</div>
      <div class="mt-1.5 h-1.5 rounded-full bg-slate-100 overflow-hidden">
        <div class={`h-full rounded-full ${barPct(cobertura ?? 0)}`} style={`width:${cobertura ?? 0}%`}></div>
      </div>
      <div class="mt-1 text-[11px] text-slate-400">{conPlan.length} con plan · {sinPlan.length} sin plan</div>
    </div>
    <div class="card p-4">
      <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">Preventivos vencidos</div>
      <div class={`mt-1.5 text-3xl font-bold ${conVencido.length === 0 ? "text-emerald-600" : "text-red-600"}`}>{conVencido.length}</div>
      <div class="mt-0.5 text-[11px] text-slate-400">equipos con rutina atrasada</div>
    </div>
    <div class="card p-4">
      <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">Calibración</div>
      <div class={`mt-1.5 text-3xl font-bold ${calib.sinDatos ? "text-slate-400" : calib.fallas === 0 ? "text-emerald-600" : "text-red-600"}`}>
        {calib.sinDatos ? "—" : calib.fallas}
      </div>
      <div class="mt-0.5 text-[11px] text-slate-400">
        {calib.sinDatos ? "Sin datos todavía" : `pendientes de ${calib.universo} · ${calib.avisos} por vencer (${calib.pct === null ? "—" : `${calib.pct}% al día`})`}
      </div>
    </div>
    <div class="card p-4">
      <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">Alertas abiertas</div>
      <div class={`mt-1.5 text-3xl font-bold ${alertasAbiertas === 0 ? "text-emerald-600" : "text-amber-600"}`}>{alertasAbiertas}</div>
      <div class="mt-0.5 text-[11px] text-slate-400">{alertasAbiertas} abiertas · {alertasSinAnalisis} sin análisis</div>
    </div>
  </div>

  {claseASinPlan.length > 0 && (
    <div class="card mt-4 border-l-4 border-red-500 p-4">
      <h2 class="font-semibold text-red-700">{claseASinPlan.length} equipo(s) de criticidad alta SIN plan preventivo</h2>
      <p class="mt-1 text-xs text-slate-600">Hallazgo prioritario: la falla de estos equipos compromete la vida del paciente y no tienen rutina programada.</p>
      <div class="mt-2 flex flex-wrap gap-1.5 text-xs">
        {claseASinPlan.map((e) => (
          <a href={`/activos/${e.id}`} class="rounded-md bg-red-50 px-2 py-1 text-red-700 hover:bg-red-100">
            <span class="font-mono text-[10px]">{e.codigo}</span> {e.nombre}
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Clasificación pendiente -->
  {(sinCriticidad.length > 0 || sinSubcat.length > 0 || sinClase.length > 0) && (
    <div class="card mt-4 border-l-4 border-amber-400 p-4">
      <h2 class="font-semibold text-amber-800">Clasificación pendiente</h2>
      <p class="mt-1 text-xs text-slate-600">
        {sinCriticidad.length} sin criticidad · {sinSubcat.length} sin subcategoría clínica · {sinClase.length} sin clase de riesgo
        {puedeClasificar && <> — <a href="/activos/clasificar" class="text-brand-600 hover:underline font-medium no-print">completar en la herramienta de clasificación →</a></>}
      </p>
    </div>
  )}

  <!-- ═══ Expediente, regulación y seguridad: una tarjeta por indicador ═══ -->
  <section class="mt-6">
    <h2 class="text-sm font-semibold text-slate-800">Expediente, regulación y seguridad</h2>
    <p class="text-xs text-slate-500">Rojo: hallazgos que fallan el requisito. Ámbar: vencen pronto. Cada tarjeta lleva a su detalle.</p>
    <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {indicadores.map((i) => (
        <div class="card p-4">
          <div class="text-xs font-semibold uppercase tracking-wide text-slate-500">{i.titulo}</div>
          {i.sinDatos ? (
            <>
              <div class="mt-1.5 text-2xl font-bold text-slate-400">—</div>
              <div class="mt-0.5 text-[11px] text-slate-400">Sin datos todavía</div>
            </>
          ) : (
            <>
              <div class={`mt-1.5 text-2xl font-bold ${i.fallas > 0 ? "text-red-600" : "text-emerald-600"}`}>{i.fallas}</div>
              <div class="mt-0.5 text-[11px] text-slate-500">
                {i.universo === 0 ? "Sin registros que medir" : `${i.fallas === 1 ? "hallazgo" : "hallazgos"} de ${i.universo}`}
                {i.pct !== null && <span> · {i.pct}% cumple</span>}
                {i.avisos > 0 && <span class="text-amber-700"> · {i.avisos} por vencer</span>}
              </div>
            </>
          )}
          <p class="mt-1.5 text-[11px] leading-snug text-slate-400">{i.descripcion}</p>
          <div class="no-print mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs">
            <a href={`#det-${i.clave}`} class="font-medium text-brand-700 hover:underline">Ver detalle</a>
            <a href={i.enlace} class="text-slate-500 hover:underline">{i.enlaceTexto} →</a>
            {i.extras.map((x) => <a href={x.enlace} class="text-slate-500 hover:underline">{x.texto} →</a>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
    <!-- Por subcategoría -->
    <div class="card overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-100 font-semibold text-slate-800 text-sm">Cobertura por subcategoría clínica</div>
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-500 uppercase">
          <tr>
            <th class="px-4 py-2">Subcategoría</th>
            <th class="px-2 py-2 text-center">Equipos</th>
            <th class="px-2 py-2 text-center">Con plan</th>
            <th class="px-2 py-2 text-center">Vencidos</th>
            <th class="px-4 py-2 text-right">Cobertura</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {porSubcat.length === 0 && (
            <tr><td colspan="5" class="px-4 py-5 text-center text-slate-400">Sin equipos segmentados aún — usa Clasificar.</td></tr>
          )}
          {porSubcat.map((r) => {
            const p = pct(r.conPlan, r.total);
            return (
              <tr>
                <td class="px-4 py-2 font-medium text-slate-700">{subcatIcono(r.subcat)} {subcatLabel(r.subcat)}</td>
                <td class="px-2 py-2 text-center">{r.total}</td>
                <td class="px-2 py-2 text-center">{r.conPlan}</td>
                <td class={`px-2 py-2 text-center ${r.vencidos > 0 ? "text-red-600 font-semibold" : "text-slate-400"}`}>{r.vencidos || "—"}</td>
                <td class={`px-4 py-2 text-right font-bold ${colorPct(p)}`}>{p}%</td>
              </tr>
            );
          })}
          {sinSegmentar.length > 0 && (
            <tr class="bg-amber-50/50">
              <td class="px-4 py-2 text-amber-800">Sin segmentar</td>
              <td class="px-2 py-2 text-center">{sinSegmentar.length}</td>
              <td colspan="3" class="px-4 py-2 text-right text-[11px] text-amber-700">pendiente de clasificación</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <!-- Por sede -->
    <div class="card overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-100 font-semibold text-slate-800 text-sm">Cobertura por sede</div>
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-500 uppercase">
          <tr>
            <th class="px-4 py-2">Sede</th>
            <th class="px-2 py-2 text-center">Equipos</th>
            <th class="px-2 py-2 text-center">Con plan</th>
            <th class="px-2 py-2 text-center">Vencidos</th>
            <th class="px-4 py-2 text-right">Cobertura</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {sedes.length === 0 && (
            <tr><td colspan="5" class="px-4 py-5 text-center text-slate-400">Todavía no hay equipos biomédicos cargados.</td></tr>
          )}
          {sedes.map(([sede, e]) => {
            const p = pct(e.conPlan, e.total);
            return (
              <tr>
                <td class="px-4 py-2 font-medium text-slate-700">{sede}</td>
                <td class="px-2 py-2 text-center">{e.total}</td>
                <td class="px-2 py-2 text-center">{e.conPlan}</td>
                <td class={`px-2 py-2 text-center ${e.vencidos > 0 ? "text-red-600 font-semibold" : "text-slate-400"}`}>{e.vencidos || "—"}</td>
                <td class={`px-4 py-2 text-right font-bold ${colorPct(p)}`}>{p}%</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <!-- ═══ Biblioteca de procedimientos modelo · GO-GUI-011-2026 cap. 08 ═══ -->
  <section class="card mt-6 overflow-hidden">
    <div class="border-b border-slate-100 px-5 py-3">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-sm font-semibold text-slate-800">Biblioteca de procedimientos (GO-GUI-011-2026)</h2>
          <p class="mt-0.5 text-xs text-slate-500">
            Avance real de los {META_BIBLIOTECA} documentos modelo y de la ruta de validación de cuatro semanas:
            SCP en la 1 · SOP y AOP en la 2 · EOP en la 3 (con simulacro de mesa) · MOP en la 4.
            Regla 8.1: un documento con un campo en azul vacío no está aprobado.
          </p>
        </div>
        <div class="shrink-0 text-right">
          <div class={`text-3xl font-bold ${colorPct(bt.pctVigente)}`}>{bt.vigentes}<span class="text-lg text-slate-300">/{META_BIBLIOTECA}</span></div>
          <div class="text-[11px] text-slate-400">vigentes</div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4 p-5 lg:grid-cols-4">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">Documentos cargados</div>
        <div class="mt-1.5 text-2xl font-bold text-slate-800">{bt.existen}<span class="text-sm text-slate-300">/{META_BIBLIOTECA}</span></div>
        <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-slate-100">
          <div class={`h-full rounded-full ${barPct(bt.pctCarga)}`} style={`width:${bt.pctCarga}%`}></div>
        </div>
        <div class="mt-1 text-[11px] text-slate-400">{bt.pctCarga}% de la biblioteca en el sistema</div>
        {bt.faltantes.length > 0 && (
          <div class="mt-1 font-mono text-[10px] text-slate-400">
            faltan {bt.faltantes.length}: {bt.faltantes.slice(0, 6).join(", ")}{bt.faltantes.length > 6 ? "…" : ""}
          </div>
        )}
      </div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">Vigentes</div>
        <div class={`mt-1.5 text-2xl font-bold ${colorPct(bt.pctVigente)}`}>{bt.vigentes}</div>
        <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-slate-100">
          <div class={`h-full rounded-full ${barPct(bt.pctVigente)}`} style={`width:${bt.pctVigente}%`}></div>
        </div>
        <div class="mt-1 text-[11px] text-slate-400">{bt.enValidacion} en validación · {bt.borradores} borrador</div>
      </div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">Campos en azul pendientes</div>
        <div class={`mt-1.5 text-2xl font-bold ${bt.camposPendientes === 0 ? "text-emerald-600" : "text-amber-600"}`}>{bt.camposPendientes}</div>
        <div class="mt-0.5 text-[11px] text-slate-400">en {bt.docsConCamposPendientes} documento(s) — celdas que decide Avante</div>
      </div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">Validaciones pendientes</div>
        <div class={`mt-1.5 text-2xl font-bold ${bt.validacionesPendientes === 0 ? "text-emerald-600" : "text-red-600"}`}>{bt.validacionesPendientes}</div>
        <div class="mt-0.5 text-[11px] text-slate-400">
          de {bt.validacionesTotal} programadas{bt.validacionesObservadas > 0 ? ` · ${bt.validacionesObservadas} observada(s)` : ""}
        </div>
      </div>
    </div>

    {bt.existen === 0 ? (
      <p class="border-t border-slate-100 px-5 py-5 text-center text-xs text-slate-400">
        Todavía no hay documentos cargados. La biblioteca entrega {META_BIBLIOTECA}: cinco SCP, cinco SOP, cinco MOP, cinco EOP y cinco AOP.
      </p>
    ) : (
      <>
        <!-- Ruta de validación de cuatro semanas -->
        <div class="grid grid-cols-2 gap-3 border-t border-slate-100 px-5 py-4 lg:grid-cols-4">
          {biblio.porSemana.map((w) => (
            <div class="rounded-md border border-slate-200 p-3">
              <div class="text-[11px] font-semibold text-slate-700" title={w.detalle}>{w.label}</div>
              <div class="mt-1 text-lg font-bold text-slate-800">{w.vigentes}<span class="text-xs text-slate-300">/{w.meta}</span></div>
              <div class="mt-1 h-1 overflow-hidden rounded-full bg-slate-100">
                <div class={`h-full rounded-full ${barPct(pct(w.vigentes, w.meta))}`} style={`width:${pct(w.vigentes, w.meta)}%`}></div>
              </div>
              <div class="mt-1 text-[10px] text-slate-400">
                {w.existen} cargado(s) · {w.camposPendientes} campo(s) azul · {w.validacionesPendientes} validación(es) pend.
              </div>
            </div>
          ))}
        </div>

        <!-- Avance por tipo de documento -->
        <div class="overflow-x-auto border-t border-slate-100">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 uppercase text-slate-500">
              <tr>
                <th class="px-4 py-2">Tipo</th>
                <th class="px-2 py-2 text-center">Semana</th>
                <th class="px-2 py-2 text-center">Cargados</th>
                <th class="px-2 py-2 text-center">Vigentes</th>
                <th class="px-2 py-2 text-center">En validación</th>
                <th class="px-2 py-2 text-center">Borrador</th>
                <th class="px-2 py-2 text-center">Campos azul pend.</th>
                <th class="px-2 py-2 text-center">Validaciones pend.</th>
                <th class="px-4 py-2 text-right">Vigente</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {biblio.porTipo.map((t) => (
                <tr>
                  <td class="px-4 py-2">
                    <span class={`badge font-mono text-[10px] ${t.color}`}>{t.label}</span>
                    <span class="ml-1 font-medium text-slate-700">{t.icono} {t.nombre}</span>
                    {t.faltantes.length > 0 && (
                      <div class="mt-0.5 font-mono text-[10px] text-slate-400" title="Códigos del volumen que aún no existen">
                        falta: {t.faltantes.join(", ")}
                      </div>
                    )}
                  </td>
                  <td class="px-2 py-2 text-center text-slate-500">{t.semana}</td>
                  <td class="px-2 py-2 text-center text-slate-700">{t.existen}<span class="text-slate-300">/{t.meta}</span></td>
                  <td class="px-2 py-2 text-center font-semibold text-emerald-700">{t.vigentes || "—"}</td>
                  <td class="px-2 py-2 text-center text-amber-700">{t.enValidacion || "—"}</td>
                  <td class="px-2 py-2 text-center text-slate-500">{t.borradores || "—"}</td>
                  <td class={`px-2 py-2 text-center ${t.camposPendientes > 0 ? "font-semibold text-amber-600" : "text-slate-400"}`}>
                    {t.camposPendientes || "—"}
                  </td>
                  <td class={`px-2 py-2 text-center ${t.validacionesPendientes > 0 ? "font-semibold text-red-600" : "text-slate-400"}`}>
                    {t.validacionesPendientes || "—"}
                  </td>
                  <td class={`px-4 py-2 text-right font-bold ${colorPct(t.pctVigente)}`}>{t.pctVigente}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Documentos con trabajo pendiente -->
        {biblio.pendientes.length > 0 && (
          <div class="border-t border-slate-100 px-5 py-4">
            <h3 class="text-xs font-semibold text-slate-700">
              Documentos con trabajo pendiente ({biblio.pendientes.length})
            </h3>
            <ul class="mt-2 max-h-72 space-y-1 overflow-y-auto text-xs">
              {biblio.pendientes.map((d) => (
                <li>
                  <a href={`/procedimientos/${d.id}`} class="flex flex-wrap items-center justify-between gap-2 rounded-md px-2 py-1.5 hover:bg-slate-50">
                    <span class="min-w-0">
                      <span class="font-mono text-[10px] text-slate-400">{d.codigoCorto}</span>
                      <span class="ml-1 font-medium text-slate-700">{d.titulo}</span>
                      <span class="ml-1 text-[10px] text-slate-400">· {d.sistemaLabel} · v{d.version} · sem. {d.semana}</span>
                      <span class={`badge ml-1 ${d.estadoColor}`}>{d.estadoLabel}</span>
                    </span>
                    <span class="flex shrink-0 flex-wrap items-center gap-1.5">
                      {d.camposPendientes > 0 && (
                        <span class="badge bg-amber-100 text-amber-700">{d.camposPendientes} campo(s) azul</span>
                      )}
                      {d.validacionesPendientes > 0 && (
                        <span class="badge bg-red-100 text-red-700">{d.validacionesPendientes} validación(es)</span>
                      )}
                      {d.validacionesObservadas > 0 && (
                        <span class="badge bg-orange-100 text-orange-700">{d.validacionesObservadas} observada(s)</span>
                      )}
                      {d.proximaValidacion && (
                        <span class="text-[10px] text-slate-400">programada {fechaCorta(d.proximaValidacion)}</span>
                      )}
                      <span class={`font-mono text-[10px] font-bold ${colorPct(d.pct)}`}>{d.pct}%</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </>
    )}
  </section>

  <!-- ═══ Detalle por indicador (se imprime si la casilla está marcada) ═══ -->
  <section class="det-bloque mt-6">
    <h2 class="text-sm font-semibold text-slate-800">Detalle por indicador</h2>
    <p class="text-xs text-slate-500">Cada fila lleva a la ficha o al registro donde se corrige. El mismo detalle sale en «Descargar CSV».</p>
    {indicadores.map((i) => {
      const filas = hallazgosDe.get(i.clave) ?? [];
      return (
        <div class="card mt-3 p-4">
          <h2 id={`det-${i.clave}`} class="scroll-mt-20 font-semibold text-slate-800 text-sm">{i.titulo} ({filas.length})</h2>
          {i.sinDatos ? (
            <p class="mt-2 text-sm text-slate-400">Sin datos todavía.</p>
          ) : filas.length === 0 ? (
            <p class="mt-2 text-sm text-emerald-700">✓ Sin pendientes.</p>
          ) : (
            <ul class="det-lista mt-2 max-h-80 space-y-1 overflow-y-auto text-xs">
              {filas.map((h) => (
                <li>
                  <a href={h.enlace} class="flex flex-wrap items-center justify-between gap-2 rounded-md px-2 py-1.5 hover:bg-slate-50">
                    <span class="min-w-0">
                      <span class="font-mono text-[10px] text-slate-400">{h.codigo}</span>
                      <span class="ml-1 font-medium text-slate-700">{h.nombre}</span>
                      {h.sede && <span class="ml-1 text-[10px] text-slate-400">· {h.sede}{h.ubicacion ? ` · ${h.ubicacion}` : ""}</span>}
                    </span>
                    <span class={`shrink-0 font-medium ${h.nivel === "falla" ? "text-red-600" : "text-amber-700"}`}>{h.detalle}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      );
    })}
  </section>

  <div class="mt-4 text-[10px] text-slate-400">
    Panel generado el {fechaGeneracion} · Umbral de referencia: ≥95% verde, 80–94% ámbar, &lt;80% rojo (meta institucional: ≥95% en criticidad alta) ·
    La vigencia de calibración sale de la última calibración registrada; es la misma regla del tablero Calibraciones ·
    Los equipos dados de baja no cuentan, salvo en «Bajas sin acta».
  </div>

  <DocFolio soloImpresion codigo="Cumplimiento FMS.07" />
  </div>

  <style is:global>
    /* globals.css ya oculta la barra superior y lo «no-print»: no se oculta `header`,
       porque DocCabecera es un <header>. Las listas salen completas en papel. */
    @media print {
      .det-lista, #cumplimiento ul { max-height: none !important; overflow: visible !important; }
      .sin-detalle .det-bloque { display: none !important; }
    }
  </style>

  <script>
    const contenedor = document.getElementById("cumplimiento");
    document.getElementById("conDetalle")?.addEventListener("change", (e) => {
      contenedor?.classList.toggle("sin-detalle", !(e.currentTarget as HTMLInputElement).checked);
    });
  </script>
</Layout>
