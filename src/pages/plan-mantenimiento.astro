---
import Layout from "@/layouts/Layout.astro";
import { getDb } from "@/lib/db";
import { planesMantenimiento, activos, usuarios, sucursales, ubicaciones, actividades, actividadCategorias } from "@/lib/schema";
import { eq, asc, and } from "drizzle-orm";
import { fmtFechaSoloCompacta, fmtFechaSolo } from "@/lib/datetime";
export const prerender = false;

const user = Astro.locals.user!;
if (user.rol === "motorista" || user.rol === "proveedor") return Astro.redirect("/");
const db = getDb(Astro);

const url = new URL(Astro.request.url);
const sedeParam = url.searchParams.get("sede");
const sedeId = sedeParam ? Number(sedeParam) : null;

const sucursalesList = await db
  .select({ id: sucursales.id, nombre: sucursales.nombre, direccion: sucursales.direccion })
  .from(sucursales)
  .where(eq(sucursales.activa, true))
  .orderBy(asc(sucursales.nombre));

const sedeActiva = sedeId ? sucursalesList.find((s) => s.id === sedeId) ?? null : null;

// 1) Planes por equipo (sede vía activo→ubicación→sucursal)
const planRowsAll = await db
  .select({ p: planesMantenimiento, a: activos, u: usuarios, s: sucursales, ub: ubicaciones })
  .from(planesMantenimiento)
  .leftJoin(activos, eq(activos.id, planesMantenimiento.activoId))
  .leftJoin(usuarios, eq(usuarios.id, planesMantenimiento.asignadoA))
  .leftJoin(ubicaciones, eq(ubicaciones.id, activos.ubicacionId))
  .leftJoin(sucursales, eq(sucursales.id, ubicaciones.sucursalId))
  .where(eq(planesMantenimiento.activo, true))
  .orderBy(asc(planesMantenimiento.proximaFecha));

// 2) Actividades recurrentes (sede directa)
const actRowsAll = await db
  .select({ a: actividades, c: actividadCategorias, u: usuarios, s: sucursales, ub: ubicaciones })
  .from(actividades)
  .leftJoin(actividadCategorias, eq(actividadCategorias.id, actividades.categoriaId))
  .leftJoin(usuarios, eq(usuarios.id, actividades.asignadoA))
  .leftJoin(sucursales, eq(sucursales.id, actividades.sucursalId))
  .leftJoin(ubicaciones, eq(ubicaciones.id, actividades.ubicacionId))
  .where(eq(actividades.activo, true))
  .orderBy(asc(actividades.proximaFecha));

const planRows = sedeId ? planRowsAll.filter((r) => r.s?.id === sedeId) : planRowsAll;
const actRows = sedeId ? actRowsAll.filter((r) => (r.s?.id ?? r.a.sucursalId) === sedeId) : actRowsAll;

// Agrupar planes de equipo por categoría del activo
const planesPorCategoria = new Map<string, typeof planRows>();
for (const r of planRows) {
  const cat = (r.a?.categoria?.trim() || (r.a?.tipo === "biomedico" ? "Equipo biomédico" : "Sin categoría"));
  const arr = planesPorCategoria.get(cat) ?? [];
  arr.push(r);
  planesPorCategoria.set(cat, arr);
}
const catsPlanes = [...planesPorCategoria.keys()].sort((a, b) => a.localeCompare(b, "es"));

// Agrupar actividades por su categoría
const actsPorCategoria = new Map<string, typeof actRows>();
for (const r of actRows) {
  const cat = r.c ? `${r.c.icono ?? ""} ${r.c.nombre}`.trim() : "📋 Sin categoría";
  const arr = actsPorCategoria.get(cat) ?? [];
  arr.push(r);
  actsPorCategoria.set(cat, arr);
}
const catsActs = [...actsPorCategoria.keys()].sort((a, b) => a.localeCompare(b, "es"));

const FRECUENCIA_LABEL: Record<string, string> = {
  diaria: "Diaria", semanal: "Semanal", quincenal: "Quincenal", mensual: "Mensual",
  bimestral: "Bimestral", trimestral: "Trimestral", semestral: "Semestral", anual: "Anual",
};

const hoy = new Date().toISOString().slice(0, 10);
const fmt = (s: string) => fmtFechaSoloCompacta(s);
const fechaGeneracion = fmtFechaSolo(hoy);
const titulo = sedeActiva ? `Plan de mantenimiento — ${sedeActiva.nombre}` : "Plan de mantenimiento — Todas las sedes";
---

<Layout title={titulo}>
  <!-- Barra de control (no se imprime) -->
  <div class="no-print flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">📄 Plan de mantenimiento por sede</h1>
      <p class="mt-1 text-sm text-slate-500">Documento consolidado: equipos con plan preventivo + actividades recurrentes.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <select id="sedeSel" class="input w-auto text-sm py-1.5">
        <option value="">🏢 Todas las sedes</option>
        {sucursalesList.map((s) => (
          <option value={s.id} selected={s.id === sedeId}>{s.nombre}</option>
        ))}
      </select>
      <button id="printBtn" class="btn-primary">🖨 Imprimir / PDF</button>
      <a href={`/cronograma${sedeId ? `?sede=${sedeId}` : ""}`} class="btn-secondary">← Cronograma</a>
    </div>
  </div>

  <!-- Documento -->
  <div class="print-doc card mt-4 p-6 sm:p-8">
    <!-- Encabezado del documento -->
    <div class="border-b-2 border-slate-800 pb-4">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="text-xs font-semibold uppercase tracking-widest text-slate-400">Avante Complejo Hospitalario · Mantenimiento</div>
          <h2 class="mt-1 text-xl font-bold text-slate-900">{titulo}</h2>
          {sedeActiva?.direccion && <p class="mt-0.5 text-xs text-slate-500">{sedeActiva.direccion}</p>}
        </div>
        <div class="text-right text-xs text-slate-500 shrink-0">
          <div>Generado: <span class="font-medium text-slate-700">{fechaGeneracion}</span></div>
          <div class="mt-0.5">Por: {user.nombre}</div>
        </div>
      </div>
      <div class="mt-3 flex flex-wrap gap-4 text-sm">
        <div><span class="font-bold text-slate-900">{planRows.length}</span> <span class="text-slate-500">planes de equipos</span></div>
        <div><span class="font-bold text-slate-900">{actRows.length}</span> <span class="text-slate-500">actividades recurrentes</span></div>
        <div><span class="font-bold text-slate-900">{catsPlanes.length + catsActs.length}</span> <span class="text-slate-500">categorías</span></div>
      </div>
    </div>

    <!-- Sección A: Equipos con plan preventivo -->
    <h3 class="mt-6 text-base font-bold text-slate-900 border-l-4 border-brand-600 pl-3">A. Equipos con plan preventivo</h3>
    {catsPlanes.length === 0 && (
      <p class="mt-3 text-sm text-slate-400">Sin planes de equipos {sedeActiva ? "registrados para esta sede" : "registrados"}. Los equipos deben tener ubicación asignada para aparecer bajo su sede.</p>
    )}
    {catsPlanes.map((cat) => {
      const rows = planesPorCategoria.get(cat)!;
      return (
        <div class="mt-4 avoid-break">
          <h4 class="text-sm font-semibold text-slate-700 bg-slate-100 rounded-md px-3 py-1.5 capitalize">{cat} <span class="font-normal text-slate-400">({rows.length})</span></h4>
          <div class="overflow-x-auto">
            <table class="mt-1 w-full text-left text-xs">
              <thead class="text-slate-500 border-b border-slate-200">
                <tr>
                  <th class="px-2 py-1.5 font-medium">Equipo</th>
                  <th class="px-2 py-1.5 font-medium">Ubicación</th>
                  <th class="px-2 py-1.5 font-medium">Plan / rutina</th>
                  <th class="px-2 py-1.5 font-medium">Frecuencia</th>
                  <th class="px-2 py-1.5 font-medium">Próxima fecha</th>
                  <th class="px-2 py-1.5 font-medium">Responsable</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {rows.map((r) => (
                  <tr>
                    <td class="px-2 py-1.5">
                      <span class="font-mono text-[10px] text-slate-400">{r.a?.codigo}</span>
                      <span class="ml-1 font-medium text-slate-800">{r.a?.nombre}</span>
                    </td>
                    <td class="px-2 py-1.5 text-slate-500">{!sedeActiva && r.s?.nombre ? `${r.s.nombre} · ` : ""}{r.ub?.nombre ?? r.a?.ubicacion ?? "—"}</td>
                    <td class="px-2 py-1.5 text-slate-700">{r.p.titulo}</td>
                    <td class="px-2 py-1.5 text-slate-600">{FRECUENCIA_LABEL[r.p.frecuencia] ?? r.p.frecuencia}</td>
                    <td class={`px-2 py-1.5 font-medium ${r.p.proximaFecha <= hoy ? "text-red-600" : "text-slate-700"}`}>{fmt(r.p.proximaFecha)}</td>
                    <td class="px-2 py-1.5 text-slate-500">{r.u?.nombre ?? "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      );
    })}

    <!-- Sección B: Actividades recurrentes (infraestructura) -->
    <h3 class="mt-8 text-base font-bold text-slate-900 border-l-4 border-emerald-600 pl-3">B. Actividades recurrentes de infraestructura</h3>
    {catsActs.length === 0 && (
      <p class="mt-3 text-sm text-slate-400">Sin actividades recurrentes {sedeActiva ? "registradas para esta sede" : "registradas"}.</p>
    )}
    {catsActs.map((cat) => {
      const rows = actsPorCategoria.get(cat)!;
      return (
        <div class="mt-4 avoid-break">
          <h4 class="text-sm font-semibold text-slate-700 bg-slate-100 rounded-md px-3 py-1.5">{cat} <span class="font-normal text-slate-400">({rows.length})</span></h4>
          <div class="overflow-x-auto">
            <table class="mt-1 w-full text-left text-xs">
              <thead class="text-slate-500 border-b border-slate-200">
                <tr>
                  <th class="px-2 py-1.5 font-medium">Código</th>
                  <th class="px-2 py-1.5 font-medium">Actividad</th>
                  <th class="px-2 py-1.5 font-medium">Ubicación</th>
                  <th class="px-2 py-1.5 font-medium">Frecuencia</th>
                  <th class="px-2 py-1.5 font-medium">Próxima fecha</th>
                  <th class="px-2 py-1.5 font-medium">Responsable</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {rows.map((r) => (
                  <tr>
                    <td class="px-2 py-1.5 font-mono text-[10px] text-slate-400">{r.a.codigo}</td>
                    <td class="px-2 py-1.5 font-medium text-slate-800">{r.a.titulo}</td>
                    <td class="px-2 py-1.5 text-slate-500">{!sedeActiva && r.s?.nombre ? `${r.s.nombre} · ` : ""}{r.ub?.nombre ?? r.a.ubicacionDetalle ?? "—"}</td>
                    <td class="px-2 py-1.5 text-slate-600">{FRECUENCIA_LABEL[r.a.frecuencia] ?? r.a.frecuencia}</td>
                    <td class={`px-2 py-1.5 font-medium ${r.a.proximaFecha <= hoy ? "text-red-600" : "text-slate-700"}`}>{fmt(r.a.proximaFecha)}</td>
                    <td class="px-2 py-1.5 text-slate-500">{r.u?.nombre ?? "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      );
    })}

    <!-- Pie del documento -->
    <div class="mt-8 border-t border-slate-200 pt-3 text-[10px] text-slate-400">
      Documento generado desde la plataforma de mantenimiento · Las fechas mostradas corresponden a la próxima ejecución programada de cada rutina · Fechas en rojo indican rutinas vencidas.
    </div>
  </div>

  <style is:global>
    @media print {
      .no-print, #sidebar, header, #bellPanel, #toastContainer { display: none !important; }
      main { padding: 0 !important; }
      .print-doc { border: none !important; box-shadow: none !important; margin-top: 0 !important; }
      .avoid-break { break-inside: avoid; }
      body { background: white !important; }
    }
  </style>

  <script>
    document.getElementById("printBtn")?.addEventListener("click", () => window.print());
    document.getElementById("sedeSel")?.addEventListener("change", (e) => {
      const v = (e.currentTarget as HTMLSelectElement).value;
      location.href = v ? `/plan-mantenimiento?sede=${v}` : "/plan-mantenimiento";
    });
  </script>
</Layout>
