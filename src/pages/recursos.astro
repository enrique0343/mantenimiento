---
import ModuleHub from "@/components/ModuleHub.astro";
import { puedeVerBio } from "@/lib/biomedico";
export const prerender=false;
const rol=Astro.locals.user!.rol;
const operativo=["admin","jefe","tecnico"].includes(rol),gestor=["admin","jefe"].includes(rol);
// Fase 59: lo biomédico (calibraciones, seguridad eléctrica, expedientes, licencias,
// capacitaciones, alertas, protocolos) lo ven admin, jefe, técnico y visualizador.
const verBio=puedeVerBio(rol);
const groups=[{label:"Abastecimiento",links:[
{href:"/inventario",label:"Almacén",description:"Repuestos, existencias y movimientos.",show:rol!=="motorista"},
{href:"/solicitudes-compra",label:"Compras",description:"Solicitudes, seguimiento y documentos.",show:operativo},
{href:"/requisiciones",label:"Requisiciones",description:"Solicitud y recepción de materiales.",show:operativo},
{href:"/recepciones",label:"Recepciones",description:"Entradas de materiales al almacén.",show:operativo},
]},{label:"Control compartido de activos",links:[
{href:"/calibraciones",label:"Calibraciones",description:"Estado por equipo, equipos críticos, viñetas, equipos patrón y laboratorios.",show:verBio},
{href:"/seguridad-electrica",label:"Seguridad eléctrica",description:"Pruebas IEC 62353, última prueba y próxima de los equipos Clase III.",show:verBio},
{href:"/expedientes",label:"Expedientes técnicos",description:"Qué documentos tiene cada equipo biomédico y qué le falta.",show:verBio},
{href:"/licencias",label:"Licencias y permisos",description:"Licencias del establecimiento, de servicios, de equipos y del personal, con su vencimiento.",show:verBio},
{href:"/capacitaciones",label:"Capacitaciones",description:"Capacitaciones al personal sobre el uso seguro de los equipos.",show:verBio},
{href:"/alertas",label:"Alertas y retiros",description:"Seguimiento de alertas que afectan a los activos.",show:verBio},
{href:"/incidentes",label:"Incidentes",description:"Órdenes relacionadas con incidentes o eventos adversos avisados a Calidad.",show:gestor||rol==="visualizador"},
{href:"/procedimientos?tipo=protocolo",label:"Protocolos institucionales",description:"Protocolos de Calidad con su PDF aprobado: incidentes, limpieza y desinfección, bajas.",show:verBio},
]},{label:"Servicios externos",links:[
{href:"/proveedores",label:"Proveedores",description:"Directorio de proveedores y servicios.",show:gestor},
{href:"/contratos",label:"Contratos",description:"Cobertura de activos y vencimientos.",show:gestor},
{href:"/configuracion#compras",label:"Destinatarios de compras",description:"Personas que reciben las solicitudes.",show:rol==="admin"},
]}];
---
<ModuleHub title="Recursos" description="Abastecimiento y servicios para las cuatro áreas de mantenimiento." groups={groups}/>
