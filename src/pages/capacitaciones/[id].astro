---
// Fase 59 · WP-D: hoja de una capacitación. Se imprime como registro y, sin asistentes,
// como hoja de asistencia para firmar a mano. Fuera de la hoja: archivos, edición e historial.
import { asc, eq } from "drizzle-orm";
import Layout from "@/layouts/Layout.astro";
import DocCabecera from "@/components/DocCabecera.astro";
import DocFolio from "@/components/DocFolio.astro";
import CapacitacionForm from "@/components/bio/CapacitacionForm.astro";
import { getDb } from "@/lib/db";
import { proveedores } from "@/lib/schema";
import { capacitacionConDetalle, equiposParaElegir, sedesActivas, sugerenciasServicio } from "@/lib/bio-consultas";
import {
  CATEGORIAS_ARCHIVO_CAPACITACION, EVIDENCIA_CAPACITACION, INSTRUCTOR_TIPO, codigoCapacitacion, etiquetaTipoCapacitacion,
  evidenciaCapacitacion, textoDeAsistentes, textoDuracion,
} from "@/lib/capacitaciones";
import { ARCHIVO_ACCEPT, fechaCorta, fechaHoraSV, hoySV, puedeGestionarBio, puedeRegistrarBio, puedeVerBio } from "@/lib/biomedico";
import { idPositivo } from "@/lib/bio-archivos";
import { areaHref } from "@/lib/areas";
export const prerender = false;

const user = Astro.locals.user!;
if (!puedeVerBio(user.rol)) return Astro.redirect("/");
const area = Astro.locals.area ?? null;
const id = idPositivo(Astro.params.id);
if (!id) return Astro.redirect(areaHref("/capacitaciones", area));
const db = getDb(Astro);
const d = await capacitacionConDetalle(db, id);
if (!d) return new Response("Capacitación no encontrada", { status: 404 });
const c = d.capacitacion;
const hoy = hoySV();
const codigo = codigoCapacitacion(c.id);
const listas = d.archivos.filter((a) => a.categoria === "lista_firmada").length;
const ev = evidenciaCapacitacion({ fecha: c.fecha, asistentes: d.asistentes.length, listasFirmadas: listas }, hoy);
const registra = puedeRegistrarBio(user.rol);
const gestiona = puedeGestionarBio(user.rol);
const enlace = (ruta: string) => areaHref(ruta, area);
const [equiposForm, provs, sedes, servicios] = registra
  ? await Promise.all([
    equiposParaElegir(db, { soloBiomedicos: true, capacitacionId: c.id }),
    db.select({ id: proveedores.id, nombre: proveedores.nombre }).from(proveedores).where(eq(proveedores.activo, true)).orderBy(asc(proveedores.nombre)),
    sedesActivas(db),
    sugerenciasServicio(db),
  ])
  : [[], [], [], []];
const filasFirma = d.asistentes.length ? d.asistentes : Array.from({ length: 20 }, () => null);
const ACCION: Record<string, string> = { create: "Registro", update: "Cambio", delete: "Eliminación", estado: "Cambio de estado" };
const empresa = c.instructorTipo === "externo" ? (c.proveedor ?? c.instructorEntidad ?? "—") : "—";
---

<Layout title={`${codigo} · ${c.tema}`}>
  <div class="no-print doc-barra" data-registro-api={`/api/capacitaciones/${c.id}`} data-registro-lista={enlace("/capacitaciones")}>
    <a class="btn-secondary" href={enlace("/capacitaciones")}>Volver</a>
    <div class="flex flex-wrap items-center gap-2">
      <span class={`badge ${EVIDENCIA_CAPACITACION[ev].color}`}>{EVIDENCIA_CAPACITACION[ev].etiqueta}</span>
      <button type="button" class="btn-primary" onclick="window.print()">Imprimir o guardar PDF</button>
      {registra && <button type="button" class="btn-secondary" data-editar>Editar</button>}
      {gestiona && (
        <button type="button" class="btn-danger" data-eliminar data-titulo="¿Eliminar esta capacitación?"
          data-mensaje={`${codigo}, sus asistentes y sus archivos se borran. No se puede deshacer.`}>Eliminar</button>
      )}
    </div>
  </div>

  <article class="print-doc doc-hoja" data-ver-capacitacion>
    <DocCabecera titulo="Registro de capacitación" subtitulo={c.tema} codigo={codigo} fecha={c.fecha} />
    <section class="doc-seccion">
      <table class="doc-kv">
        <tbody>
          <tr><th>Fecha</th><td>{fechaCorta(c.fecha)}</td><th>Tipo</th><td>{etiquetaTipoCapacitacion(c.tipo)}</td></tr>
          <tr><th>Tema</th><td colspan="3">{c.tema}</td></tr>
          <tr><th>Duración</th><td>{textoDuracion(c.duracionMinutos)}</td><th>Instructor</th><td>{c.instructorNombre}</td></tr>
          <tr><th>Interno o externo</th><td>{INSTRUCTOR_TIPO[c.instructorTipo as keyof typeof INSTRUCTOR_TIPO] ?? c.instructorTipo}</td><th>Proveedor o empresa</th><td>{empresa}</td></tr>
          <tr><th>Sede</th><td>{c.sede ?? "—"}</td><th>Lugar</th><td>{c.lugar ?? "—"}</td></tr>
          <tr><th>Servicio</th><td>{c.servicio ?? "—"}</td><th>Modelo cubierto</th><td>{c.modeloCubierto ?? "—"}</td></tr>
          {c.notas && <tr><th>Notas</th><td colspan="3">{c.notas}</td></tr>}
        </tbody>
      </table>
    </section>

    <section class="doc-seccion">
      <h2 class="doc-h">Equipos cubiertos</h2>
      {d.equipos.length === 0 ? <p class="doc-texto">{c.modeloCubierto ? `Modelo: ${c.modeloCubierto}` : "Sin equipos enlazados."}</p> : (
        <table class="doc-tabla">
          <thead><tr><th>Código</th><th>Equipo</th><th>Marca y modelo</th><th>Serie</th><th>Ubicación</th></tr></thead>
          <tbody>
            {d.equipos.map((e) => (
              <tr>
                <td class="tn"><a href={`/activos/${e.id}#capacitaciones`}>{e.codigo}</a></td>
                <td>{e.nombre}{e.estado === "baja" && <span class="doc-nota-celda">Dado de baja</span>}</td>
                <td>{[e.marca, e.modelo].filter(Boolean).join(" ") || "—"}</td>
                <td>{e.serial ?? "—"}</td>
                <td>{[e.ubicacion ?? e.ubicacionTexto, e.sede].filter(Boolean).join(" · ") || "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>

    <section class="doc-seccion">
      <h2 class="doc-h">Asistentes</h2>
      <table class="doc-tabla">
        <thead><tr><th class="n">N.º</th><th style="min-width:180px">Nombre</th><th>Cargo</th><th>Servicio</th><th style="min-width:140px">Firma</th></tr></thead>
        <tbody>
          {filasFirma.map((a, i) => (
            <tr>
              <td class="n">{i + 1}</td>
              <td>{a?.nombre ?? " "}</td>
              <td>{a?.cargo ?? ""}</td>
              <td>{a?.servicio ?? ""}</td>
              <td style="height:26px"></td>
            </tr>
          ))}
        </tbody>
      </table>
      {d.asistentes.length === 0 && <p class="doc-nota">Hoja para firmar a mano. Después sube la foto o el PDF de la lista firmada.</p>}
    </section>

    {d.archivos.length > 0 && (
      <section class="doc-seccion">
        <h2 class="doc-h">Archivos adjuntos</h2>
        <ul class="doc-texto list-disc pl-5">
          {d.archivos.map((a) => <li>{a.nombre} · {CATEGORIAS_ARCHIVO_CAPACITACION[a.categoria as keyof typeof CATEGORIAS_ARCHIVO_CAPACITACION] ?? a.categoria}</li>)}
        </ul>
      </section>
    )}

    <section class="doc-seccion doc-firmas">
      <div><div class="doc-firma-vacia"></div><span class="doc-etq">Instructor</span><span>{c.instructorNombre}</span></div>
      <div><div class="doc-firma-vacia"></div><span class="doc-etq">Responsable de Ingeniería Biomédica</span><span>&nbsp;</span></div>
    </section>
    <DocFolio codigo={codigo} />
  </article>

  <div class="no-print card mt-4 p-5" data-registro-api={`/api/capacitaciones/${c.id}`} data-registro-lista={enlace("/capacitaciones")}>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="font-semibold">Archivos</h2>
      {registra && <button type="button" class="btn-primary text-sm" data-archivo-abrir>+ Subir archivo</button>}
    </div>
    {registra && (
      <form class="mt-3 hidden grid grid-cols-1 gap-3 rounded-md border border-slate-200 bg-slate-50 p-4 sm:grid-cols-3" data-archivo-form novalidate>
        <div class="sm:col-span-2">
          <label class="label" for="capArchivo">Archivo (PDF o foto, máx. 15 MB cada uno) *</label>
          <input id="capArchivo" name="file" type="file" accept={ARCHIVO_ACCEPT} multiple class="input" />
        </div>
        <div>
          <label class="label" for="capArchivoCategoria">Categoría</label>
          <select id="capArchivoCategoria" name="categoria" class="input">
            {Object.entries(CATEGORIAS_ARCHIVO_CAPACITACION).map(([v, t]) => <option value={v}>{t}</option>)}
          </select>
        </div>
        <p class="hidden text-sm sm:col-span-3" data-msg role="alert"></p>
        <div class="flex gap-2 sm:col-span-3">
          <button type="submit" class="btn-primary btn-sm">Subir</button>
          <button type="button" class="btn-secondary btn-sm" data-archivo-cancelar>Cancelar</button>
        </div>
      </form>
    )}
    {d.archivos.length === 0 ? (
      <p class="mt-3 text-sm text-slate-500">{ev === "programada" ? "Cuando se realice, sube aquí la lista firmada." : "Falta la lista de asistencia firmada."}</p>
    ) : (
      <ul class="mt-3 divide-y divide-slate-100 text-sm">
        {d.archivos.map((a) => (
          <li class="flex flex-wrap items-center justify-between gap-2 py-2">
            <span class="min-w-0">
              <a class="break-words font-medium text-brand-700 hover:underline" href={`/api/capacitaciones/archivo/${a.id}`} target="_blank" rel="noopener">{a.nombre}</a>
              <span class="block text-xs text-slate-500">{CATEGORIAS_ARCHIVO_CAPACITACION[a.categoria as keyof typeof CATEGORIAS_ARCHIVO_CAPACITACION] ?? a.categoria} · {Math.max(1, Math.round(a.tamano / 1024))} KB · {fechaCorta(a.createdAt)}{a.usuario ? ` · ${a.usuario}` : ""}</span>
            </span>
            {gestiona && <button type="button" class="text-xs text-red-600 hover:underline" data-archivo-eliminar data-id={a.id} data-nombre={a.nombre}>Eliminar</button>}
          </li>
        ))}
      </ul>
    )}
  </div>

  {registra && (
    <CapacitacionForm
      modo="editar"
      oculto
      inicial={{ ...c, equipoIds: d.equipos.map((e) => e.id), asistentesTexto: textoDeAsistentes(d.asistentes) }}
      equipos={equiposForm}
      proveedores={provs}
      sucursales={sedes}
      sugerenciasServicio={servicios}
      cancelarHref={enlace(`/capacitaciones/${c.id}`)}
    />
  )}

  {d.historial.length > 0 && (
    <div class="no-print card mt-4 p-5">
      <h2 class="font-semibold">Historial</h2>
      <ul class="mt-2 divide-y divide-slate-100 text-sm">
        {d.historial.map((h) => (
          <li class="py-2"><span class="text-xs text-slate-500">{fechaHoraSV(h.cuando)} · {h.usuario ?? "—"}</span><span class="block">{h.resumen ?? ACCION[h.accion] ?? h.accion}</span></li>
        ))}
      </ul>
      <p class="mt-2 text-xs text-slate-500">Registrada por {c.registradoPor ?? "—"} el {fechaHoraSV(c.createdAt)}.</p>
    </div>
  )}

  <script>
    import { instalarAccionesRegistro } from "@/components/bio/archivos-registro";
    instalarAccionesRegistro();
  </script>
</Layout>
